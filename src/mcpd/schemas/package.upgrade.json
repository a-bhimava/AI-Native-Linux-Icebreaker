{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "package.upgrade",
  "description": "Upgrade a Debian package. Returns requires_cow_approval; Phase 3 commits.",
  "type": "object",
  "properties": {
    "package": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9+\\-.]*$"
    }
  },
  "required": [
    "package"
  ],
  "additionalProperties": false,
  "x-icebreaker-trust": {
    "tier": 2,
    "reversible": true,
    "requires_hitl": false,
    "requires_cow": true
  }
}
