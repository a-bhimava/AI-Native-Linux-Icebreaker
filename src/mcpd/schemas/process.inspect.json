{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "process.inspect",
  "description": "Returns detailed info about a specific process by PID.",
  "type": "object",
  "properties": {
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304,
      "description": "Process ID to inspect (Linux PID_MAX_LIMIT = 4194304)."
    }
  },
  "required": [
    "pid"
  ],
  "additionalProperties": false,
  "x-icebreaker-trust": {
    "tier": 0,
    "reversible": true,
    "requires_hitl": false,
    "requires_cow": false
  }
}
