{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fs.stat",
  "description": "Return file metadata: size, type (file/dir/symlink), mode, uid, gid, mtime.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Absolute path to inspect."
    }
  },
  "required": ["path"],
  "additionalProperties": false
}
