{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "package.install",
  "description": "Install a Debian package. ALWAYS returns requires_cow_approval \u2014 Phase 3 commits via apt-get inside a COW overlay.",
  "type": "object",
  "properties": {
    "package": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9+\\-.]*$",
      "description": "Debian package name (policy 5.6.7)."
    }
  },
  "required": [
    "package"
  ],
  "additionalProperties": false,
  "x-icebreaker-trust": {
    "tier": 2,
    "reversible": true,
    "requires_hitl": false,
    "requires_cow": true
  }
}
