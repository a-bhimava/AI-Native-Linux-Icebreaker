{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "service.stop",
  "description": "Stop a systemd unit via org.freedesktop.systemd1.Manager.StopUnit.",
  "type": "object",
  "properties": {
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._@:\\\\-]+$",
      "description": "Unit name, e.g. 'nginx.service'."
    }
  },
  "required": ["unit"],
  "additionalProperties": false
}
