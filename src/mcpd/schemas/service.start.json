{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "service.start",
  "description": "Start a systemd unit via org.freedesktop.systemd1.Manager.StartUnit. Returns status:unavailable when the system bus is not reachable (P1-F3 graceful degradation).",
  "type": "object",
  "properties": {
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._@:\\\\-]+$",
      "description": "Unit name, e.g. 'nginx.service'."
    }
  },
  "required": [
    "unit"
  ],
  "additionalProperties": false,
  "x-icebreaker-trust": {
    "tier": 2,
    "reversible": true,
    "requires_hitl": false,
    "requires_cow": false
  }
}
