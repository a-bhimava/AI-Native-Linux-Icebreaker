{"nl": "I want to make a new empty text file called notes on my desktop", "bash": "touch ~/Desktop/notes.txt", "category": "colloquial"}
{"nl": "create an empty file named todo in my documents folder", "bash": "touch ~/Documents/todo.txt", "category": "colloquial"}
{"nl": "make a blank file called readme inside my projects folder", "bash": "touch ~/projects/readme.md", "category": "colloquial"}
{"nl": "I need an empty log file in my downloads folder", "bash": "touch ~/Downloads/debug.log", "category": "colloquial"}
{"nl": "make a brand new folder called photos in my home directory", "bash": "mkdir ~/photos", "category": "colloquial"}
{"nl": "create a folder named backups on my desktop", "bash": "mkdir ~/Desktop/backups", "category": "colloquial"}
{"nl": "I want a new directory called invoices inside documents", "bash": "mkdir ~/Documents/invoices", "category": "colloquial"}
{"nl": "make a folder called april2026 inside my reports folder", "bash": "mkdir ~/reports/april2026", "category": "colloquial"}
{"nl": "how do I make a folder inside another folder that doesnt exist yet", "bash": "mkdir -p ~/projects/myapp/src/components", "category": "colloquial"}
{"nl": "create the whole folder path documents slash work slash 2026 slash q2 in one go", "bash": "mkdir -p ~/Documents/work/2026/q2", "category": "colloquial"}
{"nl": "I want to make several nested folders for organizing my photos by year and month", "bash": "mkdir -p ~/Pictures/2026/{01,02,03,04,05,06,07,08,09,10,11,12}", "category": "colloquial"}
{"nl": "set up a typical project folder layout under newapp with src tests and docs", "bash": "mkdir -p ~/projects/newapp/{src,tests,docs}", "category": "colloquial"}
{"nl": "make me a folder for each weekday inside my schedule folder", "bash": "mkdir -p ~/schedule/{monday,tuesday,wednesday,thursday,friday}", "category": "colloquial"}
{"nl": "I want to create a quick file with the text hello world in it", "bash": "echo 'hello world' > ~/hello.txt", "category": "colloquial"}
{"nl": "make a file called config.txt with the line debug equals true inside it", "bash": "echo 'debug=true' > ~/config.txt", "category": "colloquial"}
{"nl": "create a shopping list file with three items milk eggs bread", "bash": "printf 'milk\\neggs\\nbread\\n' > ~/Documents/shopping.txt", "category": "colloquial"}
{"nl": "I need a small shell script file that just prints hi", "bash": "printf '#!/bin/bash\\necho hi\\n' > ~/scripts/hi.sh", "category": "colloquial"}
{"nl": "save a multi line note about my meeting today into a file", "bash": "cat > ~/Documents/meeting.txt <<'EOF'\nMeeting with team\nDiscussed Q2 roadmap\nNext steps: send recap\nEOF", "category": "colloquial"}
{"nl": "write a quick readme with three lines of content into my new project folder", "bash": "cat > ~/projects/newapp/README.md <<'EOF'\n# newapp\nA small experiment.\nRun with: ./start.sh\nEOF", "category": "colloquial"}
{"nl": "make a temporary scratch file I can use for a moment", "bash": "mktemp", "category": "colloquial"}
{"nl": "I want a temp file with a name I can save and reuse", "bash": "mktemp /tmp/scratch.XXXXXX", "category": "colloquial"}
{"nl": "create a temporary folder I can dump files into for now", "bash": "mktemp -d", "category": "colloquial"}
{"nl": "make a one gigabyte placeholder file for testing", "bash": "truncate -s 1G ~/Downloads/placeholder.bin", "category": "colloquial"}
{"nl": "I need a 500 megabyte dummy file to test upload speeds", "bash": "truncate -s 500M ~/Downloads/dummy.bin", "category": "colloquial"}
{"nl": "create a 10 megabyte test file in tmp", "bash": "truncate -s 10M /tmp/test10mb.bin", "category": "colloquial"}
{"nl": "make a copy of my resume so I can edit one version safely", "bash": "cp ~/Documents/resume.pdf ~/Documents/resume_backup.pdf", "category": "colloquial"}
{"nl": "I want to make a copy of this file before I edit it", "bash": "cp ~/projects/myapp/config.yaml ~/projects/myapp/config.yaml.bak", "category": "colloquial"}
{"nl": "duplicate the notes file as notes2", "bash": "cp ~/Documents/notes.txt ~/Documents/notes2.txt", "category": "colloquial"}
{"nl": "copy my budget spreadsheet to the desktop", "bash": "cp ~/Documents/budget.xlsx ~/Desktop/budget.xlsx", "category": "colloquial"}
{"nl": "put a copy of the slides into the shared folder", "bash": "cp ~/Documents/slides.pptx ~/shared/slides.pptx", "category": "colloquial"}
{"nl": "copy the whole projects folder to my external drive mount point", "bash": "cp -r ~/projects /mnt/external/projects", "category": "colloquial"}
{"nl": "make a full copy of my pictures folder onto the desktop", "bash": "cp -r ~/Pictures ~/Desktop/Pictures_copy", "category": "colloquial"}
{"nl": "copy the entire myapp directory into the archive folder", "bash": "cp -r ~/projects/myapp ~/archive/myapp", "category": "colloquial"}
{"nl": "I want to copy the receipts folder including everything inside it", "bash": "cp -r ~/Documents/receipts ~/Documents/receipts_2025", "category": "colloquial"}
{"nl": "copy this file but keep the original date and permissions intact", "bash": "cp -p ~/Documents/contract.pdf ~/Desktop/contract.pdf", "category": "colloquial"}
{"nl": "duplicate the log file but preserve its timestamps", "bash": "cp -p /var/log/syslog ~/syslog_snapshot", "category": "colloquial"}
{"nl": "copy these photos but only overwrite if mine are older", "bash": "cp -u ~/Pictures/*.jpg /mnt/backup/Pictures/", "category": "colloquial"}
{"nl": "sync documents to backup but only replace files that have changed", "bash": "cp -ru ~/Documents/* /mnt/backup/Documents/", "category": "colloquial"}
{"nl": "copy the config file but make a numbered backup of any existing version", "bash": "cp --backup=numbered ~/.bashrc ~/.bashrc.new", "category": "colloquial"}
{"nl": "copy three different files into my reports folder", "bash": "cp ~/Documents/q1.pdf ~/Documents/q2.pdf ~/Documents/q3.pdf ~/reports/", "category": "colloquial"}
{"nl": "put all my pdf files into a single folder called pdfs", "bash": "cp ~/Documents/*.pdf ~/Documents/pdfs/", "category": "colloquial"}
{"nl": "copy every jpg from downloads into my pictures folder", "bash": "cp ~/Downloads/*.jpg ~/Pictures/", "category": "colloquial"}
{"nl": "I need to copy the hidden config files from my old account folder", "bash": "cp -r /home/olduser/.config ~/.config_old", "category": "colloquial"}
{"nl": "copy all dotfiles including hidden ones from this folder to backup", "bash": "cp -a ~/myconfig/. ~/backup_myconfig/", "category": "colloquial"}
{"nl": "rename this file from draft to final", "bash": "mv ~/Documents/draft.docx ~/Documents/final.docx", "category": "colloquial"}
{"nl": "change the name of the photos folder to memories", "bash": "mv ~/photos ~/memories", "category": "colloquial"}
{"nl": "rename my screenshot file to something more descriptive", "bash": "mv ~/Pictures/Screenshot.png ~/Pictures/login_error_screenshot.png", "category": "colloquial"}
{"nl": "move my resume from downloads into documents", "bash": "mv ~/Downloads/resume.pdf ~/Documents/resume.pdf", "category": "colloquial"}
{"nl": "shift this video file to my videos folder", "bash": "mv ~/Downloads/movie.mp4 ~/Videos/movie.mp4", "category": "colloquial"}
{"nl": "move the whole reports folder into the archive folder", "bash": "mv ~/reports ~/archive/reports", "category": "colloquial"}
{"nl": "transfer all jpg files from downloads to pictures", "bash": "mv ~/Downloads/*.jpg ~/Pictures/", "category": "colloquial"}
{"nl": "move every pdf out of downloads into documents", "bash": "mv ~/Downloads/*.pdf ~/Documents/", "category": "colloquial"}
{"nl": "I want to rename a bunch of files at once and put a prefix on them", "bash": "for f in ~/Pictures/IMG_*.jpg; do mv \"$f\" \"$(dirname \"$f\")/vacation_$(basename \"$f\")\"; done", "category": "colloquial"}
{"nl": "rename every txt file in this folder to have a 2026 prefix", "bash": "for f in ~/Documents/notes/*.txt; do mv \"$f\" \"$(dirname \"$f\")/2026_$(basename \"$f\")\"; done", "category": "colloquial"}
{"nl": "change the extension of all my htm files to html", "bash": "for f in ~/site/*.htm; do mv \"$f\" \"${f%.htm}.html\"; done", "category": "colloquial"}
{"nl": "rename all jpeg files to jpg", "bash": "for f in ~/Pictures/*.jpeg; do mv \"$f\" \"${f%.jpeg}.jpg\"; done", "category": "colloquial"}
{"nl": "move this file but only if a file with that name doesnt already exist at the destination", "bash": "mv -n ~/Downloads/report.pdf ~/Documents/report.pdf", "category": "colloquial"}
{"nl": "shift my photos into the archive but dont overwrite anything that is already there", "bash": "mv -n ~/Pictures/2025/* ~/archive/photos/2025/", "category": "colloquial"}
{"nl": "delete the file called old notes from my desktop", "bash": "rm ~/Desktop/old_notes.txt", "category": "colloquial"}
{"nl": "throw away this temp file", "bash": "rm /tmp/scratch.txt", "category": "colloquial"}
{"nl": "remove the broken download from my downloads folder", "bash": "rm ~/Downloads/installer.dmg", "category": "colloquial"}
{"nl": "I want to get rid of this entire old project folder", "bash": "rm -r ~/projects/old_prototype", "category": "colloquial"}
{"nl": "delete the trash folder on my desktop and everything inside it", "bash": "rm -r ~/Desktop/trash", "category": "colloquial"}
{"nl": "wipe out the cache folder for my app", "bash": "rm -r ~/.cache/myapp", "category": "colloquial"}
{"nl": "force delete this stubborn file that wont go away", "bash": "rm -f ~/Downloads/.DS_Store", "category": "colloquial"}
{"nl": "delete every tmp file in the temp folder without asking", "bash": "rm -f /tmp/*.tmp", "category": "colloquial"}
{"nl": "delete this file but ask me to confirm first", "bash": "rm -i ~/Documents/important.doc", "category": "colloquial"}
{"nl": "remove every log file in this folder but prompt me before each one", "bash": "rm -i ~/logs/*.log", "category": "colloquial"}
{"nl": "delete every file ending in dot bak in my projects folder", "bash": "find ~/projects -type f -name '*.bak' -delete", "category": "colloquial"}
{"nl": "remove all the empty zero size files from downloads", "bash": "find ~/Downloads -type f -empty -delete", "category": "colloquial"}
{"nl": "find and delete all the ds store junk files in my pictures", "bash": "find ~/Pictures -type f -name '.DS_Store' -delete", "category": "colloquial"}
{"nl": "delete every log file older than 30 days in my logs folder", "bash": "find ~/logs -type f -name '*.log' -mtime +30 -delete", "category": "colloquial"}
{"nl": "securely wipe this sensitive file so nobody can recover it", "bash": "shred -u ~/Documents/secrets.txt", "category": "colloquial"}
{"nl": "permanently destroy this old tax document with no chance of recovery", "bash": "shred -u -n 5 ~/Documents/tax_2018.pdf", "category": "colloquial"}
{"nl": "empty out this log file without deleting it", "bash": "truncate -s 0 ~/logs/app.log", "category": "colloquial"}
{"nl": "clear the contents of this debug file but keep the file there", "bash": "truncate -s 0 ~/projects/myapp/debug.log", "category": "colloquial"}
{"nl": "delete this empty folder", "bash": "rmdir ~/Documents/empty_folder", "category": "colloquial"}
{"nl": "remove the empty draft directory", "bash": "rmdir ~/projects/myapp/drafts", "category": "colloquial"}
{"nl": "delete all empty subfolders inside my downloads", "bash": "find ~/Downloads -type d -empty -delete", "category": "colloquial"}
{"nl": "I downloaded a zip file how do I unzip it", "bash": "unzip ~/Downloads/archive.zip -d ~/Downloads/", "category": "colloquial"}
{"nl": "unzip this file I downloaded into a new folder called extracted", "bash": "unzip ~/Downloads/files.zip -d ~/Downloads/extracted", "category": "colloquial"}
{"nl": "extract the contents of this zip", "bash": "unzip ~/Downloads/photos.zip -d ~/Pictures/", "category": "colloquial"}
{"nl": "compress my reports folder into a single zip file", "bash": "zip -r ~/reports.zip ~/reports", "category": "colloquial"}
{"nl": "zip up the documents folder into one archive", "bash": "zip -r ~/Documents_backup.zip ~/Documents", "category": "colloquial"}
{"nl": "package my whole projects folder into a compressed file for emailing", "bash": "tar czf ~/projects_$(date +%F).tar.gz -C ~ projects", "category": "colloquial"}
{"nl": "create a compressed archive of my photos folder", "bash": "tar czf ~/photos_backup.tar.gz -C ~ Pictures", "category": "colloquial"}
{"nl": "I have a tar.gz file how do I open it", "bash": "tar xzf ~/Downloads/release.tar.gz -C ~/Downloads/", "category": "colloquial"}
{"nl": "extract this tarball into my projects folder", "bash": "tar xzf ~/Downloads/source.tar.gz -C ~/projects/", "category": "colloquial"}
{"nl": "what files are inside this tar archive without extracting it", "bash": "tar tzf ~/Downloads/release.tar.gz", "category": "colloquial"}
{"nl": "peek inside this gz file and list its contents", "bash": "tar tzf ~/Downloads/data.tar.gz", "category": "colloquial"}
{"nl": "pull out just the readme file from inside this tarball", "bash": "tar xzf ~/Downloads/project.tar.gz -C ~/Downloads/ project/README.md", "category": "colloquial"}
{"nl": "extract only the config file from this archive", "bash": "tar xzf ~/Downloads/app.tar.gz -C ~/Downloads/ app/config.yaml", "category": "colloquial"}
{"nl": "make a compressed archive of my projects folder but skip the node modules folders", "bash": "tar czf ~/projects.tar.gz --exclude='node_modules' -C ~ projects", "category": "colloquial"}
{"nl": "zip my source code but leave out the build folder", "bash": "tar czf ~/source.tar.gz --exclude='build' --exclude='dist' -C ~/projects myapp", "category": "colloquial"}
{"nl": "compress this big log file to save space", "bash": "gzip ~/logs/syslog.20260520", "category": "colloquial"}
{"nl": "shrink this database dump with gzip", "bash": "gzip ~/backups/db_dump.sql", "category": "colloquial"}
{"nl": "uncompress this gz file back to the original", "bash": "gunzip ~/Downloads/data.csv.gz", "category": "colloquial"}
{"nl": "decompress the log file so I can read it", "bash": "gunzip ~/logs/syslog.20260520.gz", "category": "colloquial"}
{"nl": "make this file executable so I can run it", "bash": "chmod +x ~/scripts/start.sh", "category": "colloquial"}
{"nl": "give this script permission to be run", "bash": "chmod +x ~/projects/myapp/deploy.sh", "category": "colloquial"}
{"nl": "let everyone read this file but not change it", "bash": "chmod a=r ~/Documents/public_notice.txt", "category": "colloquial"}
{"nl": "take away write permission from the group on this file", "bash": "chmod g-w ~/Documents/report.pdf", "category": "colloquial"}
{"nl": "only let me read and write this file nobody else", "bash": "chmod 600 ~/.ssh/id_ed25519", "category": "colloquial"}
{"nl": "set this folder so only I can use it", "bash": "chmod 700 ~/private", "category": "colloquial"}
{"nl": "make this file readable by everyone but only writable by me", "bash": "chmod 644 ~/Documents/changelog.md", "category": "colloquial"}
{"nl": "set the standard permissions for a website folder", "bash": "chmod 755 ~/sites/blog", "category": "colloquial"}
{"nl": "lock this file down to owner only with full access", "bash": "chmod 700 ~/Documents/private_journal.txt", "category": "colloquial"}
{"nl": "fix the permissions on my pictures folder recursively", "bash": "chmod -R 755 ~/Pictures", "category": "colloquial"}
{"nl": "make all the scripts in this folder runnable", "bash": "chmod -R +x ~/scripts", "category": "colloquial"}
{"nl": "change who owns this folder to me", "bash": "chown -R $USER:$USER ~/projects/myapp", "category": "colloquial"}
{"nl": "make a shortcut on my desktop that points to my projects folder", "bash": "ln -s ~/projects ~/Desktop/projects_link", "category": "colloquial"}
{"nl": "create a symlink to the config file in my home directory", "bash": "ln -s ~/projects/myapp/config.yaml ~/config.yaml", "category": "colloquial"}
{"nl": "make a hard link from this document to a second name", "bash": "ln ~/Documents/notes.txt ~/Documents/notes_link.txt", "category": "colloquial"}
{"nl": "where does this shortcut actually point to", "bash": "readlink ~/Desktop/projects_link", "category": "colloquial"}
{"nl": "find all the broken shortcuts in my home folder", "bash": "find ~ -xtype l", "category": "colloquial"}
{"nl": "show me all the dead symlinks under home", "bash": "find ~ -type l ! -exec test -e {} \\; -print", "category": "colloquial"}
{"nl": "atomically replace this shortcut to point to a new location", "bash": "ln -sfn ~/projects/newapp ~/current", "category": "colloquial"}
{"nl": "find every pdf file in my documents folder", "bash": "find ~/Documents -type f -name '*.pdf'", "category": "colloquial"}
{"nl": "I want to see all the jpg photos under pictures", "bash": "find ~/Pictures -type f -name '*.jpg'", "category": "colloquial"}
{"nl": "list every subfolder under projects", "bash": "find ~/projects -type d", "category": "colloquial"}
{"nl": "show me only the files not the folders in this tree", "bash": "find ~/Documents -type f", "category": "colloquial"}
{"nl": "what files have changed in the last 7 days under home", "bash": "find ~ -type f -mtime -7", "category": "colloquial"}
{"nl": "find every file I changed today in my projects folder", "bash": "find ~/projects -type f -mtime 0", "category": "colloquial"}
{"nl": "show me files larger than 100 megabytes in downloads", "bash": "find ~/Downloads -type f -size +100M", "category": "colloquial"}
{"nl": "find any really small files under 1 kilobyte in my logs folder", "bash": "find ~/logs -type f -size -1k", "category": "colloquial"}
{"nl": "list all files owned by my user under the projects folder", "bash": "find ~/projects -type f -user $USER", "category": "colloquial"}
{"nl": "find every file with permissions set to wide open 777", "bash": "find ~ -type f -perm 777", "category": "colloquial"}
{"nl": "show me all the empty files in my downloads", "bash": "find ~/Downloads -type f -empty", "category": "colloquial"}
{"nl": "list the empty folders inside documents", "bash": "find ~/Documents -type d -empty", "category": "colloquial"}
{"nl": "tell me everything about this file when it was made size permissions", "bash": "stat ~/Documents/report.pdf", "category": "colloquial"}
{"nl": "what kind of file is this exactly", "bash": "file ~/Downloads/unknown_blob", "category": "colloquial"}
{"nl": "is this an image or a text file", "bash": "file ~/Downloads/attachment", "category": "colloquial"}
{"nl": "how many lines are in this text file", "bash": "wc -l ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "count the lines in my todo list", "bash": "wc -l ~/Documents/todo.txt", "category": "colloquial"}
{"nl": "how many characters are in this file", "bash": "wc -c ~/Documents/essay.txt", "category": "colloquial"}
{"nl": "show me a detailed file listing including hidden files", "bash": "ls -lah ~", "category": "colloquial"}
{"nl": "list everything in my documents folder with sizes and dates", "bash": "ls -lah ~/Documents", "category": "colloquial"}
{"nl": "how big is my downloads folder total", "bash": "du -sh ~/Downloads", "category": "colloquial"}
{"nl": "what is the size of my projects directory", "bash": "du -sh ~/projects", "category": "colloquial"}
{"nl": "check if a file called report.pdf exists in documents", "bash": "test -e ~/Documents/report.pdf && echo exists || echo missing", "category": "colloquial"}
{"nl": "does my dotfile bashrc exist in home", "bash": "test -f ~/.bashrc && echo yes || echo no", "category": "colloquial"}
{"nl": "replace every instance of foo with bar in this config file", "bash": "sed -i 's/foo/bar/g' ~/projects/myapp/config.yaml", "category": "colloquial"}
{"nl": "swap localhost for 127.0.0.1 in this hosts list", "bash": "sed -i 's/localhost/127.0.0.1/g' ~/projects/myapp/hosts.txt", "category": "colloquial"}
{"nl": "fix the typo teh to the in this draft", "bash": "sed -i 's/teh/the/g' ~/Documents/draft.txt", "category": "colloquial"}
{"nl": "add a new line at the end of my todo list", "bash": "echo 'buy groceries' >> ~/Documents/todo.txt", "category": "colloquial"}
{"nl": "append a comment to the bottom of my bashrc", "bash": "echo '# updated 2026-05-28' >> ~/.bashrc", "category": "colloquial"}
{"nl": "tack on another todo item to my list", "bash": "echo 'call dentist' >> ~/Documents/todo.txt", "category": "colloquial"}
{"nl": "stick a new shebang line at the top of this script", "bash": "sed -i '1i #!/bin/bash' ~/scripts/run.sh", "category": "colloquial"}
{"nl": "insert a header line at the top of this csv", "bash": "sed -i '1i name,email,phone' ~/Documents/contacts.csv", "category": "colloquial"}
{"nl": "insert a note as line 5 of my journal file", "bash": "sed -i '5i Inserted note on 2026-05-28' ~/Documents/journal.txt", "category": "colloquial"}
{"nl": "delete every line that has the word debug in it from this config", "bash": "sed -i '/debug/d' ~/projects/myapp/config.yaml", "category": "colloquial"}
{"nl": "remove all blank lines from this text file", "bash": "sed -i '/^$/d' ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "strip out every line containing the word TODO from this file", "bash": "sed -i '/TODO/d' ~/projects/myapp/main.py", "category": "colloquial"}
{"nl": "compare these two versions of the config file and show what changed", "bash": "diff -u ~/projects/myapp/config.yaml ~/projects/myapp/config.yaml.bak", "category": "colloquial"}
{"nl": "show the differences between my old and new resume", "bash": "diff -u ~/Documents/resume_old.txt ~/Documents/resume_new.txt", "category": "colloquial"}
{"nl": "are these two files exactly identical", "bash": "cmp ~/Documents/a.bin ~/Documents/b.bin && echo same || echo different", "category": "colloquial"}
{"nl": "tell me if file1 and file2 in my downloads are the same", "bash": "cmp ~/Downloads/file1.zip ~/Downloads/file2.zip && echo identical || echo different", "category": "colloquial"}
{"nl": "watch this log file and tell me when it changes", "bash": "inotifywait -m ~/logs/app.log", "category": "colloquial"}
{"nl": "alert me when anything in this folder is modified", "bash": "inotifywait -m -r ~/projects/myapp", "category": "colloquial"}
{"nl": "keep showing me the file list updated every 2 seconds", "bash": "watch -n 2 ls -lah ~/Downloads", "category": "colloquial"}
{"nl": "monitor the size of this growing file", "bash": "watch -n 1 'stat -c %s ~/logs/app.log'", "category": "colloquial"}
{"nl": "make this file read only so I dont accidentally edit it", "bash": "chmod 444 ~/Documents/final_contract.pdf", "category": "colloquial"}
{"nl": "lock this configuration file so it cant be changed at all", "bash": "sudo chattr +i /etc/resolv.conf", "category": "sudo"}
{"nl": "unlock the immutable flag on my hosts file", "bash": "sudo chattr -i /etc/hosts", "category": "sudo"}
{"nl": "I want to copy something into the etc folder but it says permission denied", "bash": "sudo cp ~/Documents/nginx.conf /etc/nginx/nginx.conf", "category": "sudo"}
{"nl": "save my new config file into etc but I cant write there", "bash": "sudo cp ~/myresolv.conf /etc/resolv.conf", "category": "sudo"}
{"nl": "edit the hosts file it wont let me save", "bash": "sudo nano /etc/hosts", "category": "sudo"}
{"nl": "I need to add a line to my fstab but it says read only", "bash": "echo '/dev/sdb1 /mnt/data ext4 defaults 0 2' | sudo tee -a /etc/fstab", "category": "sudo"}
{"nl": "write a new ssh config file to etc ssh I dont have permission", "bash": "sudo cp ~/Documents/sshd_config /etc/ssh/sshd_config", "category": "sudo"}
{"nl": "create a new file in etc cron daily called backup", "bash": "sudo touch /etc/cron.daily/backup", "category": "sudo"}
{"nl": "make this script in etc cron daily executable", "bash": "sudo chmod +x /etc/cron.daily/backup", "category": "sudo"}
{"nl": "delete the leftover old config file in etc nginx sites available", "bash": "sudo rm /etc/nginx/sites-available/old_site.conf", "category": "sudo"}
{"nl": "I want to remove a file from var log but it says operation not permitted", "bash": "sudo rm /var/log/old_app.log", "category": "sudo"}
{"nl": "rename the postgres config in etc postgresql to a backup name", "bash": "sudo mv /etc/postgresql/14/main/postgresql.conf /etc/postgresql/14/main/postgresql.conf.bak", "category": "sudo"}
{"nl": "move my custom motd into etc its blocked otherwise", "bash": "sudo mv ~/motd /etc/motd", "category": "sudo"}
{"nl": "change the owner of this folder under var www to my user", "bash": "sudo chown -R $USER:$USER /var/www/html", "category": "sudo"}
{"nl": "give myself ownership of the nginx html folder", "bash": "sudo chown -R $USER:$USER /var/www/html", "category": "sudo"}
{"nl": "change ownership of the logs folder to www-data", "bash": "sudo chown -R www-data:www-data /var/log/nginx", "category": "sudo"}
{"nl": "set the group of this system folder to admin", "bash": "sudo chgrp -R admin /opt/myapp", "category": "sudo"}
{"nl": "I cant change permissions on this system file", "bash": "sudo chmod 644 /etc/ssh/sshd_config", "category": "sudo"}
{"nl": "set the permissions of this protected file to 600", "bash": "sudo chmod 600 /etc/ssh/ssh_host_ed25519_key", "category": "sudo"}
{"nl": "make this binary in usr local bin executable I cant from my account", "bash": "sudo chmod +x /usr/local/bin/myapp", "category": "sudo"}
{"nl": "copy my new shell script to usr local bin so everyone can run it", "bash": "sudo cp ~/scripts/sysinfo.sh /usr/local/bin/sysinfo && sudo chmod +x /usr/local/bin/sysinfo", "category": "sudo"}
{"nl": "create a new folder under opt called myapp", "bash": "sudo mkdir /opt/myapp", "category": "sudo"}
{"nl": "make a folder called shared inside var", "bash": "sudo mkdir /var/shared", "category": "sudo"}
{"nl": "I want to install a script into etc profile.d to set environment variables for everyone", "bash": "sudo cp ~/Documents/myenv.sh /etc/profile.d/myenv.sh && sudo chmod 644 /etc/profile.d/myenv.sh", "category": "sudo"}
{"nl": "make this file immutable so even root cant accidentally change it", "bash": "sudo chattr +i /etc/sysctl.conf", "category": "sudo"}
{"nl": "lock the dns resolver so something doesnt keep rewriting it", "bash": "sudo chattr +i /etc/resolv.conf", "category": "sudo"}
{"nl": "I want to truncate this protected log file to zero", "bash": "sudo truncate -s 0 /var/log/syslog", "category": "sudo"}
{"nl": "make a hard link from my custom binary into usr local bin", "bash": "sudo ln /opt/myapp/bin/myapp /usr/local/bin/myapp", "category": "sudo"}
{"nl": "set up a symlink from etc nginx sites enabled to sites available", "bash": "sudo ln -s /etc/nginx/sites-available/blog.conf /etc/nginx/sites-enabled/blog.conf", "category": "sudo"}
{"nl": "delete the symlink in sites enabled it has a leftover", "bash": "sudo rm /etc/nginx/sites-enabled/default", "category": "sudo"}
{"nl": "extract this tar file into opt where I cant write", "bash": "sudo tar xzf ~/Downloads/myapp.tar.gz -C /opt/", "category": "sudo"}
{"nl": "I want to clean up old logs in var log it says permission denied", "bash": "sudo find /var/log -type f -name '*.gz' -mtime +30 -delete", "category": "sudo"}
{"nl": "delete every old archived log under var log nginx", "bash": "sudo find /var/log/nginx -type f -name '*.gz' -mtime +60 -delete", "category": "sudo"}
{"nl": "I need to wipe this log file but I cant edit it", "bash": "sudo truncate -s 0 /var/log/auth.log", "category": "sudo"}
{"nl": "edit the sudoers file safely", "bash": "sudo visudo", "category": "sudo"}
{"nl": "change the group of this system binary to staff", "bash": "sudo chgrp staff /usr/local/bin/customtool", "category": "sudo"}
{"nl": "compress this protected log into an archive in tmp", "bash": "sudo tar czf /tmp/auth_backup.tar.gz /var/log/auth.log", "category": "sudo"}
{"nl": "make this folder under etc readable by everyone but only writable by root", "bash": "sudo chmod -R 755 /etc/myapp", "category": "sudo"}
{"nl": "append a new line into my apt sources list", "bash": "echo 'deb http://archive.ubuntu.com/ubuntu jammy-backports main' | sudo tee -a /etc/apt/sources.list", "category": "sudo"}
{"nl": "write a new dns server line into resolv conf", "bash": "echo 'nameserver 1.1.1.1' | sudo tee -a /etc/resolv.conf", "category": "sudo"}
{"nl": "I want to install a script into etc that runs on every boot but it says read only", "bash": "sudo cp ~/scripts/onboot.sh /etc/init.d/onboot && sudo chmod +x /etc/init.d/onboot", "category": "sudo"}
{"nl": "delete the user home directory of a removed account", "bash": "sudo rm -r /home/olduser", "category": "sudo"}
{"nl": "create a new shared folder under srv with proper permissions", "bash": "sudo mkdir /srv/shared && sudo chown root:users /srv/shared && sudo chmod 2775 /srv/shared", "category": "sudo"}
{"nl": "make a new directory under usr local share for my fonts", "bash": "sudo mkdir -p /usr/local/share/fonts/custom", "category": "sudo"}
{"nl": "copy these font files into the system fonts folder", "bash": "sudo cp ~/Downloads/*.ttf /usr/local/share/fonts/custom/", "category": "sudo"}
{"nl": "set the permission so a folder under var lib is owned by the postgres user", "bash": "sudo chown -R postgres:postgres /var/lib/postgresql", "category": "sudo"}
{"nl": "write a quick file with my dns settings into etc systemd resolved.conf", "bash": "sudo cp ~/Documents/resolved.conf /etc/systemd/resolved.conf", "category": "sudo"}
{"nl": "create the folder under etc called myservice and a config file inside it", "bash": "sudo mkdir -p /etc/myservice && sudo cp ~/Documents/myservice.conf /etc/myservice/config.yaml", "category": "sudo"}
{"nl": "remove an old configuration directory under etc that I no longer use", "bash": "sudo rm -r /etc/oldservice", "category": "sudo"}
{"nl": "install a new udev rule into etc udev rules.d", "bash": "sudo cp ~/Documents/99-mykeyboard.rules /etc/udev/rules.d/99-mykeyboard.rules", "category": "sudo"}
{"nl": "the var lib docker folder is huge how do I clean it up safely", "bash": "sudo find /var/lib/docker/tmp -type f -mtime +7 -delete", "category": "sudo"}
{"nl": "delete every old crash report file in var crash", "bash": "sudo find /var/crash -type f -name '*.crash' -mtime +14 -delete", "category": "sudo"}
{"nl": "remove old kernel files from boot that I dont need", "bash": "sudo apt autoremove --purge", "category": "sudo"}
{"nl": "delete my big files", "bash": "CLARIFY: Which directory should I look in (home folder, Downloads, /var/log), and what size counts as big (over 100MB, 500MB, 1GB)?", "category": "clarify"}
{"nl": "remove the old stuff", "bash": "CLARIFY: Which directory has the old stuff, and how old should a file be to count as old (7 days, 30 days, 90 days)?", "category": "clarify"}
{"nl": "clean up the logs", "bash": "CLARIFY: Which logs do you mean - system logs in /var/log, application logs in your home folder, or a specific service's log files?", "category": "clarify"}
{"nl": "back up my data", "bash": "CLARIFY: Which folder should I back up (Documents, the whole home folder, a project directory), and where should the backup go (external drive, /backup, cloud)?", "category": "clarify"}
{"nl": "move my work files", "bash": "CLARIFY: Which work files (a specific folder, all .docx files, files modified this week) and where should they be moved to?", "category": "clarify"}
{"nl": "get rid of the junk", "bash": "CLARIFY: What counts as junk - temp files in /tmp, browser cache, old downloads, or something specific you can point me to?", "category": "clarify"}
{"nl": "archive the old projects", "bash": "CLARIFY: Where do the projects live (~/projects, ~/work), and what makes a project 'old' (last modified date, name pattern, or a list I should review)?", "category": "clarify"}
{"nl": "free up space on my computer", "bash": "CLARIFY: Which disk is full (run 'df -h' to see), and do you want me to delete cache, old downloads, or large files specifically?", "category": "clarify"}
{"nl": "delete the duplicates", "bash": "CLARIFY: Which directory should I scan for duplicates, and how do you want to match them (same name, same content hash, same size)?", "category": "clarify"}
{"nl": "clean my downloads", "bash": "CLARIFY: Do you want to delete everything in ~/Downloads, only files older than a certain date, or only specific file types like .zip or .dmg?", "category": "clarify"}
{"nl": "delete the cache", "bash": "CLARIFY: Which cache - browser cache, ~/.cache, apt package cache, or an application-specific cache directory?", "category": "clarify"}
{"nl": "clear out temp", "bash": "CLARIFY: Do you mean /tmp, /var/tmp, or a project's temp folder? And should I delete everything or only files older than a certain age?", "category": "clarify"}
{"nl": "remove my old backups", "bash": "CLARIFY: Where are the backups stored, and how old should a backup be before deletion (older than 30 days, older than 90 days)?", "category": "clarify"}
{"nl": "compress these files", "bash": "CLARIFY: Which files or folder do you want to compress, and what format (zip, tar.gz, tar.xz)?", "category": "clarify"}
{"nl": "unzip the file", "bash": "CLARIFY: Which archive file do you want to extract, and where should it be unpacked (current directory, Desktop, a specific folder)?", "category": "clarify"}
{"nl": "find the file", "bash": "CLARIFY: What's the file called, or what's in it? And which directory should I search (home folder, the whole system, a specific project)?", "category": "clarify"}
{"nl": "rename these", "bash": "CLARIFY: Which files do you want to rename, and what's the renaming pattern (add a prefix, change extension, sequential numbers)?", "category": "clarify"}
{"nl": "copy these somewhere safe", "bash": "CLARIFY: Which files should I copy, and where is 'somewhere safe' - an external drive, a backup folder, or a specific path?", "category": "clarify"}
{"nl": "organize my desktop", "bash": "CLARIFY: How would you like the Desktop organized - by file type (Documents, Images), by date, or moved into a single folder?", "category": "clarify"}
{"nl": "throw away the old photos", "bash": "CLARIFY: Which photos folder, and how old is 'old' (taken before a specific year, modified more than 2 years ago)?", "category": "clarify"}
{"nl": "i need to delete some files", "bash": "CLARIFY: Which directory, and which files specifically (by name pattern, by age, by size)? I want to be careful not to delete the wrong ones.", "category": "clarify"}
{"nl": "make a backup", "bash": "CLARIFY: Backup of what (a specific folder, the whole home directory, a database), and where should the backup be saved?", "category": "clarify"}
{"nl": "move stuff to the external drive", "bash": "CLARIFY: Which files or folders should I move, and what's the name or mount point of the external drive (check 'lsblk')?", "category": "clarify"}
{"nl": "tidy up my documents folder", "bash": "CLARIFY: What kind of tidying - sort by type into subfolders, delete files older than a year, or move old items into an archive folder?", "category": "clarify"}
{"nl": "delete all the temp files", "bash": "CLARIFY: Do you mean files in /tmp, files with .tmp extension in your home folder, or editor temp files like .swp?", "category": "clarify"}
{"nl": "remove the empty folders", "bash": "CLARIFY: Which parent directory should I scan for empty folders (home directory, Documents, somewhere else)?", "category": "clarify"}
{"nl": "delete old emails", "bash": "CLARIFY: Are the emails stored locally (which mail client, which folder), or are they on a server? I can't easily reach an online inbox from the shell.", "category": "clarify"}
{"nl": "send these to the trash", "bash": "CLARIFY: Which files or folders do you want to move to the trash? Please give me the names or paths.", "category": "clarify"}
{"nl": "empty the recycle bin", "bash": "CLARIFY: Do you want to empty the trash for your user account (~/.local/share/Trash) or system-wide?", "category": "clarify"}
{"nl": "save this for later", "bash": "CLARIFY: What is 'this' - the current terminal output, a file you're looking at, or the last command's result? And where would you like it saved?", "category": "clarify"}
{"nl": "merge these folders", "bash": "CLARIFY: Which two (or more) folders should be merged, and if files have the same name in both, should I overwrite, skip, or rename?", "category": "clarify"}
{"nl": "split this file up", "bash": "CLARIFY: Which file do you want to split, and how - by size (every 100MB), by line count, or at specific markers?", "category": "clarify"}
{"nl": "back up before i mess things up", "bash": "CLARIFY: What are you about to change - a configuration file, a project folder, or the whole system? Tell me what to back up and I'll make a copy first.", "category": "clarify"}
{"nl": "save the database", "bash": "CLARIFY: Which database (MySQL, PostgreSQL, SQLite, MongoDB), which database name, and where should the dump be written?", "category": "clarify"}
{"nl": "delete the screenshots", "bash": "CLARIFY: Where are the screenshots stored (~/Pictures/Screenshots, ~/Desktop), and do you want all of them or only ones older than a certain date?", "category": "clarify"}
{"nl": "throw away the videos", "bash": "CLARIFY: Which folder has the videos (~/Videos, ~/Downloads), and do you want all video files or only ones matching a specific filter?", "category": "clarify"}
{"nl": "delete music i dont listen to", "bash": "CLARIFY: I can't tell what you listen to from the file system. Should I delete files older than a date, files smaller than a size, or from a specific subfolder?", "category": "clarify"}
{"nl": "remove some pdfs", "bash": "CLARIFY: Which directory has the PDFs, and which ones - all of them, ones older than a date, or matching a name pattern?", "category": "clarify"}
{"nl": "delete the old downloads", "bash": "CLARIFY: How old should a file in ~/Downloads be before deletion (older than 7 days, 30 days, 90 days)?", "category": "clarify"}
{"nl": "shrink my folder", "bash": "CLARIFY: Which folder, and how - compress everything into a zip, delete the largest files, or remove duplicates?", "category": "clarify"}
{"nl": "move these to where they belong", "bash": "CLARIFY: Which files, and where do they belong? I don't have context about your organization scheme - please give me a source and destination.", "category": "clarify"}
{"nl": "rename my files to be cleaner", "bash": "CLARIFY: Which files, and what does cleaner mean - remove spaces, lowercase everything, strip special characters, or follow a specific naming pattern?", "category": "clarify"}
{"nl": "compress everything", "bash": "CLARIFY: Compress which directory or files, and into what archive format (zip, tar.gz, 7z)?", "category": "clarify"}
{"nl": "extract all the archives", "bash": "CLARIFY: Which folder contains the archives, and where should each one be extracted - in place, or into a single destination?", "category": "clarify"}
{"nl": "clean up node_modules", "bash": "CLARIFY: Do you want to delete every node_modules folder under a parent directory (which one - ~/projects, ~/code)?", "category": "clarify"}
{"nl": "fix my mess", "bash": "CLARIFY: What mess are you looking at - a folder that needs organizing, a broken installation, or something else? Please point me at a specific path or symptom.", "category": "clarify"}
{"nl": "back up the important stuff", "bash": "CLARIFY: What's important to you - Documents only, the whole home folder, photos, work projects? And where should the backup live?", "category": "clarify"}
{"nl": "delete the corrupted files", "bash": "CLARIFY: Which folder, and how should I identify corruption - zero-byte files, files that fail a checksum, files of a certain type that won't open?", "category": "clarify"}
{"nl": "remove old versions", "bash": "CLARIFY: Old versions of what - files with timestamps in their name, files in a backups folder, or a specific application's old releases?", "category": "clarify"}
{"nl": "i have too many files", "bash": "CLARIFY: In which folder? I can show you the biggest files, the most common file types, or files you haven't opened in a while - tell me which to target.", "category": "clarify"}
{"nl": "make the folder smaller", "bash": "CLARIFY: Which folder, and how - delete the largest files, compress its contents, or remove files older than a date?", "category": "clarify"}
{"nl": "save what i was working on", "bash": "CLARIFY: I don't know what you were working on. Tell me the folder or file you'd like saved and where to put the backup.", "category": "clarify"}
{"nl": "delete some of my pictures", "bash": "CLARIFY: Which pictures folder, and on what basis - by date, by size, by filename pattern, or specific files you'll list?", "category": "clarify"}
{"nl": "i want to start fresh", "bash": "CLARIFY: Start fresh with what - a single folder, a project's build output, configuration files? Resetting the whole system would erase data, so please be specific.", "category": "clarify"}
{"nl": "remove the unused stuff", "bash": "CLARIFY: Unused files in which directory, and how do I detect 'unused' - access time older than 90 days, never opened, or something else?", "category": "clarify"}
{"nl": "wipe the folder", "bash": "CLARIFY: Which folder do you want emptied, and should the folder itself be deleted or kept (just its contents removed)?", "category": "clarify"}
{"nl": "burn this to dvd", "bash": "CLARIFY: Which file or ISO image, and which drive (run 'wodim --devices' to see available burners)?", "category": "clarify"}
{"nl": "save the report", "bash": "CLARIFY: Which report (file path), and where should it be saved? If it's already open in an editor, you need to save it from there.", "category": "clarify"}
{"nl": "backup my emails", "bash": "CLARIFY: Where are the emails stored - Thunderbird profile, Apple Mail, a Maildir folder, or an IMAP server? The approach differs for each.", "category": "clarify"}
{"nl": "archive the project", "bash": "CLARIFY: Which project folder, and what archive format (tar.gz, zip), and where should the archive be saved?", "category": "clarify"}
{"nl": "remove the trash files", "bash": "CLARIFY: Do you mean files already in the trash (~/.local/share/Trash), or files you consider junk that need to be deleted? If the latter, which ones?", "category": "clarify"}
{"nl": "encrypt my files", "bash": "CLARIFY: Which file or folder, and with what method (gpg with a passphrase, age, or a full-disk solution)?", "category": "clarify"}
{"nl": "make a copy of this", "bash": "CLARIFY: A copy of what (file or folder path), and where should the copy be placed?", "category": "clarify"}
{"nl": "delete duplicates from photos", "bash": "CLARIFY: How should I identify duplicates - same filename, same content hash, or visually similar? Visual similarity needs special tools.", "category": "clarify"}
{"nl": "clean my desktop", "bash": "CLARIFY: Clean how - move everything into a folder, sort by type, delete files older than a date, or specific items you'll point out?", "category": "clarify"}
{"nl": "wipe the drive", "bash": "CLARIFY: Which drive (run 'lsblk' to list), and do you want a quick wipe (mkfs) or a secure wipe (overwrite with random data)? This will destroy all data on it.", "category": "clarify"}
{"nl": "format the usb", "bash": "CLARIFY: What's the USB device path (lsblk will show it - looks like /dev/sdb), and which filesystem (FAT32, exFAT, ext4, NTFS)?", "category": "clarify"}
{"nl": "make this folder shared", "bash": "CLARIFY: Shared with whom - other local users (group permissions), the network (Samba/NFS), or a specific user?", "category": "clarify"}
{"nl": "set up auto delete", "bash": "CLARIFY: Auto-delete what, where, and after how long? For example: files in /tmp older than 7 days, deleted nightly via cron?", "category": "clarify"}
{"nl": "back up daily", "bash": "CLARIFY: Back up which folder, to where, and at what time of day? I'll set up a cron job once those are clear.", "category": "clarify"}
{"nl": "delete the old session files", "bash": "CLARIFY: Which application's session files - browser sessions, tmux/screen sessions, or a specific app's data folder?", "category": "clarify"}
{"nl": "remove the broken symlinks", "bash": "CLARIFY: Which directory should I scan for broken symlinks (home folder, /etc, a project directory)?", "category": "clarify"}
{"nl": "clean up the recycling", "bash": "CLARIFY: Empty your user trash (~/.local/share/Trash), or also clear other users' trash? Usually only the current user's is meant.", "category": "clarify"}
{"nl": "delete what i dont need", "bash": "CLARIFY: I can't decide what you don't need. Tell me a directory and a rule (older than 90 days, larger than 500MB, matching *.tmp) and I'll act on it.", "category": "clarify"}
{"nl": "clean out the printer queue", "bash": "CLARIFY: Cancel all current print jobs, or only a specific printer's queue? Run 'lpstat -o' to see active jobs first.", "category": "clarify"}
{"nl": "move my pictures to one place", "bash": "CLARIFY: Pictures are scattered where (Desktop, Downloads, Documents)? And what's the destination folder where they should all end up?", "category": "clarify"}
{"nl": "delete duplicates in downloads", "bash": "CLARIFY: How should duplicates be matched - identical content (hash), same filename ignoring extension, or files with names ending in (1), (2) suffixes?", "category": "clarify"}
{"nl": "save my work", "bash": "CLARIFY: Which folder is your work in, and where would you like a backup copy? I can compress it into a dated archive if helpful.", "category": "clarify"}
{"nl": "wipe out the old", "bash": "CLARIFY: 'The old' what, in which folder? Please give me a path and an age threshold (older than 30 days, 90 days, etc).", "category": "clarify"}
{"nl": "make me some breathing room", "bash": "CLARIFY: Where is space tight - your home folder, the root filesystem, an external drive? Run 'df -h' to see which mount is filling up.", "category": "clarify"}
{"nl": "delete the giant files", "bash": "CLARIFY: In which directory, and how big counts as giant (over 500MB, over 1GB, over 5GB)?", "category": "clarify"}
{"nl": "tidy up", "bash": "CLARIFY: Tidy what - a specific folder, the desktop, system temp files? And what does 'tidy' mean for you (sorted into subfolders, junk removed)?", "category": "clarify"}
{"nl": "make room for more downloads", "bash": "CLARIFY: How much space do you need to free, and where can I delete from (~/Downloads, old archives, browser cache)?", "category": "clarify"}
{"nl": "delete the cache files", "bash": "CLARIFY: Which cache - ~/.cache (general user cache), browser cache, apt's package cache (/var/cache/apt), or an app-specific cache?", "category": "clarify"}
{"nl": "save my photos elsewhere", "bash": "CLARIFY: Move them or copy them? And from which folder to which destination (external drive, cloud-synced folder, another disk)?", "category": "clarify"}
{"nl": "remove all the old reports", "bash": "CLARIFY: Where do the reports live, and how old is 'old' (older than 6 months, older than 1 year, before a specific date)?", "category": "clarify"}
{"nl": "delete the project i dont use anymore", "bash": "CLARIFY: Which project folder do you want to delete? Please give me the full path so I don't remove the wrong one.", "category": "clarify"}
{"nl": "back up before the upgrade", "bash": "CLARIFY: What kind of backup - just your home folder, configuration files in /etc, the whole disk image? And where should the backup live?", "category": "clarify"}
{"nl": "compress the logs", "bash": "CLARIFY: Which logs (a specific file, all of /var/log, or a service's logs), and into one archive or compressed in place with gzip?", "category": "clarify"}
{"nl": "rotate the logs", "bash": "CLARIFY: Which log file or service - I can rotate a specific log manually with logrotate, or set up logrotate config for it. Which one needs rotating?", "category": "clarify"}
{"nl": "extract this thing", "bash": "CLARIFY: Which archive file do you mean, and where should the contents be extracted?", "category": "clarify"}
{"nl": "save the screen output", "bash": "CLARIFY: Which command's output, and to which file? You can rerun a command and redirect with '> output.txt' - tell me which command.", "category": "clarify"}
{"nl": "make a copy on the network drive", "bash": "CLARIFY: Which file or folder to copy, and what's the path or mount of the network drive (e.g. /mnt/nas)?", "category": "clarify"}
{"nl": "remove this file everywhere", "bash": "CLARIFY: Which file (give me a name or path), and search 'everywhere' meaning where - your home folder, the whole filesystem, a specific tree?", "category": "clarify"}
{"nl": "find and delete duplicates", "bash": "CLARIFY: In which directory should I search, and how should duplicates be detected - same content hash (safest) or same filename?", "category": "clarify"}
{"nl": "delete the unused images", "bash": "CLARIFY: Which folder has the images, and how do you define 'unused' - not opened in 90 days (access time), or not linked from anything?", "category": "clarify"}
{"nl": "delete trash older than a week", "bash": "CLARIFY: From which trash - your user trash (~/.local/share/Trash), or a folder you've been treating as trash? Confirm the path and I'll filter by age.", "category": "clarify"}
{"nl": "back up nightly", "bash": "CLARIFY: Back up which folder, to where, and at what time? I'll write a cron entry once those are clear.", "category": "clarify"}
{"nl": "save this file as a backup", "bash": "CLARIFY: Which file (give me the path), and what should the backup be named or where should it go (same folder with .bak suffix, ~/backups)?", "category": "clarify"}
{"nl": "delete everything in this folder", "bash": "CLARIFY: Which folder, and does 'everything' include hidden files (those starting with a dot)? Also confirm you want the contents gone but the folder kept.", "category": "clarify"}
{"nl": "install python", "bash": "CLARIFY: Which Python version (3.10, 3.11, 3.12, latest available), and from where (system package manager, pyenv, deadsnakes PPA)?", "category": "clarify"}
{"nl": "remove old software", "bash": "CLARIFY: Which package or packages should I remove? Run 'apt list --installed' to see what's there and tell me which to drop.", "category": "clarify"}
{"nl": "update my packages", "bash": "CLARIFY: Update everything (apt upgrade), only security updates, or a specific package? Also: do you want to refresh the package list first?", "category": "clarify"}
{"nl": "upgrade the system", "bash": "CLARIFY: Apply available package updates (apt upgrade), do a full distribution upgrade to the next Ubuntu release, or upgrade a specific component?", "category": "clarify"}
{"nl": "install the editor", "bash": "CLARIFY: Which editor (vim, nano, neovim, vscode, sublime, emacs)? They're installed differently.", "category": "clarify"}
{"nl": "install docker", "bash": "CLARIFY: From the Ubuntu repositories (docker.io) or from Docker's official repo (docker-ce, latest version)? The latter needs adding a repo key.", "category": "clarify"}
{"nl": "install nodejs", "bash": "CLARIFY: Which Node.js version (LTS 20, current 22), and via which method (Ubuntu apt, NodeSource repo, nvm for per-user)?", "category": "clarify"}
{"nl": "uninstall a package", "bash": "CLARIFY: Which package name? Run 'dpkg -l | grep keyword' to find it, then tell me which to remove.", "category": "clarify"}
{"nl": "get the new version", "bash": "CLARIFY: New version of what software? Tell me the package or program name and I'll check what's available.", "category": "clarify"}
{"nl": "install a browser", "bash": "CLARIFY: Which browser (Firefox, Chromium, Google Chrome, Brave, Vivaldi)? Several have different install methods.", "category": "clarify"}
{"nl": "set up a database", "bash": "CLARIFY: Which database (PostgreSQL, MySQL, MariaDB, SQLite, MongoDB)? They have different installs and configurations.", "category": "clarify"}
{"nl": "install the latest version", "bash": "CLARIFY: Latest version of which software? And from where - distribution repo, vendor's PPA, snap, or flatpak?", "category": "clarify"}
{"nl": "get me a python environment", "bash": "CLARIFY: A system-wide Python install, a virtual environment for a project (which folder), or a conda environment with specific packages?", "category": "clarify"}
{"nl": "install java", "bash": "CLARIFY: Which Java distribution (OpenJDK, Temurin, Oracle), and which major version (8, 11, 17, 21)?", "category": "clarify"}
{"nl": "remove the unused packages", "bash": "CLARIFY: Do you mean packages installed as dependencies but no longer needed (apt autoremove), or specific packages by name?", "category": "clarify"}
{"nl": "clean up apt", "bash": "CLARIFY: Clean cached .deb files (apt clean), remove orphaned packages (apt autoremove), or both?", "category": "clarify"}
{"nl": "install git", "bash": "CLARIFY: The git package from Ubuntu (often older), or from the git-core PPA for the latest version?", "category": "clarify"}
{"nl": "install a music player", "bash": "CLARIFY: Which music player (Rhythmbox, Audacious, Clementine, Spotify, Strawberry, mpd command-line)?", "category": "clarify"}
{"nl": "i need a code editor", "bash": "CLARIFY: Which one - VS Code, Sublime Text, JetBrains IDE, Atom, neovim, or something else? Each installs differently.", "category": "clarify"}
{"nl": "install a screen recorder", "bash": "CLARIFY: Which tool - OBS Studio, Kazam, SimpleScreenRecorder, peek for GIFs, or ffmpeg for command-line recording?", "category": "clarify"}
{"nl": "install office software", "bash": "CLARIFY: Which suite - LibreOffice, OnlyOffice, WPS Office, or a specific app like Calligra?", "category": "clarify"}
{"nl": "update everything to the latest", "bash": "CLARIFY: All system packages (apt full-upgrade), all snap apps, all pip packages globally, or one specific tool?", "category": "clarify"}
{"nl": "install a vpn", "bash": "CLARIFY: Which VPN client - OpenVPN, WireGuard, NetworkManager-openvpn, a commercial client like Mullvad or NordVPN, or set up your own?", "category": "clarify"}
{"nl": "install rust", "bash": "CLARIFY: Via rustup (recommended, per-user) or via apt (older but system-wide)?", "category": "clarify"}
{"nl": "install go", "bash": "CLARIFY: Via apt (golang-go, may lag in version) or download the latest from go.dev? And which version do you need?", "category": "clarify"}
{"nl": "remove the bloat", "bash": "CLARIFY: Bloat meaning what - default Ubuntu apps you don't use, snaps, or orphaned packages? Tell me which to target.", "category": "clarify"}
{"nl": "install a torrent client", "bash": "CLARIFY: Which one (transmission, qBittorrent, Deluge, Vuze, command-line aria2)?", "category": "clarify"}
{"nl": "install an antivirus", "bash": "CLARIFY: Which one - ClamAV (free, command-line), Sophos for Linux, or another? Note that Linux generally doesn't need active AV for desktop use.", "category": "clarify"}
{"nl": "install a backup tool", "bash": "CLARIFY: Which tool - Deja Dup (GUI), Timeshift (system snapshots), restic, rsnapshot, or borg backup?", "category": "clarify"}
{"nl": "set up postgres", "bash": "CLARIFY: Install only, or also create a database and user? And which PostgreSQL major version (14, 15, 16)?", "category": "clarify"}
{"nl": "install ruby", "bash": "CLARIFY: System Ruby (apt install ruby-full), or per-user via rbenv/asdf? And which version (3.0, 3.2, 3.3)?", "category": "clarify"}
{"nl": "get the build tools", "bash": "CLARIFY: For what - C/C++ (build-essential), Rust (rustup), embedded (gcc-arm-none-eabi), or a specific language toolchain?", "category": "clarify"}
{"nl": "install a media player", "bash": "CLARIFY: Which one - VLC, mpv, Celluloid, SMPlayer, Totem? Each has its own package.", "category": "clarify"}
{"nl": "fix my broken package", "bash": "CLARIFY: Which package is broken? Run 'apt list --installed | grep keyword' and share the name and the error you're seeing.", "category": "clarify"}
{"nl": "install everything for web dev", "bash": "CLARIFY: Which stack - Node.js + npm, Python + pip, Ruby + Rails, PHP + Laravel? Tell me your stack and I'll install the toolchain.", "category": "clarify"}
{"nl": "get me ffmpeg", "bash": "CLARIFY: From Ubuntu apt (stable but older) or the latest static build from ffmpeg.org? They have slight differences in available codecs.", "category": "clarify"}
{"nl": "install steam", "bash": "CLARIFY: From Ubuntu's multiverse repository (apt install steam) or Steam's official .deb installer? Both work but install differently.", "category": "clarify"}
{"nl": "set up wine", "bash": "CLARIFY: Stock wine from Ubuntu (older) or the latest WineHQ repo? And do you also need winetricks for setup helpers?", "category": "clarify"}
{"nl": "install a pdf reader", "bash": "CLARIFY: Which one - Evince (default GNOME), Okular (KDE), MuPDF (lightweight), Foxit, or Adobe Reader (no longer maintained on Linux)?", "category": "clarify"}
{"nl": "install a chat app", "bash": "CLARIFY: Which one - Slack, Discord, Element/Matrix, Telegram, Signal? Each has its own install path.", "category": "clarify"}
{"nl": "i want a terminal", "bash": "CLARIFY: A new terminal emulator - which one (Alacritty, Kitty, Tilix, WezTerm, gnome-terminal)?", "category": "clarify"}
{"nl": "get me a shell", "bash": "CLARIFY: A new shell - which one (zsh, fish, dash)? And do you also want to set it as your default login shell?", "category": "clarify"}
{"nl": "install a notes app", "bash": "CLARIFY: Which one - Obsidian, Joplin, Standard Notes, Logseq, simplenote, or a CLI tool like jrnl?", "category": "clarify"}
{"nl": "install gimp", "bash": "CLARIFY: From apt (stable Ubuntu version) or the latest from the GIMP flatpak? Versions differ.", "category": "clarify"}
{"nl": "install kubectl", "bash": "CLARIFY: From Ubuntu apt (often outdated) or the official Kubernetes repo for the latest stable? And do you need a specific kubectl version to match a cluster?", "category": "clarify"}
{"nl": "install ansible", "bash": "CLARIFY: From apt (older), pip (latest per-user), or the official Ansible PPA? Which is fine?", "category": "clarify"}
{"nl": "install terraform", "bash": "CLARIFY: Via HashiCorp's apt repo (latest) or tfenv for managing multiple versions? Do you need a specific version?", "category": "clarify"}
{"nl": "install some games", "bash": "CLARIFY: Which game or games? I need package names. You can browse 'apt search games' or specific titles like '0ad', 'supertuxkart', etc.", "category": "clarify"}
{"nl": "set up nginx", "bash": "CLARIFY: Just install it (apt install nginx) or also create a virtual host config? If the latter, what domain and root directory?", "category": "clarify"}
{"nl": "install kibana", "bash": "CLARIFY: From the Elastic apt repo (recommended), and which major version (matching an Elasticsearch you have, or latest 8.x)?", "category": "clarify"}
{"nl": "install jenkins", "bash": "CLARIFY: From the official Jenkins apt repo, and which line - stable or LTS? Also: which Java version is currently installed (jenkins needs it)?", "category": "clarify"}
{"nl": "install zsh and oh my zsh", "bash": "CLARIFY: I can install zsh via apt easily. For oh-my-zsh I'd need to download an install script - is that ok, and for which user account?", "category": "clarify"}
{"nl": "install neovim", "bash": "CLARIFY: From apt (older 0.x version) or the official PPA / appimage for the latest 0.10? Some plugins need the newer version.", "category": "clarify"}
{"nl": "install spotify", "bash": "CLARIFY: Via the official Spotify apt repo (.deb) or the snap version? Either works on Ubuntu.", "category": "clarify"}
{"nl": "install zoom", "bash": "CLARIFY: From Zoom's official .deb download or the flatpak/snap version? The .deb is most common.", "category": "clarify"}
{"nl": "install signal", "bash": "CLARIFY: From the official Signal apt repo (recommended, auto-updates) or the flatpak? Confirm and I'll proceed.", "category": "clarify"}
{"nl": "i want minecraft", "bash": "CLARIFY: The official Minecraft launcher (.deb from minecraft.net), or PrismLauncher / MultiMC for managing multiple versions?", "category": "clarify"}
{"nl": "install audacity", "bash": "CLARIFY: From apt (older version) or the flatpak for the latest? Audacity also has new ownership - confirm you're ok with the current one.", "category": "clarify"}
{"nl": "install obs", "bash": "CLARIFY: From the official OBS Studio PPA (recommended, latest) or apt (older)? PPA usually preferred for streaming features.", "category": "clarify"}
{"nl": "install thunderbird", "bash": "CLARIFY: From apt (versioned with Ubuntu) or the snap (auto-updating to latest)? Or the flatpak?", "category": "clarify"}
{"nl": "install firefox esr", "bash": "CLARIFY: From the Mozilla apt repo (recommended for ESR), or the snap? The snap is the default Firefox on Ubuntu but not ESR.", "category": "clarify"}
{"nl": "install r", "bash": "CLARIFY: R language for statistics? From Ubuntu's apt (older) or the CRAN apt repo for the latest version? Also, do you need RStudio too?", "category": "clarify"}
{"nl": "install dotnet", "bash": "CLARIFY: Which .NET SDK version (6, 7, 8 LTS), and from Microsoft's apt repo or the package included in Ubuntu?", "category": "clarify"}
{"nl": "install php", "bash": "CLARIFY: Which PHP version (8.1, 8.2, 8.3), and from Ubuntu repos or the ondrej PPA for newer versions? Plus which modules do you need?", "category": "clarify"}
{"nl": "install a font", "bash": "CLARIFY: Which font? If from a .ttf/.otf file, where is it? If from a package (e.g. fonts-firacode, fonts-jetbrains-mono), tell me which.", "category": "clarify"}
{"nl": "install ssh", "bash": "CLARIFY: The SSH client (openssh-client, usually already installed) or the SSH server (openssh-server) for remote access into this machine?", "category": "clarify"}
{"nl": "install some dev libraries", "bash": "CLARIFY: For which language or project - libssl-dev, libcurl-dev, build-essential? Or are you trying to compile something that's failing? Show me the error.", "category": "clarify"}
{"nl": "install everything for c++", "bash": "CLARIFY: Compiler only (g++), or the full toolchain with cmake, gdb, valgrind, and clang? Tell me what you plan to do.", "category": "clarify"}
{"nl": "install machine learning stuff", "bash": "CLARIFY: Which stack - PyTorch + CUDA, TensorFlow, scikit-learn, JAX? And in a virtual environment or system-wide pip?", "category": "clarify"}
{"nl": "install graphics drivers", "bash": "CLARIFY: For which GPU - NVIDIA (proprietary or nouveau), AMD (mesa, amdgpu-pro), or Intel (already included)? Run 'lspci | grep -i vga' to identify.", "category": "clarify"}
{"nl": "install printer drivers", "bash": "CLARIFY: Which printer brand and model? Many work with CUPS out of the box - try printing first. If not, I need the model name.", "category": "clarify"}
{"nl": "install the development version", "bash": "CLARIFY: Development version of what software, and from which source (PPA, git source, snap edge)?", "category": "clarify"}
{"nl": "install something for screenshots", "bash": "CLARIFY: Which tool - Flameshot, Shutter, Spectacle, gnome-screenshot, or scrot for command-line?", "category": "clarify"}
{"nl": "install the kernel headers", "bash": "CLARIFY: For your current running kernel (linux-headers-$(uname -r))? That's usually what people want - confirm and I'll proceed.", "category": "clarify"}
{"nl": "set up a mail server", "bash": "CLARIFY: Which mail server - Postfix + Dovecot, Exim, or a turnkey setup like Mailcow? This is a non-trivial setup; tell me your goal.", "category": "clarify"}
{"nl": "install a web server", "bash": "CLARIFY: Which web server - nginx, Apache (apache2), Caddy, or lighttpd?", "category": "clarify"}
{"nl": "install something to read epub", "bash": "CLARIFY: Which reader - Calibre (full management), Foliate (simple), Bookworm, or fbreader?", "category": "clarify"}
{"nl": "install image viewer", "bash": "CLARIFY: Which one - Eye of GNOME (eog), gThumb, feh (lightweight), nomacs, or gpicview?", "category": "clarify"}
{"nl": "install office tools", "bash": "CLARIFY: Which suite - LibreOffice (apt install libreoffice), OnlyOffice, WPS, or specific tools (word processor only, spreadsheet only)?", "category": "clarify"}
{"nl": "install some virt thing", "bash": "CLARIFY: Which virtualization - VirtualBox, qemu/KVM with virt-manager, libvirt, or a container runtime like Docker/Podman?", "category": "clarify"}
{"nl": "install for gaming", "bash": "CLARIFY: Steam? Lutris? Proton? Specific game launcher? Plus do you have the right GPU drivers for gaming (NVIDIA proprietary, Mesa for AMD)?", "category": "clarify"}
{"nl": "install pip packages", "bash": "CLARIFY: Which packages, and in which environment - global (pip install --user), a project's virtualenv, or pipx for tools?", "category": "clarify"}
{"nl": "install all my npm tools", "bash": "CLARIFY: I need the list - what tools do you usually use? If you have a list (package-lock or a file), share its path.", "category": "clarify"}
{"nl": "install a markdown editor", "bash": "CLARIFY: Which one - Typora, Mark Text, Ghostwriter, Apostrophe, or Obsidian?", "category": "clarify"}
{"nl": "install a calendar app", "bash": "CLARIFY: Which one - GNOME Calendar (gnome-calendar), Evolution, Thunderbird with Lightning, or a CLI tool like khal?", "category": "clarify"}
{"nl": "install a password manager", "bash": "CLARIFY: Which one - Bitwarden, KeePassXC, 1Password (commercial), pass (command-line)?", "category": "clarify"}
{"nl": "install network tools", "bash": "CLARIFY: Which tools - net-tools (legacy ifconfig), iproute2 (modern, usually preinstalled), nmap, wireshark, tcpdump? Tell me your goal.", "category": "clarify"}
{"nl": "install a sql client", "bash": "CLARIFY: For which database (psql for Postgres, mysql-client for MySQL, sqlite3 for SQLite, or DBeaver as a universal GUI)?", "category": "clarify"}
{"nl": "install everything for school", "bash": "CLARIFY: What does school need - LibreOffice, a code editor, a specific programming language, browsers, communication apps? Tell me what classes/tools you need.", "category": "clarify"}
{"nl": "install latex", "bash": "CLARIFY: A full install (texlive-full, ~5GB) or a minimal one (texlive-latex-base)? And do you want an editor like TeXstudio too?", "category": "clarify"}
{"nl": "install kvm", "bash": "CLARIFY: KVM with command-line tools only, or with virt-manager GUI? Also, has CPU virtualization been verified (egrep -c '(vmx|svm)' /proc/cpuinfo)?", "category": "clarify"}
{"nl": "install a virtual machine app", "bash": "CLARIFY: Which one - VirtualBox, virt-manager (libvirt/KVM), GNOME Boxes, or VMware?", "category": "clarify"}
{"nl": "install python libraries", "bash": "CLARIFY: Which libraries, and into which environment (a project's venv, --user globally, conda)? Give me a list or a requirements.txt path.", "category": "clarify"}
{"nl": "install something to convert videos", "bash": "CLARIFY: GUI tool (HandBrake) or command-line (ffmpeg)? Both are great; the choice depends on whether you want a UI.", "category": "clarify"}
{"nl": "install image converter", "bash": "CLARIFY: GUI (Converseen, GIMP) or command-line (ImageMagick - convert command)? And what conversions (format, resize, batch)?", "category": "clarify"}
{"nl": "install a code formatter", "bash": "CLARIFY: For which language - prettier (JS/TS/HTML/CSS), black (Python), gofmt (Go built-in), rustfmt (Rust)? Each is a different package.", "category": "clarify"}
{"nl": "install a linter", "bash": "CLARIFY: For which language - eslint (JS), ruff or flake8 (Python), shellcheck (bash), clippy (Rust built-in)?", "category": "clarify"}
{"nl": "install a typing tutor", "bash": "CLARIFY: Which one - klavaro, gtypist, or a terminal-based one like 'typespeed'?", "category": "clarify"}
{"nl": "install drawing software", "bash": "CLARIFY: Which one - Krita (digital painting), Inkscape (vector), GIMP (raster/photo editing), MyPaint?", "category": "clarify"}
{"nl": "install 3d software", "bash": "CLARIFY: Which one - Blender (modeling/animation), FreeCAD (CAD), OpenSCAD (parametric), or something else?", "category": "clarify"}
{"nl": "install accounting software", "bash": "CLARIFY: Which one - GnuCash, HomeBank, KMyMoney, Manager.io, or a CLI like ledger or hledger?", "category": "clarify"}
{"nl": "restart the server", "bash": "CLARIFY: Which service - the web server (nginx, apache2), database (postgresql, mysql), or a custom application? Tell me the name.", "category": "clarify"}
{"nl": "stop the broken thing", "bash": "CLARIFY: Which service is broken? Run 'systemctl --failed' to list failed units and tell me which one to stop.", "category": "clarify"}
{"nl": "fix the service", "bash": "CLARIFY: Which service is failing, and what's the symptom? Share the output of 'systemctl status SERVICE_NAME' so I can see what's wrong.", "category": "clarify"}
{"nl": "kill the stuck process", "bash": "CLARIFY: Which process is stuck? Run 'ps aux' or share what's hanging - I need a PID or process name to act safely.", "category": "clarify"}
{"nl": "start the service", "bash": "CLARIFY: Which service - which package or daemon do you want started? Tell me the service name and I'll use systemctl.", "category": "clarify"}
{"nl": "restart everything", "bash": "CLARIFY: Restart all failed services, reload all daemon configs, or reboot the system? Rebooting is the broadest; what's the goal?", "category": "clarify"}
{"nl": "kill the hung app", "bash": "CLARIFY: Which app is hung? Run 'ps aux | grep keyword' or 'pgrep -lf keyword' to find it, then tell me the name or PID.", "category": "clarify"}
{"nl": "stop the process eating cpu", "bash": "CLARIFY: Run 'top' (or 'ps aux --sort=-pcpu | head') and tell me which process - I need a PID or exact name to terminate it safely.", "category": "clarify"}
{"nl": "restart the network", "bash": "CLARIFY: Restart NetworkManager (desktop), systemd-networkd (server), or just bring an interface down/up? Which interface (run 'ip a')?", "category": "clarify"}
{"nl": "enable it on boot", "bash": "CLARIFY: Which service should be enabled to start at boot? Tell me the service name (systemctl enable SERVICE_NAME).", "category": "clarify"}
{"nl": "make it run at startup", "bash": "CLARIFY: Which application or service should start at boot? Is it a systemd service, a desktop autostart, or a cron @reboot job?", "category": "clarify"}
{"nl": "stop it from running at boot", "bash": "CLARIFY: Which service or autostart item should be disabled? Give me the name and I'll use 'systemctl disable' or remove the autostart entry.", "category": "clarify"}
{"nl": "the server isnt responding", "bash": "CLARIFY: Which server (a process running on this machine, or a remote one), and which port or address? I'll check if the service is listening.", "category": "clarify"}
{"nl": "reload the config", "bash": "CLARIFY: For which service? Many support 'systemctl reload SERVICE_NAME' to reread config without restarting - tell me which one.", "category": "clarify"}
{"nl": "the service crashed", "bash": "CLARIFY: Which service? Run 'systemctl --failed' to see crashed ones and share the name, or paste 'systemctl status NAME' so I can see the failure.", "category": "clarify"}
{"nl": "find what's running", "bash": "CLARIFY: Do you want all processes (ps aux), only those listening on a port (ss -tlnp), only systemd services (systemctl list-units), or a specific name?", "category": "clarify"}
{"nl": "stop the bad daemon", "bash": "CLARIFY: Which daemon is misbehaving? Share the name from 'systemctl list-units --type=service' or describe the symptom.", "category": "clarify"}
{"nl": "fix the worker thats stuck", "bash": "CLARIFY: Which worker process - a celery worker, a background job runner, a custom script? Give me a name or PID.", "category": "clarify"}
{"nl": "restart my app", "bash": "CLARIFY: Which application, and how is it running - as a systemd service (which one), under tmux/screen, via supervisor, in a Docker container?", "category": "clarify"}
{"nl": "kill the zombie", "bash": "CLARIFY: Zombie processes can't be killed directly - they need the parent to reap them. Run 'ps -A -ostat,ppid | grep -e '[zZ]'' to find the parent PID and we can act on that.", "category": "clarify"}
{"nl": "stop everything", "bash": "CLARIFY: Stop all running services (dangerous - would take the system offline), or just one service? Tell me what 'everything' means here.", "category": "clarify"}
{"nl": "make this run in the background", "bash": "CLARIFY: Which command or script should I daemonize, and should it survive logout - via 'nohup', 'systemd-run --user', or a proper systemd service?", "category": "clarify"}
{"nl": "stop the background task", "bash": "CLARIFY: Which background task? Run 'jobs' (if started in this shell) or 'ps aux | grep keyword' and give me the PID or name.", "category": "clarify"}
{"nl": "restart docker", "bash": "CLARIFY: Restart the Docker daemon (systemctl restart docker), or restart a specific container? If the latter, which container (docker ps)?", "category": "clarify"}
{"nl": "the database wont start", "bash": "CLARIFY: Which database (postgresql, mysql, mariadb, mongodb), and what does 'systemctl status DB_NAME' show? Paste the error.", "category": "clarify"}
{"nl": "my website is down", "bash": "CLARIFY: Is the web server running (systemctl status nginx OR apache2)? Or is the issue with the application behind it? Share the error you're seeing.", "category": "clarify"}
{"nl": "redis isnt working", "bash": "CLARIFY: What's the symptom - service not running, connection refused, or slow responses? Share 'systemctl status redis-server' and the client error.", "category": "clarify"}
{"nl": "restart all containers", "bash": "CLARIFY: All Docker containers ('docker restart $(docker ps -q)'), only those in a specific docker-compose project, or only stopped ones?", "category": "clarify"}
{"nl": "kill the slow query", "bash": "CLARIFY: Which database, and do you know the query's PID? In Postgres: 'SELECT pg_cancel_backend(pid);' - I need the database type and query identifier.", "category": "clarify"}
{"nl": "fix the cron job", "bash": "CLARIFY: Which cron job, and what's wrong with it? Run 'crontab -l' to see your jobs and share which line isn't working.", "category": "clarify"}
{"nl": "stop the schedule", "bash": "CLARIFY: Which scheduled task - a cron entry, a systemd timer, or an at-job? Share what you have and which to remove.", "category": "clarify"}
{"nl": "remove the cron", "bash": "CLARIFY: Which cron entry do you want removed? Run 'crontab -l' and tell me which line - or share the command pattern.", "category": "clarify"}
{"nl": "the timer isnt firing", "bash": "CLARIFY: Which systemd timer? Run 'systemctl list-timers --all' and share the name. Or is it a cron job that's not firing?", "category": "clarify"}
{"nl": "background this script", "bash": "CLARIFY: Which script do you want running in the background? Should it restart on failure (systemd) or just keep running until logout (nohup)?", "category": "clarify"}
{"nl": "stop the loop", "bash": "CLARIFY: Which loop - a shell loop in a terminal (Ctrl+C), a background script (need PID), or an infinite job in a service? Tell me where it's running.", "category": "clarify"}
{"nl": "the app keeps restarting", "bash": "CLARIFY: Which app, and how is it managed (systemd, docker, supervisor)? Share 'journalctl -u SERVICE_NAME -n 50' so we can see why it's crashing.", "category": "clarify"}
{"nl": "disable the auto restart", "bash": "CLARIFY: For which service - I need to edit its systemd unit (Restart= line). Tell me the service name.", "category": "clarify"}
{"nl": "make it restart automatically", "bash": "CLARIFY: Which service should restart on failure? I'll add Restart=on-failure to its systemd unit - share the service name.", "category": "clarify"}
{"nl": "find what is using port 8080", "bash": "CLARIFY: Port 8080 is clear, but should I also kill the process, or just report what's there? 'sudo lsof -i :8080' will show it - want me to act?", "category": "clarify"}
{"nl": "stop the dev server", "bash": "CLARIFY: Which dev server (Node, Python, Rails, Webpack, Vite)? They run on different ports - is yours on 3000, 5173, 8000? Or share the process name.", "category": "clarify"}
{"nl": "the service is in a bad state", "bash": "CLARIFY: Which service, and what state - failed, activating, deactivating? Run 'systemctl status SERVICE_NAME' and paste the output.", "category": "clarify"}
{"nl": "make it stop spawning", "bash": "CLARIFY: What's spawning what? Share the process name (e.g., 'ps -ef --forest') so I can find the parent and stop it correctly.", "category": "clarify"}
{"nl": "this thing wont die", "bash": "CLARIFY: Which process? Try 'kill -9 PID' if a normal kill failed. If it's a zombie or D-state, we can't kill it - share 'ps -A -ostat,pid,cmd | grep PROCESS' so I see.", "category": "clarify"}
{"nl": "restart it cleanly", "bash": "CLARIFY: Which service or process should I restart? 'Cleanly' implies graceful - I'll send SIGTERM first. Just tell me the name.", "category": "clarify"}
{"nl": "the worker isnt picking up jobs", "bash": "CLARIFY: Which worker (celery, sidekiq, rq, custom) and what's the queue/broker (Redis, RabbitMQ)? Share recent worker logs so we can see what's happening.", "category": "clarify"}
{"nl": "fix the systemd thing", "bash": "CLARIFY: Which systemd unit? Run 'systemctl --failed' to find failed ones, or tell me the name and I'll check status.", "category": "clarify"}
{"nl": "stop the print job", "bash": "CLARIFY: All print jobs (cancel -a), only on a specific printer, or a specific job ID? Run 'lpstat -o' to see job IDs.", "category": "clarify"}
{"nl": "restart bluetooth", "bash": "CLARIFY: Restart the bluetooth service ('systemctl restart bluetooth'), or just toggle bluetooth (bluetoothctl power off/on)?", "category": "clarify"}
{"nl": "wifi keeps disconnecting", "bash": "CLARIFY: Which interface is affected (run 'iw dev')? And do you want me to restart NetworkManager, or investigate the driver/logs first?", "category": "clarify"}
{"nl": "stop the auto updates", "bash": "CLARIFY: Disable unattended-upgrades package, mask the systemd timer, or just delay updates? Each has different long-term implications.", "category": "clarify"}
{"nl": "make my script always run", "bash": "CLARIFY: Always run meaning - on boot (systemd service), on a schedule (cron/timer), or restart whenever it crashes? And which script (path)?", "category": "clarify"}
{"nl": "fix the broken dependency", "bash": "CLARIFY: Apt dependency error - share the exact error message? Or do you mean a missing dependency for a different tool (npm, pip, etc.)?", "category": "clarify"}
{"nl": "stop the syncing", "bash": "CLARIFY: Stop which sync - rsync, Dropbox, Syncthing, OneDrive client, Google Drive client? Each has a different process name.", "category": "clarify"}
{"nl": "the daemon is stuck", "bash": "CLARIFY: Which daemon - share the service name? I'll check 'systemctl status NAME' and decide between restart and kill.", "category": "clarify"}
{"nl": "kill all instances", "bash": "CLARIFY: All instances of which process? Run 'pgrep -lf KEYWORD' and confirm what comes up - I'll then use 'pkill' on the right name.", "category": "clarify"}
{"nl": "stop the cron service", "bash": "CLARIFY: You want to stop the cron daemon entirely (systemctl stop cron)? That would disable all scheduled jobs system-wide - is that intended?", "category": "clarify"}
{"nl": "fix nginx", "bash": "CLARIFY: What's the symptom - nginx won't start, returns 502, or won't reload config? Share 'sudo nginx -t' output and 'systemctl status nginx'.", "category": "clarify"}
{"nl": "stop the print spooler", "bash": "CLARIFY: Stop CUPS (systemctl stop cups), or only cancel current jobs (cancel -a)? Stopping the whole service disables printing until restart.", "category": "clarify"}
{"nl": "the build keeps failing", "bash": "CLARIFY: Which build (make, cargo, npm, mvn, gradle), and what error appears? Share the last 30 lines of build output.", "category": "clarify"}
{"nl": "stop the autostart program", "bash": "CLARIFY: Which program autostarts - check ~/.config/autostart/*.desktop for desktop apps, or it might be a systemd user service. Which one do you mean?", "category": "clarify"}
{"nl": "restart bluetooth daemon", "bash": "CLARIFY: That's 'sudo systemctl restart bluetooth' - confirm you want a full daemon restart, or just toggle the radio with 'bluetoothctl power off; bluetoothctl power on'?", "category": "clarify"}
{"nl": "stop daemons i dont need", "bash": "CLARIFY: Which daemons do you consider unneeded? Run 'systemctl list-units --type=service --state=running' and tell me which to disable.", "category": "clarify"}
{"nl": "kill all my python scripts", "bash": "CLARIFY: All python processes you own (pkill -u $USER python)? That would also kill anything python-based you might need - confirm or be more specific?", "category": "clarify"}
{"nl": "stop the celery workers", "bash": "CLARIFY: Stop them gracefully (let current tasks finish - 'celery control shutdown' on the right app) or kill immediately ('pkill -f celery')? And which celery app?", "category": "clarify"}
{"nl": "fix the queue", "bash": "CLARIFY: Which queue - print queue (cups), mail queue (postfix), a job queue (sidekiq/rq/celery), or apt's package queue? Tell me which.", "category": "clarify"}
{"nl": "make the script run forever", "bash": "CLARIFY: Which script, and what should happen on failure - restart automatically (systemd service with Restart=always)? And which user should run it?", "category": "clarify"}
{"nl": "the timer is misbehaving", "bash": "CLARIFY: Which timer (systemctl list-timers), and what's the misbehavior - firing too often, not firing, drifting? Share the timer name and journal output.", "category": "clarify"}
{"nl": "stop the auto sync", "bash": "CLARIFY: Which sync service is auto-syncing - Syncthing, Nextcloud, Dropbox, Google Drive? I'll stop that specific one.", "category": "clarify"}
{"nl": "restart with new config", "bash": "CLARIFY: Which service did you edit the config for? Often 'systemctl reload SERVICE' is enough - share the service name.", "category": "clarify"}
{"nl": "find what's listening", "bash": "CLARIFY: Listening on which port, or all ports? 'ss -tlnp' shows all TCP listeners - do you want that, or filter to one port?", "category": "clarify"}
{"nl": "stop the listener on the port", "bash": "CLARIFY: Which port number? I'll find what's listening with 'sudo lsof -i :PORT' and then stop that process.", "category": "clarify"}
{"nl": "graceful stop", "bash": "CLARIFY: Of which service or process? Many services have specific graceful-stop commands (nginx -s quit, postgres pg_ctl stop -m smart). Tell me which.", "category": "clarify"}
{"nl": "stop the data sync now", "bash": "CLARIFY: Which sync - share the tool's name? I want to make sure I stop the right one and don't interrupt other syncs you might be running.", "category": "clarify"}
{"nl": "restart with debug logging", "bash": "CLARIFY: For which service - I'd need to edit its config or pass a flag. Tell me the service and what kind of debug output you need.", "category": "clarify"}
{"nl": "kill processes by user", "bash": "CLARIFY: Kill all processes belonging to which user (e.g., 'pkill -KILL -u USERNAME')? Confirm the username and that you want all of them killed.", "category": "clarify"}
{"nl": "stop all docker containers", "bash": "CLARIFY: Just the running ones ('docker stop $(docker ps -q)'), or also remove stopped ones? And should this include containers from compose projects?", "category": "clarify"}
{"nl": "fix snapd", "bash": "CLARIFY: What's the symptom - snaps won't install, daemon is failing, refreshing forever? Share 'systemctl status snapd' and the snap command output.", "category": "clarify"}
{"nl": "auto restart on crash", "bash": "CLARIFY: For which service - I'll add Restart=on-failure to its systemd unit. Tell me the service name and how many retries you want.", "category": "clarify"}
{"nl": "stop apache nicely", "bash": "CLARIFY: Graceful stop (apache2ctl graceful-stop - lets connections finish) or fast stop (systemctl stop apache2)? Confirm.", "category": "clarify"}
{"nl": "the api process is sluggish", "bash": "CLARIFY: Which API process - share name or PID? Then I can profile (strace, perf), check resource limits, or restart if appropriate.", "category": "clarify"}
{"nl": "is the service up", "bash": "CLARIFY: Which service do you want to check? Tell me the name and I'll run 'systemctl is-active' on it.", "category": "clarify"}
{"nl": "restart at midnight", "bash": "CLARIFY: Restart which service or the whole system, every night, only tonight, or once a week? I'll set up a cron or systemd timer.", "category": "clarify"}
{"nl": "make sure it stays running", "bash": "CLARIFY: Which service or script? I'll wrap it in a systemd unit with Restart=always - share the name and the command to start it.", "category": "clarify"}
{"nl": "stop the user service", "bash": "CLARIFY: Which user systemd service (systemctl --user list-units shows them)? Give me the name.", "category": "clarify"}
{"nl": "kill all my background jobs", "bash": "CLARIFY: All jobs in this shell (kill $(jobs -p)), or all background processes owned by you (pkill -u $USER)? The second is much broader.", "category": "clarify"}
{"nl": "fix gnome shell", "bash": "CLARIFY: What symptom - frozen, missing icons, won't start? On X11 you can restart with Alt+F2 then 'r'. On Wayland you need to log out. Which session are you in?", "category": "clarify"}
{"nl": "stop my game from running", "bash": "CLARIFY: Which game (process name)? Run 'ps -ef | grep -i game_keyword' and share what appears - I'll kill the right PID.", "category": "clarify"}
{"nl": "restart networking", "bash": "CLARIFY: Restart NetworkManager (desktop, common case), systemd-networkd (servers), or just bounce a specific interface (ip link set down/up)?", "category": "clarify"}
{"nl": "stop the audio service", "bash": "CLARIFY: PulseAudio (systemctl --user stop pulseaudio.socket pulseaudio.service) or PipeWire (systemctl --user stop pipewire)? Run 'pactl info' to see which is in use.", "category": "clarify"}
{"nl": "restart bluez", "bash": "CLARIFY: That's 'sudo systemctl restart bluetooth' - confirm you want the system-wide bluetooth daemon restarted, not just toggling the radio?", "category": "clarify"}
{"nl": "kill the high cpu thing", "bash": "CLARIFY: Run 'ps aux --sort=-pcpu | head -5' and tell me which process - or share what's at the top so I act on the correct one.", "category": "clarify"}
{"nl": "fix the freeze", "bash": "CLARIFY: What's freezing - one app (which one), the whole desktop, or a server? For a single app, kill it; for the whole system, the diagnostic is different.", "category": "clarify"}
{"nl": "stop my script from looping", "bash": "CLARIFY: Which script (give me the name from 'ps aux | grep SCRIPT_NAME')? I'll kill that PID once we identify the right one.", "category": "clarify"}
{"nl": "restart my container", "bash": "CLARIFY: Which container (docker ps to list)? Use 'docker restart NAME' or 'docker compose restart SERVICE' depending on how it was launched.", "category": "clarify"}
{"nl": "fix the kubelet", "bash": "CLARIFY: On a real cluster node? What's the symptom - share 'systemctl status kubelet' and 'journalctl -u kubelet -n 100'. I'll triage from there.", "category": "clarify"}
{"nl": "make the daemon reload its file", "bash": "CLARIFY: Which daemon and which config file? Most reload with 'systemctl reload SERVICE' or by sending SIGHUP - tell me the service.", "category": "clarify"}
{"nl": "fix the orphaned process", "bash": "CLARIFY: Orphaned processes are reparented to init - they're usually fine. Which process are you concerned about? Share PID or name.", "category": "clarify"}
{"nl": "stop the indexer", "bash": "CLARIFY: Which indexer - tracker (GNOME), baloo (KDE), or an app's search index? Tell me which.", "category": "clarify"}
{"nl": "auto restart docker", "bash": "CLARIFY: Restart Docker daemon if it crashes (it already does via systemd), or restart a specific container on host reboot (--restart=always)? Which?", "category": "clarify"}
{"nl": "give someone access", "bash": "CLARIFY: Access to what (a file, folder, service)? And for which user, and which level (read-only, read/write, full ownership)?", "category": "clarify"}
{"nl": "change the permissions", "bash": "CLARIFY: For which file or folder, and to what - readable by everyone, executable, restricted to owner? Tell me the path and desired access.", "category": "clarify"}
{"nl": "add a user", "bash": "CLARIFY: What username, should they have sudo access, a regular shell or be a service account, and which groups should they belong to?", "category": "clarify"}
{"nl": "fix the ownership", "bash": "CLARIFY: For which file or folder, and which user/group should own it? Run 'ls -l PATH' so we see what it is now.", "category": "clarify"}
{"nl": "let her edit my files", "bash": "CLARIFY: Which files or folder, and what's her username on this system? I'd also need to decide between adding her to a group or using ACLs.", "category": "clarify"}
{"nl": "make this folder open to everyone", "bash": "CLARIFY: Read-only for everyone (chmod 755) or read/write (chmod 775 with group, or 777 - which is risky)? Which folder?", "category": "clarify"}
{"nl": "remove someones access", "bash": "CLARIFY: Whose access, and to what - a file, a folder, a database, ssh access? Tell me the user and the resource.", "category": "clarify"}
{"nl": "add a sudo user", "bash": "CLARIFY: What's the username, and should they have unrestricted sudo (in the sudo group) or only specific commands (via /etc/sudoers.d)?", "category": "clarify"}
{"nl": "lock the account", "bash": "CLARIFY: Which account, and lock how - prevent password login (passwd -l), disable shell, or fully expire the account?", "category": "clarify"}
{"nl": "delete a user", "bash": "CLARIFY: Which username, and should I keep or remove their home directory and mailspool? Use 'userdel' vs 'userdel -r'.", "category": "clarify"}
{"nl": "make the file executable", "bash": "CLARIFY: Which file (give me the path)? Executable for owner only (chmod u+x), or for everyone (chmod +x)?", "category": "clarify"}
{"nl": "fix permission denied", "bash": "CLARIFY: Which command or file gave the permission denied error? Paste the full message and I'll figure out what permission needs adjusting.", "category": "clarify"}
{"nl": "give the group access", "bash": "CLARIFY: Which group, to which file or folder, and what kind of access (read, read+write, read+write+execute)?", "category": "clarify"}
{"nl": "change the owner", "bash": "CLARIFY: For which file or directory, and to which user? Should I also change the group, and apply recursively?", "category": "clarify"}
{"nl": "add me to a group", "bash": "CLARIFY: Which group (docker, sudo, www-data, dialout, etc.)? You may need to log out and back in for group membership to take effect.", "category": "clarify"}
{"nl": "create a service account", "bash": "CLARIFY: Username for the service account, should it have a shell (no, usually /usr/sbin/nologin), and what home directory if any?", "category": "clarify"}
{"nl": "let it write to this folder", "bash": "CLARIFY: Let which process or user write to which folder? I need both to set the right ownership or ACL.", "category": "clarify"}
{"nl": "set up sudo without password", "bash": "CLARIFY: For which user, and for ALL commands or only specific ones (much safer - which commands)? NOPASSWD on everything is high-risk.", "category": "clarify"}
{"nl": "give my friend ssh access", "bash": "CLARIFY: What username should I create, and do you have his public SSH key (where, or paste it)? Should he have sudo?", "category": "clarify"}
{"nl": "remove the user from group", "bash": "CLARIFY: Which user, and from which group? Also, do you want them in any other groups - 'gpasswd -d USER GROUP' removes from one specific group.", "category": "clarify"}
{"nl": "fix the file owner", "bash": "CLARIFY: Which file - and what user should own it? Current owner might be 'root' or another user; run 'ls -l PATH' so we can see.", "category": "clarify"}
{"nl": "make this read only", "bash": "CLARIFY: Which file or folder? Read-only for owner too (chmod 444 / chattr +i), or just for others (chmod 644)?", "category": "clarify"}
{"nl": "set up password expiry", "bash": "CLARIFY: For which user, and what policy - expire in N days, force change on next login, lock if not changed?", "category": "clarify"}
{"nl": "disable my password", "bash": "CLARIFY: Switch this user to SSH-key-only login (passwd -l)? Or remove the user's password entirely? These are different.", "category": "clarify"}
{"nl": "give the database user access", "bash": "CLARIFY: Which database (postgres, mysql), which user inside the DB, to which database/tables, and which permissions (SELECT, INSERT, ALL)?", "category": "clarify"}
{"nl": "let the web server read my files", "bash": "CLARIFY: Which web server (nginx, apache - they run as www-data), which files, and read-only? I'll set group permissions or ACLs.", "category": "clarify"}
{"nl": "make the folder private", "bash": "CLARIFY: Private from whom - other local users (chmod 700), or specific user/group? Which folder?", "category": "clarify"}
{"nl": "share with my team", "bash": "CLARIFY: Share what (folder), with which users, and how - filesystem permissions (need a shared group), Samba, NFS, or a cloud-style sync?", "category": "clarify"}
{"nl": "let everyone in this group write", "bash": "CLARIFY: Which group, to which folder, and should new files inherit group ownership (setgid)? If yes I'll also chmod g+s the folder.", "category": "clarify"}
{"nl": "remove world write access", "bash": "CLARIFY: From a specific file/folder, or recursively across a tree (e.g., your home directory)? I'd use 'chmod -R o-w PATH'.", "category": "clarify"}
{"nl": "set up file acls", "bash": "CLARIFY: For which file or folder, and which users/groups should have which access? ACLs let you grant per-user rights beyond owner/group/other.", "category": "clarify"}
{"nl": "make the script runnable by everyone", "bash": "CLARIFY: Which script - and confirm it's safe to expose to all users on this system? Path and confirmation, please.", "category": "clarify"}
{"nl": "lock root", "bash": "CLARIFY: Disable root password login (passwd -l root)? Note this still allows sudo from authorized users - is that what you want?", "category": "clarify"}
{"nl": "give jenkins access to docker", "bash": "CLARIFY: Add the jenkins user to the docker group? That effectively grants root - confirm. Run 'usermod -aG docker jenkins' if so.", "category": "clarify"}
{"nl": "make the home folder accessible", "bash": "CLARIFY: Whose home folder, and accessible by whom? Granting access to a home folder can expose private data - what's the use case?", "category": "clarify"}
{"nl": "disable a user temporarily", "bash": "CLARIFY: Which user, and how - lock their password (passwd -l) so they can't log in but data is preserved, or expire the account?", "category": "clarify"}
{"nl": "give read access to log files", "bash": "CLARIFY: For which user, and which log files? Many require root or adm group - I can add the user to 'adm' if that's appropriate.", "category": "clarify"}
{"nl": "make a folder writable by apache", "bash": "CLARIFY: Which folder, and should apache (www-data) be the owner, in the owning group, or via ACL? Recursive?", "category": "clarify"}
{"nl": "transfer ownership", "bash": "CLARIFY: Of which file or folder, from whom to whom, recursively (chown -R)? Also confirm with 'ls -l' so I see current state.", "category": "clarify"}
{"nl": "set permissions back to default", "bash": "CLARIFY: Default for what - home directories (700), system files (644 for files / 755 for dirs)? Which path needs reset?", "category": "clarify"}
{"nl": "let me write to var www", "bash": "CLARIFY: Add your user to the www-data group and chmod g+w the folder, or chown it to you? Which is preferred depends on if a server also writes there.", "category": "clarify"}
{"nl": "make the script owned by root", "bash": "CLARIFY: Which script, and should it also be setuid (runs with root regardless of who launches)? Setuid is risky - confirm if so.", "category": "clarify"}
{"nl": "set up shared folder for the family", "bash": "CLARIFY: A local-disk shared folder (which users), or a network share via Samba so other devices can connect? Either works.", "category": "clarify"}
{"nl": "remove the deleted users files", "bash": "CLARIFY: Which user (now deleted), and where do their files live - /home/USER, plus any orphaned files elsewhere? Identify with 'find / -nouser'.", "category": "clarify"}
{"nl": "give a user shell access", "bash": "CLARIFY: Which user, and via what - local login (set shell with chsh) or SSH (add public key to ~/.ssh/authorized_keys)?", "category": "clarify"}
{"nl": "disable shell for this account", "bash": "CLARIFY: Which user, and disable how - set shell to /usr/sbin/nologin (login fails politely) or /bin/false (login fails silently)?", "category": "clarify"}
{"nl": "give the user a strong password", "bash": "CLARIFY: Which user, and should I generate a random password (and how should you receive it), or do you want to set one manually?", "category": "clarify"}
{"nl": "make the file private to me", "bash": "CLARIFY: Which file - I'll chmod 600 if it's a regular file, 700 if directory. Confirm path.", "category": "clarify"}
{"nl": "share a file with someone", "bash": "CLARIFY: Which file, with which local user? Either chmod o+r (anyone on system reads), or use ACLs to grant just that user.", "category": "clarify"}
{"nl": "i want guest access", "bash": "CLARIFY: A guest user for local login, or guest access to a Samba/file share? Each setup is different.", "category": "clarify"}
{"nl": "block a user from logging in", "bash": "CLARIFY: Which user, and how - lock password (passwd -l), set shell to nologin, or remove from ssh allow list? Each blocks a different login path.", "category": "clarify"}
{"nl": "give everyone read", "bash": "CLARIFY: Read access to which file or folder? On a multi-user system, chmod o+r exposes it to all local users - confirm path.", "category": "clarify"}
{"nl": "fix the permission bits", "bash": "CLARIFY: Which file or folder, and what should they be (e.g., 644 for files / 755 for directories, or stricter 600/700)?", "category": "clarify"}
{"nl": "make sure no one else can read this", "bash": "CLARIFY: Which file - and 'no one else' meaning no other local user? I'll chmod 600 and confirm ownership belongs to you.", "category": "clarify"}
{"nl": "give the dev team access to the deploy folder", "bash": "CLARIFY: Are 'devs' a unix group already (run 'getent group devs')? If not, what users should be in it, and which folder needs write access?", "category": "clarify"}
{"nl": "set up file sharing for the office", "bash": "CLARIFY: Local network (Samba/CIFS for Windows interop, NFS for Linux/Mac), or cloud-like (Nextcloud)? Which folder shared, and to which users?", "category": "clarify"}
{"nl": "let the user mount usb sticks", "bash": "CLARIFY: Add the user to the 'plugdev' group (works on Ubuntu desktop), or do you need them to mount manually via sudo? Different paths.", "category": "clarify"}
{"nl": "the file says i dont have permission", "bash": "CLARIFY: Which file (full path), and what are you trying to do (read, write, execute)? Share 'ls -l PATH' so I know the current permissions.", "category": "clarify"}
{"nl": "give myself permission everywhere", "bash": "CLARIFY: Everywhere on your home folder (chown -R you:you ~), or system-wide (very risky)? Tell me the scope; system-wide can break the OS.", "category": "clarify"}
{"nl": "lock down sensitive files", "bash": "CLARIFY: Which files (e.g., ~/.ssh, ~/.gnupg, a credentials folder)? I'll chmod 600/700 - confirm the paths.", "category": "clarify"}
{"nl": "give docker access to that folder", "bash": "CLARIFY: Docker containers run as whatever user the image uses. Which folder, mounted into which container, and what UID:GID does the container's process use?", "category": "clarify"}
{"nl": "fix kubectl access", "bash": "CLARIFY: For which kubeconfig (path), and what's failing - 'permission denied' for the file (chmod 600 ~/.kube/config), or RBAC denial in the cluster?", "category": "clarify"}
{"nl": "let www-data write logs", "bash": "CLARIFY: Which log directory? I'll either chown to www-data or add ACL so www-data can write. Confirm the path.", "category": "clarify"}
{"nl": "rotate user passwords", "bash": "CLARIFY: For which user(s), and to what - force password change on next login (chage -d 0 USER), or set a policy for expiry every N days?", "category": "clarify"}
{"nl": "create a restricted user", "bash": "CLARIFY: Restricted how - no shell (rsync/sftp-only), no sudo, chrooted, limited resources (cgroups)? Tell me what they should and shouldn't do.", "category": "clarify"}
{"nl": "give read-only ssh", "bash": "CLARIFY: For which user - I'd create a chrooted sftp-only account, or restrict to specific commands. Tell me the username and what they need to access.", "category": "clarify"}
{"nl": "give me write access here", "bash": "CLARIFY: Where is 'here' - the current directory? Run 'pwd' and 'ls -l' so I see the path and current ownership before chmod or chown.", "category": "clarify"}
{"nl": "remove world-writable", "bash": "CLARIFY: Strip world-writable from a single file/folder, or scan a tree to find and fix all of them (find PATH -perm -o=w)?", "category": "clarify"}
{"nl": "fix the home folder permissions", "bash": "CLARIFY: Whose home folder, and to what - 700 (private, most common), 750 (private to user, readable by their group), or 755 (world-readable)?", "category": "clarify"}
{"nl": "let me run sudo without prompting all the time", "bash": "CLARIFY: For your user, for which commands? NOPASSWD for everything is risky; safer is for specific commands. List the commands you want.", "category": "clarify"}
{"nl": "create read only account", "bash": "CLARIFY: Read-only of what - filesystem (limit via filesystem ACLs), a database (specific DB grants), or a Git repo? Each is a different setup.", "category": "clarify"}
{"nl": "share with all users", "bash": "CLARIFY: Share what (file or folder), with all local users on this system? I'll chmod accordingly - what's the path?", "category": "clarify"}
{"nl": "make my config private", "bash": "CLARIFY: Which config file - e.g., ~/.ssh/config, ~/.aws/credentials, an app config? I'll set 600 or 700 once I have the path.", "category": "clarify"}
{"nl": "audit the permissions", "bash": "CLARIFY: Audit what - find world-writable files, find SUID binaries, files with no owner? Tell me which class of risky permission to scan for.", "category": "clarify"}
{"nl": "swap the user account", "bash": "CLARIFY: Swap how - rename a user (usermod -l NEW OLD), change UID, or change who owns home files? Tell me what 'swap' means.", "category": "clarify"}
{"nl": "set the umask", "bash": "CLARIFY: For which user, and to what value (022 for default permissive, 027 for restrict-other, 077 for owner-only)? And system-wide or just your shell?", "category": "clarify"}
{"nl": "let only members of a group write", "bash": "CLARIFY: Which group, which folder, and should new files inherit the group (setgid)? Need group name and path.", "category": "clarify"}
{"nl": "make read writable for all in my project", "bash": "CLARIFY: Which folder, who is 'all in my project' (a unix group - which one)? I'll set group ownership and chmod 775.", "category": "clarify"}
{"nl": "give read-write to specific user", "bash": "CLARIFY: Which user, to which file or folder? I'll use ACLs (setfacl -m u:USER:rwx PATH) since standard perms only have one owner.", "category": "clarify"}
{"nl": "stop the user from sudo", "bash": "CLARIFY: Remove which user from the sudo (or wheel) group? Or remove a specific NOPASSWD line from sudoers? Tell me what they currently have.", "category": "clarify"}
{"nl": "give my coworker pull access", "bash": "CLARIFY: Pull access to what - a Git repo on this server, a Docker registry, an apt mirror, a network share? Each is set up differently.", "category": "clarify"}
{"nl": "make my server multi user", "bash": "CLARIFY: Add additional user accounts (how many, what usernames), or set up authentication for an existing service (like SSH for multiple keys)? Be specific.", "category": "clarify"}
{"nl": "set up user quotas", "bash": "CLARIFY: For which user(s), on which filesystem, and what limit (size in MB/GB, inode count, or both)? Quotas need quota tools and fstab options.", "category": "clarify"}
{"nl": "fix mod bits on this", "bash": "CLARIFY: 'This' meaning which file or folder, and what should the permissions be? Share the path and intended mode (e.g., 644 / 755 / 600).", "category": "clarify"}
{"nl": "give my account more power", "bash": "CLARIFY: Add to sudo group for general admin, or specific groups for specific access (docker, libvirt, dialout)? What do you actually need to do?", "category": "clarify"}
{"nl": "set ownership recursively", "bash": "CLARIFY: For which folder, and to which user/group? Confirm the path - 'chown -R USER:GROUP PATH' is the form.", "category": "clarify"}
{"nl": "give a service account permission", "bash": "CLARIFY: Which service account, to which resource (file, folder, port, system call), and what level of access? Be specific so I can keep privileges minimal.", "category": "clarify"}
{"nl": "let docker run without sudo", "bash": "CLARIFY: Add your user to the docker group? Be aware this grants effective root via container mounts - confirm if you accept that risk.", "category": "clarify"}
{"nl": "make a folder for everyone in our group", "bash": "CLARIFY: Which group, and where should the folder live? I'll mkdir, chown root:GROUP, chmod 2775 so new files inherit the group.", "category": "clarify"}
{"nl": "lock down my desktop", "bash": "CLARIFY: Lock the screen now (loginctl lock-session), set an auto-lock timeout, or harden filesystem permissions? Different actions for each goal.", "category": "clarify"}
{"nl": "set permissions for ssh", "bash": "CLARIFY: ~/.ssh should be 700, ~/.ssh/authorized_keys 600, private keys 600. Which file is misbehaving, or do you want the standard set applied?", "category": "clarify"}
{"nl": "change file permissions to safe defaults", "bash": "CLARIFY: For which directory tree, and what's 'safe' to you - 644/755 (default), 640/750 (group-only), or 600/700 (owner-only)?", "category": "clarify"}
{"nl": "give jenkins push access", "bash": "CLARIFY: Push access to what - a Git remote (need ssh key in remote), Docker registry (need creds), package repo? Tell me the destination.", "category": "clarify"}
{"nl": "fix executable permissions", "bash": "CLARIFY: For which file - make it executable (chmod +x PATH)? Or for a folder of scripts, all matching a pattern?", "category": "clarify"}
{"nl": "let me see other users home folders", "bash": "CLARIFY: This usually requires sudo and revealing private data. What's the actual goal - administering a specific user's files, or browsing? I might suggest a safer approach.", "category": "clarify"}
{"nl": "give ftp access", "bash": "CLARIFY: For which user, and is the ftp server already running (which one - vsftpd, proftpd)? Or do you want SFTP via SSH instead (more secure)?", "category": "clarify"}
{"nl": "kick the user out", "bash": "CLARIFY: Kill their active sessions (pkill -KILL -u USER), lock the account, or fully delete them? Each is different in severity.", "category": "clarify"}
{"nl": "let postgres read this folder", "bash": "CLARIFY: Which folder, and is the postgres user named 'postgres'? I'll chown or use ACLs - confirm the path.", "category": "clarify"}
{"nl": "set up sudoers entry", "bash": "CLARIFY: For which user, allowing which commands? I'll write a file in /etc/sudoers.d/ - share the username and the commands they should be allowed to run.", "category": "clarify"}
{"nl": "let two users edit the same file", "bash": "CLARIFY: Create a shared group, chown the file to that group, chmod g+w? Tell me the file path and the two usernames.", "category": "clarify"}
{"nl": "free up space", "bash": "CLARIFY: Which disk is running low (run 'df -h')? And what should I target - apt cache, old kernels, large files in home, browser caches?", "category": "clarify"}
{"nl": "check what's using space", "bash": "CLARIFY: Look at which mount point (home, root, an external drive)? I'll run du or ncdu - tell me the path you want analyzed.", "category": "clarify"}
{"nl": "mount the drive", "bash": "CLARIFY: Which drive (run 'lsblk' to see), and where should it be mounted (e.g., /mnt/usb, /media/$USER/data)?", "category": "clarify"}
{"nl": "format it", "bash": "CLARIFY: Which device (run 'lsblk'), and to which filesystem (ext4 for Linux, exFAT for cross-platform, NTFS for Windows)? Formatting destroys all data on it.", "category": "clarify"}
{"nl": "expand the partition", "bash": "CLARIFY: Which partition (lsblk to identify), and to what size? Is there free unallocated space after it, or do you need to shrink a neighbor first?", "category": "clarify"}
{"nl": "check my disk usage", "bash": "CLARIFY: Across all mounts ('df -h') or breakdown by folder ('du -sh /path/*')? Which path if du?", "category": "clarify"}
{"nl": "mount the network drive", "bash": "CLARIFY: What kind of share - NFS, Samba (CIFS), SSHFS? And what's the server address, share name, and mount point on this machine?", "category": "clarify"}
{"nl": "unmount the drive", "bash": "CLARIFY: Which mount? Run 'mount | grep -v ^proc' to list, then tell me the mount point or device.", "category": "clarify"}
{"nl": "find big files", "bash": "CLARIFY: Where to look (home folder, /var, the whole system), and how big counts as big (>100MB, >1GB)? Sort by size descending?", "category": "clarify"}
{"nl": "find big directories", "bash": "CLARIFY: Starting from which directory, and how deep to traverse? I'll run 'du -h --max-depth=N PATH | sort -h' - need both inputs.", "category": "clarify"}
{"nl": "set up swap", "bash": "CLARIFY: How big a swapfile (e.g., 4G, 8G), and where to place it (default /swapfile)? Or do you want a swap partition instead?", "category": "clarify"}
{"nl": "make swap bigger", "bash": "CLARIFY: Resize the existing /swapfile or create an additional one? And to what size? Current size: check with 'swapon --show'.", "category": "clarify"}
{"nl": "check disk health", "bash": "CLARIFY: For which drive (lsblk to identify), and do you want a quick check (smartctl -H) or a long self-test (smartctl -t long)?", "category": "clarify"}
{"nl": "fix the disk", "bash": "CLARIFY: What's the symptom - filesystem errors, can't mount, slow performance? And which device/partition? Different fixes for each.", "category": "clarify"}
{"nl": "show partition layout", "bash": "CLARIFY: For all disks (lsblk) or a specific one (lsblk /dev/sda)? And do you want partition table type too (fdisk -l)?", "category": "clarify"}
{"nl": "increase disk space", "bash": "CLARIFY: Add a new disk (which device), expand an existing partition (which), or extend a logical volume (LVM)? Tell me your storage layout.", "category": "clarify"}
{"nl": "clean up disk", "bash": "CLARIFY: Which type of cleanup - apt cache, old kernels, journal logs, Docker images, large files in home? Each has its own command.", "category": "clarify"}
{"nl": "find what's filling up", "bash": "CLARIFY: Which mount point is filling (df -h shows this), and from which directory should I search for the culprits (e.g., /var, ~)?", "category": "clarify"}
{"nl": "set up raid", "bash": "CLARIFY: Which RAID level (0, 1, 5, 10), using which devices (lsblk), and via what (mdadm software RAID, ZFS, btrfs)? This destroys data on the devices.", "category": "clarify"}
{"nl": "make a usb bootable", "bash": "CLARIFY: Which ISO file, and which USB device (lsblk)? I'll use dd - this destroys all data on the USB.", "category": "clarify"}
{"nl": "see if drive is failing", "bash": "CLARIFY: Which drive? Run 'sudo smartctl -a /dev/sdX' on the device you suspect - tell me which, and I'll interpret the output.", "category": "clarify"}
{"nl": "show me whats on the disk", "bash": "CLARIFY: A directory tree (which path), partitions (lsblk), or filesystem usage breakdown (du)? Each gives a different view.", "category": "clarify"}
{"nl": "shrink the partition", "bash": "CLARIFY: Which partition, and what's the new size? Also: is the filesystem unmounted? Shrinking a mounted filesystem is unsafe.", "category": "clarify"}
{"nl": "find old large files", "bash": "CLARIFY: Where to search, and what's the size threshold (>100MB, >500MB) and age threshold (older than 30 days, 90 days)?", "category": "clarify"}
{"nl": "what's eating my space", "bash": "CLARIFY: Look in your home folder, the root filesystem, or a specific path? I'll run 'du -sh PATH/* | sort -h' once we agree on the path.", "category": "clarify"}
{"nl": "delete biggest files", "bash": "CLARIFY: Where to search, and what's 'biggest' - top 10 by size, or files over a threshold? Also confirm: review before deleting, or auto-delete?", "category": "clarify"}
{"nl": "mount the windows partition", "bash": "CLARIFY: Which device (run 'sudo fdisk -l' to see NTFS partitions), and to which mount point (e.g., /mnt/windows)? Read-only or read-write?", "category": "clarify"}
{"nl": "extend lvm volume", "bash": "CLARIFY: Which logical volume (lvs), and by how much (e.g., +10G or to a specific size)? Plus resize the filesystem on top?", "category": "clarify"}
{"nl": "make a snapshot", "bash": "CLARIFY: A LVM snapshot of a logical volume (which one), a btrfs snapshot (which subvolume), or a ZFS snapshot? Tell me which storage system.", "category": "clarify"}
{"nl": "back up to external", "bash": "CLARIFY: What to back up (which folder), and which external drive (lsblk, what's the mount point)? Tool - rsync, tar, or restic?", "category": "clarify"}
{"nl": "the disk is full", "bash": "CLARIFY: Which mount point is full ('df -h' shows usage)? Then we can target the biggest consumers on that specific filesystem.", "category": "clarify"}
{"nl": "show file system type", "bash": "CLARIFY: For a specific mount/device, or all of them ('lsblk -f' shows all)? Which would be more useful?", "category": "clarify"}
{"nl": "encrypt the drive", "bash": "CLARIFY: Set up new LUKS encryption on a device (lsblk - which, and this destroys data), or unlock an existing encrypted device?", "category": "clarify"}
{"nl": "unlock the encrypted disk", "bash": "CLARIFY: Which device (lsblk, look for crypto_LUKS), and do you have the passphrase ready? I'll use 'cryptsetup luksOpen'.", "category": "clarify"}
{"nl": "set up auto mount", "bash": "CLARIFY: Which device or share, and at which mount point? I'll add an /etc/fstab entry - share device, type, mount point, and options.", "category": "clarify"}
{"nl": "find which folder is huge", "bash": "CLARIFY: Starting where? I'll run 'du -h --max-depth=2 PATH | sort -h | tail -20' once you give me the starting path.", "category": "clarify"}
{"nl": "create a partition", "bash": "CLARIFY: On which disk (lsblk), how big, what type/filesystem, and where in the disk? Also: is there free space?", "category": "clarify"}
{"nl": "delete a partition", "bash": "CLARIFY: Which partition (lsblk to identify exact name like /dev/sda3)? Deleting destroys data on it - confirm.", "category": "clarify"}
{"nl": "merge two partitions", "bash": "CLARIFY: Which two (lsblk), and which filesystem will remain? You'd need to delete one and extend the other - data on the deleted one will be lost.", "category": "clarify"}
{"nl": "fix corrupted disk", "bash": "CLARIFY: Which device, and what's the symptom - won't mount, errors in dmesg, files unreadable? I'll run fsck or smartctl, but I need to know which.", "category": "clarify"}
{"nl": "extend the root partition", "bash": "CLARIFY: To grow the root partition, the disk must have unallocated space after it (or be on LVM). Run 'lsblk' and 'sudo parted -l' so we can see the layout.", "category": "clarify"}
{"nl": "free disk in var", "bash": "CLARIFY: Look in /var/log (rotate or clear logs), /var/cache (apt clean), /var/lib/docker, or somewhere else? Run 'du -sh /var/* | sort -h' to find the biggest.", "category": "clarify"}
{"nl": "find duplicate files on disk", "bash": "CLARIFY: In which directory tree, and match by hash (most reliable) or by name? Tool fdupes works on a path - which path?", "category": "clarify"}
{"nl": "check if drive is mounted", "bash": "CLARIFY: Which drive or mount point should I check? Run 'mount | grep KEYWORD' or share the device path.", "category": "clarify"}
{"nl": "remove old snapshots", "bash": "CLARIFY: Which kind of snapshot - LVM (lvs --all), btrfs (btrfs subvolume list), Timeshift, ZFS? And how old should they be to remove?", "category": "clarify"}
{"nl": "see space on usb", "bash": "CLARIFY: Which USB device or its mount point? Run 'lsblk' to find it and tell me the path - I'll show usage with 'df -h MOUNTPOINT'.", "category": "clarify"}
{"nl": "wipe the partition", "bash": "CLARIFY: Quick wipe (mkfs - fast, recoverable with software) or secure wipe (shred or 'dd if=/dev/urandom')? Which device, and confirm data loss is acceptable.", "category": "clarify"}
{"nl": "set noatime on the mount", "bash": "CLARIFY: For which mount point - I'll edit /etc/fstab to add 'noatime'. Tell me the mount or device, and whether to remount immediately.", "category": "clarify"}
{"nl": "the system says no space left", "bash": "CLARIFY: On which mount ('df -h')? It could also be inodes ('df -i'). Once we see which, I'll target the right cleanup.", "category": "clarify"}
{"nl": "out of inodes", "bash": "CLARIFY: Which mount (df -i shows inode usage)? Then I'd find directories with the most files: 'find PATH -xdev -type f | wc -l' for candidates.", "category": "clarify"}
{"nl": "find what consumes disk in home", "bash": "CLARIFY: Top-level folders ('du -sh ~/* | sort -h'), or a deeper analysis (ncdu)? Either works - which do you prefer?", "category": "clarify"}
{"nl": "remount as read only", "bash": "CLARIFY: Which mount point? I'll run 'sudo mount -o remount,ro MOUNTPOINT' - tell me the path.", "category": "clarify"}
{"nl": "convert ntfs to ext4", "bash": "CLARIFY: This would destroy all existing data on the partition. Which device, and have you backed up the data? Confirm and I'll mkfs.ext4.", "category": "clarify"}
{"nl": "expand my home directory space", "bash": "CLARIFY: Is /home on its own partition or LVM volume? Run 'df -h /home' and 'lvs' so I see the layout, then I can expand the right thing.", "category": "clarify"}
{"nl": "set up disk encryption", "bash": "CLARIFY: For a new disk (LUKS, destroys data), an existing partition (will need backup/restore), or a directory (gocryptfs, encfs)? Which device or path?", "category": "clarify"}
{"nl": "see who is using a mount", "bash": "CLARIFY: Which mount point? I'll run 'fuser -mv MOUNTPOINT' or 'lsof MOUNTPOINT' to show processes holding files - tell me the path.", "category": "clarify"}
{"nl": "the drive has bad sectors", "bash": "CLARIFY: Which drive, and do you want to mark them and continue (badblocks + mkfs with -l), or replace the drive? Sharing 'smartctl -a /dev/sdX' would help triage.", "category": "clarify"}
{"nl": "clone a partition", "bash": "CLARIFY: Source and destination devices? I'll use 'dd' or 'partclone' - confirm both, and that the destination is empty (data will be overwritten).", "category": "clarify"}
{"nl": "back up the boot partition", "bash": "CLARIFY: Which partition is /boot ('df /boot'), and where should the backup go? I'll dd it to an image file or another disk.", "category": "clarify"}
{"nl": "configure btrfs subvolume", "bash": "CLARIFY: Create a new subvolume (where on a btrfs mount, and what name)? Or list/manage existing ones? Tell me the goal.", "category": "clarify"}
{"nl": "trim ssd", "bash": "CLARIFY: Run fstrim now on all mounts ('sudo fstrim -av'), enable the weekly fstrim timer ('systemctl enable fstrim.timer'), or just one mount?", "category": "clarify"}
{"nl": "free up boot", "bash": "CLARIFY: /boot is filling with old kernels. Remove unused kernels with 'sudo apt autoremove --purge', or do you also want to clean initramfs caches?", "category": "clarify"}
{"nl": "stop disk activity", "bash": "CLARIFY: Identify what's writing (iotop) so we can stop the culprit? Or are you trying to spin down an idle drive (hdparm -y)?", "category": "clarify"}
{"nl": "speed up the disk", "bash": "CLARIFY: Tune mount options (noatime), upgrade hardware, switch scheduler? What's your bottleneck - random reads, sequential writes, latency?", "category": "clarify"}
{"nl": "what files have i changed today", "bash": "CLARIFY: In which directory should I search? I'll run 'find PATH -mtime -1 -type f' once you confirm the starting path.", "category": "clarify"}
{"nl": "find files modified in the last hour", "bash": "CLARIFY: In which directory tree? 'find PATH -mmin -60 -type f' - tell me PATH.", "category": "clarify"}
{"nl": "show oldest files in folder", "bash": "CLARIFY: Which folder, and how many to show? E.g., 'ls -lt FOLDER | tail -20' for the 20 oldest by mtime.", "category": "clarify"}
{"nl": "rebalance the storage", "bash": "CLARIFY: Btrfs rebalance (which mount), ZFS rebalance, or moving files between disks manually? Tell me the storage tech in use.", "category": "clarify"}
{"nl": "find sparse files", "bash": "CLARIFY: In which directory? 'find PATH -type f -printf %S\\t%p\\n' shows sparseness - tell me where to look.", "category": "clarify"}
{"nl": "clean nix store", "bash": "CLARIFY: Run 'nix-collect-garbage' (current user) or '-d' (delete old generations system-wide, requires root)? Also: how many generations to keep?", "category": "clarify"}
{"nl": "clean snap data", "bash": "CLARIFY: Remove old snap revisions ('snap list --all' to see), or remove unused snaps entirely? Snaps keep 3 revisions by default - reduce to how many?", "category": "clarify"}
{"nl": "clean docker", "bash": "CLARIFY: Remove dangling images (docker image prune), all unused images (-a), stopped containers, unused volumes, or everything (docker system prune -a --volumes)?", "category": "clarify"}
{"nl": "clean journalctl", "bash": "CLARIFY: Limit by size ('journalctl --vacuum-size=200M') or by age ('journalctl --vacuum-time=2weeks')? Pick a target.", "category": "clarify"}
{"nl": "delete kernel logs", "bash": "CLARIFY: Truncate /var/log/kern.log, or vacuum journalctl (which stores kernel messages)? And what's the goal - free space or hide info?", "category": "clarify"}
{"nl": "set up disk quota", "bash": "CLARIFY: For which user, on which filesystem, and what limit (soft, hard, in MB or GB, plus inode limit)? Quotas need to be enabled in fstab first.", "category": "clarify"}
{"nl": "shrink ext4 partition", "bash": "CLARIFY: Which partition, and to what new size? Filesystem must be unmounted, and shrinking carries risk - confirm a backup is in place.", "category": "clarify"}
{"nl": "move home to another drive", "bash": "CLARIFY: Source (/home is on which disk?) and destination drive (lsblk)? I'll set up the new partition, rsync data, and update /etc/fstab.", "category": "clarify"}
{"nl": "convert mbr to gpt", "bash": "CLARIFY: For which disk (lsblk)? This affects bootability - is the system currently booting from this disk? And do you have a backup?", "category": "clarify"}
{"nl": "see partition uuids", "bash": "CLARIFY: All partitions ('blkid' or 'lsblk -o NAME,UUID,LABEL'), or just one device (blkid /dev/sdX)? Either works.", "category": "clarify"}
{"nl": "label the partition", "bash": "CLARIFY: Which partition (lsblk), and what label? Tool depends on filesystem - e2label for ext, ntfslabel for NTFS, exfatlabel for exFAT.", "category": "clarify"}
{"nl": "check for filesystem errors", "bash": "CLARIFY: Which filesystem (device path)? It must be unmounted for fsck. Boot to recovery, or unmount it now? Which mount?", "category": "clarify"}
{"nl": "speed up boot", "bash": "CLARIFY: What's the current slow part - kernel init, services, GUI loading? Run 'systemd-analyze blame' and share the top entries.", "category": "clarify"}
{"nl": "compact docker images", "bash": "CLARIFY: Which images need compacting - removing layers, multistage build to slim, or just pruning unused? Share the image name(s) and goal.", "category": "clarify"}
{"nl": "remove unused volumes", "bash": "CLARIFY: Docker volumes ('docker volume prune'), LVM volumes (which to remove from 'lvs'), or libvirt storage volumes? Different tools.", "category": "clarify"}
{"nl": "find files larger than 1gb", "bash": "CLARIFY: From which directory? I'll run 'find PATH -type f -size +1G' once you confirm the path.", "category": "clarify"}
{"nl": "create swap file 8 gigs", "bash": "CLARIFY: Where to place the swapfile (default /swapfile)? I'll dd or fallocate 8G, mkswap, swapon, and add to fstab - confirm.", "category": "clarify"}
{"nl": "remove swap", "bash": "CLARIFY: Disable swap entirely (swapoff -a, remove from fstab), or only one specific swap (which - 'swapon --show')?", "category": "clarify"}
{"nl": "check ssd life", "bash": "CLARIFY: For which device (lsblk)? I'll run 'sudo smartctl -A /dev/sdX' and interpret the Wear_Leveling and Total_LBAs_Written attributes.", "category": "clarify"}
{"nl": "find the disk hog", "bash": "CLARIFY: Which mount, and disk hog by space (du) or by I/O (iotop)? Each addresses a different problem - which?", "category": "clarify"}
{"nl": "make / smaller", "bash": "CLARIFY: Resize the root filesystem - this is non-trivial and usually needs offline (rescue) tools unless on LVM/btrfs. What's the storage layout? Backup in place?", "category": "clarify"}
{"nl": "see disk speed", "bash": "CLARIFY: Sequential read benchmark ('sudo hdparm -tT /dev/sdX'), random IO ('fio'), or just casual ('dd if=/dev/sdX of=/dev/null bs=1M count=1024')? Which device?", "category": "clarify"}
{"nl": "set scheduler for the disk", "bash": "CLARIFY: For which device (lsblk), and which scheduler (none for NVMe SSD, mq-deadline for SATA SSD, bfq for desktops)? I'll write to /sys/block/.../queue/scheduler.", "category": "clarify"}
{"nl": "find old downloads to delete", "bash": "CLARIFY: How old (older than 30 days, 90 days), and any file types to skip (e.g., keep recent .pdf invoices)? Default is everything in ~/Downloads.", "category": "clarify"}
{"nl": "expand the vm disk", "bash": "CLARIFY: This needs two steps: resize the disk in the hypervisor (which - VirtualBox, VMware, qemu, cloud?), then expand inside the VM. Which hypervisor?", "category": "clarify"}
{"nl": "secure delete a file", "bash": "CLARIFY: Which file? Note: on SSDs, secure delete is mostly ineffective without full-device blkdiscard. On HDD I can use 'shred -u'. Tell me the file.", "category": "clarify"}
{"nl": "see what's taking inodes", "bash": "CLARIFY: From which directory? I'll run 'find PATH -xdev -type f -printf %h\\n | sort | uniq -c | sort -n' to find folders with most files.", "category": "clarify"}
{"nl": "tune the disk for ssd", "bash": "CLARIFY: For which mount/device - I can set noatime in fstab, ensure fstrim.timer is enabled, and pick a suitable scheduler. Confirm device.", "category": "clarify"}
{"nl": "make the disk read only", "bash": "CLARIFY: One mount remount ro, or set hardware switch? Which mount point? Note: forcing root rw->ro requires care - confirm which filesystem.", "category": "clarify"}
{"nl": "show drives plugged in", "bash": "CLARIFY: All block devices (lsblk - includes mounted ones), or only USB devices (lsusb)? Each shows different info.", "category": "clarify"}
{"nl": "test disk write speed", "bash": "CLARIFY: On which path or device? Sequential write test - 'dd if=/dev/zero of=PATH/testfile bs=1M count=1024 conv=fdatasync'. Tell me where to write.", "category": "clarify"}
{"nl": "fix the network", "bash": "CLARIFY: What's the symptom - no connection, slow, DNS not resolving, specific site unreachable? And on which interface (run 'ip a')?", "category": "clarify"}
{"nl": "open the port", "bash": "CLARIFY: Which port number, which protocol (TCP or UDP), and via which firewall (ufw, firewalld, iptables)? Also, restricted to which source IPs?", "category": "clarify"}
{"nl": "allow the connection", "bash": "CLARIFY: From which source (IP, subnet, anywhere) to which port and service? I'll add the firewall rule once those are clear.", "category": "clarify"}
{"nl": "block the traffic", "bash": "CLARIFY: Block which source IP, port, or protocol - and in which direction (incoming, outgoing)? Which firewall (ufw, firewalld, iptables)?", "category": "clarify"}
{"nl": "set up port forwarding", "bash": "CLARIFY: External port -> internal IP:port? Also: forwarding via iptables on this host, or on a router? I'd need both endpoints.", "category": "clarify"}
{"nl": "check the network speed", "bash": "CLARIFY: Internet speed (speedtest-cli), local LAN speed (iperf3 to another machine), or a specific connection? Tell me what to measure.", "category": "clarify"}
{"nl": "fix my wifi", "bash": "CLARIFY: What's wrong - won't connect, slow, drops repeatedly, no networks visible? And which interface (iw dev)?", "category": "clarify"}
{"nl": "find my ip", "bash": "CLARIFY: Local IP on your network (run 'ip -4 addr show' or 'hostname -I'), or public IP as seen by the internet ('curl ifconfig.me')?", "category": "clarify"}
{"nl": "test the connection", "bash": "CLARIFY: To where - a specific host (ping HOST), the internet at large (ping 8.8.8.8), or a specific port (nc -zv HOST PORT)?", "category": "clarify"}
{"nl": "see whats on the network", "bash": "CLARIFY: Devices on your LAN (nmap -sn 192.168.1.0/24, need to confirm subnet), or services on this host (ss -tlnp)?", "category": "clarify"}
{"nl": "scan ports", "bash": "CLARIFY: On which host or subnet, and which ports (default 1000, all 65535, or a list)? Scanning hosts you don't own may be against terms of service.", "category": "clarify"}
{"nl": "redirect port 80 to 8080", "bash": "CLARIFY: For incoming traffic to this machine - via iptables on the same host, or upstream? Confirm direction and interface.", "category": "clarify"}
{"nl": "allow ssh from one ip", "bash": "CLARIFY: Which source IP, and which firewall (ufw allow from IP to any port 22; firewall-cmd; raw iptables)? Plus current rules - share if any.", "category": "clarify"}
{"nl": "close all ports", "bash": "CLARIFY: Block all incoming (default deny), or also outgoing? And leaving SSH open so you don't lock yourself out? Be very careful on remote hosts.", "category": "clarify"}
{"nl": "set dns", "bash": "CLARIFY: System-wide DNS resolver (edit /etc/resolv.conf or systemd-resolved), or for a single interface (NetworkManager / netplan)? Which servers (1.1.1.1, 8.8.8.8)?", "category": "clarify"}
{"nl": "fix dns issues", "bash": "CLARIFY: What's failing - 'cannot resolve hostname' for everything or specific domains? Share an example: 'nslookup example.com' output, and which resolver you use.", "category": "clarify"}
{"nl": "see network usage", "bash": "CLARIFY: Real-time per-process (nethogs), per-interface aggregate (vnstat or 'ip -s link'), or per-connection (iftop)? Which is more useful?", "category": "clarify"}
{"nl": "find what's using my bandwidth", "bash": "CLARIFY: I'll run 'sudo nethogs' which shows per-process. Confirm you want that, and which interface (e.g., eth0, wlan0 - from 'ip link').", "category": "clarify"}
{"nl": "configure static ip", "bash": "CLARIFY: For which interface (ip link), what IP/netmask, gateway, and DNS? Plus configuration method - netplan (Ubuntu server), NetworkManager (desktop)?", "category": "clarify"}
{"nl": "set up vpn", "bash": "CLARIFY: Which VPN - WireGuard, OpenVPN, IPsec? Do you have config from a provider, or are you setting up your own server? Either changes the steps.", "category": "clarify"}
{"nl": "block a website", "bash": "CLARIFY: For which user/all users, via what - /etc/hosts (simple, defeated by VPN), iptables, or DNS-level (e.g., Pi-hole)? Which domain?", "category": "clarify"}
{"nl": "see who's connected", "bash": "CLARIFY: SSH sessions (who, w), all network connections (ss -tunap), or LAN devices (nmap -sn SUBNET)? Each shows different info.", "category": "clarify"}
{"nl": "see active connections", "bash": "CLARIFY: 'ss -tunap' shows all - but do you want only TCP, only listening, or only established? And to which port?", "category": "clarify"}
{"nl": "show internet traffic", "bash": "CLARIFY: Live packet capture (tcpdump - on which interface and filter?), or summary stats (vnstat -i INTERFACE)? Which interface from 'ip link'?", "category": "clarify"}
{"nl": "make my hostname permanent", "bash": "CLARIFY: What hostname, and apply where - 'hostnamectl set-hostname NEW' updates it. Also update /etc/hosts? Confirm the desired name.", "category": "clarify"}
{"nl": "test internet", "bash": "CLARIFY: ICMP reachability (ping 8.8.8.8), DNS resolution (nslookup example.com), or HTTP fetch (curl -I https://example.com)? Or all three?", "category": "clarify"}
{"nl": "set up wireguard", "bash": "CLARIFY: As a client (do you have a config from a provider?) or a server (which port, peer count, network subnet)?", "category": "clarify"}
{"nl": "let me access this from another machine", "bash": "CLARIFY: Access which service (SSH, web app, file share), on which port, from where (LAN-only, internet)? I'll open the firewall and verify the service binds publicly.", "category": "clarify"}
{"nl": "fix firewall", "bash": "CLARIFY: Which firewall (ufw, firewalld, raw iptables)? And what's the symptom - blocking too much, allowing too much, not active? Share current rules.", "category": "clarify"}
{"nl": "see firewall rules", "bash": "CLARIFY: ufw ('sudo ufw status verbose'), firewalld ('sudo firewall-cmd --list-all'), or iptables ('sudo iptables -L -v -n')? Which is active on this host?", "category": "clarify"}
{"nl": "let port 443 through", "bash": "CLARIFY: Allow inbound TCP 443 (HTTPS) - via which firewall (ufw, firewalld, iptables)? From any source or specific subnet?", "category": "clarify"}
{"nl": "block icmp", "bash": "CLARIFY: All ICMP (breaks Path MTU Discovery), only echo requests (stops ping), inbound only, or both directions? Risky to block all.", "category": "clarify"}
{"nl": "see what's listening", "bash": "CLARIFY: Run 'ss -tlnp' - confirm you want TCP listeners with process names? Or also UDP (-u) and unconnected sockets (-a)?", "category": "clarify"}
{"nl": "allow ping from a friend", "bash": "CLARIFY: From which source IP (the friend's), and is ping currently blocked? Likely you need to allow ICMP echo-request from that IP in your firewall.", "category": "clarify"}
{"nl": "find what is blocking port", "bash": "CLARIFY: Which port number, and 'blocking' meaning - firewall is rejecting (check rules), nothing is listening (check ss -tlnp), or a process holding it?", "category": "clarify"}
{"nl": "set up a proxy", "bash": "CLARIFY: HTTP proxy (squid), SOCKS proxy (ssh -D, dante), reverse proxy (nginx)? And which port, which upstream, for what kind of traffic?", "category": "clarify"}
{"nl": "make my server reachable from internet", "bash": "CLARIFY: This requires - port forwarding on your router, allowing in this host's firewall, and the service listening on 0.0.0.0. Which service and port?", "category": "clarify"}
{"nl": "block this ip", "bash": "CLARIFY: Which IP address, in which direction (incoming, outgoing, both), and via which firewall (ufw, firewalld, iptables)?", "category": "clarify"}
{"nl": "trace the route", "bash": "CLARIFY: To which destination (hostname or IP)? I'll run 'traceroute DEST' or 'mtr DEST' - tell me which target.", "category": "clarify"}
{"nl": "the site is slow", "bash": "CLARIFY: Which site, and is it slow only from here? Try 'curl -w %{time_total} -o /dev/null -s https://SITE' to time it. Also: traceroute to see hops.", "category": "clarify"}
{"nl": "show wifi networks", "bash": "CLARIFY: Available networks ('nmcli dev wifi list' or 'iwlist scan'), or currently-connected info ('iw dev IFACE link')? Which interface (iw dev)?", "category": "clarify"}
{"nl": "connect to wifi", "bash": "CLARIFY: SSID and password please? I'll use 'nmcli dev wifi connect SSID password PASS' - confirm those are what you want to use.", "category": "clarify"}
{"nl": "forget the network", "bash": "CLARIFY: Which network name (run 'nmcli connection show')? I'll delete it - confirm the exact name.", "category": "clarify"}
{"nl": "change mac address", "bash": "CLARIFY: Which interface (ip link), and to what MAC address (specific value or random)? Permanent (via NetworkManager) or just this session ('ip link set IFACE address MAC')?", "category": "clarify"}
{"nl": "see what device is using ip", "bash": "CLARIFY: Which IP address? I'll run 'arp -a | grep IP' for local LAN, or 'ip neigh' for the neighbor table. Tell me the IP.", "category": "clarify"}
{"nl": "scan my network", "bash": "CLARIFY: What's the LAN subnet (run 'ip route | grep -v default')? I'll run 'nmap -sn SUBNET' for live hosts. Or do you want service discovery too?", "category": "clarify"}
{"nl": "send a wake on lan", "bash": "CLARIFY: To which MAC address, on which interface? I'll use 'wakeonlan MAC' or 'etherwake -i IFACE MAC'.", "category": "clarify"}
{"nl": "stop firewall", "bash": "CLARIFY: Disable ufw ('sudo ufw disable'), stop firewalld, or flush iptables? Disabling the firewall exposes the host - confirm this is intentional.", "category": "clarify"}
{"nl": "rate limit a port", "bash": "CLARIFY: Which port, what limit (e.g., 10/sec per source IP), and how to handle excess (drop, queue, log)? Tool - iptables hashlimit, nftables, or nginx?", "category": "clarify"}
{"nl": "set up vlan", "bash": "CLARIFY: Which interface, which VLAN ID (1-4094), and what IP/netmask for the VLAN? Configured via ip link, netplan, or NetworkManager?", "category": "clarify"}
{"nl": "make a bridge", "bash": "CLARIFY: Bridge which interfaces together (run 'ip link' for names)? And what for - VM networking, multiple ports as one? I'll set it up once I know the bridge members.", "category": "clarify"}
{"nl": "the gateway is unreachable", "bash": "CLARIFY: What's the current gateway ('ip route | grep default'), and is the LAN interface up ('ip link show')? Share the outputs.", "category": "clarify"}
{"nl": "fix dropped connections", "bash": "CLARIFY: Which service/protocol drops - SSH, HTTP, all? On which interface? Could be MTU, keepalive, firewall, or hardware - need more info.", "category": "clarify"}
{"nl": "make ssh listen on different port", "bash": "CLARIFY: Which port should sshd use (avoid <1024 unless special reason)? I'll edit /etc/ssh/sshd_config and update the firewall - confirm the new port.", "category": "clarify"}
{"nl": "expose docker to lan", "bash": "CLARIFY: Which container/service and which port should bind to 0.0.0.0 (or specific LAN IP)? And do you want the host firewall to permit it?", "category": "clarify"}
{"nl": "set up reverse proxy", "bash": "CLARIFY: From which external port to which internal service:port, on what domain (for TLS)? Tool - nginx, caddy, traefik?", "category": "clarify"}
{"nl": "block all ads", "bash": "CLARIFY: Network-wide via Pi-hole / AdGuard Home (recommended, blocks DNS), or per-browser via uBlock Origin? Each is a different approach.", "category": "clarify"}
{"nl": "force ipv4", "bash": "CLARIFY: For all apps system-wide, or one tool (e.g., 'curl -4', 'ping -4'). Disabling IPv6 system-wide may have side effects - what's the goal?", "category": "clarify"}
{"nl": "disable ipv6", "bash": "CLARIFY: System-wide (sysctl net.ipv6.conf.all.disable_ipv6=1, persisted via sysctl.d) or just one interface? And do you have a specific reason - some apps require IPv6.", "category": "clarify"}
{"nl": "check ssl cert", "bash": "CLARIFY: For which domain or local cert file? Remote: 'openssl s_client -connect HOST:443 -servername HOST'. Local file: 'openssl x509 -in PATH -text'.", "category": "clarify"}
{"nl": "renew the certificate", "bash": "CLARIFY: A Let's Encrypt cert (which domain - I'd use 'certbot renew' or specific cert), or another CA? Plus what web server (nginx, apache)?", "category": "clarify"}
{"nl": "is my port open", "bash": "CLARIFY: Open from where - from this host (ss -tlnp PORT shows what's listening) or open from the internet (use an external port checker)?", "category": "clarify"}
{"nl": "the api is down", "bash": "CLARIFY: Which API - a remote service (which URL?), or one you run here (which port, which service)? I'll test reachability and check status.", "category": "clarify"}
{"nl": "set up a static route", "bash": "CLARIFY: For which destination network, via which gateway, on which interface? I'll add it with 'ip route' and persist via NetworkManager/netplan.", "category": "clarify"}
{"nl": "remove default route", "bash": "CLARIFY: Disconnect from upstream? Or replace with a different default gateway? Removing without replacement loses internet on this host.", "category": "clarify"}
{"nl": "see arp table", "bash": "CLARIFY: 'ip neigh' (modern) or 'arp -a' (legacy) - both show MAC↔IP. Want me to run one, on a specific interface, or all?", "category": "clarify"}
{"nl": "fix the proxy settings", "bash": "CLARIFY: Where - shell env (http_proxy in ~/.bashrc), apt (/etc/apt/apt.conf.d/), system-wide via GNOME, or docker daemon? Each has its own location.", "category": "clarify"}
{"nl": "lock down ssh", "bash": "CLARIFY: Disable password auth (PasswordAuthentication no), disable root login (PermitRootLogin no), restrict allowed users (AllowUsers), change port - which?", "category": "clarify"}
{"nl": "open the database to network", "bash": "CLARIFY: This is risky. Which DB (postgres, mysql), bind to LAN IP or 0.0.0.0, and from which source IPs should connections be permitted (firewall)? Authentication strong?", "category": "clarify"}
{"nl": "see who is on ssh", "bash": "CLARIFY: Currently logged-in users (run 'who' or 'w'), or just failed/recent attempts (run 'last' or 'lastb')?", "category": "clarify"}
{"nl": "kick someone off ssh", "bash": "CLARIFY: Which user (from 'w')? Their SSH session has a PID - I'll kill that PID. Confirm user, and that it's safe to terminate their session.", "category": "clarify"}
{"nl": "ban an ip address", "bash": "CLARIFY: Permanently (iptables/ufw drop), or temporarily (fail2ban)? And from all ports or just one (e.g., SSH)?", "category": "clarify"}
{"nl": "set bandwidth limit", "bash": "CLARIFY: For which interface or which process, and what limit? Tool - tc (traffic control) on interface, or trickle for one app?", "category": "clarify"}
{"nl": "test if port reachable from outside", "bash": "CLARIFY: I can't directly test inbound from your side. I can use an external service like canyouseeme.org via curl, or you can run nmap from another host. Which port?", "category": "clarify"}
{"nl": "fix the dns server", "bash": "CLARIFY: A local DNS server (which - bind, dnsmasq, unbound, systemd-resolved, Pi-hole)? Or change which DNS your system uses to resolve? Different fixes.", "category": "clarify"}
{"nl": "make ping work", "bash": "CLARIFY: Outbound ping failing (to where?), or incoming ping blocked? Run 'ping 8.8.8.8' for the first case - share what you see.", "category": "clarify"}
{"nl": "see who pinged me", "bash": "CLARIFY: Live capture (tcpdump -i IFACE icmp) or from historical logs (kernel firewall log if you've enabled it)? Which interface?", "category": "clarify"}
{"nl": "let me access router", "bash": "CLARIFY: Open the router admin in a browser at its IP (run 'ip route | grep default')? Or SSH/telnet into it? Tell me the goal.", "category": "clarify"}
{"nl": "save my wifi config", "bash": "CLARIFY: Export NetworkManager connection (which one - 'nmcli connection show')? It's in /etc/NetworkManager/system-connections - need sudo to read.", "category": "clarify"}
{"nl": "fix slow ssh", "bash": "CLARIFY: Slow login (often DNS - try UseDNS no in sshd_config), or slow during session (network speed)? Share 'ssh -v HOST' output for triage.", "category": "clarify"}
{"nl": "set up ipv6", "bash": "CLARIFY: Auto-configured (SLAAC, usually default), or static IPv6 (need address, prefix, gateway)? And which interface?", "category": "clarify"}
{"nl": "block torrents", "bash": "CLARIFY: Block well-known BitTorrent ports? Note: torrents often use random ports, so port-blocking is unreliable. Deep packet inspection (e.g., l7-filter or a router with QoS) is more effective.", "category": "clarify"}
{"nl": "configure dhcp", "bash": "CLARIFY: As a client (default - most desktops/servers do this) or as a server (isc-dhcp-server)? If server, which interface, IP range, lease time?", "category": "clarify"}
{"nl": "see ssh keys", "bash": "CLARIFY: Your local keys (ls ~/.ssh), keys authorized for login (ssh ~/.ssh/authorized_keys on this host), or known_hosts (servers you've connected to)?", "category": "clarify"}
{"nl": "add ssh key for user", "bash": "CLARIFY: For which user (could be you or another local user), and where's the public key (file path, or paste the content)?", "category": "clarify"}
{"nl": "remove ssh key", "bash": "CLARIFY: Remove from where - your authorized_keys (key you granted access to), known_hosts (server you've connected to), or your private key (locally generated)?", "category": "clarify"}
{"nl": "fix mtu", "bash": "CLARIFY: For which interface (ip link), and what MTU value? Default 1500 is usual; lower for VPNs (~1420 for WireGuard). Why are you changing it - what's the symptom?", "category": "clarify"}
{"nl": "make my domain point here", "bash": "CLARIFY: DNS records live with your DNS provider, not on this host. Which domain, which provider (Cloudflare, Route53, GoDaddy)? You'd update an A record there.", "category": "clarify"}
{"nl": "see network speed real time", "bash": "CLARIFY: Per-interface bandwidth (iftop or 'ip -s link'), per-process (nethogs), or per-connection (cbm)? Which interface (ip link)?", "category": "clarify"}
{"nl": "make my pc act as router", "bash": "CLARIFY: Enable IP forwarding (sysctl net.ipv4.ip_forward=1), NAT for one interface, configure firewall rules? Which interfaces (WAN side and LAN side)?", "category": "clarify"}
{"nl": "set up dns over https", "bash": "CLARIFY: System-wide via systemd-resolved (set DNS=1.1.1.1#cloudflare-dns.com, DNSOverTLS=yes), or per-browser? Which DoH/DoT provider?", "category": "clarify"}
{"nl": "find rogue device on network", "bash": "CLARIFY: I'd scan with 'nmap -sn SUBNET' to list devices, then compare to your expected list. What's the LAN subnet (ip route | grep default)?", "category": "clarify"}
{"nl": "test ssh connection", "bash": "CLARIFY: To which host and port, and as which user? I'll run 'ssh -v USER@HOST -p PORT' to verbose-test - share the connection details.", "category": "clarify"}
{"nl": "see open udp ports", "bash": "CLARIFY: On this host? Run 'sudo ss -ulnp' - confirm. Or are you trying to scan a remote host's UDP ports (nmap -sU - which target)?", "category": "clarify"}
{"nl": "share my files on the network", "bash": "CLARIFY: Which folder, and via what protocol - Samba (for Windows interop), NFS (Unix-friendly), SFTP (over SSH)? Plus which users/hosts should access?", "category": "clarify"}
{"nl": "stop the dhcp", "bash": "CLARIFY: Stop a DHCP server you're running (which - isc-dhcp-server, dnsmasq)? Or set this client to static IP instead of DHCP? Which interface?", "category": "clarify"}
{"nl": "the connection keeps timing out", "bash": "CLARIFY: Which connection - to which host/port, from what software? Share the exact error or symptom, plus 'ping HOST' and 'traceroute HOST' for triage.", "category": "clarify"}
{"nl": "configure 5ghz wifi", "bash": "CLARIFY: This is configured on the access point/router, not this host. If your host has a 5GHz-capable card and the SSID is broadcast, it should connect normally - which is the issue?", "category": "clarify"}
{"nl": "wifi password change", "bash": "CLARIFY: Change the password for connecting to a network (via 'nmcli connection modify NAME wifi-sec.psk PASS'), or change the AP's password (done on the router)?", "category": "clarify"}
{"nl": "make me anonymous", "bash": "CLARIFY: 'Anonymous' is broad. Are you trying to route through Tor (which package - torsocks for a single command, the Tor Browser, or full system Tor)?", "category": "clarify"}
{"nl": "check the logs", "bash": "CLARIFY: Which logs - system journal (journalctl), a specific service's logs (journalctl -u SERVICE), or an application log file (which path)?", "category": "clarify"}
{"nl": "clear the logs", "bash": "CLARIFY: Vacuum the journal (journalctl --vacuum-size=100M or --vacuum-time=2weeks), or truncate a specific log file? Which target?", "category": "clarify"}
{"nl": "find the errors", "bash": "CLARIFY: In which logs - system journal (journalctl -p err), a specific service, or an application file? And from which time range (last hour, today, this week)?", "category": "clarify"}
{"nl": "show me what happened", "bash": "CLARIFY: What happened when, and where - boot logs ('journalctl -b'), recent system errors, a specific service's history, login attempts ('last')? Tell me the symptom.", "category": "clarify"}
{"nl": "see today's logs", "bash": "CLARIFY: All system logs since midnight ('journalctl --since today'), or a specific service ('journalctl -u SERVICE --since today')?", "category": "clarify"}
{"nl": "show errors from last hour", "bash": "CLARIFY: System-wide ('journalctl -p err --since=-1h'), or just one service ('journalctl -u SERVICE -p err --since=-1h')?", "category": "clarify"}
{"nl": "see the latest log entries", "bash": "CLARIFY: For which service or file? E.g., 'journalctl -u SERVICE -f' tails one service, 'tail -f FILE' tails a file. Tell me which.", "category": "clarify"}
{"nl": "search the logs for error", "bash": "CLARIFY: Search where - journalctl ('journalctl | grep -i error'), or a specific file ('grep -i error /var/log/FILE')? Which?", "category": "clarify"}
{"nl": "tail the log", "bash": "CLARIFY: Which log file or journal? E.g., 'tail -f /var/log/syslog' for syslog, or 'journalctl -fu SERVICE' for a service.", "category": "clarify"}
{"nl": "clear apache logs", "bash": "CLARIFY: Truncate the current logs (sudo truncate -s 0 /var/log/apache2/access.log /var/log/apache2/error.log) and reload apache? Or wait for logrotate? Different effect.", "category": "clarify"}
{"nl": "see nginx errors", "bash": "CLARIFY: From access logs (status codes >=400 in /var/log/nginx/access.log) or error log (/var/log/nginx/error.log)? And what time window?", "category": "clarify"}
{"nl": "see what crashed", "bash": "CLARIFY: System crashes ('journalctl -p err -b' for current boot), specific service crash ('systemctl status SERVICE'), or app crash with coredump ('coredumpctl list')?", "category": "clarify"}
{"nl": "see kernel messages", "bash": "CLARIFY: All since boot ('dmesg' or 'journalctl -k'), only errors ('dmesg --level=err'), or live tail ('dmesg -w')?", "category": "clarify"}
{"nl": "find login attempts", "bash": "CLARIFY: Successful logins ('last'), failed attempts ('lastb' - needs sudo), or SSH-specific ('journalctl -u ssh' or 'grep sshd /var/log/auth.log')?", "category": "clarify"}
{"nl": "see audit logs", "bash": "CLARIFY: Is auditd installed and running? 'ausearch -k KEYWORD' or 'aureport'. What event are you looking for - file access, system calls, user actions?", "category": "clarify"}
{"nl": "see who logged in", "bash": "CLARIFY: Currently logged in ('who'), or historical logins ('last -n 50')? And just SSH or also local console?", "category": "clarify"}
{"nl": "make logs smaller", "bash": "CLARIFY: Cap journal size ('journalctl --vacuum-size=200M' now, plus 'SystemMaxUse=200M' in /etc/systemd/journald.conf), or rotate app logs (logrotate config)?", "category": "clarify"}
{"nl": "delete the old logs", "bash": "CLARIFY: Journal entries older than N days ('journalctl --vacuum-time=30d'), or rotated archive files in /var/log? How old should they be?", "category": "clarify"}
{"nl": "stream logs live", "bash": "CLARIFY: From which source - 'journalctl -f' (all), 'journalctl -fu SERVICE' (one service), or 'tail -f FILE' (specific file)?", "category": "clarify"}
{"nl": "show logs since reboot", "bash": "CLARIFY: 'journalctl -b' for all logs since the current boot - confirm? Or for a previous boot ('journalctl -b -1' for the prior boot)?", "category": "clarify"}
{"nl": "save logs to a file", "bash": "CLARIFY: Which logs to export, and to which file? E.g., 'journalctl -u SERVICE > /tmp/service.log' or 'journalctl --since=today > /tmp/today.log'. Confirm scope.", "category": "clarify"}
{"nl": "see ssh failed logins", "bash": "CLARIFY: Recent ones ('sudo grep \"Failed password\" /var/log/auth.log | tail -50') or via journalctl ('sudo journalctl -u ssh | grep -i fail')? Confirm range.", "category": "clarify"}
{"nl": "find what happened at 3pm", "bash": "CLARIFY: Today at 3pm? I'll use 'journalctl --since=\"15:00\" --until=\"15:30\"' - confirm the time window and any service filter.", "category": "clarify"}
{"nl": "see disk errors", "bash": "CLARIFY: In dmesg ('dmesg | grep -i -E \"error|fail|i/o\"') or SMART logs ('sudo smartctl -l error /dev/sdX')? Which device if SMART?", "category": "clarify"}
{"nl": "log to a different file", "bash": "CLARIFY: For which service - I'd edit its config to redirect output, or use systemd's StandardOutput=file:/path. Tell me the service and target file.", "category": "clarify"}
{"nl": "find oom killer events", "bash": "CLARIFY: I'll search dmesg / journal: 'dmesg | grep -i oom' and 'journalctl | grep -i \"killed process\"'. Confirm window (current boot, all time).", "category": "clarify"}
{"nl": "rotate logs now", "bash": "CLARIFY: Force a logrotate run ('sudo logrotate -f /etc/logrotate.conf'), or for one specific service? Confirm the scope.", "category": "clarify"}
{"nl": "see what app wrote to log", "bash": "CLARIFY: Which log file, and what app? Often the log has the program in the syslog tag. Share a few lines or the path - we'll go from there.", "category": "clarify"}
{"nl": "make logs not fill disk", "bash": "CLARIFY: Cap journal usage (SystemMaxUse in journald.conf), set up logrotate for app logs (which app?), or both? What's the current usage ('journalctl --disk-usage')?", "category": "clarify"}
{"nl": "follow service log", "bash": "CLARIFY: Which service? Run 'journalctl -fu SERVICE_NAME' - share the unit name.", "category": "clarify"}
{"nl": "filter logs by user", "bash": "CLARIFY: Which user, and which journal scope? 'journalctl _UID=$(id -u USER)' shows that user's processes. Confirm username.", "category": "clarify"}
{"nl": "see what changed in the system", "bash": "CLARIFY: Recent apt install/upgrade ('grep -i install /var/log/apt/history.log'), or files changed ('find PATH -mtime -1')? Different views.", "category": "clarify"}
{"nl": "investigate the slowness", "bash": "CLARIFY: When did the slowness start? I'll look at journal around that time, check load ('uptime'), I/O ('iostat'), or CPU ('top'). Tell me when and which subsystem feels slow.", "category": "clarify"}
{"nl": "see boot errors", "bash": "CLARIFY: All errors during current boot ('journalctl -b -p err'), or for the last boot ('journalctl -b -1 -p err')?", "category": "clarify"}
{"nl": "see what services failed last boot", "bash": "CLARIFY: Failed during current boot ('systemctl --failed') or in the previous boot ('journalctl -b -1 -p err -u \"*\"')?", "category": "clarify"}
{"nl": "show me the last error", "bash": "CLARIFY: Last error from which scope - journal ('journalctl -p err -n 1'), a specific service ('journalctl -u NAME -p err -n 1'), or a file?", "category": "clarify"}
{"nl": "log my commands", "bash": "CLARIFY: Bash history is already kept (~/.bash_history). Do you want richer logging - timestamps (HISTTIMEFORMAT), auditd, or 'script' to record a session?", "category": "clarify"}
{"nl": "see what's in the journal", "bash": "CLARIFY: All entries ('journalctl' - lots), recent ('journalctl -n 200'), or by service/priority? Tell me what you're looking for.", "category": "clarify"}
{"nl": "see logs from yesterday", "bash": "CLARIFY: All system logs from yesterday ('journalctl --since yesterday --until today'), or one service ('journalctl -u SERVICE --since yesterday')?", "category": "clarify"}
{"nl": "see only critical errors", "bash": "CLARIFY: System-wide critical and above ('journalctl -p crit'), or just one service? Plus time range (recent, today, current boot)?", "category": "clarify"}
{"nl": "save error logs", "bash": "CLARIFY: Which errors - system journal critical ('journalctl -p err -b > /tmp/errors.txt'), or a specific app's log? Confirm source and destination.", "category": "clarify"}
{"nl": "watch a log file", "bash": "CLARIFY: Which file path? I'll use 'tail -f FILE'. If it might rotate, prefer 'tail -F FILE' to follow renames.", "category": "clarify"}
{"nl": "show systemd unit logs", "bash": "CLARIFY: Which unit (service name)? 'journalctl -u UNIT' - tell me the unit name (you can list with 'systemctl list-units').", "category": "clarify"}
{"nl": "see my command history", "bash": "CLARIFY: Just 'history' shows your shell history. Want all entries, last N, or grep for a keyword? E.g., 'history | grep KEYWORD'.", "category": "clarify"}
{"nl": "search command history", "bash": "CLARIFY: What keyword? I'll run 'history | grep KEYWORD' - tell me the keyword.", "category": "clarify"}
{"nl": "find error messages", "bash": "CLARIFY: In journal ('journalctl -p err'), in a specific log file (which path), or via grep across /var/log (be careful, large)?", "category": "clarify"}
{"nl": "log to syslog", "bash": "CLARIFY: From which application or script? In bash you can use 'logger MESSAGE' to send to syslog. Tell me the source.", "category": "clarify"}
{"nl": "see app crashes", "bash": "CLARIFY: From coredumps ('coredumpctl list'), or from journal entries with SIGSEGV ('journalctl | grep -i segfault')? Which scope?", "category": "clarify"}
{"nl": "stop logging so much", "bash": "CLARIFY: Reduce log verbosity for a service (which one?) or reduce overall journal storage? Each has a different mechanism.", "category": "clarify"}
{"nl": "see all warnings", "bash": "CLARIFY: System-wide ('journalctl -p warning'), or just current boot ('journalctl -b -p warning')? Or one service?", "category": "clarify"}
{"nl": "see all the events", "bash": "CLARIFY: 'Events' meaning - journal entries, audit events (auditd), or specific app events? Tell me which event source.", "category": "clarify"}
{"nl": "logs are too verbose", "bash": "CLARIFY: For which service or file? I can suggest reducing log_level in the service's config - tell me which.", "category": "clarify"}
{"nl": "see authentication logs", "bash": "CLARIFY: Recent auth events ('sudo journalctl -u sshd' or 'sudo cat /var/log/auth.log'), failed only ('lastb'), or successful ('last')?", "category": "clarify"}
{"nl": "see logs from boot", "bash": "CLARIFY: Current boot ('journalctl -b') or previous boot ('journalctl -b -1')? And the whole thing, just errors, or one service?", "category": "clarify"}
{"nl": "logs say service failed", "bash": "CLARIFY: Which service is failing? Share 'systemctl status SERVICE' and 'journalctl -u SERVICE -n 100' so I can see the actual error.", "category": "clarify"}
{"nl": "find the warning", "bash": "CLARIFY: Which warning, where? Sharing the exact text or which service would let me narrow the search via 'journalctl | grep'.", "category": "clarify"}
{"nl": "log everything from now", "bash": "CLARIFY: For your current shell session, 'script /tmp/session.log' records everything. For system-wide, you'd need auditd or to bump journal verbosity. Which is the goal?", "category": "clarify"}
{"nl": "find what wrote this log entry", "bash": "CLARIFY: Paste a sample log line so I can identify the unit/process. The journal records the source (_COMM, _SYSTEMD_UNIT) - I can match it.", "category": "clarify"}
{"nl": "see access logs", "bash": "CLARIFY: For which service - nginx (/var/log/nginx/access.log), apache (/var/log/apache2/access.log), or another? And what filter (errors only, specific IP)?", "category": "clarify"}
{"nl": "see what gets logged on shutdown", "bash": "CLARIFY: Last boot's shutdown messages ('journalctl -b -1 -e' shows end of previous boot), or live capture next time you shutdown ('journalctl -f' before halt)?", "category": "clarify"}
{"nl": "find database errors", "bash": "CLARIFY: Which database (postgres /var/log/postgresql, mysql /var/log/mysql, mongodb /var/log/mongodb)? And by error pattern - connection refused, syntax, timeout?", "category": "clarify"}
{"nl": "see what happened before reboot", "bash": "CLARIFY: 'journalctl -b -1' shows the previous boot's full log; '-e' jumps to the end (last events before that reboot). Confirm you want the prior boot.", "category": "clarify"}
{"nl": "clear journalctl", "bash": "CLARIFY: 'journalctl --vacuum-time=1s' wipes nearly everything - confirm you want that, or do you want to keep a specific window (e.g., last day)?", "category": "clarify"}
{"nl": "see security events", "bash": "CLARIFY: From auditd (if installed), AppArmor denials ('journalctl | grep apparmor'), SELinux (if enforcing), or PAM auth events? Which kind?", "category": "clarify"}
{"nl": "logs for last hour", "bash": "CLARIFY: All journal entries ('journalctl --since=-1h'), or a specific service ('journalctl -u SERVICE --since=-1h')?", "category": "clarify"}
{"nl": "find slow queries", "bash": "CLARIFY: Which database? Postgres has log_min_duration_statement, MySQL has slow query log. Need to enable that and check the corresponding log file - confirm DB.", "category": "clarify"}
{"nl": "log to a remote server", "bash": "CLARIFY: Forward journald to a remote (systemd-journal-remote), use rsyslog to a syslog server, or ship with a different agent (vector, fluent-bit)? Where to?", "category": "clarify"}
{"nl": "see ufw log", "bash": "CLARIFY: Where ufw logs to - /var/log/ufw.log (if separate logging enabled), or in /var/log/syslog. Are you looking for blocked traffic only? Confirm.", "category": "clarify"}
{"nl": "see what mail logs", "bash": "CLARIFY: Postfix? /var/log/mail.log and /var/log/mail.err. Or another MTA (exim, sendmail)? Confirm.", "category": "clarify"}
{"nl": "see firewall blocks", "bash": "CLARIFY: ufw blocks go to /var/log/ufw.log (with LOGGING on). For iptables, you'd add a LOG rule. Which firewall, and is logging enabled?", "category": "clarify"}
{"nl": "see who used sudo", "bash": "CLARIFY: From /var/log/auth.log ('sudo grep sudo /var/log/auth.log') or journal ('sudo journalctl | grep sudo')? Filter by user?", "category": "clarify"}
{"nl": "log apt activity", "bash": "CLARIFY: It already does, in /var/log/apt/history.log and term.log. What action are you looking for - installs, removes, upgrades on a date?", "category": "clarify"}
{"nl": "find package install history", "bash": "CLARIFY: Just installs (grep ' install ' /var/log/apt/history.log), or full history with date range? Want package names only or full lines?", "category": "clarify"}
{"nl": "see container logs", "bash": "CLARIFY: Which container ('docker ps -a' to list)? 'docker logs NAME' or 'docker compose logs SERVICE'. And how much - last 100 lines, follow live?", "category": "clarify"}
{"nl": "log nginx requests", "bash": "CLARIFY: Nginx already writes access.log by default. Do you need a custom format, separate log per vhost, or to disable logging for specific paths?", "category": "clarify"}
{"nl": "back it up", "bash": "CLARIFY: Back up what (which folder or file), to where (which destination), and how (a one-time tar archive, a sync via rsync, or scheduled with restic/borg)?", "category": "clarify"}
{"nl": "restore the file", "bash": "CLARIFY: Which file (path), and from which backup source - a local archive, an external drive, a cloud backup? Tell me both.", "category": "clarify"}
{"nl": "make a copy", "bash": "CLARIFY: A copy of what (file or folder path), and where should the copy be placed? Also: should it preserve permissions and timestamps?", "category": "clarify"}
{"nl": "recover the data", "bash": "CLARIFY: Where was the data, and what happened - deleted file (try ext4-undelete/extundelete), bad disk (need ddrescue first), or accidentally overwritten? Each is a different recovery path.", "category": "clarify"}
{"nl": "save my files", "bash": "CLARIFY: Save which files to where? E.g., 'tar czf ~/backup.tar.gz ~/Documents' or 'rsync -av ~/Documents/ /mnt/external/'. Tell me source and destination.", "category": "clarify"}
{"nl": "incremental backup", "bash": "CLARIFY: Of which folder, to where, with which tool - restic, borg, rsnapshot, rsync with --link-dest? Each has different setup.", "category": "clarify"}
{"nl": "restore from yesterday", "bash": "CLARIFY: Restore from which backup tool (restic, borg, timeshift, manual snapshot)? And restore which files - all of yesterday's backup, or specific files?", "category": "clarify"}
{"nl": "make a backup before i upgrade", "bash": "CLARIFY: A simple home folder backup (tar to external), a system snapshot (Timeshift), or full system image (Clonezilla, dd)? Where is the destination?", "category": "clarify"}
{"nl": "restore the deleted file", "bash": "CLARIFY: From the trash (~/.local/share/Trash/files), from a backup (which - share path/tool), or attempt undelete on the filesystem (risky, depends on FS type)?", "category": "clarify"}
{"nl": "schedule daily backup", "bash": "CLARIFY: Of which folder, to where, at what time? I'll create a cron entry or systemd timer - I need source path, destination, and schedule.", "category": "clarify"}
{"nl": "duplicate this folder", "bash": "CLARIFY: Which source folder, and what's the destination - a sibling folder ('cp -r SRC SRC.copy') or somewhere else?", "category": "clarify"}
{"nl": "backup my mysql database", "bash": "CLARIFY: Which database name (or all with --all-databases), and where to write the dump (file path)? Also: which user with which auth?", "category": "clarify"}
{"nl": "backup postgres", "bash": "CLARIFY: Which database name (or all with pg_dumpall), as which user (typically postgres), and where to write the dump?", "category": "clarify"}
{"nl": "restore the mysql dump", "bash": "CLARIFY: Which dump file (path), into which database (name), and as which user? I'll run 'mysql -u USER DB < FILE'.", "category": "clarify"}
{"nl": "restore postgres backup", "bash": "CLARIFY: Was the dump made with pg_dump (plain SQL or custom) or pg_dumpall? And which DB to restore into, as which user?", "category": "clarify"}
{"nl": "back up to s3", "bash": "CLARIFY: Which folder, to which S3 bucket, with what tool - aws-cli ('aws s3 sync'), rclone, restic with S3 backend? And are credentials configured?", "category": "clarify"}
{"nl": "set up restic", "bash": "CLARIFY: For backing up which folder, to which repository (local path, B2, S3, SFTP)? I'll initialize the repo - confirm location and choose a password.", "category": "clarify"}
{"nl": "back up emails", "bash": "CLARIFY: Where do the emails live - Thunderbird profile (~/.thunderbird), Maildir (~/Maildir), Mbox files, or via IMAP from a server? Each is backed up differently.", "category": "clarify"}
{"nl": "copy my home to external", "bash": "CLARIFY: Which external drive (lsblk to identify), and a one-time copy ('rsync -aP ~/ /mnt/external/home/') or scheduled? Confirm mount point.", "category": "clarify"}
{"nl": "set up automatic snapshots", "bash": "CLARIFY: For which filesystem - LVM, btrfs, ZFS each have their own snapshot mechanisms. Plus interval (hourly, daily) and retention?", "category": "clarify"}
{"nl": "back up to dropbox", "bash": "CLARIFY: Which folder, and do you have the Dropbox client installed and signed in (which user)? Or do you want a one-off upload via rclone?", "category": "clarify"}
{"nl": "back up to google drive", "bash": "CLARIFY: Which folder, and use which tool - rclone with a configured Google Drive remote, or the official drive sync? Is rclone already set up?", "category": "clarify"}
{"nl": "save my settings", "bash": "CLARIFY: Which settings - ~/.config (most apps), ~/.bashrc, /etc files? I'll archive whichever you specify. Confirm path(s).", "category": "clarify"}
{"nl": "make a backup of my project", "bash": "CLARIFY: Which project folder (path), and to where (tar archive in ~/backups, external drive, git repo)? Tell me both.", "category": "clarify"}
{"nl": "recover deleted folder", "bash": "CLARIFY: When was it deleted, on which filesystem (ext4, btrfs, NTFS), and have you written anything to that disk since? Recovery is hit-or-miss after writes.", "category": "clarify"}
{"nl": "back up daily at 2am", "bash": "CLARIFY: What to back up (path), to where (path or remote), with which tool (rsync, restic, tar)? I'll add a cron entry once those are clear.", "category": "clarify"}
{"nl": "exclude some files from backup", "bash": "CLARIFY: Which backup tool are you using, and which files/patterns to exclude (e.g., node_modules, .cache, .git)? Tools have different exclude syntax.", "category": "clarify"}
{"nl": "check that backup worked", "bash": "CLARIFY: Which tool, and which backup destination? For restic: 'restic check'. For rsync: compare with 'diff -r' or 'rsync -n'. Tell me the tool.", "category": "clarify"}
{"nl": "back up etc", "bash": "CLARIFY: Which destination, and recursively as root ('sudo tar czf /backup/etc.tar.gz /etc')? Confirm output path and that you want all of /etc.", "category": "clarify"}
{"nl": "image the disk", "bash": "CLARIFY: Which device (lsblk), to which destination (file or another device), and which tool - dd (raw bit copy, slow), ddrescue (resilient), or partclone (filesystem-aware)?", "category": "clarify"}
{"nl": "back up before formatting", "bash": "CLARIFY: From which device, and to where? Be sure the destination has enough space - confirm size with 'lsblk' and 'df -h'. What's source and destination?", "category": "clarify"}
{"nl": "restore from snapshot", "bash": "CLARIFY: Which kind of snapshot (LVM, btrfs subvolume, Timeshift), and restore what - the whole subvolume, or specific files from within?", "category": "clarify"}
{"nl": "back up specific files only", "bash": "CLARIFY: Which files (give me the list or a pattern), and where to back up to? I'll use rsync or tar with appropriate filters.", "category": "clarify"}
{"nl": "make backup smaller", "bash": "CLARIFY: For which tool - enable compression (tar.gz/xz), deduplicate (restic/borg do this), or exclude noise (node_modules, caches)? Which already exists?", "category": "clarify"}
{"nl": "version my config files", "bash": "CLARIFY: Initialize a git repo in /etc (etckeeper does this nicely), or just for a specific config folder (e.g., ~/.config)? Which path?", "category": "clarify"}
{"nl": "back up to nfs", "bash": "CLARIFY: Which NFS server and export, mounted to which local path? Once mounted, you can rsync to it. Are the mount details set up?", "category": "clarify"}
{"nl": "back up vm", "bash": "CLARIFY: Which VM (libvirt, VirtualBox, VMware), running or stopped? Snapshot (live), export OVA, or just back up the disk image file ('virsh dumpxml + cp')?", "category": "clarify"}
{"nl": "duplicate the file with timestamp", "bash": "CLARIFY: Which file, and what's the timestamp format you want (e.g., file.txt.20260528, file.txt.bak.2026-05-28T15:00)?", "category": "clarify"}
{"nl": "back up old data and delete", "bash": "CLARIFY: From which folder, what's 'old' (e.g., older than 30 days), where should the archive go, and confirm: delete originals after successful archive?", "category": "clarify"}
{"nl": "back up only modified files", "bash": "CLARIFY: Modified since when (since last backup, today, a specific date)? I can use 'find PATH -newer REFERENCE' or rely on rsync's delta logic. Tell me criteria.", "category": "clarify"}
{"nl": "restore a single file from backup", "bash": "CLARIFY: From which backup (path to archive, restic repo, etc), and which file (path inside the backup)? And restore to where?", "category": "clarify"}
{"nl": "set up borg backup", "bash": "CLARIFY: To back up which folder(s), to which repo (local /backup or remote SSH user@host:/path)? I'll init the repo and create the first archive.", "category": "clarify"}
{"nl": "make encrypted backup", "bash": "CLARIFY: Which folder, with which tool (restic and borg encrypt by default - the choice of password matters)? Where to store it?", "category": "clarify"}
{"nl": "verify backup integrity", "bash": "CLARIFY: For restic ('restic check --read-data'), borg ('borg check'), rsync (re-run with --dry-run --checksum), or tar (test extraction)? Which tool?", "category": "clarify"}
{"nl": "back up etc and home", "bash": "CLARIFY: To which destination, and as a single archive or two? Plus, /etc requires sudo - confirm you want both: 'sudo tar czf BACKUP.tar.gz /etc /home/$USER'.", "category": "clarify"}
{"nl": "rsync to another machine", "bash": "CLARIFY: From which local path, to which remote (user@host:/path)? And one-way mirror (--delete on dest) or just additive sync? SSH keys set up?", "category": "clarify"}
{"nl": "save changes to a file", "bash": "CLARIFY: Which file, and 'save changes' - did you mean copy to a backup name (file.bak), commit to git, or actually save in an editor (Ctrl+S in the app)?", "category": "clarify"}
{"nl": "create a snapshot before changes", "bash": "CLARIFY: Of what scope - one folder (tar), an LVM volume (lvcreate -s), a btrfs subvolume, a full Timeshift snapshot? Confirm.", "category": "clarify"}
{"nl": "back up only this week's work", "bash": "CLARIFY: From which folder, and 'this week' meaning since which date? I'll use 'find PATH -newermt DATE' to filter. Tell me the path and start date.", "category": "clarify"}
{"nl": "compare backup to original", "bash": "CLARIFY: Source folder and backup folder paths? 'diff -r SOURCE BACKUP' or 'rsync -anc --dry-run SOURCE/ BACKUP/' will both compare. Which two paths?", "category": "clarify"}
{"nl": "save the database state", "bash": "CLARIFY: Which database (Postgres, MySQL, SQLite, MongoDB), which DB name, and where to write the dump? Also: which user/credential?", "category": "clarify"}
{"nl": "restore home from backup", "bash": "CLARIFY: From which backup source (path/tool), and overwrite existing files or restore only missing ones? Be careful - overwriting can destroy newer changes.", "category": "clarify"}
{"nl": "back up before deleting", "bash": "CLARIFY: Which files/folder are you about to delete, and where should the backup go? I'll copy them first so we can restore if needed.", "category": "clarify"}
{"nl": "version control my dotfiles", "bash": "CLARIFY: Use a tool like chezmoi/yadm, or a plain bare-git repo pointing at $HOME? Which dotfiles to start with (list a few paths)?", "category": "clarify"}
{"nl": "copy a directory to another disk", "bash": "CLARIFY: Source folder and destination disk (mount point - 'lsblk' to see mounts)? I'll use 'rsync -aHAX SRC/ DEST/' to preserve permissions and ACLs.", "category": "clarify"}
{"nl": "back up only photos", "bash": "CLARIFY: From which folder, and how to identify 'photos' - by extension (jpg, png, heic, raw), or by location (~/Pictures)? Destination?", "category": "clarify"}
{"nl": "save the config so i can revert", "bash": "CLARIFY: Which config file or folder? Easiest is 'sudo cp FILE FILE.bak' before changing. Tell me the path.", "category": "clarify"}
{"nl": "make backup app run faster", "bash": "CLARIFY: Which tool - rsync (try --inplace, increase --bwlimit), restic (more cores, smaller chunks), tar with parallel xz? Plus what's the bottleneck (CPU, I/O, network)?", "category": "clarify"}
{"nl": "back up the keys", "bash": "CLARIFY: Which keys - SSH (~/.ssh), GPG (~/.gnupg), age, application API keys? Each lives in a different place and may need decryption.", "category": "clarify"}
{"nl": "restore one folder from tar", "bash": "CLARIFY: Which tar archive (path) and which folder inside it (e.g., 'home/aditya/Documents/')? I'll use 'tar xzf ARCHIVE FOLDER/'.", "category": "clarify"}
{"nl": "back up with rsync excluding caches", "bash": "CLARIFY: Source and destination paths, and 'caches' meaning - .cache, node_modules, __pycache__? I'll add the right --exclude flags. Confirm patterns.", "category": "clarify"}
{"nl": "compress backup", "bash": "CLARIFY: Compress an existing folder ('tar czf ARCHIVE.tar.gz FOLDER'), or change a backup tool's compression? Which input and output?", "category": "clarify"}
{"nl": "rotate backups", "bash": "CLARIFY: For which backup tool - I'd set retention policy (restic 'forget --keep-daily 7 --keep-weekly 4', borg --keep-...). Tell me tool and retention.", "category": "clarify"}
{"nl": "back up over ssh", "bash": "CLARIFY: From which local path, to user@host:/path? Tool: 'rsync -aP SRC/ user@host:/path/' or 'borg create user@host:repo::name SRC'? SSH key set up?", "category": "clarify"}
{"nl": "make backup smaller and faster", "bash": "CLARIFY: Switch to deduplicating tool (restic/borg), exclude noise, or increase compression? What's your current tool and bottleneck?", "category": "clarify"}
{"nl": "back up before reinstall", "bash": "CLARIFY: Back up what scope - just /home, also /etc and package list (dpkg --get-selections), entire disk image? Plus where to (external drive, network)?", "category": "clarify"}
{"nl": "restore wifi passwords from backup", "bash": "CLARIFY: NetworkManager keeps them in /etc/NetworkManager/system-connections/. If you backed that up, restore those files (as root) and reload NetworkManager. Was that in the backup?", "category": "clarify"}
{"nl": "back up my browser data", "bash": "CLARIFY: Which browser (Firefox ~/.mozilla, Chrome ~/.config/google-chrome, Brave, etc.), and which profile? I'll archive the profile directory.", "category": "clarify"}
{"nl": "make backup before reboot", "bash": "CLARIFY: A quick backup of what to where - /etc to /backup/etc-$(date)? Or /home? Confirm the source(s) and destination.", "category": "clarify"}
{"nl": "back up only files newer than", "bash": "CLARIFY: Newer than what date or what reference file? E.g., 'find PATH -newermt 2026-05-20' or 'find PATH -newer REFFILE'. Tell me criteria and destination.", "category": "clarify"}
{"nl": "set up offsite backup", "bash": "CLARIFY: Where is 'offsite' - cloud (S3, B2), a remote SSH server you control, a NAS at another location? Tool (rclone, restic, borg)?", "category": "clarify"}
{"nl": "back up to tape", "bash": "CLARIFY: Tape drive device path (e.g., /dev/nst0), which tool (tar, dar, mt)? Tapes need explicit positioning - which folder to write?", "category": "clarify"}
{"nl": "back up after a change", "bash": "CLARIFY: Trigger backup how - on file change (inotifywait), git pre-commit hook, manual? And what to back up where?", "category": "clarify"}
{"nl": "create incremental tar", "bash": "CLARIFY: For which folder, and where's the previous snapshot file (-g flag)? Plus where to write the new archive? I'll use 'tar --listed-incremental'.", "category": "clarify"}
{"nl": "verify backup is restorable", "bash": "CLARIFY: For which backup - I can test-extract a tar ('tar tzf ARCHIVE'), run 'restic check', or actually restore to a temp dir. Which approach and which backup?", "category": "clarify"}
{"nl": "change the settings", "bash": "CLARIFY: Which application's settings, and what should change? Tell me the app and the value(s) to update.", "category": "clarify"}
{"nl": "update the config", "bash": "CLARIFY: Which config file (give me the path), and what change? E.g., setting a value, adding a line, replacing a block?", "category": "clarify"}
{"nl": "fix the configuration", "bash": "CLARIFY: Which application or service has the broken config, and what's the symptom or error message? Share what you have and the goal state.", "category": "clarify"}
{"nl": "edit the system config", "bash": "CLARIFY: Which config - /etc/sysctl.conf (kernel params), /etc/fstab (mounts), /etc/hosts (name resolution), a specific service? Tell me which file and which setting.", "category": "clarify"}
{"nl": "set environment variable", "bash": "CLARIFY: Which variable and value, and what scope - just current shell ('export VAR=VAL'), your user permanently (~/.bashrc), or system-wide (/etc/environment)?", "category": "clarify"}
{"nl": "change the default", "bash": "CLARIFY: Default for what - default editor (EDITOR env), default shell (chsh), default browser (xdg-settings), default printer (lpadmin -d)? Be specific.", "category": "clarify"}
{"nl": "make this the default editor", "bash": "CLARIFY: Default editor for which user, and which editor (nano, vim, code, nvim)? I'll set EDITOR / VISUAL in your shell rc - confirm shell (bash, zsh).", "category": "clarify"}
{"nl": "set the timezone", "bash": "CLARIFY: To which timezone (e.g., America/Los_Angeles, Europe/London, UTC)? I'll run 'sudo timedatectl set-timezone TZ' - share the IANA name.", "category": "clarify"}
{"nl": "set the locale", "bash": "CLARIFY: Which locale (en_US.UTF-8, en_GB.UTF-8, fr_FR.UTF-8)? System-wide (via 'sudo update-locale') or just your user (~/.profile)?", "category": "clarify"}
{"nl": "change kernel parameter", "bash": "CLARIFY: Which sysctl key and value (e.g., 'net.ipv4.ip_forward=1')? Just this boot ('sysctl -w') or persisted ('/etc/sysctl.d/99-custom.conf')?", "category": "clarify"}
{"nl": "fix the nginx config", "bash": "CLARIFY: What's wrong - share 'sudo nginx -t' output. Common issues: server_name conflict, missing semicolon, wrong root path. Which config file (path) and error?", "category": "clarify"}
{"nl": "edit the apache config", "bash": "CLARIFY: Main config (/etc/apache2/apache2.conf) or a site (/etc/apache2/sites-available/)? And which directive needs change?", "category": "clarify"}
{"nl": "change ssh config", "bash": "CLARIFY: Server-side (/etc/ssh/sshd_config - then reload sshd) or client-side (~/.ssh/config)? And which setting (Port, PermitRootLogin, etc.)?", "category": "clarify"}
{"nl": "fix the systemd unit", "bash": "CLARIFY: Which unit (full name like nginx.service), and what change? Edit via 'sudo systemctl edit UNIT' to create overrides, or modify the unit file directly?", "category": "clarify"}
{"nl": "change my prompt", "bash": "CLARIFY: For which shell (bash uses PS1, zsh uses PROMPT). Persist in ~/.bashrc / ~/.zshrc. What should the prompt show - user, host, path, git branch?", "category": "clarify"}
{"nl": "change the theme", "bash": "CLARIFY: Which environment - GNOME (gsettings), KDE (lookandfeeltool), terminal (.config or prompt), VS Code? And which theme?", "category": "clarify"}
{"nl": "set startup commands", "bash": "CLARIFY: For your shell (~/.bashrc, ~/.profile), at system boot (systemd service, /etc/rc.local on older systems), or at desktop login (~/.config/autostart)?", "category": "clarify"}
{"nl": "configure swap behavior", "bash": "CLARIFY: 'sysctl vm.swappiness' - lower means use swap less (10 for SSDs, 60 default). Set permanently in /etc/sysctl.d/? What value do you want?", "category": "clarify"}
{"nl": "set up cron entry", "bash": "CLARIFY: Which command to run, at what schedule (e.g., daily at 2am, every 15 min), as which user? I'll add a crontab line - need command, schedule, user.", "category": "clarify"}
{"nl": "change boot options", "bash": "CLARIFY: Add a kernel parameter (e.g., 'quiet splash'), change default kernel, or default OS in dual-boot? I'd edit /etc/default/grub then 'update-grub'. Which change?", "category": "clarify"}
{"nl": "update systemctl unit", "bash": "CLARIFY: Which unit name, and which field to change (ExecStart, Restart=, User=)? I'll use 'systemctl edit UNIT' to create a drop-in override.", "category": "clarify"}
{"nl": "edit hosts file", "bash": "CLARIFY: Which entry to add or change - IP and hostname? E.g., '192.168.1.10 myserver'. I'll append to /etc/hosts with sudo. Share IP and name.", "category": "clarify"}
{"nl": "fix dns resolver", "bash": "CLARIFY: Which resolver are you using (systemd-resolved, NetworkManager, plain /etc/resolv.conf)? And what should the new DNS server(s) be?", "category": "clarify"}
{"nl": "set the keyboard layout", "bash": "CLARIFY: For console (loadkeys / /etc/default/keyboard) or X11 (localectl set-x11-keymap)? And which layout (us, gb, de, etc.)?", "category": "clarify"}
{"nl": "change ntp servers", "bash": "CLARIFY: For systemd-timesyncd (/etc/systemd/timesyncd.conf), chronyd, or ntpd? And which servers (pool.ntp.org, time.google.com, internal)?", "category": "clarify"}
{"nl": "set system hostname", "bash": "CLARIFY: What new hostname? I'll use 'sudo hostnamectl set-hostname NAME' and update /etc/hosts. Confirm the name.", "category": "clarify"}
{"nl": "make changes permanent", "bash": "CLARIFY: Which changes - environment variables, sysctl, network settings, mounts? Each persists in a different file. Tell me what you changed.", "category": "clarify"}
{"nl": "fix the env variables", "bash": "CLARIFY: Which variables are wrong, and in which scope (just your shell, your login env, system-wide)? Share what's set ('printenv | sort') and what should change.", "category": "clarify"}
{"nl": "set up alias", "bash": "CLARIFY: For which shell (bash, zsh, fish), what command alias, and persisting where (~/.bashrc, ~/.zshrc)? E.g., alias ll='ls -lah'.", "category": "clarify"}
{"nl": "change git config", "bash": "CLARIFY: User-level (~/.gitconfig, 'git config --global') or repo-level (this repo's .git/config)? Which key (user.email, core.editor) and value?", "category": "clarify"}
{"nl": "set up ssh config", "bash": "CLARIFY: Add a host entry to ~/.ssh/config? Need Host alias, HostName, User, Port, IdentityFile. Share those and I'll write it.", "category": "clarify"}
{"nl": "change the default browser", "bash": "CLARIFY: To which browser (firefox, google-chrome, brave-browser)? I'll use 'xdg-settings set default-web-browser BROWSER.desktop' - confirm the desktop file name.", "category": "clarify"}
{"nl": "set max open files", "bash": "CLARIFY: For which user, soft/hard limit, and at what value (e.g., 65535)? Persist in /etc/security/limits.d/ - tell me user and limit.", "category": "clarify"}
{"nl": "configure the network manager", "bash": "CLARIFY: Add a connection, modify an existing one, or change DNS? Share which connection (nmcli connection show) and what change.", "category": "clarify"}
{"nl": "set up automount", "bash": "CLARIFY: Which device or share to auto-mount, where to mount it, and which options (e.g., noauto, x-systemd.automount)? Need device, mount point, fstype.", "category": "clarify"}
{"nl": "change pam config", "bash": "CLARIFY: Which PAM config (/etc/pam.d/sshd, common-auth, sudo) and what's the change? PAM mis-edits can lock you out - what's the goal?", "category": "clarify"}
{"nl": "set keyboard shortcut", "bash": "CLARIFY: In which environment - GNOME (gsettings, dconf), KDE (kglobalaccel)? And which shortcut for which action? Be specific.", "category": "clarify"}
{"nl": "fix locale warnings", "bash": "CLARIFY: 'sudo locale-gen LOCALE && sudo update-locale LANG=LOCALE'. Which locale (e.g., en_US.UTF-8)? Confirm and I'll run.", "category": "clarify"}
{"nl": "set umask system wide", "bash": "CLARIFY: Which value (022 default, 027 restrict-other, 077 owner-only)? I'll set in /etc/login.defs or PAM. Confirm value.", "category": "clarify"}
{"nl": "configure logrotate", "bash": "CLARIFY: For which log file(s), with what rotation policy (daily, weekly, max size), and how many to keep? I'll write /etc/logrotate.d/CUSTOM.", "category": "clarify"}
{"nl": "modify motd", "bash": "CLARIFY: Edit /etc/motd (static) or dynamic via /etc/update-motd.d/ scripts? And what message? Share the content.", "category": "clarify"}
{"nl": "set system shell", "bash": "CLARIFY: Default shell for which user, and which shell (bash, zsh, fish, dash)? I'll run 'chsh -s /usr/bin/SHELL USER' - confirm both.", "category": "clarify"}
{"nl": "make python 3 default", "bash": "CLARIFY: 'python' currently points where (run 'which python; ls -l $(which python)')? Use update-alternatives, or just alias in your shell rc?", "category": "clarify"}
{"nl": "change docker storage location", "bash": "CLARIFY: To which path? I'd stop docker, edit /etc/docker/daemon.json with 'data-root', migrate /var/lib/docker, then start. Confirm new path and that data can be moved.", "category": "clarify"}
{"nl": "configure gnome settings", "bash": "CLARIFY: Which setting (theme, fonts, key bindings, power)? Use 'gsettings list-recursively' to find keys, then 'gsettings set SCHEMA KEY VALUE'. Tell me the goal.", "category": "clarify"}
{"nl": "fix the broken config file", "bash": "CLARIFY: Which file (path), and what's the error - syntax (share the line) or missing values? I'll need to see the file's content or the related app's error.", "category": "clarify"}
{"nl": "change profile pic", "bash": "CLARIFY: For which user, and which image file? For desktop user pic, it's typically /var/lib/AccountsService/icons/USER. Confirm.", "category": "clarify"}
{"nl": "set up dotfiles", "bash": "CLARIFY: Which dotfiles do you want managed (~/.bashrc, ~/.vimrc, ~/.config/nvim, ~/.gitconfig)? And via plain symlinks, chezmoi, yadm, or a bare git repo?", "category": "clarify"}
{"nl": "add path", "bash": "CLARIFY: Add which directory to PATH, and where to persist - ~/.bashrc, ~/.profile, /etc/profile (system-wide)? Confirm path and scope.", "category": "clarify"}
{"nl": "change package source", "bash": "CLARIFY: Which package manager - apt (/etc/apt/sources.list, /etc/apt/sources.list.d/), pip (~/.pip/pip.conf), npm (~/.npmrc)? And to which mirror?", "category": "clarify"}
{"nl": "throw this out", "bash": "CLARIFY: Which file or folder do you want deleted? Please share the path so I don't remove the wrong thing.", "category": "clarify"}
{"nl": "fix it", "bash": "CLARIFY: Fix what specifically? Share the symptom - an error message, a service that won't start, a file that won't open - and which component is involved.", "category": "clarify"}
{"nl": "it's broken", "bash": "CLARIFY: What's broken - a specific application, a service, the network, the GUI? Share the symptom or error you're seeing.", "category": "clarify"}
{"nl": "speed up startup", "bash": "CLARIFY: What's currently slow on boot? Run 'systemd-analyze blame' and share the worst entries - I'll suggest disabling or fixing the heaviest ones.", "category": "clarify"}
{"nl": "make memory free", "bash": "CLARIFY: 'Drop caches' (sudo sysctl vm.drop_caches=3 - usually unnecessary, kernel manages this) or find/kill a memory-hungry process? Free output is what?", "category": "clarify"}
{"nl": "kill the memory leak", "bash": "CLARIFY: Which process is leaking memory? Run 'ps aux --sort=-rss | head' and share the top - I'll target the right one.", "category": "clarify"}
{"nl": "find what's using ram", "bash": "CLARIFY: Top consumers ('ps aux --sort=-rss | head'), or a specific process's memory map ('pmap PID')? Which view do you want?", "category": "clarify"}
{"nl": "find what is hogging cpu", "bash": "CLARIFY: Real-time view ('top' or 'htop'), or one-time top consumers ('ps aux --sort=-pcpu | head')?", "category": "clarify"}
{"nl": "schedule a one off task", "bash": "CLARIFY: Run which command, at what specific time? I'll use 'at' (one-time) - need both the command and the time (e.g., 'now + 1 hour', '15:30 today').", "category": "clarify"}
{"nl": "set up weekly task", "bash": "CLARIFY: Which command, on which day of the week, at what time? I'll write a cron entry or systemd timer - share command + schedule.", "category": "clarify"}
{"nl": "remove the scheduled job", "bash": "CLARIFY: Which job - cron line ('crontab -l' to list), at-job ('atq'), or systemd timer ('systemctl list-timers')? Tell me which.", "category": "clarify"}
{"nl": "see all my scheduled tasks", "bash": "CLARIFY: For your user (crontab -l, atq, systemctl --user list-timers), system-wide (sudo crontab -l, /etc/cron.*, /etc/systemd/system/*.timer), or both?", "category": "clarify"}
{"nl": "make it run only weekdays", "bash": "CLARIFY: Which command - I'll write a cron entry using '* * * * 1-5'. Share the command and the time-of-day to run.", "category": "clarify"}
{"nl": "show user list", "bash": "CLARIFY: All users including system accounts ('getent passwd' or 'cut -d: -f1 /etc/passwd'), or just human users (UID >= 1000)?", "category": "clarify"}
{"nl": "make my account admin", "bash": "CLARIFY: Add your user to the sudo group ('sudo usermod -aG sudo USER'), or specific sudoers rules? Be aware - you need an existing sudo user to do this.", "category": "clarify"}
{"nl": "remove sudo from someone", "bash": "CLARIFY: Which user (gpasswd -d USER sudo)? And also check /etc/sudoers.d/ in case they have a custom NOPASSWD entry - which user?", "category": "clarify"}
{"nl": "view docker info", "bash": "CLARIFY: Daemon info ('docker info'), running containers ('docker ps'), all containers ('docker ps -a'), or images ('docker images')? Which?", "category": "clarify"}
{"nl": "stop my container", "bash": "CLARIFY: Which container? Run 'docker ps' to list, then I'll 'docker stop NAME'. Or do you mean stop all ('docker stop $(docker ps -q)')?", "category": "clarify"}
{"nl": "delete a docker image", "bash": "CLARIFY: Which image (run 'docker images' for names and tags)? I'll 'docker rmi IMAGE:TAG' - confirm exact reference.", "category": "clarify"}
{"nl": "rebuild the container", "bash": "CLARIFY: For docker-compose ('docker compose build SERVICE' then up), or a standalone Dockerfile (which path)? Which container and where's the Dockerfile?", "category": "clarify"}
{"nl": "see logs of my container", "bash": "CLARIFY: Which container name? I'll 'docker logs -f NAME' to follow live, or 'docker logs --tail=200 NAME' for recent history.", "category": "clarify"}
{"nl": "enter the running container", "bash": "CLARIFY: Which container, and which shell (bash, sh, ash)? I'll 'docker exec -it NAME bash' - confirm container name.", "category": "clarify"}
{"nl": "delete unused docker stuff", "bash": "CLARIFY: 'docker system prune' (containers, images, networks - safe), '-a' (also images without containers - more aggressive), '--volumes' (also data - destructive)?", "category": "clarify"}
{"nl": "pull image", "bash": "CLARIFY: Which image and tag (e.g., nginx:1.27, postgres:16)? I'll 'docker pull IMAGE:TAG'.", "category": "clarify"}
{"nl": "start docker compose", "bash": "CLARIFY: From which directory (where docker-compose.yml lives), and detached ('docker compose up -d') or foreground? I'll need the directory.", "category": "clarify"}
{"nl": "stop docker compose", "bash": "CLARIFY: From which directory (the one with compose file)? 'docker compose down' stops and removes containers; 'docker compose stop' only stops. Which?", "category": "clarify"}
{"nl": "make container restart on boot", "bash": "CLARIFY: Which container (and was it started via plain docker run or compose)? I'll set --restart=unless-stopped via docker update or in the compose file.", "category": "clarify"}
{"nl": "see git history", "bash": "CLARIFY: For which repo (or are you already in one)? Full log ('git log'), oneline ('git log --oneline'), graphical ('git log --graph --oneline --all')?", "category": "clarify"}
{"nl": "undo my last commit", "bash": "CLARIFY: Keep the changes in your working tree ('git reset --soft HEAD~1'), or discard them entirely ('git reset --hard HEAD~1' - destroys work)?", "category": "clarify"}
{"nl": "switch branches", "bash": "CLARIFY: To which branch (run 'git branch -a' to list)? I'll 'git checkout BRANCH' or 'git switch BRANCH'. Confirm name and that working tree is clean.", "category": "clarify"}
{"nl": "create new branch", "bash": "CLARIFY: What name, and from which base (current HEAD by default, or another branch)? I'll 'git checkout -b NAME [BASE]'.", "category": "clarify"}
{"nl": "delete branch", "bash": "CLARIFY: Which branch name, and local only ('git branch -d NAME') or also remote ('git push origin --delete NAME')? Has it been merged?", "category": "clarify"}
{"nl": "save my work in git", "bash": "CLARIFY: Stage everything and commit? Then push? I need a commit message, and which files (all changes vs. specific ones).", "category": "clarify"}
{"nl": "discard my git changes", "bash": "CLARIFY: All uncommitted changes ('git restore .' or 'git checkout -- .'), or specific files? This destroys work - confirm which.", "category": "clarify"}
{"nl": "rollback a file", "bash": "CLARIFY: Which file, and to which version - last commit ('git restore FILE'), a specific commit ('git checkout SHA -- FILE')?", "category": "clarify"}
{"nl": "see what changed", "bash": "CLARIFY: In git ('git diff' for unstaged, 'git diff --staged' for staged, 'git log -p' for committed), in the filesystem ('find PATH -mtime -1'), or in a config? Which?", "category": "clarify"}
{"nl": "find a commit", "bash": "CLARIFY: By what - author ('git log --author=NAME'), message text ('git log --grep=TEXT'), file changed ('git log -- PATH'), date? Which criterion?", "category": "clarify"}
{"nl": "merge another branch", "bash": "CLARIFY: Merge which branch into your current branch, or vice versa? I'll 'git merge OTHER' from your current branch - confirm direction.", "category": "clarify"}
{"nl": "pull latest", "bash": "CLARIFY: From which remote and branch ('git pull origin BRANCH' or just 'git pull' if upstream is set)? Are local commits ahead, and do you prefer rebase or merge?", "category": "clarify"}
{"nl": "push to remote", "bash": "CLARIFY: Which remote (default origin) and branch (current)? If first push of branch, I'll add '-u origin BRANCH'. Confirm.", "category": "clarify"}
{"nl": "set up git remote", "bash": "CLARIFY: Remote name (origin), and URL (https://... or git@...)? Run 'git remote add NAME URL' - share URL.", "category": "clarify"}
{"nl": "clone the repo", "bash": "CLARIFY: From which URL, into which folder (default the repo name)? Also: shallow clone (--depth=1) to save space?", "category": "clarify"}
{"nl": "ignore some files", "bash": "CLARIFY: Add what patterns to .gitignore (e.g., node_modules, .env, *.log)? Share the patterns and I'll append to the right file.", "category": "clarify"}
{"nl": "stash my changes", "bash": "CLARIFY: All tracked changes (git stash) or including untracked ('git stash -u')? And want a message label ('git stash push -m MSG')?", "category": "clarify"}
{"nl": "show git config", "bash": "CLARIFY: System config ('git config --system --list'), user config (--global --list), or this repo (--local --list)? Which scope?", "category": "clarify"}
{"nl": "fix git author", "bash": "CLARIFY: For just future commits (set user.name and user.email), or rewrite past commits (rebase --rewrite history - changes SHAs)? Which?", "category": "clarify"}
{"nl": "see who modified this", "bash": "CLARIFY: For which file? I'll run 'git blame FILE' to show per-line authors. Confirm path.", "category": "clarify"}
{"nl": "test the connection to github", "bash": "CLARIFY: Via SSH ('ssh -T git@github.com') or HTTPS ('git ls-remote https://github.com/owner/repo.git')? Which protocol do you use?", "category": "clarify"}
{"nl": "set git ssh key", "bash": "CLARIFY: Generate a new SSH key (which type - ed25519 recommended)? Or configure an existing key for GitHub - I'll point to ~/.ssh/config. Confirm.", "category": "clarify"}
{"nl": "show running services", "bash": "CLARIFY: All ('systemctl list-units --type=service'), only active ('--state=running'), only enabled at boot ('list-unit-files --state=enabled')?", "category": "clarify"}
{"nl": "find recently changed files", "bash": "CLARIFY: In which directory, and how recent - last hour ('find PATH -mmin -60'), last day ('-mtime -1'), since a date? Tell me the directory.", "category": "clarify"}
{"nl": "find very new files", "bash": "CLARIFY: In which directory, and how new (created or modified in the last hour, day, week)? I'll use find with -mtime or -mmin - tell me the path and window.", "category": "clarify"}
{"nl": "see whats using my cpu", "bash": "CLARIFY: Top CPU consumers ('ps aux --sort=-pcpu | head'), per-CPU breakdown ('mpstat -P ALL'), or interactive ('htop')?", "category": "clarify"}
{"nl": "free memory now", "bash": "CLARIFY: Drop page cache (sudo sysctl vm.drop_caches=3 - usually no point unless debugging), kill heavy process (which), or restart a leaking service?", "category": "clarify"}
{"nl": "see disk io", "bash": "CLARIFY: Live per-process ('sudo iotop'), per-device stats ('iostat -xz 1'), or read/write totals ('cat /proc/diskstats')? Which view?", "category": "clarify"}
{"nl": "find slowest process", "bash": "CLARIFY: Slow how - using most CPU ('ps aux --sort=-pcpu'), most memory ('--sort=-rss'), most I/O ('iotop')? Which metric do you want?", "category": "clarify"}
{"nl": "see open files for process", "bash": "CLARIFY: For which PID or process name? Run 'lsof -p PID' or 'lsof -c PROCNAME'. Tell me which.", "category": "clarify"}
{"nl": "stop services i dont need", "bash": "CLARIFY: Run 'systemctl list-unit-files --state=enabled' - which ones are unneeded for you? I'll disable+stop the ones you list.", "category": "clarify"}
{"nl": "see network sockets", "bash": "CLARIFY: All TCP ('ss -tan'), all listening ('ss -tln'), all UDP ('ss -uan')? Plus do you want process names ('-p', needs sudo)?", "category": "clarify"}
{"nl": "show me cpu usage per core", "bash": "CLARIFY: Live ('mpstat -P ALL 1' or 'htop' with cores enabled), or one-shot snapshot ('mpstat -P ALL')? Install sysstat if mpstat is missing.", "category": "clarify"}
{"nl": "monitor my app", "bash": "CLARIFY: Which app (process name or PID)? I'll use 'ps -p PID' periodically, or top filtered to that PID. Confirm.", "category": "clarify"}
{"nl": "see who is logged in via ssh", "bash": "CLARIFY: Currently ('who | grep pts' or 'ss -tnp src :22'), or historical attempts ('last -i')? Which?", "category": "clarify"}
{"nl": "make this a service", "bash": "CLARIFY: Which command/script should become a systemd service - I need the ExecStart command, the user to run as, and the service name. Share those.", "category": "clarify"}
{"nl": "fix the broken update", "bash": "CLARIFY: Which update broke things - apt upgrade (revert with snapshots/Timeshift), a kernel (boot previous kernel from GRUB), an application (downgrade which)? Specifics?", "category": "clarify"}
{"nl": "downgrade the package", "bash": "CLARIFY: Which package, and to which version? Run 'apt-cache madison PKG' to see available versions, then 'sudo apt install PKG=VERSION'. Confirm both.", "category": "clarify"}
{"nl": "hold the package version", "bash": "CLARIFY: Which package should not be auto-upgraded? I'll 'sudo apt-mark hold PACKAGE' - confirm name.", "category": "clarify"}
{"nl": "let it upgrade again", "bash": "CLARIFY: Which package was held? Run 'apt-mark showhold', then 'sudo apt-mark unhold PACKAGE' for the right one. Confirm.", "category": "clarify"}
{"nl": "fix kernel boot issue", "bash": "CLARIFY: What's the symptom - kernel panic, can't find init, GRUB error, hangs on boot logo? And which kernel version? Share what you see on screen.", "category": "clarify"}
{"nl": "boot a different kernel", "bash": "CLARIFY: Set a different default in GRUB (sudo grub-set-default INDEX), or just choose at boot menu? Which kernel version (uname -r for current)?", "category": "clarify"}
{"nl": "remove old kernels", "bash": "CLARIFY: 'sudo apt autoremove --purge' removes unused kernels, keeping the current and one fallback. Confirm, or want to remove specific kernel versions (list which)?", "category": "clarify"}
{"nl": "see how much ram i have", "bash": "CLARIFY: Total + used summary ('free -h'), or detailed breakdown including buffers/cache ('cat /proc/meminfo')?", "category": "clarify"}
{"nl": "see cpu info", "bash": "CLARIFY: Summary ('lscpu') or full per-core ('cat /proc/cpuinfo')? Either works - which would help more?", "category": "clarify"}
{"nl": "see gpu info", "bash": "CLARIFY: For NVIDIA ('nvidia-smi'), AMD ('rocm-smi' if installed, else 'glxinfo | grep -i renderer'), or generic ('lspci -nnk | grep -i vga -A3')? Which GPU?", "category": "clarify"}
{"nl": "see usb devices", "bash": "CLARIFY: Listed devices ('lsusb'), tree view ('lsusb -t'), or detailed for one device ('lsusb -v -s BUS:DEV')? Which detail level?", "category": "clarify"}
{"nl": "see hardware info", "bash": "CLARIFY: General summary ('inxi -Fxz' if installed, otherwise individual: lscpu, lsmem, lsblk, lspci, lsusb)? Which component?", "category": "clarify"}
{"nl": "see kernel version", "bash": "CLARIFY: Running kernel ('uname -r'), full system info ('uname -a'), or installed kernel packages ('dpkg -l | grep linux-image')? Which?", "category": "clarify"}
{"nl": "see distro version", "bash": "CLARIFY: Pretty name ('lsb_release -d' or 'cat /etc/os-release'), kernel version ('uname -a'), or systemd version ('systemctl --version')? Which?", "category": "clarify"}
{"nl": "remove a service file", "bash": "CLARIFY: Which service unit, and from where (/etc/systemd/system/ for custom, /lib/systemd/system/ for package-provided)? Removing package-provided breaks the package.", "category": "clarify"}
{"nl": "make user a service account", "bash": "CLARIFY: Which existing user, or create new? I'd set shell to /usr/sbin/nologin, lock password, and maybe set home. Confirm username and that they shouldn't log in interactively.", "category": "clarify"}
{"nl": "set up first user", "bash": "CLARIFY: What username, real name, sudo access (yes/no), and shell (bash default)? I'll 'sudo adduser USER' interactively, or share all params.", "category": "clarify"}
{"nl": "fix the wallpaper", "bash": "CLARIFY: In which environment - GNOME (gsettings set org.gnome.desktop.background picture-uri PATH), KDE, Xfce? And what image path?", "category": "clarify"}
{"nl": "fix screen resolution", "bash": "CLARIFY: List available with 'xrandr' - which output, which resolution? Or for Wayland, use the Settings app. What's your session ($XDG_SESSION_TYPE)?", "category": "clarify"}
{"nl": "second monitor not working", "bash": "CLARIFY: Detected by 'xrandr' / 'wlr-randr'? Which port (HDMI, DP) and which GPU (nvidia, amd, intel)? Driver up to date? Share xrandr output.", "category": "clarify"}
{"nl": "fix audio", "bash": "CLARIFY: PulseAudio or PipeWire ('pactl info' shows)? What's the symptom - no sound, wrong device, crackling? And what device (run 'pactl list short sinks')?", "category": "clarify"}
{"nl": "set default audio device", "bash": "CLARIFY: Which sink (run 'pactl list short sinks' for names)? I'll 'pactl set-default-sink NAME' - share the name.", "category": "clarify"}
{"nl": "fix bluetooth audio", "bash": "CLARIFY: What's wrong - won't pair, paired but no sound, low quality? And which device. Share output of 'bluetoothctl devices' and what symptom.", "category": "clarify"}
{"nl": "configure printer", "bash": "CLARIFY: Add a new printer (which model, what IP/USB), set default, or fix one not working? Plus is CUPS running ('systemctl status cups')?", "category": "clarify"}
{"nl": "test print", "bash": "CLARIFY: Default printer or specific? 'lp /usr/share/cups/data/testprint' to default, or '-d PRINTER' to choose. What's the printer name ('lpstat -p')?", "category": "clarify"}
{"nl": "see firewall status", "bash": "CLARIFY: For ufw ('sudo ufw status verbose'), firewalld ('sudo firewall-cmd --state'), or iptables ('sudo iptables -L -v -n')? Which is active?", "category": "clarify"}
{"nl": "remove a firewall rule", "bash": "CLARIFY: Which rule and which firewall? Run 'sudo ufw status numbered' (or firewall-cmd --list-all) and tell me the rule number or specification.", "category": "clarify"}
{"nl": "back up firewall rules", "bash": "CLARIFY: For iptables ('iptables-save > /tmp/rules.v4'), nftables ('nft list ruleset > /tmp/nft.txt'), ufw (copy /etc/ufw/), firewalld (copy /etc/firewalld/)? Which?", "category": "clarify"}
{"nl": "see what is sshd doing", "bash": "CLARIFY: Recent log ('sudo journalctl -u ssh -n 50'), active connections ('sudo ss -tnp src :22'), config ('sudo cat /etc/ssh/sshd_config')? Which?", "category": "clarify"}
{"nl": "list user crontabs", "bash": "CLARIFY: For your user ('crontab -l'), root ('sudo crontab -l'), or all users (read /var/spool/cron/crontabs/* as root)? Which?", "category": "clarify"}
{"nl": "see all crons", "bash": "CLARIFY: System cron tabs ('sudo ls /etc/cron.*'), user crontabs (sudo ls /var/spool/cron/crontabs), or systemd timers ('systemctl list-timers --all')? All sources?", "category": "clarify"}
{"nl": "find a file by name", "bash": "CLARIFY: What name (substring or exact), and where to search (your home, the whole filesystem, a specific path)?", "category": "clarify"}
{"nl": "find a file by content", "bash": "CLARIFY: What text or phrase to search for, and in which directory tree? I'll use 'grep -r PATTERN PATH'.", "category": "clarify"}
{"nl": "see disk read activity", "bash": "CLARIFY: Live live per-process ('sudo iotop'), per-device ('iostat -x 1'), or kernel I/O stats ('cat /proc/diskstats')? Which?", "category": "clarify"}
{"nl": "find what makes a sound at boot", "bash": "CLARIFY: Looking for boot-time audio (PulseAudio/PipeWire startup, the welcome chime)? Tell me what should be silenced - the GNOME login sound, or all desktop notifications?", "category": "clarify"}
{"nl": "set up screen sharing", "bash": "CLARIFY: For what purpose - watch a meeting, remote desktop, presentation share? Tools differ (browser-based for meetings, vino/krfb for VNC desktop, x11vnc).", "category": "clarify"}
{"nl": "fix laptop battery", "bash": "CLARIFY: What's wrong - draining too fast (find which process - powertop), not charging (firmware/BIOS check), or showing wrong percentage (recalibrate)? Symptoms?", "category": "clarify"}
{"nl": "see battery health", "bash": "CLARIFY: 'upower -i $(upower -e | grep BAT)' shows capacity, charge, state. Or use 'cat /sys/class/power_supply/BAT0/charge_full*'. Confirm interest.", "category": "clarify"}
{"nl": "make laptop quieter", "bash": "CLARIFY: Reduce CPU frequency (cpupower set powersave governor), lower fan curve (depends on hardware - need EC tool), or quiet a specific app? Goal?", "category": "clarify"}
{"nl": "set up wake on lan", "bash": "CLARIFY: On which interface? Enable in firmware (BIOS) + 'sudo ethtool -s INTERFACE wol g' + persist via NetworkManager or a service. Share interface name.", "category": "clarify"}
{"nl": "test webcam", "bash": "CLARIFY: Which camera device (list with 'v4l2-ctl --list-devices' or 'ls /dev/video*')? I'll preview with 'ffplay /dev/videoN' or guvcview - which?", "category": "clarify"}
{"nl": "delete the user data", "bash": "CLARIFY: For which user, and what counts as their data - home folder (/home/USER), mail spool, cron, plus anywhere they own outside home? Tell me the username and scope.", "category": "clarify"}
{"nl": "make my os faster", "bash": "CLARIFY: Faster how - boot time (systemd-analyze blame), GUI responsiveness (check GPU drivers), disk speed (move to SSD), or a specific slow app?", "category": "clarify"}
{"nl": "deep clean my system", "bash": "CLARIFY: What scope - apt cache + autoremove (safe), also user caches, also old kernels, also docker prune? Each is more invasive. List which categories.", "category": "clarify"}
{"nl": "find files that shouldnt be here", "bash": "CLARIFY: 'Shouldn't be here' meaning - duplicates, files with no owner, world-writable, unexpected setuid, very large, or very old? Each is a different scan.", "category": "clarify"}
{"nl": "delete logs older than 30 days", "bash": "CLARIFY: Journal entries ('journalctl --vacuum-time=30d') or rotated files in /var/log ('find /var/log -name \"*.gz\" -mtime +30 -delete')? Both?", "category": "clarify"}
{"nl": "see what services start on boot", "bash": "CLARIFY: All enabled service units ('systemctl list-unit-files --state=enabled --type=service'), or only services currently running ('systemctl list-units --type=service')?", "category": "clarify"}
{"nl": "make app start in background", "bash": "CLARIFY: Which app, and how should it behave - run as a user systemd service, started on login via autostart, or just nohup for one session? Tell me the app and goal.", "category": "clarify"}
{"nl": "schedule reboot", "bash": "CLARIFY: Once (now + N minutes via 'sudo shutdown -r +N'), or recurring (cron @reboot is not the answer - that's at-boot). What's the schedule?", "category": "clarify"}
{"nl": "cancel scheduled reboot", "bash": "CLARIFY: If it was 'shutdown -r', cancel with 'sudo shutdown -c'. If scheduled via cron/timer, share which and I'll remove it.", "category": "clarify"}
{"nl": "see when system was last started", "bash": "CLARIFY: Last boot time ('uptime -s') or boot history ('last reboot')? Either works.", "category": "clarify"}
{"nl": "make this folder backed up regularly", "bash": "CLARIFY: Which folder, to where, with what tool (rsync, restic, borg), and how often (daily, hourly)? I'll set up a systemd timer or cron once those are clear.", "category": "clarify"}
{"nl": "set up filesync between two computers", "bash": "CLARIFY: Which two hosts, which folder on each, and which tool (Syncthing - peer-to-peer, Unison - bidirectional, rsync - one-way)? Network reachable?", "category": "clarify"}
{"nl": "back up the whole system", "bash": "CLARIFY: Full disk image (clonezilla, dd - destination drive needed), file-level backup of '/' (need lots of space, exclude /proc /sys /dev), or system snapshot (Timeshift)?", "category": "clarify"}
{"nl": "find biggest log file", "bash": "CLARIFY: In /var/log ('sudo du -ah /var/log | sort -h | tail -10'), in your home, or somewhere else? Want only specific types (e.g., .log)?", "category": "clarify"}
{"nl": "see ssh known hosts", "bash": "CLARIFY: Just list ('cat ~/.ssh/known_hosts') or search for a specific host ('ssh-keygen -F HOST')? Or system-wide /etc/ssh/ssh_known_hosts?", "category": "clarify"}
{"nl": "remove known host", "bash": "CLARIFY: Which host's entry should I remove? 'ssh-keygen -R HOSTNAME' removes it from known_hosts. Share the hostname.", "category": "clarify"}
{"nl": "trust a host key", "bash": "CLARIFY: For which host (hostname or IP)? I'll connect with 'ssh-keyscan' and add to known_hosts, or you can connect once and accept the prompt. Share host.", "category": "clarify"}
{"nl": "set up sftp account", "bash": "CLARIFY: What username, do they need shell access (no by default for sftp-only), and chrooted to which directory? Share those for /etc/ssh/sshd_config tuning.", "category": "clarify"}
{"nl": "make ssh login passwordless", "bash": "CLARIFY: To which host, as which user? I'll need to copy your public key (ssh-copy-id user@host) and confirm key-only auth is desired.", "category": "clarify"}
{"nl": "generate ssh key", "bash": "CLARIFY: Which type (ed25519 recommended, rsa for older systems), and where to save (default ~/.ssh/id_ed25519)? Plus passphrase or no? Confirm.", "category": "clarify"}
{"nl": "convert ssh key", "bash": "CLARIFY: From what to what - OpenSSH to PuTTY (puttygen), PEM to PPK, public to authorized_keys format? Tell me input and target.", "category": "clarify"}
{"nl": "back up ssh setup", "bash": "CLARIFY: Just your ~/.ssh folder (chmod 700 keys), or also /etc/ssh server config? Where to (encrypted archive recommended for keys)?", "category": "clarify"}
{"nl": "use a different key for this host", "bash": "CLARIFY: For which host (alias or hostname), and which IdentityFile path? I'll add a Host block to ~/.ssh/config - share both.", "category": "clarify"}
{"nl": "ssh agent setup", "bash": "CLARIFY: Start ssh-agent now ('eval $(ssh-agent)'), or auto-start with desktop (gnome-keyring usually does this). And which keys to add ('ssh-add ~/.ssh/id_ed25519')?", "category": "clarify"}
{"nl": "remove a key from agent", "bash": "CLARIFY: Which key (run 'ssh-add -l' to list)? I'll 'ssh-add -d PATH'. Or remove all with 'ssh-add -D'. Confirm.", "category": "clarify"}
{"nl": "clear pip cache", "bash": "CLARIFY: User cache ('pip cache purge'), or just one package ('pip cache remove PKG')? Either is safe.", "category": "clarify"}
{"nl": "clear npm cache", "bash": "CLARIFY: 'npm cache clean --force' wipes the cache - confirm. Or only for one package? Cache rarely needs clearing - what's the symptom?", "category": "clarify"}
{"nl": "clean yarn cache", "bash": "CLARIFY: 'yarn cache clean' clears all - or 'yarn cache clean PACKAGE' for one. Which?", "category": "clarify"}
{"nl": "remove pip package", "bash": "CLARIFY: Which package, and from which environment (global pip, --user, or a virtualenv)? 'pip uninstall PACKAGE' in the active env.", "category": "clarify"}
{"nl": "install pip package", "bash": "CLARIFY: Which package, which version (latest by default), and where (global, --user, or active venv)? Share the package and any constraints.", "category": "clarify"}
{"nl": "set up venv", "bash": "CLARIFY: Where (which directory should the venv folder be in), with which Python version, and any initial packages? I'll 'python3 -m venv PATH'.", "category": "clarify"}
{"nl": "fix pip not found", "bash": "CLARIFY: Is python3 installed ('which python3')? pip can be installed with 'sudo apt install python3-pip' or 'python3 -m ensurepip'. Confirm which approach.", "category": "clarify"}
{"nl": "set default python", "bash": "CLARIFY: System 'python' to point to python3 ('sudo apt install python-is-python3'), or use update-alternatives for multiple versions? Which is fine?", "category": "clarify"}
{"nl": "install node version", "bash": "CLARIFY: Which Node.js major version (20 LTS, 22 current), and via which manager (nvm for per-user, n, asdf, fnm, or NodeSource apt)? Tell me both.", "category": "clarify"}
{"nl": "switch node version", "bash": "CLARIFY: Are you using nvm, fnm, asdf, or n? Each has different command - 'nvm use 20', 'fnm use 20', 'asdf set nodejs 20.0.0'. Which?", "category": "clarify"}
{"nl": "delete node modules", "bash": "CLARIFY: Just one project's ('rm -rf ./node_modules'), or across many projects? If many, give me the parent directory to search under.", "category": "clarify"}
{"nl": "show npm globals", "bash": "CLARIFY: For the current Node ('npm ls -g --depth=0'), or for a specific node version? Confirm.", "category": "clarify"}
{"nl": "remove global npm package", "bash": "CLARIFY: Which package name? I'll 'npm uninstall -g PACKAGE'. Confirm name (run 'npm ls -g --depth=0' to list).", "category": "clarify"}
{"nl": "install go module", "bash": "CLARIFY: In which Go project (cd to the module first), and which package path? I'll 'go get PACKAGE'. Share the module URL.", "category": "clarify"}
{"nl": "set go path", "bash": "CLARIFY: GOPATH (older modules) or GOBIN (binaries)? And to which directory? Persist in ~/.bashrc or ~/.profile - share values.", "category": "clarify"}
{"nl": "fix permission denied with pip", "bash": "CLARIFY: Don't use sudo pip - prefer per-user install ('pip install --user PKG') or a virtualenv. Which package, and which approach do you want?", "category": "clarify"}
{"nl": "list installed packages", "bash": "CLARIFY: For which package manager - apt ('dpkg -l'), pip ('pip list'), npm ('npm ls'), snap, flatpak? Or a specific search across them?", "category": "clarify"}
{"nl": "find package that provides command", "bash": "CLARIFY: Which command? 'apt-file search /usr/bin/COMMAND' (after apt-file update) or 'command-not-found COMMAND' (often suggests). Share the command name.", "category": "clarify"}
{"nl": "list snap packages", "bash": "CLARIFY: 'snap list' shows installed - confirm? Or want only those needing updates ('snap refresh --list')?", "category": "clarify"}
{"nl": "remove snap", "bash": "CLARIFY: Which snap package? 'sudo snap remove NAME' - confirm name (run 'snap list' to see). To also purge data, add '--purge'.", "category": "clarify"}
{"nl": "list flatpaks", "bash": "CLARIFY: 'flatpak list' shows installed - confirm? Or want only apps ('flatpak list --app') and not runtimes?", "category": "clarify"}
{"nl": "remove flatpak", "bash": "CLARIFY: Which flatpak (run 'flatpak list --app' for app IDs)? 'flatpak uninstall APP_ID'. Confirm.", "category": "clarify"}
{"nl": "find what is using my microphone", "bash": "CLARIFY: 'pactl list source-outputs' shows active capturers in PulseAudio; for PipeWire use 'pw-cli ls Node | grep -A5 capture'. Which audio system are you on?", "category": "clarify"}
{"nl": "see what is using camera", "bash": "CLARIFY: 'sudo fuser -v /dev/video0' shows processes holding the camera. Which video device do you mean (ls /dev/video*)?", "category": "clarify"}
{"nl": "show file type", "bash": "CLARIFY: For which file? 'file PATH' tells you. Share the path.", "category": "clarify"}
{"nl": "compare two files", "bash": "CLARIFY: Which two files, and how - text diff ('diff FILE1 FILE2'), side-by-side ('diff -y'), or byte-level for binary ('cmp')?", "category": "clarify"}
{"nl": "compare two folders", "bash": "CLARIFY: Which two folders, and detail level - names only ('diff -rq A B'), full content diff ('diff -r A B'), or rsync dry-run for sync status?", "category": "clarify"}
{"nl": "calculate file hash", "bash": "CLARIFY: Which file, and which hash (md5sum, sha1sum, sha256sum)? Share the file path and algorithm.", "category": "clarify"}
{"nl": "verify checksum", "bash": "CLARIFY: For which file, and what's the expected checksum (or a checksum file with the manifest)? Algorithm (md5, sha256)?", "category": "clarify"}
{"nl": "encrypt a file", "bash": "CLARIFY: Which file, and with what tool (gpg, age, openssl)? gpg with a passphrase or a recipient key? Confirm tool and key/passphrase choice.", "category": "clarify"}
{"nl": "decrypt a file", "bash": "CLARIFY: Which encrypted file, and with what tool (was it gpg, age, openssl)? Do you have the passphrase or private key ready?", "category": "clarify"}
{"nl": "sign a file with gpg", "bash": "CLARIFY: Which file, and with which key (gpg -K to list)? Detached signature (-b) or inline? Confirm.", "category": "clarify"}
{"nl": "verify gpg signature", "bash": "CLARIFY: Which signature file and which signed file? 'gpg --verify SIG FILE'. Share the paths.", "category": "clarify"}
{"nl": "list gpg keys", "bash": "CLARIFY: Public ('gpg --list-keys'), private ('gpg --list-secret-keys'), or detailed (--list-keys --with-colons)? Which?", "category": "clarify"}
{"nl": "import gpg key", "bash": "CLARIFY: From a file ('gpg --import FILE'), from a keyserver ('gpg --keyserver SERVER --recv-keys KEYID'), or from clipboard? Share source.", "category": "clarify"}
{"nl": "delete gpg key", "bash": "CLARIFY: Public ('gpg --delete-keys KEYID') or also private ('gpg --delete-secret-keys KEYID')? And which key (run 'gpg -K' for IDs)?", "category": "clarify"}
{"nl": "see crontab errors", "bash": "CLARIFY: Cron output goes to mail by default, or to /var/log/syslog. Check 'grep CRON /var/log/syslog' or 'journalctl -u cron'. Which is more useful?", "category": "clarify"}
{"nl": "run a script as another user", "bash": "CLARIFY: Which script, and as which user? 'sudo -u USER /path/script' - confirm user and script path.", "category": "clarify"}
{"nl": "test as root", "bash": "CLARIFY: Run which command as root, with environment? 'sudo COMMAND' for one command, 'sudo -i' for a full root shell. Which?", "category": "clarify"}
{"nl": "see system uptime", "bash": "CLARIFY: 'uptime' shows uptime + load + users. Want just boot time ('uptime -s'), or pretty ('uptime -p')?", "category": "clarify"}
{"nl": "see open files", "bash": "CLARIFY: All open files system-wide ('lsof' - large output), by a specific process ('lsof -p PID'), or by file ('lsof FILE')? Which scope?", "category": "clarify"}
{"nl": "see who is using a file", "bash": "CLARIFY: Which file? 'sudo lsof FILEPATH' shows processes holding it open. Confirm path.", "category": "clarify"}
{"nl": "limit cpu for a process", "bash": "CLARIFY: For which process - I can lower priority with 'renice 10 -p PID' (still uses CPU when idle), or hard cap via cgroups/cpulimit. Which?", "category": "clarify"}
{"nl": "pause a process", "bash": "CLARIFY: Which PID or process name? 'kill -STOP PID' pauses; 'kill -CONT PID' resumes. Confirm target.", "category": "clarify"}
{"nl": "resume a process", "bash": "CLARIFY: Which PID was stopped? 'kill -CONT PID' resumes. Run 'ps -ostat,pid,cmd' and look for 'T' (stopped) - share PID.", "category": "clarify"}
{"nl": "make this command quieter", "bash": "CLARIFY: Which command - I'd suggest redirecting stdout/stderr ('CMD > /dev/null 2>&1') or finding a quiet flag (-q in many tools). Share the command.", "category": "clarify"}
{"nl": "make script run once a day", "bash": "CLARIFY: Which script (path), and which user runs it? At what time? I'll add a daily cron entry - share path, user, time.", "category": "clarify"}
{"nl": "delete files larger than 100mb", "bash": "CLARIFY: In which directory? 'find PATH -type f -size +100M -delete' is destructive - confirm path and that you want immediate delete (vs. listing first).", "category": "clarify"}
{"nl": "find files i havent opened in a year", "bash": "CLARIFY: 'find PATH -atime +365 -type f' uses access time, which many filesystems don't update accurately. Which directory? Mtime is more reliable - which would you prefer?", "category": "clarify"}
{"nl": "see file age", "bash": "CLARIFY: For which file? 'stat PATH' shows access/modify/change times - confirm the path.", "category": "clarify"}
{"nl": "set file timestamp", "bash": "CLARIFY: Which file, and to what timestamp (use 'touch -d \"YYYY-MM-DD HH:MM\" FILE' or '-r OTHER' to match another file)?", "category": "clarify"}
{"nl": "watch a directory for changes", "bash": "CLARIFY: Which directory, and what to do on change - just log, run a script (which)? Tool: inotifywait. Share path and trigger.", "category": "clarify"}
{"nl": "convert image format", "bash": "CLARIFY: Which input file (or batch), and to what format (png, jpg, webp)? I'll use 'convert INPUT OUTPUT' from ImageMagick - need both.", "category": "clarify"}
{"nl": "resize image", "bash": "CLARIFY: Which file, and to which dimensions (e.g., 800x600, 50%)? Preserve aspect ratio? 'convert INPUT -resize 800x600 OUTPUT'.", "category": "clarify"}
{"nl": "batch resize images", "bash": "CLARIFY: Which folder, which formats to include, target size, output - overwrite or new folder? Tool: ImageMagick mogrify or a script.", "category": "clarify"}
{"nl": "convert video", "bash": "CLARIFY: Which input file, to which format/codec (mp4 h264, webm vp9, mkv), and any quality settings (CRF, bitrate)? Output path?", "category": "clarify"}
{"nl": "extract audio from video", "bash": "CLARIFY: Which video file, and target audio format (mp3, m4a, opus)? I'll 'ffmpeg -i INPUT -vn -acodec copy OUTPUT.m4a' or transcode - which?", "category": "clarify"}
{"nl": "merge videos", "bash": "CLARIFY: Which video files (paths, in order)? Same codec/container? If yes, simple concat; if no, transcode required. Output path?", "category": "clarify"}
{"nl": "trim a video", "bash": "CLARIFY: Which file, start and end times (e.g., 00:01:00 to 00:02:30), and output path? I'll 'ffmpeg -ss START -to END -i IN OUT'.", "category": "clarify"}
{"nl": "compress pdf", "bash": "CLARIFY: Which PDF, and what target quality (low ~72dpi, medium ~150dpi, high ~300dpi)? I'll use Ghostscript - share input and target.", "category": "clarify"}
{"nl": "merge pdfs", "bash": "CLARIFY: Which PDFs (paths, in order), and output filename? Tool: pdfunite or pdftk - I'll use pdfunite.", "category": "clarify"}
{"nl": "split pdf", "bash": "CLARIFY: Which PDF, and how to split - one file per page, by page ranges (1-5,6-10), or extract specific pages? Output naming?", "category": "clarify"}
{"nl": "convert document format", "bash": "CLARIFY: Which input file, to what output format (docx, pdf, html, md)? Tool: pandoc for many formats, libreoffice --convert-to for office docs. Share both.", "category": "clarify"}
{"nl": "send a notification", "bash": "CLARIFY: 'notify-send TITLE BODY' for a desktop notification - confirm? Or send to a service (email, Slack, ntfy) - which?", "category": "clarify"}
{"nl": "speak this text", "bash": "CLARIFY: Which text, and which TTS engine (espeak-ng for simple, festival, or a higher-quality one like piper)? Output to speakers or save to file?", "category": "clarify"}
{"nl": "translate this", "bash": "CLARIFY: From what language to what language, and which tool (trans from translate-shell, or an online API)? Plus the text or file to translate.", "category": "clarify"}
{"nl": "share clipboard", "bash": "CLARIFY: With what - another machine (clipboard sync tool like clipnotify+xclip+netcat), another user, or save to file ('xclip -selection clipboard -o > file')?", "category": "clarify"}
{"nl": "get clipboard contents", "bash": "CLARIFY: On X11 ('xclip -selection clipboard -o' or 'xsel --clipboard --output'). On Wayland ('wl-paste'). Which session ($XDG_SESSION_TYPE)?", "category": "clarify"}
{"nl": "set clipboard", "bash": "CLARIFY: From what source - a file ('xclip -selection clipboard < FILE'), a string ('echo TEXT | xclip')? And X11 (xclip) or Wayland (wl-copy)?", "category": "clarify"}
{"nl": "set the brightness", "bash": "CLARIFY: To what level (0-100), and via which interface - 'brightnessctl set N%' (recommended) or writing /sys/class/backlight/*/brightness? Confirm.", "category": "clarify"}
{"nl": "fix the brightness", "bash": "CLARIFY: What's wrong - stuck at full, can't lower, keys don't work? Hardware - laptop model? And which kernel? Share lspci and uname -r.", "category": "clarify"}
{"nl": "see my session type", "bash": "CLARIFY: Just 'echo $XDG_SESSION_TYPE' shows x11 or wayland - want me to run that? Or want full session info (loginctl show-session)?", "category": "clarify"}
{"nl": "change to wayland", "bash": "CLARIFY: This is selected at the login screen (gear icon when picking user). To force, I can adjust /etc/gdm3/custom.conf - which display manager (gdm, lightdm)?", "category": "clarify"}
{"nl": "make sure i have backup of this", "bash": "CLARIFY: Which file or folder, and check where? I'll search likely backup locations - tell me both the source path and where backups might live.", "category": "clarify"}
{"nl": "stop the migration", "bash": "CLARIFY: Which migration - a database migration (which tool, alembic, rails, knex), a system migration, an apt half-completed install? Share the symptom.", "category": "clarify"}
{"nl": "where did i save my tax return last year", "bash": "find ~ -iname '*tax*2025*' 2>/dev/null", "category": "colloquial"}
{"nl": "locate that pdf about climate change i downloaded", "bash": "find ~ -iname '*climate*.pdf' 2>/dev/null", "category": "colloquial"}
{"nl": "find every photo on my computer", "bash": "find ~ -type f \\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.heic' \\)", "category": "colloquial"}
{"nl": "show me all the word documents i have", "bash": "find ~ -type f \\( -iname '*.docx' -o -iname '*.doc' \\)", "category": "colloquial"}
{"nl": "track down a file called invoice march somewhere on my machine", "bash": "find ~ -iname '*invoice*march*' 2>/dev/null", "category": "colloquial"}
{"nl": "hunt for any file with the word resume in the name", "bash": "find ~ -iname '*resume*' 2>/dev/null", "category": "colloquial"}
{"nl": "look up all my excel spreadsheets", "bash": "find ~ -type f \\( -iname '*.xlsx' -o -iname '*.xls' -o -iname '*.csv' \\)", "category": "colloquial"}
{"nl": "find every powerpoint deck on my computer", "bash": "find ~ -type f \\( -iname '*.pptx' -o -iname '*.ppt' \\)", "category": "colloquial"}
{"nl": "show me all videos i have downloaded", "bash": "find ~/Downloads -type f \\( -iname '*.mp4' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.avi' \\)", "category": "colloquial"}
{"nl": "scan for any zip files in my downloads", "bash": "find ~/Downloads -type f -iname '*.zip'", "category": "colloquial"}
{"nl": "any python scripts in my home folder", "bash": "find ~ -type f -iname '*.py'", "category": "colloquial"}
{"nl": "find files i changed today", "bash": "find ~ -type f -mtime 0", "category": "colloquial"}
{"nl": "show me everything i edited yesterday", "bash": "find ~ -type f -mtime 1", "category": "colloquial"}
{"nl": "which files have i changed in the last hour", "bash": "find ~ -type f -mmin -60", "category": "colloquial"}
{"nl": "anything modified this week in my projects folder", "bash": "find ~/projects -type f -mtime -7", "category": "colloquial"}
{"nl": "files i havent touched in a year", "bash": "find ~ -type f -mtime +365", "category": "colloquial"}
{"nl": "show me empty files in my downloads", "bash": "find ~/Downloads -type f -empty", "category": "colloquial"}
{"nl": "find empty folders i can clean up", "bash": "find ~ -type d -empty", "category": "colloquial"}
{"nl": "any file bigger than 500 megabytes in my home", "bash": "find ~ -type f -size +500M", "category": "colloquial"}
{"nl": "find files larger than a gig", "bash": "find ~ -type f -size +1G", "category": "colloquial"}
{"nl": "show files between 100 and 500 megabytes", "bash": "find ~ -type f -size +100M -size -500M", "category": "colloquial"}
{"nl": "look for very small files under 1k", "bash": "find ~ -type f -size -1k", "category": "colloquial"}
{"nl": "find which file has my api key in it", "bash": "grep -rln 'api_key' ~/projects 2>/dev/null", "category": "colloquial"}
{"nl": "which config file mentions port 8080", "bash": "grep -rln '8080' ~/projects /etc 2>/dev/null", "category": "colloquial"}
{"nl": "search all my notes for the word meeting", "bash": "grep -rn 'meeting' ~/Documents/notes/ 2>/dev/null", "category": "colloquial"}
{"nl": "find any file that contains my email address", "bash": "grep -rln 'abhimava@andrew.cmu.edu' ~ 2>/dev/null", "category": "colloquial"}
{"nl": "look inside every text file for the word password", "bash": "grep -rln 'password' ~ --include='*.txt' 2>/dev/null", "category": "colloquial"}
{"nl": "search my code for TODO comments", "bash": "grep -rn 'TODO' ~/projects/myapp", "category": "colloquial"}
{"nl": "count how many lines mention error in this log file", "bash": "grep -c 'error' ~/logs/app.log", "category": "colloquial"}
{"nl": "show me the lines with WARN in my java log", "bash": "grep 'WARN' ~/logs/server.log", "category": "colloquial"}
{"nl": "find errors but ignore the word notice", "bash": "grep 'error' ~/logs/app.log | grep -v 'notice'", "category": "colloquial"}
{"nl": "how much room is left on my drive", "bash": "df -h /", "category": "colloquial"}
{"nl": "am i running low on storage", "bash": "df -h ~", "category": "colloquial"}
{"nl": "which folder is hogging all my space", "bash": "du -sh ~/* 2>/dev/null | sort -hr | head -20", "category": "colloquial"}
{"nl": "what is taking up so much room in my downloads", "bash": "du -sh ~/Downloads/* 2>/dev/null | sort -hr | head -20", "category": "colloquial"}
{"nl": "show me the biggest folders in documents", "bash": "du -sh ~/Documents/* 2>/dev/null | sort -hr | head -10", "category": "colloquial"}
{"nl": "how big is my home folder total", "bash": "du -sh ~", "category": "colloquial"}
{"nl": "size of the trash folder", "bash": "du -sh ~/.local/share/Trash", "category": "colloquial"}
{"nl": "how much is the browser cache eating", "bash": "du -sh ~/.cache/google-chrome ~/.cache/mozilla 2>/dev/null", "category": "colloquial"}
{"nl": "empty my trash to free up space", "bash": "rm -rf ~/.local/share/Trash/files/* ~/.local/share/Trash/info/*", "category": "colloquial"}
{"nl": "clear out my browser cache to free space", "bash": "rm -rf ~/.cache/google-chrome ~/.cache/mozilla", "category": "colloquial"}
{"nl": "delete temp files in my user temp folder", "bash": "rm -rf /tmp/*-$USER-* 2>/dev/null", "category": "colloquial"}
{"nl": "free up space by removing thumbnail cache", "bash": "rm -rf ~/.cache/thumbnails/*", "category": "colloquial"}
{"nl": "unzip this file i just downloaded", "bash": "unzip ~/Downloads/archive.zip -d ~/Downloads/", "category": "colloquial"}
{"nl": "how do i open this tar.gz file", "bash": "tar -xzf ~/Downloads/package.tar.gz -C ~/Downloads/", "category": "colloquial"}
{"nl": "extract this rar file", "bash": "unrar x ~/Downloads/package.rar ~/Downloads/", "category": "colloquial"}
{"nl": "open this 7zip archive", "bash": "7z x ~/Downloads/archive.7z -o/home/$USER/Downloads/", "category": "colloquial"}
{"nl": "decompress this tar.bz2 file", "bash": "tar -xjf ~/Downloads/package.tar.bz2 -C ~/Downloads/", "category": "colloquial"}
{"nl": "extract that tar.xz package i grabbed", "bash": "tar -xJf ~/Downloads/package.tar.xz -C ~/Downloads/", "category": "colloquial"}
{"nl": "just take a peek inside this zip without unpacking", "bash": "unzip -l ~/Downloads/archive.zip", "category": "colloquial"}
{"nl": "list whats inside this tar archive without extracting", "bash": "tar -tzf ~/Downloads/package.tar.gz", "category": "colloquial"}
{"nl": "compress my photos folder into a zip", "bash": "zip -r ~/photos.zip ~/Pictures/", "category": "colloquial"}
{"nl": "make a tar.gz of my project folder", "bash": "tar -czf ~/myapp.tar.gz -C ~ projects/myapp", "category": "colloquial"}
{"nl": "bundle up my documents folder for emailing", "bash": "tar -czf ~/Desktop/documents.tar.gz -C ~ Documents/", "category": "colloquial"}
{"nl": "zip these three files together", "bash": "zip ~/Desktop/bundle.zip ~/Documents/a.txt ~/Documents/b.txt ~/Documents/c.txt", "category": "colloquial"}
{"nl": "make a password protected zip of this folder", "bash": "zip -er ~/Desktop/private.zip ~/Documents/private/", "category": "colloquial"}
{"nl": "whats hogging my cpu right now", "bash": "top -bn1 | head -20", "category": "colloquial"}
{"nl": "which app is using all my memory", "bash": "ps aux --sort=-%mem | head -10", "category": "colloquial"}
{"nl": "show me the top 10 cpu hogs", "bash": "ps aux --sort=-%cpu | head -11", "category": "colloquial"}
{"nl": "is firefox running", "bash": "pgrep -a firefox", "category": "colloquial"}
{"nl": "see all the chrome processes", "bash": "pgrep -a chrome", "category": "colloquial"}
{"nl": "how many processes do i have running", "bash": "ps aux | wc -l", "category": "colloquial"}
{"nl": "show me all my running programs", "bash": "ps -u $USER", "category": "colloquial"}
{"nl": "kill the spotify app its frozen", "bash": "pkill -f spotify", "category": "colloquial"}
{"nl": "close all my chrome windows", "bash": "pkill -f chrome", "category": "colloquial"}
{"nl": "force quit slack its stuck", "bash": "pkill -9 -f slack", "category": "colloquial"}
{"nl": "how long has my computer been on", "bash": "uptime -p", "category": "colloquial"}
{"nl": "when did i last boot up", "bash": "who -b", "category": "colloquial"}
{"nl": "show me the load average", "bash": "uptime", "category": "colloquial"}
{"nl": "which process is listening on port 8080", "bash": "lsof -i :8080", "category": "colloquial"}
{"nl": "whats using port 443", "bash": "lsof -i :443", "category": "colloquial"}
{"nl": "how much ram am i using", "bash": "free -h", "category": "colloquial"}
{"nl": "am i out of memory", "bash": "free -h", "category": "colloquial"}
{"nl": "show me cpu temperature", "bash": "sensors 2>/dev/null || echo 'install lm-sensors first'", "category": "colloquial"}
{"nl": "how many cpu cores do i have", "bash": "nproc", "category": "colloquial"}
{"nl": "what kind of cpu is in this computer", "bash": "lscpu | head -20", "category": "colloquial"}
{"nl": "show me hardware info about this machine", "bash": "lshw -short 2>/dev/null || sudo lshw -short", "category": "colloquial"}
{"nl": "whats my ip address", "bash": "ip -4 addr show | grep inet", "category": "colloquial"}
{"nl": "what is my external ip", "bash": "curl -s ifconfig.me", "category": "colloquial"}
{"nl": "am i connected to the internet", "bash": "ping -c 3 8.8.8.8", "category": "colloquial"}
{"nl": "can i reach google", "bash": "ping -c 4 google.com", "category": "colloquial"}
{"nl": "test my dns is working", "bash": "nslookup google.com", "category": "colloquial"}
{"nl": "look up the ip for github", "bash": "dig +short github.com", "category": "colloquial"}
{"nl": "show me my wifi network name", "bash": "iwgetid -r 2>/dev/null || nmcli -t -f active,ssid dev wifi | grep '^yes'", "category": "colloquial"}
{"nl": "list available wifi networks", "bash": "nmcli dev wifi list", "category": "colloquial"}
{"nl": "connect to the wifi called HomeNet", "bash": "nmcli dev wifi connect HomeNet", "category": "colloquial"}
{"nl": "forget that wifi network", "bash": "nmcli connection delete HomeNet", "category": "colloquial"}
{"nl": "see all my network interfaces", "bash": "ip link show", "category": "colloquial"}
{"nl": "show open network ports on my computer", "bash": "ss -tuln", "category": "colloquial"}
{"nl": "which programs are using the internet right now", "bash": "ss -tunap 2>/dev/null", "category": "colloquial"}
{"nl": "download this file from the internet", "bash": "wget -P ~/Downloads/ https://example.com/file.zip", "category": "colloquial"}
{"nl": "grab this file with curl", "bash": "curl -L -o ~/Downloads/file.zip https://example.com/file.zip", "category": "colloquial"}
{"nl": "test how fast my internet is", "bash": "curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3", "category": "colloquial"}
{"nl": "check my dns server", "bash": "grep nameserver /etc/resolv.conf", "category": "colloquial"}
{"nl": "traceroute to github", "bash": "traceroute github.com", "category": "colloquial"}
{"nl": "see the system log from today", "bash": "journalctl --since today", "category": "colloquial"}
{"nl": "show me errors from the system log", "bash": "journalctl -p err -n 100", "category": "colloquial"}
{"nl": "what happened the last time i booted", "bash": "journalctl -b -1 -p err", "category": "colloquial"}
{"nl": "watch the system log live", "bash": "journalctl -f", "category": "colloquial"}
{"nl": "show me the kernel messages", "bash": "dmesg | tail -50", "category": "colloquial"}
{"nl": "any errors in the syslog", "bash": "grep -i error /var/log/syslog 2>/dev/null | tail -20", "category": "colloquial"}
{"nl": "show me only the last 100 lines of the auth log", "bash": "tail -100 /var/log/auth.log 2>/dev/null", "category": "colloquial"}
{"nl": "see the nginx access log", "bash": "tail -50 /var/log/nginx/access.log 2>/dev/null", "category": "colloquial"}
{"nl": "tail the nginx error log live", "bash": "tail -f /var/log/nginx/error.log 2>/dev/null", "category": "colloquial"}
{"nl": "is my web server running", "bash": "systemctl status nginx", "category": "colloquial"}
{"nl": "is postgres running", "bash": "systemctl status postgresql", "category": "colloquial"}
{"nl": "check if docker is up", "bash": "systemctl status docker", "category": "colloquial"}
{"nl": "list all the services on my computer", "bash": "systemctl list-units --type=service", "category": "colloquial"}
{"nl": "show me failed services", "bash": "systemctl --failed", "category": "colloquial"}
{"nl": "list services that start at boot", "bash": "systemctl list-unit-files --state=enabled --type=service", "category": "colloquial"}
{"nl": "what time is it", "bash": "date", "category": "colloquial"}
{"nl": "show me the date in iso format", "bash": "date -I", "category": "colloquial"}
{"nl": "whats the unix timestamp right now", "bash": "date +%s", "category": "colloquial"}
{"nl": "what day of the week is it", "bash": "date +%A", "category": "colloquial"}
{"nl": "show me a calendar for this month", "bash": "cal", "category": "colloquial"}
{"nl": "calendar for the whole year", "bash": "cal 2026", "category": "colloquial"}
{"nl": "what timezone am i in", "bash": "timedatectl | grep 'Time zone'", "category": "colloquial"}
{"nl": "count how many lines are in this file", "bash": "wc -l ~/Documents/longreport.txt", "category": "colloquial"}
{"nl": "how many words is my essay", "bash": "wc -w ~/Documents/essay.txt", "category": "colloquial"}
{"nl": "character count of this file", "bash": "wc -c ~/Documents/article.md", "category": "colloquial"}
{"nl": "show me unique lines in this list", "bash": "sort -u ~/Documents/emails.txt", "category": "colloquial"}
{"nl": "how many unique entries in this file", "bash": "sort -u ~/Documents/emails.txt | wc -l", "category": "colloquial"}
{"nl": "get rid of duplicate lines in this csv", "bash": "sort -u -o ~/Documents/data.csv ~/Documents/data.csv", "category": "colloquial"}
{"nl": "alphabetize this list of names", "bash": "sort -o ~/Documents/names.txt ~/Documents/names.txt", "category": "colloquial"}
{"nl": "sort this number list smallest to largest", "bash": "sort -n -o ~/Documents/numbers.txt ~/Documents/numbers.txt", "category": "colloquial"}
{"nl": "reverse the order of lines in this file", "bash": "tac ~/Documents/notes.txt > ~/Documents/notes_reversed.txt", "category": "colloquial"}
{"nl": "shuffle these lines randomly", "bash": "shuf ~/Documents/list.txt > ~/Documents/shuffled.txt", "category": "colloquial"}
{"nl": "first 50 lines of this giant log", "bash": "head -50 ~/logs/app.log", "category": "colloquial"}
{"nl": "last 200 lines of this csv file", "bash": "tail -200 ~/Documents/transactions.csv", "category": "colloquial"}
{"nl": "see lines 100 to 120 of this file", "bash": "sed -n '100,120p' ~/Documents/longreport.txt", "category": "colloquial"}
{"nl": "save my current work in git", "bash": "git -C ~/projects/myapp add -A && git -C ~/projects/myapp commit -m 'wip'", "category": "colloquial"}
{"nl": "what files have i changed since last commit", "bash": "git -C ~/projects/myapp status", "category": "colloquial"}
{"nl": "show me what changed in this project", "bash": "git -C ~/projects/myapp diff", "category": "colloquial"}
{"nl": "see my recent commits", "bash": "git -C ~/projects/myapp log --oneline -20", "category": "colloquial"}
{"nl": "how do i undo my last commit but keep the changes", "bash": "git -C ~/projects/myapp reset --soft HEAD~1", "category": "colloquial"}
{"nl": "push my changes up to github", "bash": "git -C ~/projects/myapp push", "category": "colloquial"}
{"nl": "download the latest from github", "bash": "git -C ~/projects/myapp pull", "category": "colloquial"}
{"nl": "clone the dotfiles repo onto my computer", "bash": "git clone https://github.com/$USER/dotfiles.git ~/projects/dotfiles", "category": "colloquial"}
{"nl": "which branch am i on", "bash": "git -C ~/projects/myapp branch --show-current", "category": "colloquial"}
{"nl": "switch to the develop branch", "bash": "git -C ~/projects/myapp checkout develop", "category": "colloquial"}
{"nl": "make a new branch called fix-login", "bash": "git -C ~/projects/myapp checkout -b fix-login", "category": "colloquial"}
{"nl": "delete the old feature branch i finished with", "bash": "git -C ~/projects/myapp branch -d old-feature", "category": "colloquial"}
{"nl": "show me who edited this file last", "bash": "git -C ~/projects/myapp log -1 --pretty=format:'%an %ad' -- src/main.py", "category": "colloquial"}
{"nl": "open this folder in the file manager", "bash": "xdg-open ~/Documents", "category": "colloquial"}
{"nl": "open this pdf with the default viewer", "bash": "xdg-open ~/Documents/report.pdf", "category": "colloquial"}
{"nl": "preview this image", "bash": "xdg-open ~/Pictures/screenshot.png", "category": "colloquial"}
{"nl": "play this video file", "bash": "xdg-open ~/Videos/recording.mp4", "category": "colloquial"}
{"nl": "open a terminal here", "bash": "gnome-terminal --working-directory=$PWD 2>/dev/null || x-terminal-emulator", "category": "colloquial"}
{"nl": "which version of python do i have", "bash": "python3 --version", "category": "colloquial"}
{"nl": "which node version is installed", "bash": "node --version", "category": "colloquial"}
{"nl": "show me the bash version", "bash": "bash --version | head -1", "category": "colloquial"}
{"nl": "which version of ubuntu am i running", "bash": "lsb_release -a 2>/dev/null", "category": "colloquial"}
{"nl": "kernel version", "bash": "uname -r", "category": "colloquial"}
{"nl": "show me all my environment variables", "bash": "env", "category": "colloquial"}
{"nl": "what is my path variable", "bash": "echo $PATH", "category": "colloquial"}
{"nl": "where is the python executable", "bash": "which python3", "category": "colloquial"}
{"nl": "find where curl lives", "bash": "which curl", "category": "colloquial"}
{"nl": "history of commands i ran today", "bash": "history | tail -50", "category": "colloquial"}
{"nl": "clear my command history", "bash": "history -c && history -w", "category": "colloquial"}
{"nl": "rerun my last command", "bash": "!!", "category": "colloquial"}
{"nl": "search my command history for git push", "bash": "history | grep 'git push'", "category": "colloquial"}
{"nl": "make this script runnable", "bash": "chmod +x ~/scripts/deploy.sh", "category": "colloquial"}
{"nl": "give this shell script execute permission", "bash": "chmod +x ~/projects/myapp/build.sh", "category": "colloquial"}
{"nl": "lock down permissions on my ssh key", "bash": "chmod 600 ~/.ssh/id_ed25519", "category": "colloquial"}
{"nl": "fix permissions on my ssh folder", "bash": "chmod 700 ~/.ssh && chmod 600 ~/.ssh/id_* && chmod 644 ~/.ssh/*.pub", "category": "colloquial"}
{"nl": "see who owns this file", "bash": "stat -c '%U:%G' ~/Documents/report.pdf", "category": "colloquial"}
{"nl": "show me file permissions in this folder", "bash": "ls -la ~/Documents/", "category": "colloquial"}
{"nl": "rename all my jpgs to lowercase", "bash": "for f in ~/Pictures/*.JPG; do mv -- \"$f\" \"${f%.JPG}.jpg\"; done", "category": "colloquial"}
{"nl": "add a date prefix to all the pdfs in this folder", "bash": "for f in ~/Documents/*.pdf; do mv -- \"$f\" \"$(dirname \"$f\")/2026-05-28_$(basename \"$f\")\"; done", "category": "colloquial"}
{"nl": "rename file old.txt to new.txt", "bash": "mv ~/Documents/old.txt ~/Documents/new.txt", "category": "colloquial"}
{"nl": "change extension from .txt to .md on this file", "bash": "mv ~/Documents/notes.txt ~/Documents/notes.md", "category": "colloquial"}
{"nl": "copy this file path to my clipboard", "bash": "echo -n ~/Documents/report.pdf | xclip -selection clipboard", "category": "colloquial"}
{"nl": "paste from my clipboard into a file", "bash": "xclip -selection clipboard -o > ~/Documents/clipboard.txt", "category": "colloquial"}
{"nl": "get the md5 hash of this file", "bash": "md5sum ~/Downloads/installer.iso", "category": "colloquial"}
{"nl": "compute sha256 of this download", "bash": "sha256sum ~/Downloads/installer.iso", "category": "colloquial"}
{"nl": "verify the checksum of this iso matches", "bash": "sha256sum -c ~/Downloads/installer.iso.sha256", "category": "colloquial"}
{"nl": "open my bashrc in nano", "bash": "nano ~/.bashrc", "category": "colloquial"}
{"nl": "edit my vimrc", "bash": "nano ~/.vimrc", "category": "colloquial"}
{"nl": "open my ssh config", "bash": "nano ~/.ssh/config", "category": "colloquial"}
{"nl": "create a new bash alias", "bash": "echo \"alias ll='ls -lah'\" >> ~/.bashrc && source ~/.bashrc", "category": "colloquial"}
{"nl": "reload my bashrc", "bash": "source ~/.bashrc", "category": "colloquial"}
{"nl": "create a shortcut from my dotfiles to home", "bash": "ln -s ~/projects/dotfiles/.bashrc ~/.bashrc", "category": "colloquial"}
{"nl": "link this script into my path", "bash": "ln -s ~/projects/myapp/run.sh ~/.local/bin/run", "category": "colloquial"}
{"nl": "convert this png to jpg", "bash": "convert ~/Pictures/image.png ~/Pictures/image.jpg", "category": "colloquial"}
{"nl": "resize this image to 800 wide", "bash": "convert ~/Pictures/photo.jpg -resize 800x ~/Pictures/photo_small.jpg", "category": "colloquial"}
{"nl": "rotate this photo 90 degrees", "bash": "convert ~/Pictures/photo.jpg -rotate 90 ~/Pictures/photo_rotated.jpg", "category": "colloquial"}
{"nl": "merge these pdfs into one", "bash": "pdfunite ~/Documents/a.pdf ~/Documents/b.pdf ~/Documents/c.pdf ~/Documents/merged.pdf", "category": "colloquial"}
{"nl": "split this pdf into pages", "bash": "pdfseparate ~/Documents/book.pdf ~/Documents/page_%d.pdf", "category": "colloquial"}
{"nl": "convert this docx to pdf", "bash": "libreoffice --headless --convert-to pdf --outdir ~/Documents/ ~/Documents/report.docx", "category": "colloquial"}
{"nl": "extract text from this pdf", "bash": "pdftotext ~/Documents/article.pdf ~/Documents/article.txt", "category": "colloquial"}
{"nl": "convert this video to mp4", "bash": "ffmpeg -i ~/Videos/recording.mkv ~/Videos/recording.mp4", "category": "colloquial"}
{"nl": "extract audio from this video as mp3", "bash": "ffmpeg -i ~/Videos/lecture.mp4 -q:a 0 -map a ~/Music/lecture.mp3", "category": "colloquial"}
{"nl": "trim this video to the first 30 seconds", "bash": "ffmpeg -i ~/Videos/clip.mp4 -t 30 -c copy ~/Videos/clip_30s.mp4", "category": "colloquial"}
{"nl": "resize this video to 720p", "bash": "ffmpeg -i ~/Videos/big.mp4 -vf scale=-2:720 ~/Videos/big_720p.mp4", "category": "colloquial"}
{"nl": "take a screenshot of my whole screen", "bash": "gnome-screenshot -f ~/Pictures/screenshot.png", "category": "colloquial"}
{"nl": "screenshot just one window", "bash": "gnome-screenshot -w -f ~/Pictures/window.png", "category": "colloquial"}
{"nl": "my terminal is messed up reset it", "bash": "reset", "category": "colloquial"}
{"nl": "clear the screen", "bash": "clear", "category": "colloquial"}
{"nl": "show me everyone logged in", "bash": "who", "category": "colloquial"}
{"nl": "show me my username", "bash": "whoami", "category": "colloquial"}
{"nl": "which groups am i in", "bash": "groups", "category": "colloquial"}
{"nl": "change my password", "bash": "passwd", "category": "colloquial"}
{"nl": "set my hostname display", "bash": "echo $HOSTNAME", "category": "colloquial"}
{"nl": "list my scheduled jobs", "bash": "crontab -l", "category": "colloquial"}
{"nl": "edit my scheduled jobs", "bash": "crontab -e", "category": "colloquial"}
{"nl": "remove all my scheduled jobs", "bash": "crontab -r", "category": "colloquial"}
{"nl": "see all my shell aliases", "bash": "alias", "category": "colloquial"}
{"nl": "show me what ll points to", "bash": "type ll", "category": "colloquial"}
{"nl": "update the locate database so locate finds new files", "bash": "updatedb 2>/dev/null || sudo updatedb", "category": "colloquial"}
{"nl": "locate every file named config.json", "bash": "locate config.json", "category": "colloquial"}
{"nl": "show me all mounted drives", "bash": "mount | grep -E '^/dev'", "category": "colloquial"}
{"nl": "list usb drives plugged in", "bash": "lsblk -o NAME,SIZE,MOUNTPOINT,TYPE | grep -E 'disk|part'", "category": "colloquial"}
{"nl": "how full are all my mounts", "bash": "df -h", "category": "colloquial"}
{"nl": "show me a json file pretty printed", "bash": "python3 -m json.tool ~/Downloads/data.json", "category": "colloquial"}
{"nl": "validate this json file", "bash": "python3 -m json.tool ~/Downloads/data.json > /dev/null && echo valid", "category": "colloquial"}
{"nl": "convert tabs to spaces in this file", "bash": "expand -t 4 ~/projects/myapp/main.py > /tmp/main.py && mv /tmp/main.py ~/projects/myapp/main.py", "category": "colloquial"}
{"nl": "strip trailing whitespace from this file", "bash": "sed -i 's/[[:space:]]*$//' ~/projects/myapp/main.py", "category": "colloquial"}
{"nl": "show me the contents of this file in pages", "bash": "less ~/Documents/longreport.txt", "category": "colloquial"}
{"nl": "just print the file out", "bash": "cat ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "show this file with line numbers", "bash": "cat -n ~/projects/myapp/main.py", "category": "colloquial"}
{"nl": "dump this binary file as hex", "bash": "xxd ~/Downloads/file.bin | head -50", "category": "colloquial"}
{"nl": "what kind of file is this", "bash": "file ~/Downloads/unknown.bin", "category": "colloquial"}
{"nl": "how many files in my downloads folder", "bash": "ls -1 ~/Downloads | wc -l", "category": "colloquial"}
{"nl": "count the photos in my pictures folder", "bash": "find ~/Pictures -type f \\( -iname '*.jpg' -o -iname '*.png' \\) | wc -l", "category": "colloquial"}
{"nl": "eject the usb drive", "bash": "udisksctl unmount -b /dev/sdb1 && udisksctl power-off -b /dev/sdb", "category": "colloquial"}
{"nl": "safely remove this external disk", "bash": "udisksctl unmount -b /dev/sdb1", "category": "colloquial"}
{"nl": "mount that usb stick", "bash": "udisksctl mount -b /dev/sdb1", "category": "colloquial"}
{"nl": "turn the volume up to 80 percent", "bash": "pactl set-sink-volume @DEFAULT_SINK@ 80%", "category": "colloquial"}
{"nl": "mute the sound", "bash": "pactl set-sink-mute @DEFAULT_SINK@ 1", "category": "colloquial"}
{"nl": "unmute audio", "bash": "pactl set-sink-mute @DEFAULT_SINK@ 0", "category": "colloquial"}
{"nl": "which file in this folder is the biggest", "bash": "du -ah ~/Downloads | sort -hr | head -5", "category": "colloquial"}
{"nl": "top 20 biggest files anywhere in my home", "bash": "find ~ -type f -printf '%s %p\\n' 2>/dev/null | sort -nr | head -20", "category": "colloquial"}
{"nl": "is docker installed", "bash": "command -v docker && docker --version", "category": "colloquial"}
{"nl": "do i have nodejs", "bash": "command -v node && node --version", "category": "colloquial"}
{"nl": "check if git is installed", "bash": "command -v git && git --version", "category": "colloquial"}
{"nl": "backup my documents to my external drive", "bash": "rsync -av --progress ~/Documents/ /media/$USER/BACKUP/Documents/", "category": "colloquial"}
{"nl": "mirror my code folder to the usb stick", "bash": "rsync -av --delete ~/projects/ /media/$USER/USB/projects/", "category": "colloquial"}
{"nl": "sync this folder with the remote server", "bash": "rsync -avz ~/projects/myapp/ user@server:/var/www/myapp/", "category": "colloquial"}
{"nl": "put my computer to sleep", "bash": "systemctl suspend", "category": "colloquial"}
{"nl": "lock the screen", "bash": "loginctl lock-session", "category": "colloquial"}
{"nl": "log me out", "bash": "loginctl terminate-user $USER", "category": "colloquial"}
{"nl": "how long until my battery dies", "bash": "acpi -b 2>/dev/null || upower -i $(upower -e | grep BAT) | grep -E 'time|percentage'", "category": "colloquial"}
{"nl": "show me battery percentage", "bash": "acpi -b 2>/dev/null | awk '{print $4}'", "category": "colloquial"}
{"nl": "list paired bluetooth devices", "bash": "bluetoothctl devices", "category": "colloquial"}
{"nl": "show my displays and resolution", "bash": "xrandr | grep ' connected'", "category": "colloquial"}
{"nl": "install nginx but it says i need permission", "bash": "sudo apt install -y nginx", "category": "sudo"}
{"nl": "i need to install vlc", "bash": "sudo apt install -y vlc", "category": "sudo"}
{"nl": "install git for me", "bash": "sudo apt install -y git", "category": "sudo"}
{"nl": "get firefox installed", "bash": "sudo apt install -y firefox", "category": "sudo"}
{"nl": "install python3 and pip", "bash": "sudo apt install -y python3 python3-pip", "category": "sudo"}
{"nl": "install node and npm", "bash": "sudo apt install -y nodejs npm", "category": "sudo"}
{"nl": "install build tools so i can compile stuff", "bash": "sudo apt install -y build-essential", "category": "sudo"}
{"nl": "install postgres database", "bash": "sudo apt install -y postgresql postgresql-contrib", "category": "sudo"}
{"nl": "install mysql server", "bash": "sudo apt install -y mysql-server", "category": "sudo"}
{"nl": "get docker installed", "bash": "sudo apt install -y docker.io", "category": "sudo"}
{"nl": "install the latest curl", "bash": "sudo apt install -y curl", "category": "sudo"}
{"nl": "apt says i dont have permission to install vim", "bash": "sudo apt install -y vim", "category": "sudo"}
{"nl": "install htop so i can see processes", "bash": "sudo apt install -y htop", "category": "sudo"}
{"nl": "get tmux installed", "bash": "sudo apt install -y tmux", "category": "sudo"}
{"nl": "install ffmpeg for video conversion", "bash": "sudo apt install -y ffmpeg", "category": "sudo"}
{"nl": "uninstall libreoffice i dont use it", "bash": "sudo apt remove -y libreoffice-*", "category": "sudo"}
{"nl": "remove the old version of php", "bash": "sudo apt remove -y php7.4 php7.4-*", "category": "sudo"}
{"nl": "get rid of snapd entirely", "bash": "sudo apt remove --purge -y snapd", "category": "sudo"}
{"nl": "update the list of available packages", "bash": "sudo apt update", "category": "sudo"}
{"nl": "install all available updates", "bash": "sudo apt upgrade -y", "category": "sudo"}
{"nl": "do a full system upgrade", "bash": "sudo apt full-upgrade -y", "category": "sudo"}
{"nl": "autoremove unused packages", "bash": "sudo apt autoremove -y", "category": "sudo"}
{"nl": "clean up the apt cache to save space", "bash": "sudo apt clean", "category": "sudo"}
{"nl": "fix broken packages it wont let me", "bash": "sudo apt --fix-broken install", "category": "sudo"}
{"nl": "reinstall the linux headers", "bash": "sudo apt install --reinstall -y linux-headers-$(uname -r)", "category": "sudo"}
{"nl": "add a new apt repository for vscode", "bash": "sudo add-apt-repository -y 'deb [arch=amd64] https://packages.microsoft.com/repos/code stable main'", "category": "sudo"}
{"nl": "install the .deb package i downloaded", "bash": "sudo dpkg -i ~/Downloads/package.deb", "category": "sudo"}
{"nl": "force remove this stuck package", "bash": "sudo dpkg --remove --force-remove-reinstreq broken-package", "category": "sudo"}
{"nl": "edit the apt sources list it says read only", "bash": "sudo nano /etc/apt/sources.list", "category": "sudo"}
{"nl": "modify my dns settings in resolv.conf", "bash": "sudo nano /etc/resolv.conf", "category": "sudo"}
{"nl": "edit the sudoers file", "bash": "sudo visudo", "category": "sudo"}
{"nl": "change the system hostname", "bash": "sudo hostnamectl set-hostname mydesktop", "category": "sudo"}
{"nl": "set the timezone to new york", "bash": "sudo timedatectl set-timezone America/New_York", "category": "sudo"}
{"nl": "sync clock with internet time", "bash": "sudo timedatectl set-ntp true", "category": "sudo"}
{"nl": "add a line to my system hosts file", "bash": "echo '192.168.1.50 myserver.local' | sudo tee -a /etc/hosts", "category": "sudo"}
{"nl": "update the motd login message", "bash": "echo 'Welcome to the office server' | sudo tee /etc/motd", "category": "sudo"}
{"nl": "edit the ssh server config", "bash": "sudo nano /etc/ssh/sshd_config", "category": "sudo"}
{"nl": "change the default editor system wide", "bash": "sudo update-alternatives --config editor", "category": "sudo"}
{"nl": "set vim as the default editor", "bash": "sudo update-alternatives --set editor /usr/bin/vim.basic", "category": "sudo"}
{"nl": "start nginx", "bash": "sudo systemctl start nginx", "category": "sudo"}
{"nl": "stop apache", "bash": "sudo systemctl stop apache2", "category": "sudo"}
{"nl": "restart the web server", "bash": "sudo systemctl restart nginx", "category": "sudo"}
{"nl": "reload nginx after my config change", "bash": "sudo systemctl reload nginx", "category": "sudo"}
{"nl": "restart the database", "bash": "sudo systemctl restart postgresql", "category": "sudo"}
{"nl": "enable docker to start at boot", "bash": "sudo systemctl enable docker", "category": "sudo"}
{"nl": "disable bluetooth from starting on boot", "bash": "sudo systemctl disable bluetooth", "category": "sudo"}
{"nl": "turn off the cups print service", "bash": "sudo systemctl stop cups && sudo systemctl disable cups", "category": "sudo"}
{"nl": "mask the snapd service so it never starts", "bash": "sudo systemctl mask snapd.service", "category": "sudo"}
{"nl": "unmask the firewall service", "bash": "sudo systemctl unmask ufw", "category": "sudo"}
{"nl": "start the firewall and enable at boot", "bash": "sudo systemctl enable --now ufw", "category": "sudo"}
{"nl": "reload systemd after editing a unit file", "bash": "sudo systemctl daemon-reload", "category": "sudo"}
{"nl": "flush my dns cache", "bash": "sudo systemd-resolve --flush-caches", "category": "sudo"}
{"nl": "renew my dhcp lease", "bash": "sudo dhclient -r && sudo dhclient", "category": "sudo"}
{"nl": "set a static ip address on eth0", "bash": "sudo nmcli con mod 'Wired connection 1' ipv4.method manual ipv4.addresses 192.168.1.50/24 ipv4.gateway 192.168.1.1", "category": "sudo"}
{"nl": "open port 80 in the firewall", "bash": "sudo ufw allow 80/tcp", "category": "sudo"}
{"nl": "open port 443 for https", "bash": "sudo ufw allow 443/tcp", "category": "sudo"}
{"nl": "allow ssh through the firewall", "bash": "sudo ufw allow 22/tcp", "category": "sudo"}
{"nl": "block port 8080", "bash": "sudo ufw deny 8080/tcp", "category": "sudo"}
{"nl": "see my firewall rules", "bash": "sudo ufw status verbose", "category": "sudo"}
{"nl": "enable the firewall", "bash": "sudo ufw enable", "category": "sudo"}
{"nl": "turn on rate limiting for ssh", "bash": "sudo ufw limit 22/tcp", "category": "sudo"}
{"nl": "add a new user named alice", "bash": "sudo adduser alice", "category": "sudo"}
{"nl": "delete the old user named bob", "bash": "sudo deluser --remove-home bob", "category": "sudo"}
{"nl": "add my user to the docker group", "bash": "sudo usermod -aG docker $USER", "category": "sudo"}
{"nl": "add myself to the sudo group", "bash": "sudo usermod -aG sudo $USER", "category": "sudo"}
{"nl": "remove alice from the sudo group", "bash": "sudo gpasswd -d alice sudo", "category": "sudo"}
{"nl": "create a new group called developers", "bash": "sudo groupadd developers", "category": "sudo"}
{"nl": "change alice's password", "bash": "sudo passwd alice", "category": "sudo"}
{"nl": "lock the bob account", "bash": "sudo usermod -L bob", "category": "sudo"}
{"nl": "unlock the bob account", "bash": "sudo usermod -U bob", "category": "sudo"}
{"nl": "change my login shell to zsh", "bash": "sudo chsh -s /usr/bin/zsh $USER", "category": "sudo"}
{"nl": "give myself ownership of opt myapp", "bash": "sudo chown -R $USER:$USER /opt/myapp", "category": "sudo"}
{"nl": "make this binary in usr local bin owned by root", "bash": "sudo chown root:root /usr/local/bin/myapp", "category": "sudo"}
{"nl": "set var www to be owned by www-data", "bash": "sudo chown -R www-data:www-data /var/www", "category": "sudo"}
{"nl": "fix the ownership of my postgres data dir", "bash": "sudo chown -R postgres:postgres /var/lib/postgresql", "category": "sudo"}
{"nl": "make /opt readable by everyone", "bash": "sudo chmod -R o+r /opt/sharedapp", "category": "sudo"}
{"nl": "set the setuid bit on this binary so it runs as root", "bash": "sudo chmod u+s /usr/local/bin/myhelper", "category": "sudo"}
{"nl": "remove the setuid bit from this binary", "bash": "sudo chmod u-s /usr/local/bin/myhelper", "category": "sudo"}
{"nl": "make the sticky bit set on /tmp", "bash": "sudo chmod +t /tmp", "category": "sudo"}
{"nl": "create a new systemd unit file for my app", "bash": "sudo nano /etc/systemd/system/myapp.service", "category": "sudo"}
{"nl": "write a new cron job in etc cron daily", "bash": "sudo nano /etc/cron.daily/backup-task", "category": "sudo"}
{"nl": "add a new udev rule for my usb device", "bash": "sudo nano /etc/udev/rules.d/99-myusb.rules", "category": "sudo"}
{"nl": "reload udev rules after editing", "bash": "sudo udevadm control --reload-rules && sudo udevadm trigger", "category": "sudo"}
{"nl": "regenerate the grub config after editing default", "bash": "sudo update-grub", "category": "sudo"}
{"nl": "edit the grub default settings", "bash": "sudo nano /etc/default/grub", "category": "sudo"}
{"nl": "add my ssh key to the root authorized keys", "bash": "sudo mkdir -p /root/.ssh && cat ~/.ssh/id_ed25519.pub | sudo tee -a /root/.ssh/authorized_keys", "category": "sudo"}
{"nl": "create a swap file 4gb in size", "bash": "sudo fallocate -l 4G /swapfile && sudo chmod 600 /swapfile && sudo mkswap /swapfile && sudo swapon /swapfile", "category": "sudo"}
{"nl": "turn off swap temporarily", "bash": "sudo swapoff -a", "category": "sudo"}
{"nl": "turn swap back on", "bash": "sudo swapon -a", "category": "sudo"}
{"nl": "mount my external drive sdb1 to /mnt/data", "bash": "sudo mkdir -p /mnt/data && sudo mount /dev/sdb1 /mnt/data", "category": "sudo"}
{"nl": "unmount the cdrom", "bash": "sudo umount /media/cdrom", "category": "sudo"}
{"nl": "force unmount this stuck drive", "bash": "sudo umount -l /mnt/data", "category": "sudo"}
{"nl": "format the usb as fat32", "bash": "sudo mkfs.vfat -F 32 /dev/sdb1", "category": "sudo"}
{"nl": "format the new disk as ext4", "bash": "sudo mkfs.ext4 /dev/sdb1", "category": "sudo"}
{"nl": "check the filesystem on this disk", "bash": "sudo fsck -y /dev/sdb1", "category": "sudo"}
{"nl": "show partition table for sda", "bash": "sudo fdisk -l /dev/sda", "category": "sudo"}
{"nl": "list all block devices with mount info", "bash": "sudo lsblk -f", "category": "sudo"}
{"nl": "clear out journalctl logs older than 2 weeks", "bash": "sudo journalctl --vacuum-time=2weeks", "category": "sudo"}
{"nl": "limit journal logs to 500mb total", "bash": "sudo journalctl --vacuum-size=500M", "category": "sudo"}
{"nl": "rotate the system logs now", "bash": "sudo logrotate -f /etc/logrotate.conf", "category": "sudo"}
{"nl": "read the auth log", "bash": "sudo cat /var/log/auth.log", "category": "sudo"}
{"nl": "see who tried to ssh in", "bash": "sudo grep 'Failed password' /var/log/auth.log | tail -20", "category": "sudo"}
{"nl": "watch the apache error log live", "bash": "sudo tail -f /var/log/apache2/error.log", "category": "sudo"}
{"nl": "clear the apache access log", "bash": "sudo truncate -s 0 /var/log/apache2/access.log", "category": "sudo"}
{"nl": "load the wireguard kernel module", "bash": "sudo modprobe wireguard", "category": "sudo"}
{"nl": "unload the bluetooth module", "bash": "sudo modprobe -r btusb", "category": "sudo"}
{"nl": "see all loaded kernel modules", "bash": "sudo lsmod", "category": "sudo"}
{"nl": "blacklist the nouveau module", "bash": "echo 'blacklist nouveau' | sudo tee /etc/modprobe.d/blacklist-nouveau.conf", "category": "sudo"}
{"nl": "update the initramfs", "bash": "sudo update-initramfs -u", "category": "sudo"}
{"nl": "reboot the machine", "bash": "sudo reboot", "category": "sudo"}
{"nl": "shut down the computer", "bash": "sudo shutdown -h now", "category": "sudo"}
{"nl": "schedule a shutdown in 30 minutes", "bash": "sudo shutdown -h +30", "category": "sudo"}
{"nl": "cancel the scheduled shutdown", "bash": "sudo shutdown -c", "category": "sudo"}
{"nl": "check disk health on sda", "bash": "sudo smartctl -H /dev/sda", "category": "sudo"}
{"nl": "run a quick disk self test", "bash": "sudo smartctl -t short /dev/sda", "category": "sudo"}
{"nl": "copy this script into /usr/local/bin so everyone can run it", "bash": "sudo cp ~/scripts/deploy.sh /usr/local/bin/deploy && sudo chmod +x /usr/local/bin/deploy", "category": "sudo"}
{"nl": "install this python package system wide", "bash": "sudo pip3 install requests", "category": "sudo"}
{"nl": "install a global npm package", "bash": "sudo npm install -g typescript", "category": "sudo"}
{"nl": "write to /etc/environment", "bash": "echo 'EDITOR=vim' | sudo tee -a /etc/environment", "category": "sudo"}
{"nl": "change the system locale to en_US", "bash": "sudo update-locale LANG=en_US.UTF-8", "category": "sudo"}
{"nl": "regenerate the ca certificates", "bash": "sudo update-ca-certificates", "category": "sudo"}
{"nl": "install a new font into the system fonts folder", "bash": "sudo cp ~/Downloads/MyFont.ttf /usr/share/fonts/truetype/ && sudo fc-cache -fv", "category": "sudo"}
{"nl": "set the default python to python3", "bash": "sudo update-alternatives --install /usr/bin/python python /usr/bin/python3 1", "category": "sudo"}
{"nl": "clear the systemd-resolve cache", "bash": "sudo systemd-resolve --flush-caches", "category": "sudo"}
{"nl": "delete the contents of /var/cache/apt/archives", "bash": "sudo rm -rf /var/cache/apt/archives/*.deb", "category": "sudo"}
{"nl": "clear the systemd journal for nginx unit", "bash": "sudo journalctl --rotate && sudo journalctl --vacuum-time=1s --unit=nginx", "category": "sudo"}
{"nl": "rename a system binary to a backup name", "bash": "sudo mv /usr/local/bin/oldcli /usr/local/bin/oldcli.bak", "category": "sudo"}
{"nl": "delete an unused systemd unit file", "bash": "sudo rm /etc/systemd/system/oldapp.service && sudo systemctl daemon-reload", "category": "sudo"}
{"nl": "change the boot splash background", "bash": "sudo cp ~/Pictures/splash.png /usr/share/plymouth/themes/spinner/watermark.png && sudo update-initramfs -u", "category": "sudo"}
{"nl": "add a new path to /etc/profile.d", "bash": "echo 'export PATH=$PATH:/opt/mytool/bin' | sudo tee /etc/profile.d/mytool.sh", "category": "sudo"}
{"nl": "set immutable flag on resolv.conf so nothing changes it", "bash": "sudo chattr +i /etc/resolv.conf", "category": "sudo"}
{"nl": "remove the immutable flag from resolv.conf", "bash": "sudo chattr -i /etc/resolv.conf", "category": "sudo"}
{"nl": "touch a file in /var/log", "bash": "sudo touch /var/log/myapp.log", "category": "sudo"}
{"nl": "change owner of /var/log/myapp.log to my user", "bash": "sudo chown $USER:$USER /var/log/myapp.log", "category": "sudo"}
{"nl": "install certbot for ssl", "bash": "sudo apt install -y certbot python3-certbot-nginx", "category": "sudo"}
{"nl": "get a new ssl certificate for my domain", "bash": "sudo certbot --nginx -d example.com", "category": "sudo"}
{"nl": "renew all my ssl certificates", "bash": "sudo certbot renew", "category": "sudo"}
{"nl": "show me hidden files in my home folder", "bash": "ls -la ~ | grep '^\\.\\|^d.*\\.[^.]'", "category": "colloquial"}
{"nl": "list everything including hidden stuff in this folder", "bash": "ls -la", "category": "colloquial"}
{"nl": "how big is this folder really", "bash": "du -sh ~/projects/myapp", "category": "colloquial"}
{"nl": "count how many files are in here including subfolders", "bash": "find ~/projects/myapp -type f | wc -l", "category": "colloquial"}
{"nl": "show file tree of this directory", "bash": "tree ~/projects/myapp 2>/dev/null || find ~/projects/myapp -print | sed 's;[^/]*/;|-- ;g'", "category": "colloquial"}
{"nl": "just two levels deep of the folder tree", "bash": "tree -L 2 ~/projects 2>/dev/null", "category": "colloquial"}
{"nl": "preview the first few lines of every txt file in this folder", "bash": "for f in ~/Documents/*.txt; do echo \"--- $f ---\"; head -3 \"$f\"; done", "category": "colloquial"}
{"nl": "move all my photos from downloads to pictures", "bash": "mv ~/Downloads/*.jpg ~/Downloads/*.png ~/Pictures/ 2>/dev/null", "category": "colloquial"}
{"nl": "copy this whole folder structure to my backup drive", "bash": "cp -r ~/projects/myapp /media/$USER/BACKUP/", "category": "colloquial"}
{"nl": "move everything older than 30 days from downloads to archive", "bash": "find ~/Downloads -maxdepth 1 -type f -mtime +30 -exec mv {} ~/Archive/ \\;", "category": "colloquial"}
{"nl": "show me the 10 most recently changed files in my projects folder", "bash": "find ~/projects -type f -printf '%T@ %p\\n' 2>/dev/null | sort -nr | head -10 | cut -d' ' -f2-", "category": "colloquial"}
{"nl": "which file did i edit most recently", "bash": "find ~ -type f -printf '%T@ %p\\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-", "category": "colloquial"}
{"nl": "convert this windows text file to unix line endings", "bash": "dos2unix ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "convert unix file to windows line endings", "bash": "unix2dos ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "check the encoding of this text file", "bash": "file -i ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "convert this file from latin1 to utf8", "bash": "iconv -f ISO-8859-1 -t UTF-8 ~/Documents/old.txt -o ~/Documents/new.txt", "category": "colloquial"}
{"nl": "show me my mac address", "bash": "ip link show | grep ether", "category": "colloquial"}
{"nl": "which port is the ssh daemon listening on", "bash": "ss -tlnp | grep ssh", "category": "colloquial"}
{"nl": "show me all listening ports with the program names", "bash": "ss -tlnp", "category": "colloquial"}
{"nl": "test if port 443 is open on github.com", "bash": "nc -zv github.com 443", "category": "colloquial"}
{"nl": "scan my own machine for open ports", "bash": "ss -tln", "category": "colloquial"}
{"nl": "show me a tree of all running processes", "bash": "ps -ef --forest | head -30", "category": "colloquial"}
{"nl": "which process is the parent of this firefox instance", "bash": "ps -o ppid= -p $(pgrep -n firefox 2>/dev/null) 2>/dev/null", "category": "colloquial"}
{"nl": "kill all processes started by my user", "bash": "pkill -u $USER -f myapp", "category": "colloquial"}
{"nl": "send sigterm to the python script i started", "bash": "pkill -f 'python.*myscript.py'", "category": "colloquial"}
{"nl": "how much memory is my chrome using total", "bash": "ps -C chrome -o rss= | awk '{sum+=$1} END {print sum/1024 \" MB\"}'", "category": "colloquial"}
{"nl": "list my running docker containers", "bash": "docker ps", "category": "colloquial"}
{"nl": "show all containers including stopped ones", "bash": "docker ps -a", "category": "colloquial"}
{"nl": "see my docker images", "bash": "docker images", "category": "colloquial"}
{"nl": "stop the postgres container", "bash": "docker stop postgres", "category": "colloquial"}
{"nl": "restart the redis container", "bash": "docker restart redis", "category": "colloquial"}
{"nl": "see logs from my web app container", "bash": "docker logs -f myapp", "category": "colloquial"}
{"nl": "remove stopped containers", "bash": "docker container prune -f", "category": "colloquial"}
{"nl": "clean up unused docker images", "bash": "docker image prune -a -f", "category": "colloquial"}
{"nl": "how much space is docker using", "bash": "docker system df", "category": "colloquial"}
{"nl": "make a new python virtual environment", "bash": "python3 -m venv ~/venvs/myenv", "category": "colloquial"}
{"nl": "activate my virtual env", "bash": "source ~/venvs/myenv/bin/activate", "category": "colloquial"}
{"nl": "install requests in my venv", "bash": "~/venvs/myenv/bin/pip install requests", "category": "colloquial"}
{"nl": "show me installed python packages", "bash": "pip list", "category": "colloquial"}
{"nl": "freeze my requirements to a file", "bash": "pip freeze > ~/projects/myapp/requirements.txt", "category": "colloquial"}
{"nl": "install everything in requirements.txt", "bash": "pip install -r ~/projects/myapp/requirements.txt", "category": "colloquial"}
{"nl": "install dependencies for this node project", "bash": "cd ~/projects/myapp && npm install", "category": "colloquial"}
{"nl": "run the start script for this node project", "bash": "cd ~/projects/myapp && npm start", "category": "colloquial"}
{"nl": "update all my npm packages", "bash": "cd ~/projects/myapp && npm update", "category": "colloquial"}
{"nl": "look up a word in the dictionary", "bash": "dict 'serendipity' 2>/dev/null", "category": "colloquial"}
{"nl": "encode this string to base64", "bash": "echo -n 'hello world' | base64", "category": "colloquial"}
{"nl": "decode this base64 string", "bash": "echo 'aGVsbG8gd29ybGQ=' | base64 -d", "category": "colloquial"}
{"nl": "url encode this string", "bash": "python3 -c 'import urllib.parse; print(urllib.parse.quote(\"hello world & friends\"))'", "category": "colloquial"}
{"nl": "generate a random password", "bash": "openssl rand -base64 16", "category": "colloquial"}
{"nl": "generate a uuid", "bash": "uuidgen", "category": "colloquial"}
{"nl": "get random bytes in hex", "bash": "openssl rand -hex 32", "category": "colloquial"}
{"nl": "ssh into my server", "bash": "ssh user@myserver.example.com", "category": "colloquial"}
{"nl": "copy this file to my server", "bash": "scp ~/Documents/report.pdf user@myserver.example.com:~/", "category": "colloquial"}
{"nl": "download a file from my server", "bash": "scp user@myserver.example.com:~/data.csv ~/Downloads/", "category": "colloquial"}
{"nl": "show me my ssh keys", "bash": "ls -la ~/.ssh/*.pub", "category": "colloquial"}
{"nl": "generate a new ssh key pair", "bash": "ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N ''", "category": "colloquial"}
{"nl": "copy my ssh key to a server", "bash": "ssh-copy-id user@myserver.example.com", "category": "colloquial"}
{"nl": "see what ssh agent has loaded", "bash": "ssh-add -l", "category": "colloquial"}
{"nl": "add my private key to ssh agent", "bash": "ssh-add ~/.ssh/id_ed25519", "category": "colloquial"}
{"nl": "see who wrote each line of this file", "bash": "git -C ~/projects/myapp blame src/main.py", "category": "colloquial"}
{"nl": "stash my work to come back to later", "bash": "git -C ~/projects/myapp stash", "category": "colloquial"}
{"nl": "bring back my stashed work", "bash": "git -C ~/projects/myapp stash pop", "category": "colloquial"}
{"nl": "see what i stashed away", "bash": "git -C ~/projects/myapp stash list", "category": "colloquial"}
{"nl": "discard all my uncommitted changes", "bash": "git -C ~/projects/myapp checkout -- .", "category": "colloquial"}
{"nl": "see commits from last week", "bash": "git -C ~/projects/myapp log --since='1 week ago' --oneline", "category": "colloquial"}
{"nl": "show me changes between this commit and the last", "bash": "git -C ~/projects/myapp diff HEAD~1 HEAD", "category": "colloquial"}
{"nl": "am i on wayland or x11", "bash": "echo $XDG_SESSION_TYPE", "category": "colloquial"}
{"nl": "set my screen brightness to half", "bash": "brightnessctl set 50%", "category": "colloquial"}
{"nl": "set screen brightness to maximum", "bash": "brightnessctl set 100%", "category": "colloquial"}
{"nl": "show me only unique lines that appear at least twice", "bash": "sort ~/Documents/list.txt | uniq -d", "category": "colloquial"}
{"nl": "count how many times each line appears", "bash": "sort ~/Documents/list.txt | uniq -c | sort -nr", "category": "colloquial"}
{"nl": "get only the second column of this csv", "bash": "cut -d',' -f2 ~/Documents/data.csv", "category": "colloquial"}
{"nl": "extract the username field from /etc/passwd", "bash": "cut -d':' -f1 /etc/passwd", "category": "colloquial"}
{"nl": "join these two sorted files", "bash": "join ~/Documents/a.txt ~/Documents/b.txt", "category": "colloquial"}
{"nl": "paste these files side by side", "bash": "paste ~/Documents/a.txt ~/Documents/b.txt", "category": "colloquial"}
{"nl": "schedule a script to run every day at 9am", "bash": "(crontab -l 2>/dev/null; echo '0 9 * * * /home/$USER/scripts/morning.sh') | crontab -", "category": "colloquial"}
{"nl": "run a backup every sunday at midnight", "bash": "(crontab -l 2>/dev/null; echo '0 0 * * 0 /home/$USER/scripts/backup.sh') | crontab -", "category": "colloquial"}
{"nl": "schedule cleanup every hour", "bash": "(crontab -l 2>/dev/null; echo '0 * * * * /home/$USER/scripts/cleanup.sh') | crontab -", "category": "colloquial"}
{"nl": "install vscode it needs admin", "bash": "sudo apt install -y code", "category": "sudo"}
{"nl": "install zsh as the shell", "bash": "sudo apt install -y zsh", "category": "sudo"}
{"nl": "get the redis server installed", "bash": "sudo apt install -y redis-server", "category": "sudo"}
{"nl": "install rabbitmq", "bash": "sudo apt install -y rabbitmq-server", "category": "sudo"}
{"nl": "install wireguard vpn", "bash": "sudo apt install -y wireguard", "category": "sudo"}
{"nl": "install openvpn package", "bash": "sudo apt install -y openvpn", "category": "sudo"}
{"nl": "install fail2ban for security", "bash": "sudo apt install -y fail2ban", "category": "sudo"}
{"nl": "install net tools so i have ifconfig", "bash": "sudo apt install -y net-tools", "category": "sudo"}
{"nl": "install network manager", "bash": "sudo apt install -y network-manager", "category": "sudo"}
{"nl": "get the linux source headers", "bash": "sudo apt install -y linux-source", "category": "sudo"}
{"nl": "install nvidia drivers", "bash": "sudo apt install -y nvidia-driver-535", "category": "sudo"}
{"nl": "get the gnome desktop", "bash": "sudo apt install -y ubuntu-desktop", "category": "sudo"}
{"nl": "install the kde plasma desktop", "bash": "sudo apt install -y kubuntu-desktop", "category": "sudo"}
{"nl": "update my system and remove old kernels", "bash": "sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove --purge -y", "category": "sudo"}
{"nl": "start the ssh server", "bash": "sudo systemctl enable --now ssh", "category": "sudo"}
{"nl": "disable ssh root login", "bash": "sudo sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && sudo systemctl reload ssh", "category": "sudo"}
{"nl": "change the ssh port to 2222", "bash": "sudo sed -i 's/^#*Port .*/Port 2222/' /etc/ssh/sshd_config && sudo systemctl reload ssh", "category": "sudo"}
{"nl": "disable ssh password login", "bash": "sudo sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config && sudo systemctl reload ssh", "category": "sudo"}
{"nl": "trust this self-signed cert system wide", "bash": "sudo cp ~/Downloads/mycert.crt /usr/local/share/ca-certificates/mycert.crt && sudo update-ca-certificates", "category": "sudo"}
{"nl": "add this nfs share to fstab so it mounts at boot", "bash": "echo 'server.example.com:/data /mnt/data nfs defaults 0 0' | sudo tee -a /etc/fstab", "category": "sudo"}
{"nl": "mount everything in fstab now", "bash": "sudo mount -a", "category": "sudo"}
{"nl": "enable ip forwarding", "bash": "echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/99-ipforward.conf && sudo sysctl --system", "category": "sudo"}
{"nl": "increase the max file watches", "bash": "echo 'fs.inotify.max_user_watches=524288' | sudo tee /etc/sysctl.d/99-watches.conf && sudo sysctl --system", "category": "sudo"}
{"nl": "disable ipv6 system wide", "bash": "echo 'net.ipv6.conf.all.disable_ipv6=1' | sudo tee /etc/sysctl.d/99-disable-ipv6.conf && sudo sysctl --system", "category": "sudo"}
{"nl": "remove old kernel versions", "bash": "sudo apt autoremove --purge -y", "category": "sudo"}
{"nl": "change a user's home directory", "bash": "sudo usermod -d /home/newhome -m alice", "category": "sudo"}
{"nl": "set account expiration for alice", "bash": "sudo chage -E 2026-12-31 alice", "category": "sudo"}
{"nl": "force alice to change password on next login", "bash": "sudo passwd -e alice", "category": "sudo"}
{"nl": "enable site config in nginx", "bash": "sudo ln -s /etc/nginx/sites-available/mysite /etc/nginx/sites-enabled/mysite && sudo nginx -t && sudo systemctl reload nginx", "category": "sudo"}
{"nl": "disable a nginx site", "bash": "sudo rm /etc/nginx/sites-enabled/oldsite && sudo systemctl reload nginx", "category": "sudo"}
{"nl": "test the nginx config is valid", "bash": "sudo nginx -t", "category": "sudo"}
{"nl": "enable an apache module", "bash": "sudo a2enmod rewrite && sudo systemctl reload apache2", "category": "sudo"}
{"nl": "enable apache site config", "bash": "sudo a2ensite mysite && sudo systemctl reload apache2", "category": "sudo"}
{"nl": "create a new postgres user", "bash": "sudo -u postgres createuser alice", "category": "sudo"}
{"nl": "create a postgres database", "bash": "sudo -u postgres createdb mydb", "category": "sudo"}
{"nl": "access the postgres prompt", "bash": "sudo -u postgres psql", "category": "sudo"}
{"nl": "reset the mysql root password", "bash": "sudo mysqladmin -u root password 'newSecurePass123'", "category": "sudo"}
{"nl": "install vlc via snap", "bash": "sudo snap install vlc", "category": "sudo"}
{"nl": "block ssh from a specific ip in hosts.deny", "bash": "echo 'sshd: 203.0.113.55' | sudo tee -a /etc/hosts.deny", "category": "sudo"}
{"nl": "I need to find that pdf I downloaded yesterday somewhere", "bash": "find ~/Downloads -name '*.pdf' -mtime -2", "category": "colloquial"}
{"nl": "where did I put that word document about taxes", "bash": "find ~ -iname '*tax*.docx' 2>/dev/null", "category": "colloquial"}
{"nl": "show me all the pictures in my downloads folder", "bash": "ls ~/Downloads/*.{jpg,jpeg,png,gif,heic} 2>/dev/null", "category": "colloquial"}
{"nl": "I lost a file called budget somewhere on my computer", "bash": "find ~ -iname 'budget*' 2>/dev/null", "category": "colloquial"}
{"nl": "search for any file with the word invoice in the name", "bash": "find ~ -iname '*invoice*' 2>/dev/null", "category": "colloquial"}
{"nl": "look for all the screenshots I took today", "bash": "find ~/Pictures -name 'Screenshot*' -mtime -1", "category": "colloquial"}
{"nl": "find every text file in my documents", "bash": "find ~/Documents -type f -name '*.txt'", "category": "colloquial"}
{"nl": "where are all my python files", "bash": "find ~ -name '*.py' -type f 2>/dev/null", "category": "colloquial"}
{"nl": "I need to see all the videos on my computer", "bash": "find ~ -type f \\( -iname '*.mp4' -o -iname '*.mov' -o -iname '*.mkv' \\) 2>/dev/null", "category": "colloquial"}
{"nl": "show me files that were changed in the last hour", "bash": "find ~ -type f -mmin -60 2>/dev/null", "category": "colloquial"}
{"nl": "I want to find files bigger than 100 megabytes", "bash": "find ~ -type f -size +100M 2>/dev/null", "category": "colloquial"}
{"nl": "rename this file to something else", "bash": "mv ~/Documents/old_name.txt ~/Documents/new_name.txt", "category": "colloquial"}
{"nl": "I want to rename my resume from draft to final", "bash": "mv ~/Documents/resume_draft.pdf ~/Documents/resume_final.pdf", "category": "colloquial"}
{"nl": "change the name of this folder from temp to archive", "bash": "mv ~/Desktop/temp ~/Desktop/archive", "category": "colloquial"}
{"nl": "move this picture to my pictures folder", "bash": "mv ~/Downloads/photo.jpg ~/Pictures/", "category": "colloquial"}
{"nl": "move all my downloaded pdfs into the documents folder", "bash": "mv ~/Downloads/*.pdf ~/Documents/", "category": "colloquial"}
{"nl": "move the project folder from desktop to my projects directory", "bash": "mv ~/Desktop/myproject ~/projects/", "category": "colloquial"}
{"nl": "I want to move all jpg files into a photos subfolder", "bash": "mkdir -p ~/photos && mv ~/*.jpg ~/photos/", "category": "colloquial"}
{"nl": "copy this folder and everything in it to the backup drive", "bash": "cp -r ~/Documents/important /media/backup/", "category": "colloquial"}
{"nl": "copy my entire downloads folder to the external drive", "bash": "cp -r ~/Downloads /media/usb/", "category": "colloquial"}
{"nl": "duplicate this project folder so I can experiment", "bash": "cp -r ~/projects/myapp ~/projects/myapp_experimental", "category": "colloquial"}
{"nl": "make an exact mirror of my pictures folder on the backup disk", "bash": "rsync -av ~/Pictures/ /media/backup/Pictures/", "category": "colloquial"}
{"nl": "sync my documents to the external drive but only the new stuff", "bash": "rsync -avu ~/Documents/ /media/backup/Documents/", "category": "colloquial"}
{"nl": "back up only the files that changed since last time", "bash": "rsync -av --update ~/projects/ /media/backup/projects/", "category": "colloquial"}
{"nl": "I deleted a file by mistake can I get it back", "bash": "ls -la ~/.local/share/Trash/files/", "category": "colloquial"}
{"nl": "restore that file I just threw in the trash", "bash": "mv ~/.local/share/Trash/files/document.pdf ~/Documents/", "category": "colloquial"}
{"nl": "empty the trash for good", "bash": "rm -rf ~/.local/share/Trash/files/* ~/.local/share/Trash/info/*", "category": "colloquial"}
{"nl": "delete this old document I don't need anymore", "bash": "rm ~/Documents/old_notes.txt", "category": "colloquial"}
{"nl": "remove all the files ending in .tmp from my downloads", "bash": "rm ~/Downloads/*.tmp", "category": "colloquial"}
{"nl": "I want to delete every log file in this folder", "bash": "rm ~/projects/myapp/logs/*.log", "category": "colloquial"}
{"nl": "delete this entire folder of old work", "bash": "rm -rf ~/Desktop/old_project", "category": "colloquial"}
{"nl": "wipe out all the cached files in this folder", "bash": "rm -rf ~/.cache/myapp/*", "category": "colloquial"}
{"nl": "unzip this archive I just downloaded", "bash": "unzip ~/Downloads/archive.zip -d ~/Downloads/", "category": "colloquial"}
{"nl": "extract this rar file someone sent me", "bash": "unrar x ~/Downloads/files.rar ~/Downloads/", "category": "colloquial"}
{"nl": "open this tar gz file I got from the internet", "bash": "tar -xzf ~/Downloads/source.tar.gz -C ~/Downloads/", "category": "colloquial"}
{"nl": "I have a 7z file how do I open it", "bash": "7z x ~/Downloads/files.7z -o/home/$USER/Downloads/", "category": "colloquial"}
{"nl": "unpack this tarball into my projects folder", "bash": "tar -xzf ~/Downloads/project.tar.gz -C ~/projects/", "category": "colloquial"}
{"nl": "make a zip of my project folder so I can email it", "bash": "zip -r ~/Desktop/project.zip ~/projects/myapp", "category": "colloquial"}
{"nl": "compress all my pictures into a single archive", "bash": "tar -czf ~/Desktop/pictures.tar.gz ~/Pictures/", "category": "colloquial"}
{"nl": "zip up these three files together", "bash": "zip ~/Desktop/bundle.zip ~/Documents/a.txt ~/Documents/b.txt ~/Documents/c.txt", "category": "colloquial"}
{"nl": "make a smaller version of this big folder", "bash": "tar -cJf ~/Desktop/folder.tar.xz ~/projects/bigproject", "category": "colloquial"}
{"nl": "see what's inside this zip file without extracting", "bash": "unzip -l ~/Downloads/archive.zip", "category": "colloquial"}
{"nl": "peek into this tarball to see what files are inside", "bash": "tar -tzf ~/Downloads/archive.tar.gz", "category": "colloquial"}
{"nl": "show me the contents of my pictures folder", "bash": "ls ~/Pictures/", "category": "colloquial"}
{"nl": "list everything in this folder with details", "bash": "ls -lh ~/Documents/", "category": "colloquial"}
{"nl": "I want to see my files sorted by date newest first", "bash": "ls -lt ~/Documents/", "category": "colloquial"}
{"nl": "show files in this folder sorted by size", "bash": "ls -lhS ~/Downloads/", "category": "colloquial"}
{"nl": "give me a tree view of my projects folder", "bash": "tree ~/projects/ -L 2", "category": "colloquial"}
{"nl": "count how many files are in my downloads folder", "bash": "ls ~/Downloads | wc -l", "category": "colloquial"}
{"nl": "how many photos do I have", "bash": "find ~/Pictures -type f \\( -iname '*.jpg' -o -iname '*.png' \\) | wc -l", "category": "colloquial"}
{"nl": "show me my hard drive space", "bash": "df -h", "category": "colloquial"}
{"nl": "how much disk do I have left", "bash": "df -h /", "category": "colloquial"}
{"nl": "what's eating up all my disk space", "bash": "du -h --max-depth=1 ~ | sort -hr | head -20", "category": "colloquial"}
{"nl": "find the biggest folders on my computer", "bash": "du -h --max-depth=2 / 2>/dev/null | sort -hr | head -20", "category": "colloquial"}
{"nl": "which folder in my home is the biggest", "bash": "du -sh ~/* | sort -hr | head -10", "category": "colloquial"}
{"nl": "show me the size of my downloads folder", "bash": "du -sh ~/Downloads", "category": "colloquial"}
{"nl": "how big is my pictures folder", "bash": "du -sh ~/Pictures", "category": "colloquial"}
{"nl": "find the largest 10 files anywhere in my home", "bash": "find ~ -type f -exec du -h {} + 2>/dev/null | sort -hr | head -10", "category": "colloquial"}
{"nl": "find files over 1 gigabyte hogging space", "bash": "find ~ -type f -size +1G 2>/dev/null", "category": "colloquial"}
{"nl": "I'm running out of space please help", "bash": "df -h && echo '---' && du -sh ~/* 2>/dev/null | sort -hr | head -10", "category": "colloquial"}
{"nl": "show all my mounted drives", "bash": "df -h --output=source,size,used,target | grep -v tmpfs", "category": "colloquial"}
{"nl": "how do I see all my partitions", "bash": "lsblk", "category": "colloquial"}
{"nl": "list all attached storage", "bash": "lsblk -o NAME,SIZE,TYPE,MOUNTPOINT", "category": "colloquial"}
{"nl": "show me the usb drives connected", "bash": "lsblk -o NAME,SIZE,VENDOR,MODEL,TRAN | grep usb", "category": "colloquial"}
{"nl": "did the system see my usb stick", "bash": "lsusb", "category": "colloquial"}
{"nl": "eject my external hard drive safely", "bash": "udisksctl unmount -b /dev/sdb1", "category": "colloquial"}
{"nl": "unmount the usb drive before I pull it out", "bash": "sudo umount /media/usb", "category": "colloquial"}
{"nl": "mount the usb drive at slash media slash mydrive", "bash": "sudo mount /dev/sdb1 /media/mydrive", "category": "colloquial"}
{"nl": "where is my external drive mounted", "bash": "mount | grep /dev/sd", "category": "colloquial"}
{"nl": "see all mounted filesystems", "bash": "mount | column -t", "category": "colloquial"}
{"nl": "how do I install chrome", "bash": "sudo apt update && sudo apt install -y google-chrome-stable", "category": "colloquial"}
{"nl": "install firefox", "bash": "sudo apt install -y firefox", "category": "colloquial"}
{"nl": "I want to install vim", "bash": "sudo apt install -y vim", "category": "colloquial"}
{"nl": "add the latest nodejs to my system", "bash": "curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash - && sudo apt install -y nodejs", "category": "colloquial"}
{"nl": "install vlc media player", "bash": "sudo apt install -y vlc", "category": "colloquial"}
{"nl": "I need the gimp image editor", "bash": "sudo apt install -y gimp", "category": "colloquial"}
{"nl": "I want to get discord", "bash": "sudo snap install discord", "category": "colloquial"}
{"nl": "add slack to my computer", "bash": "sudo snap install slack", "category": "colloquial"}
{"nl": "install zoom for video calls", "bash": "sudo snap install zoom-client", "category": "colloquial"}
{"nl": "I need to install git", "bash": "sudo apt install -y git", "category": "colloquial"}
{"nl": "install the latest python", "bash": "sudo apt install -y python3 python3-pip", "category": "colloquial"}
{"nl": "get me visual studio code", "bash": "sudo snap install code --classic", "category": "colloquial"}
{"nl": "install obs studio for recording", "bash": "sudo apt install -y obs-studio", "category": "colloquial"}
{"nl": "I want libreoffice", "bash": "sudo apt install -y libreoffice", "category": "colloquial"}
{"nl": "uninstall this program I don't use anymore", "bash": "sudo apt remove -y libreoffice", "category": "colloquial"}
{"nl": "remove chrome from my computer", "bash": "sudo apt remove -y google-chrome-stable", "category": "colloquial"}
{"nl": "get rid of an app I installed as a snap", "bash": "sudo snap remove discord", "category": "colloquial"}
{"nl": "completely uninstall this and its config files too", "bash": "sudo apt purge -y nginx", "category": "colloquial"}
{"nl": "clean up packages I don't need anymore", "bash": "sudo apt autoremove -y", "category": "colloquial"}
{"nl": "free up space from old downloaded installers", "bash": "sudo apt clean", "category": "colloquial"}
{"nl": "update all my software", "bash": "sudo apt update && sudo apt upgrade -y", "category": "colloquial"}
{"nl": "check if there are any updates available", "bash": "sudo apt update && apt list --upgradable", "category": "colloquial"}
{"nl": "upgrade just one specific package", "bash": "sudo apt install --only-upgrade -y firefox", "category": "colloquial"}
{"nl": "what version of firefox do I have", "bash": "firefox --version", "category": "colloquial"}
{"nl": "what version of python is installed", "bash": "python3 --version", "category": "colloquial"}
{"nl": "show me the version of git", "bash": "git --version", "category": "colloquial"}
{"nl": "is docker installed and what version", "bash": "docker --version", "category": "colloquial"}
{"nl": "list every program I installed", "bash": "apt list --installed 2>/dev/null", "category": "colloquial"}
{"nl": "search for an app related to photos", "bash": "apt search photo 2>/dev/null | head -20", "category": "colloquial"}
{"nl": "find a package that has the word audio", "bash": "apt-cache search audio | head -20", "category": "colloquial"}
{"nl": "my computer is running really slow today", "bash": "top -bn1 | head -20", "category": "colloquial"}
{"nl": "what's hogging my cpu right now", "bash": "ps aux --sort=-%cpu | head -10", "category": "colloquial"}
{"nl": "show me what's using all my ram", "bash": "ps aux --sort=-%mem | head -10", "category": "colloquial"}
{"nl": "is something stuck eating 100 percent cpu", "bash": "top -bn1 -o %CPU | head -15", "category": "colloquial"}
{"nl": "open the task manager equivalent", "bash": "htop", "category": "colloquial"}
{"nl": "show me all the programs that are running", "bash": "ps -ef", "category": "colloquial"}
{"nl": "list every running process", "bash": "ps aux", "category": "colloquial"}
{"nl": "is firefox still running in the background", "bash": "pgrep -fl firefox", "category": "colloquial"}
{"nl": "is my python script still going", "bash": "pgrep -fla python3", "category": "colloquial"}
{"nl": "find the process id of chrome", "bash": "pgrep -f chrome", "category": "colloquial"}
{"nl": "this app is frozen close it", "bash": "pkill -9 -f firefox", "category": "colloquial"}
{"nl": "force quit slack", "bash": "pkill -9 slack", "category": "colloquial"}
{"nl": "stop a stuck process by name", "bash": "pkill -f myapp", "category": "colloquial"}
{"nl": "kill the process that's using port 8080", "bash": "fuser -k 8080/tcp", "category": "colloquial"}
{"nl": "stop whatever is listening on port 3000", "bash": "fuser -k 3000/tcp", "category": "colloquial"}
{"nl": "I want to kill process number 4523", "bash": "kill 4523", "category": "colloquial"}
{"nl": "force kill that hung process", "bash": "kill -9 4523", "category": "colloquial"}
{"nl": "show me how much memory I have free", "bash": "free -h", "category": "colloquial"}
{"nl": "check my available memory", "bash": "free -m", "category": "colloquial"}
{"nl": "is my computer using a lot of swap", "bash": "free -h | grep -i swap", "category": "colloquial"}
{"nl": "is my cpu running hot", "bash": "sensors | grep -E 'Core|Package'", "category": "colloquial"}
{"nl": "see system load average", "bash": "uptime", "category": "colloquial"}
{"nl": "how long has my computer been running", "bash": "uptime -p", "category": "colloquial"}
{"nl": "show me cpu info", "bash": "lscpu", "category": "colloquial"}
{"nl": "what cpu am I using", "bash": "grep 'model name' /proc/cpuinfo | head -1", "category": "colloquial"}
{"nl": "see all my hardware specs", "bash": "sudo lshw -short", "category": "colloquial"}
{"nl": "what graphics card do I have", "bash": "lspci | grep -i vga", "category": "colloquial"}
{"nl": "is my gpu being used", "bash": "nvidia-smi 2>/dev/null || intel_gpu_top 2>/dev/null", "category": "colloquial"}
{"nl": "how much total memory does my computer have", "bash": "free -h | awk '/^Mem:/ {print $2}'", "category": "colloquial"}
{"nl": "kill any zombie processes", "bash": "ps -A -ostat,ppid | awk '/[zZ]/ {print $2}' | xargs -r kill -9", "category": "colloquial"}
{"nl": "show processes using more than 5 percent cpu", "bash": "ps aux | awk '$3 > 5 {print}'", "category": "colloquial"}
{"nl": "find the parent process of this one", "bash": "ps -o ppid= -p 4523", "category": "colloquial"}
{"nl": "stop a background job I started earlier", "bash": "jobs && kill %1", "category": "colloquial"}
{"nl": "show me all my background jobs", "bash": "jobs -l", "category": "colloquial"}
{"nl": "bring a background job back to the foreground", "bash": "fg %1", "category": "colloquial"}
{"nl": "send the current process to the background", "bash": "bg", "category": "colloquial"}
{"nl": "I can't open this file it says permission denied", "bash": "chmod u+r ~/Documents/locked.txt", "category": "colloquial"}
{"nl": "let everyone read this file", "bash": "chmod 644 ~/Documents/public.txt", "category": "colloquial"}
{"nl": "make this file only readable by me", "bash": "chmod 600 ~/Documents/private.txt", "category": "colloquial"}
{"nl": "I downloaded this program but it won't run", "bash": "chmod +x ~/Downloads/program.AppImage", "category": "colloquial"}
{"nl": "this folder won't let me see inside", "bash": "chmod +rx ~/projects/restricted", "category": "colloquial"}
{"nl": "give myself ownership of this file", "bash": "sudo chown $USER:$USER ~/Documents/file.txt", "category": "colloquial"}
{"nl": "take ownership of this whole folder", "bash": "sudo chown -R $USER:$USER ~/projects/myapp", "category": "colloquial"}
{"nl": "fix permissions so I can edit my own files", "bash": "sudo chown -R $USER:$USER ~", "category": "colloquial"}
{"nl": "make all the scripts in this folder executable", "bash": "chmod +x ~/scripts/*.sh", "category": "colloquial"}
{"nl": "set this whole project folder so only I can access it", "bash": "chmod -R 700 ~/projects/private", "category": "colloquial"}
{"nl": "what permissions does this file have", "bash": "ls -l ~/Documents/report.pdf", "category": "colloquial"}
{"nl": "who owns this file", "bash": "stat -c '%U:%G' ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "see who owns everything in this folder", "bash": "ls -la ~/projects/myapp/", "category": "colloquial"}
{"nl": "check if I'm connected to the internet", "bash": "ping -c 3 8.8.8.8", "category": "colloquial"}
{"nl": "is my wifi working", "bash": "ping -c 3 google.com", "category": "colloquial"}
{"nl": "what's my computer's ip address", "bash": "ip addr show | grep -oP 'inet \\K[\\d.]+' | grep -v 127", "category": "colloquial"}
{"nl": "show me my public ip address", "bash": "curl -s ifconfig.me", "category": "colloquial"}
{"nl": "what's my external ip", "bash": "curl -s https://api.ipify.org", "category": "colloquial"}
{"nl": "is example.com online or down", "bash": "curl -I https://example.com", "category": "colloquial"}
{"nl": "test if a website is reachable", "bash": "curl -Is https://github.com | head -1", "category": "colloquial"}
{"nl": "show all my network connections", "bash": "ss -tunap 2>/dev/null", "category": "colloquial"}
{"nl": "see what ports are open on my machine", "bash": "ss -tlnp", "category": "colloquial"}
{"nl": "what services are listening for connections", "bash": "ss -tlnp | grep LISTEN", "category": "colloquial"}
{"nl": "is anything listening on port 80", "bash": "ss -tlnp 'sport = :80'", "category": "colloquial"}
{"nl": "what's using port 5432", "bash": "ss -tlnp 'sport = :5432'", "category": "colloquial"}
{"nl": "see my wifi network name", "bash": "iwgetid -r", "category": "colloquial"}
{"nl": "show available wifi networks", "bash": "nmcli device wifi list", "category": "colloquial"}
{"nl": "connect to a wifi network", "bash": "nmcli device wifi connect 'HomeWiFi' password 'mypassword123'", "category": "colloquial"}
{"nl": "show my current network connection", "bash": "nmcli connection show --active", "category": "colloquial"}
{"nl": "turn off wifi", "bash": "nmcli radio wifi off", "category": "colloquial"}
{"nl": "turn wifi back on", "bash": "nmcli radio wifi on", "category": "colloquial"}
{"nl": "see my router ip address", "bash": "ip route | awk '/default/ {print $3}'", "category": "colloquial"}
{"nl": "find the mac address of my wifi adapter", "bash": "ip link show wlan0 | awk '/ether/ {print $2}'", "category": "colloquial"}
{"nl": "trace the route to google", "bash": "traceroute google.com", "category": "colloquial"}
{"nl": "look up the ip of a domain", "bash": "dig +short github.com", "category": "colloquial"}
{"nl": "what server hosts this website", "bash": "dig github.com NS +short", "category": "colloquial"}
{"nl": "see the mail server for a domain", "bash": "dig example.com MX +short", "category": "colloquial"}
{"nl": "reverse lookup an ip address", "bash": "dig -x 8.8.8.8 +short", "category": "colloquial"}
{"nl": "show me what's using my internet bandwidth", "bash": "sudo nethogs", "category": "colloquial"}
{"nl": "monitor my network traffic in real time", "bash": "sudo iftop", "category": "colloquial"}
{"nl": "download a file from a url", "bash": "wget https://example.com/file.zip -P ~/Downloads/", "category": "colloquial"}
{"nl": "fetch this image and save it", "bash": "curl -o ~/Downloads/image.png https://example.com/image.png", "category": "colloquial"}
{"nl": "I need to check if my vpn is connected", "bash": "ip route | grep -E 'tun|wg|ppp'", "category": "colloquial"}
{"nl": "see if openvpn is running", "bash": "systemctl status openvpn", "category": "colloquial"}
{"nl": "restart my network connection", "bash": "sudo systemctl restart NetworkManager", "category": "colloquial"}
{"nl": "nginx stopped working how do I turn it back on", "bash": "sudo systemctl restart nginx", "category": "colloquial"}
{"nl": "is apache running", "bash": "systemctl status apache2", "category": "colloquial"}
{"nl": "start the postgres database service", "bash": "sudo systemctl start postgresql", "category": "colloquial"}
{"nl": "stop the redis server", "bash": "sudo systemctl stop redis", "category": "colloquial"}
{"nl": "restart my mysql database", "bash": "sudo systemctl restart mysql", "category": "colloquial"}
{"nl": "enable docker to start when my computer boots", "bash": "sudo systemctl enable docker", "category": "colloquial"}
{"nl": "stop a service from starting at boot", "bash": "sudo systemctl disable bluetooth", "category": "colloquial"}
{"nl": "make nginx start at boot and start it now", "bash": "sudo systemctl enable --now nginx", "category": "colloquial"}
{"nl": "check if ssh is running", "bash": "systemctl is-active sshd", "category": "colloquial"}
{"nl": "show all running services", "bash": "systemctl list-units --type=service --state=running", "category": "colloquial"}
{"nl": "show me services that failed", "bash": "systemctl --failed", "category": "colloquial"}
{"nl": "see all services that start at boot", "bash": "systemctl list-unit-files --state=enabled", "category": "colloquial"}
{"nl": "reload nginx after I changed the config", "bash": "sudo systemctl reload nginx", "category": "colloquial"}
{"nl": "the database service stopped, restart it", "bash": "sudo systemctl restart postgresql", "category": "colloquial"}
{"nl": "is cron running", "bash": "systemctl status cron", "category": "colloquial"}
{"nl": "show me what happened with nginx today", "bash": "sudo journalctl -u nginx --since today", "category": "colloquial"}
{"nl": "see recent system errors", "bash": "sudo journalctl -p err -n 50", "category": "colloquial"}
{"nl": "what crashed in the last hour", "bash": "sudo journalctl --since '1 hour ago' -p err", "category": "colloquial"}
{"nl": "look at the most recent system messages", "bash": "sudo journalctl -n 100", "category": "colloquial"}
{"nl": "follow the system log live", "bash": "sudo journalctl -f", "category": "colloquial"}
{"nl": "show docker's logs", "bash": "sudo journalctl -u docker -n 100", "category": "colloquial"}
{"nl": "why did my computer restart", "bash": "last reboot | head -5", "category": "colloquial"}
{"nl": "when did the system last boot", "bash": "who -b", "category": "colloquial"}
{"nl": "show me kernel messages", "bash": "sudo dmesg | tail -50", "category": "colloquial"}
{"nl": "did the kernel see any errors", "bash": "sudo dmesg --level=err", "category": "colloquial"}
{"nl": "check the auth log for failed logins", "bash": "sudo grep 'Failed password' /var/log/auth.log | tail -20", "category": "colloquial"}
{"nl": "show me who tried to log in recently", "bash": "sudo journalctl -u sshd --since '24 hours ago'", "category": "colloquial"}
{"nl": "what does the syslog say", "bash": "sudo tail -100 /var/log/syslog", "category": "colloquial"}
{"nl": "see only errors in the system log", "bash": "sudo journalctl -p 3 -xb", "category": "colloquial"}
{"nl": "logs from yesterday only", "bash": "sudo journalctl --since yesterday --until today", "category": "colloquial"}
{"nl": "what happened between 9am and 10am today", "bash": "sudo journalctl --since '09:00' --until '10:00'", "category": "colloquial"}
{"nl": "see the boot log", "bash": "sudo journalctl -b", "category": "colloquial"}
{"nl": "show logs from the previous boot", "bash": "sudo journalctl -b -1", "category": "colloquial"}
{"nl": "tail the apache error log live", "bash": "sudo tail -f /var/log/apache2/error.log", "category": "colloquial"}
{"nl": "search system logs for the word crash", "bash": "sudo journalctl | grep -i crash | tail -20", "category": "colloquial"}
{"nl": "add a new user account named alice", "bash": "sudo adduser alice", "category": "colloquial"}
{"nl": "create a user called bob with home directory", "bash": "sudo useradd -m -s /bin/bash bob", "category": "colloquial"}
{"nl": "delete an old user account", "bash": "sudo deluser charlie", "category": "colloquial"}
{"nl": "remove a user and their home folder", "bash": "sudo deluser --remove-home dave", "category": "colloquial"}
{"nl": "reset the password for another user", "bash": "sudo passwd alice", "category": "colloquial"}
{"nl": "lock the bob account so they can't log in", "bash": "sudo passwd -l bob", "category": "colloquial"}
{"nl": "unlock the alice account", "bash": "sudo passwd -u alice", "category": "colloquial"}
{"nl": "see who else is logged in right now", "bash": "who", "category": "colloquial"}
{"nl": "list all users on this computer", "bash": "cut -d: -f1 /etc/passwd", "category": "colloquial"}
{"nl": "switch to a different user", "bash": "su - alice", "category": "colloquial"}
{"nl": "add alice to the sudo group", "bash": "sudo usermod -aG sudo alice", "category": "colloquial"}
{"nl": "show what groups I'm in", "bash": "groups", "category": "colloquial"}
{"nl": "what's my username", "bash": "whoami", "category": "colloquial"}
{"nl": "see my user id number", "bash": "id", "category": "colloquial"}
{"nl": "schedule the cleanup script to run nightly", "bash": "(crontab -l 2>/dev/null; echo '0 2 * * * /home/$USER/scripts/cleanup.sh') | crontab -", "category": "colloquial"}
{"nl": "list my scheduled tasks", "bash": "crontab -l", "category": "colloquial"}
{"nl": "remove all my scheduled tasks", "bash": "crontab -r", "category": "colloquial"}
{"nl": "see system wide cron jobs", "bash": "ls /etc/cron.d/ /etc/cron.daily/ /etc/cron.hourly/", "category": "colloquial"}
{"nl": "run a command every 5 minutes", "bash": "(crontab -l 2>/dev/null; echo '*/5 * * * * /home/$USER/scripts/check.sh') | crontab -", "category": "colloquial"}
{"nl": "schedule a reboot for 3am tomorrow", "bash": "sudo shutdown -r 03:00", "category": "colloquial"}
{"nl": "set up a one time job to run in 2 hours", "bash": "echo '/home/$USER/scripts/task.sh' | at now + 2 hours", "category": "colloquial"}
{"nl": "see what at jobs are queued", "bash": "atq", "category": "colloquial"}
{"nl": "cancel a scheduled at job", "bash": "atrm 3", "category": "colloquial"}
{"nl": "show me the date and time", "bash": "date", "category": "colloquial"}
{"nl": "what time zone am I in", "bash": "timedatectl", "category": "colloquial"}
{"nl": "set my time zone to new york", "bash": "sudo timedatectl set-timezone America/New_York", "category": "colloquial"}
{"nl": "sync my clock with the internet", "bash": "sudo systemctl restart systemd-timesyncd", "category": "colloquial"}
{"nl": "show the calendar for this month", "bash": "cal", "category": "colloquial"}
{"nl": "show me a calendar for the whole year", "bash": "cal -y", "category": "colloquial"}
{"nl": "where am I right now in the filesystem", "bash": "pwd", "category": "colloquial"}
{"nl": "go to my home folder", "bash": "cd ~", "category": "colloquial"}
{"nl": "go back to the previous folder I was in", "bash": "cd -", "category": "colloquial"}
{"nl": "navigate up one folder", "bash": "cd ..", "category": "colloquial"}
{"nl": "show me the first 20 lines of this file", "bash": "head -20 ~/Documents/log.txt", "category": "colloquial"}
{"nl": "show the last 50 lines of the log", "bash": "tail -50 /var/log/syslog", "category": "colloquial"}
{"nl": "follow this log file as it grows", "bash": "tail -f ~/projects/myapp/app.log", "category": "colloquial"}
{"nl": "show me the whole file", "bash": "cat ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "let me page through this big file", "bash": "less /var/log/syslog", "category": "colloquial"}
{"nl": "open this file in a basic editor", "bash": "nano ~/Documents/todo.txt", "category": "colloquial"}
{"nl": "view this file but I want syntax colors", "bash": "bat ~/projects/myapp/main.py", "category": "colloquial"}
{"nl": "show line numbers when viewing this file", "bash": "cat -n ~/Documents/code.py", "category": "colloquial"}
{"nl": "count the lines in my file", "bash": "wc -l ~/Documents/list.txt", "category": "colloquial"}
{"nl": "count words in this document", "bash": "wc -w ~/Documents/essay.txt", "category": "colloquial"}
{"nl": "see how big this file is in characters", "bash": "wc -c ~/Documents/file.txt", "category": "colloquial"}
{"nl": "find the word error in my log file", "bash": "grep -i error ~/projects/myapp/app.log", "category": "colloquial"}
{"nl": "search all files in this folder for a phrase", "bash": "grep -r 'database connection' ~/projects/myapp/", "category": "colloquial"}
{"nl": "look for failed in the auth log", "bash": "sudo grep -i failed /var/log/auth.log | tail -20", "category": "colloquial"}
{"nl": "search files for the word todo and show me where", "bash": "grep -rn 'TODO' ~/projects/myapp/ --include='*.py'", "category": "colloquial"}
{"nl": "count how many times the word warning appears", "bash": "grep -c warning ~/projects/myapp/app.log", "category": "colloquial"}
{"nl": "find lines that don't have the word ok", "bash": "grep -v 'OK' ~/projects/myapp/status.log", "category": "colloquial"}
{"nl": "show lines around a match for context", "bash": "grep -C 2 'error' ~/projects/myapp/app.log", "category": "colloquial"}
{"nl": "case insensitive search", "bash": "grep -i 'password' ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "sort lines in this file alphabetically", "bash": "sort ~/Documents/names.txt", "category": "colloquial"}
{"nl": "sort by number not alphabetically", "bash": "sort -n ~/Documents/scores.txt", "category": "colloquial"}
{"nl": "sort in reverse order", "bash": "sort -r ~/Documents/list.txt", "category": "colloquial"}
{"nl": "remove duplicate lines from this file", "bash": "sort -u ~/Documents/emails.txt -o ~/Documents/emails.txt", "category": "colloquial"}
{"nl": "show me only the unique lines", "bash": "sort ~/Documents/data.txt | uniq", "category": "colloquial"}
{"nl": "replace every instance of cat with dog in this file", "bash": "sed -i 's/cat/dog/g' ~/Documents/story.txt", "category": "colloquial"}
{"nl": "remove blank lines from this file", "bash": "sed -i '/^$/d' ~/Documents/data.txt", "category": "colloquial"}
{"nl": "show only lines 10 through 20", "bash": "sed -n '10,20p' ~/Documents/log.txt", "category": "colloquial"}
{"nl": "show me the second column of this csv", "bash": "awk -F',' '{print $2}' ~/Documents/data.csv", "category": "colloquial"}
{"nl": "add line numbers to this file", "bash": "nl ~/Documents/code.py", "category": "colloquial"}
{"nl": "compare two files side by side", "bash": "diff -y ~/Documents/v1.txt ~/Documents/v2.txt", "category": "colloquial"}
{"nl": "show me what changed between two files", "bash": "diff ~/Documents/old.txt ~/Documents/new.txt", "category": "colloquial"}
{"nl": "are these two files identical", "bash": "cmp -s ~/Documents/a.txt ~/Documents/b.txt && echo same || echo different", "category": "colloquial"}
{"nl": "get the checksum of this file", "bash": "sha256sum ~/Downloads/installer.iso", "category": "colloquial"}
{"nl": "calculate md5 of this file", "bash": "md5sum ~/Downloads/file.zip", "category": "colloquial"}
{"nl": "verify the integrity of my download", "bash": "sha256sum -c ~/Downloads/SHA256SUMS", "category": "colloquial"}
{"nl": "show the file type", "bash": "file ~/Downloads/mystery.bin", "category": "colloquial"}
{"nl": "show this image's dimensions", "bash": "identify ~/Pictures/photo.jpg", "category": "colloquial"}
{"nl": "get the metadata from this photo", "bash": "exiftool ~/Pictures/photo.jpg", "category": "colloquial"}
{"nl": "convert a png to jpg", "bash": "convert ~/Pictures/image.png ~/Pictures/image.jpg", "category": "colloquial"}
{"nl": "resize this image to 800 pixels wide", "bash": "convert ~/Pictures/photo.jpg -resize 800x ~/Pictures/photo_small.jpg", "category": "colloquial"}
{"nl": "make a thumbnail of this photo", "bash": "convert ~/Pictures/photo.jpg -resize 200x200 ~/Pictures/photo_thumb.jpg", "category": "colloquial"}
{"nl": "get the audio out of this video", "bash": "ffmpeg -i ~/Videos/clip.mp4 -vn -acodec copy ~/Videos/clip.aac", "category": "colloquial"}
{"nl": "trim a video to the first 30 seconds", "bash": "ffmpeg -i ~/Videos/clip.mp4 -t 30 -c copy ~/Videos/clip_short.mp4", "category": "colloquial"}
{"nl": "merge two pdf files together", "bash": "pdfunite ~/Documents/a.pdf ~/Documents/b.pdf ~/Documents/merged.pdf", "category": "colloquial"}
{"nl": "extract the first 5 pages of this pdf", "bash": "pdftk ~/Documents/big.pdf cat 1-5 output ~/Documents/first5.pdf", "category": "colloquial"}
{"nl": "split a pdf into individual pages", "bash": "pdftk ~/Documents/report.pdf burst output ~/Documents/page_%02d.pdf", "category": "colloquial"}
{"nl": "make a screen recording", "bash": "ffmpeg -f x11grab -i :0.0 -r 30 ~/Videos/recording.mp4", "category": "colloquial"}
{"nl": "screenshot just a selection I draw", "bash": "scrot -s ~/Pictures/selection.png", "category": "colloquial"}
{"nl": "screenshot with a 5 second delay", "bash": "sleep 5 && scrot ~/Pictures/delayed.png", "category": "colloquial"}
{"nl": "show me what's in my clipboard", "bash": "xclip -selection clipboard -o", "category": "colloquial"}
{"nl": "copy this text to my clipboard", "bash": "echo 'hello world' | xclip -selection clipboard", "category": "colloquial"}
{"nl": "paste from clipboard into a file", "bash": "xclip -selection clipboard -o > ~/Documents/pasted.txt", "category": "colloquial"}
{"nl": "play this song", "bash": "mpv ~/Music/song.mp3", "category": "colloquial"}
{"nl": "play this video", "bash": "mpv ~/Videos/movie.mp4", "category": "colloquial"}
{"nl": "lower the volume to 30 percent", "bash": "pactl set-sink-volume @DEFAULT_SINK@ 30%", "category": "colloquial"}
{"nl": "mute my speakers", "bash": "pactl set-sink-mute @DEFAULT_SINK@ 1", "category": "colloquial"}
{"nl": "turn the volume up", "bash": "pactl set-sink-volume @DEFAULT_SINK@ +10%", "category": "colloquial"}
{"nl": "lock my screen", "bash": "loginctl lock-session", "category": "colloquial"}
{"nl": "shut down the computer in 10 minutes", "bash": "sudo shutdown -h +10", "category": "colloquial"}
{"nl": "cancel the shutdown I just scheduled", "bash": "sudo shutdown -c", "category": "colloquial"}
{"nl": "reboot now", "bash": "sudo reboot", "category": "colloquial"}
{"nl": "restart my computer in an hour", "bash": "sudo shutdown -r +60", "category": "colloquial"}
{"nl": "hibernate my laptop", "bash": "systemctl hibernate", "category": "colloquial"}
{"nl": "log out of my session", "bash": "loginctl terminate-user $USER", "category": "colloquial"}
{"nl": "is my battery low", "bash": "acpi -b", "category": "colloquial"}
{"nl": "how much battery do I have left", "bash": "upower -i $(upower -e | grep BAT) | grep percentage", "category": "colloquial"}
{"nl": "see how my laptop battery is doing", "bash": "upower -i /org/freedesktop/UPower/devices/battery_BAT0", "category": "colloquial"}
{"nl": "show display brightness", "bash": "brightnessctl", "category": "colloquial"}
{"nl": "make my screen dimmer", "bash": "brightnessctl set 30%", "category": "colloquial"}
{"nl": "show me bluetooth devices", "bash": "bluetoothctl devices", "category": "colloquial"}
{"nl": "turn on bluetooth", "bash": "bluetoothctl power on", "category": "colloquial"}
{"nl": "scan for bluetooth devices", "bash": "bluetoothctl scan on", "category": "colloquial"}
{"nl": "connect to my bluetooth headphones", "bash": "bluetoothctl connect AA:BB:CC:DD:EE:FF", "category": "colloquial"}
{"nl": "see what audio output is being used", "bash": "pactl info | grep 'Default Sink'", "category": "colloquial"}
{"nl": "list audio devices", "bash": "pactl list sinks short", "category": "colloquial"}
{"nl": "switch to headphones output", "bash": "pactl set-default-sink alsa_output.pci-0000_00_1f.3.analog-stereo", "category": "colloquial"}
{"nl": "list my keyboard layouts", "bash": "localectl list-keymaps | head -20", "category": "colloquial"}
{"nl": "change keyboard layout to french", "bash": "setxkbmap fr", "category": "colloquial"}
{"nl": "switch keyboard back to english", "bash": "setxkbmap us", "category": "colloquial"}
{"nl": "see what my current keyboard layout is", "bash": "setxkbmap -query | grep layout", "category": "colloquial"}
{"nl": "list installed fonts", "bash": "fc-list | head -30", "category": "colloquial"}
{"nl": "search for a font", "bash": "fc-list | grep -i monaco", "category": "colloquial"}
{"nl": "see currently set environment variables", "bash": "env", "category": "colloquial"}
{"nl": "show me the value of an environment variable", "bash": "echo $HOME", "category": "colloquial"}
{"nl": "add a folder to my path permanently", "bash": "echo 'export PATH=\"$HOME/bin:$PATH\"' >> ~/.bashrc", "category": "colloquial"}
{"nl": "set an environment variable for this session", "bash": "export EDITOR=nano", "category": "colloquial"}
{"nl": "edit my shell startup file", "bash": "nano ~/.bashrc", "category": "colloquial"}
{"nl": "reload my shell config", "bash": "source ~/.bashrc", "category": "colloquial"}
{"nl": "what shell am I using", "bash": "echo $SHELL", "category": "colloquial"}
{"nl": "change my default shell to zsh", "bash": "chsh -s /usr/bin/zsh", "category": "colloquial"}
{"nl": "search through my command history", "bash": "history | grep docker", "category": "colloquial"}
{"nl": "clear my terminal history", "bash": "history -c && history -w", "category": "colloquial"}
{"nl": "run a command without saving it in history", "bash": " ls -la", "category": "colloquial"}
{"nl": "find a command I used yesterday", "bash": "history | tail -200 | grep ssh", "category": "colloquial"}
{"nl": "open a new tmux session", "bash": "tmux new -s work", "category": "colloquial"}
{"nl": "list my tmux sessions", "bash": "tmux ls", "category": "colloquial"}
{"nl": "attach to my tmux session", "bash": "tmux attach -t work", "category": "colloquial"}
{"nl": "kill a tmux session", "bash": "tmux kill-session -t old", "category": "colloquial"}
{"nl": "start a long task in the background using screen", "bash": "screen -dmS backup bash -c '/home/$USER/scripts/backup.sh'", "category": "colloquial"}
{"nl": "see active screen sessions", "bash": "screen -ls", "category": "colloquial"}
{"nl": "reattach to my screen session", "bash": "screen -r backup", "category": "colloquial"}
{"nl": "I need to check the weather", "bash": "curl -s 'wttr.in/?format=3'", "category": "colloquial"}
{"nl": "show me a 3 day weather forecast", "bash": "curl -s 'wttr.in/?2'", "category": "colloquial"}
{"nl": "convert this file from windows line endings", "bash": "dos2unix ~/Documents/script.sh", "category": "colloquial"}
{"nl": "fix line endings to be windows style", "bash": "unix2dos ~/Documents/notes.txt", "category": "colloquial"}
{"nl": "show non printable characters in this file", "bash": "cat -A ~/Documents/data.txt", "category": "colloquial"}
{"nl": "I want to see the file as hex", "bash": "xxd ~/Downloads/binary.bin | less", "category": "colloquial"}
{"nl": "look at the first few bytes of a binary file", "bash": "xxd ~/Downloads/data.bin | head", "category": "colloquial"}
{"nl": "list everyone's groups on the system", "bash": "cat /etc/group | cut -d: -f1", "category": "colloquial"}
{"nl": "add myself to the docker group", "bash": "sudo usermod -aG docker $USER", "category": "colloquial"}
{"nl": "remove a user from a group", "bash": "sudo gpasswd -d alice docker", "category": "colloquial"}
{"nl": "see who is in the sudo group", "bash": "getent group sudo", "category": "colloquial"}
{"nl": "what is the linux distribution I'm running", "bash": "lsb_release -d", "category": "colloquial"}
{"nl": "show me my os version", "bash": "cat /etc/os-release", "category": "colloquial"}
{"nl": "what kernel version do I have", "bash": "uname -r", "category": "colloquial"}
{"nl": "is this a 64 bit system", "bash": "uname -m", "category": "colloquial"}
{"nl": "show me my hostname", "bash": "hostname", "category": "colloquial"}
{"nl": "change my computer's name", "bash": "sudo hostnamectl set-hostname mylaptop", "category": "colloquial"}
{"nl": "show details about my machine", "bash": "hostnamectl", "category": "colloquial"}
{"nl": "see what shell features are enabled", "bash": "shopt", "category": "colloquial"}
{"nl": "make a directory I can write to but others can read", "bash": "mkdir -p ~/shared && chmod 755 ~/shared", "category": "colloquial"}
{"nl": "share a folder with another user on this computer", "bash": "sudo chgrp -R sharedusers ~/Documents/shared && sudo chmod -R 770 ~/Documents/shared", "category": "colloquial"}
{"nl": "set the sticky bit on a folder", "bash": "chmod +t /tmp/shared", "category": "colloquial"}
{"nl": "give read access to the team for this file", "bash": "sudo chgrp team ~/Documents/report.pdf && chmod g+r ~/Documents/report.pdf", "category": "colloquial"}
{"nl": "see how much swap I'm using", "bash": "swapon --show", "category": "colloquial"}
{"nl": "add more swap space", "bash": "sudo fallocate -l 2G /swapfile && sudo chmod 600 /swapfile && sudo mkswap /swapfile && sudo swapon /swapfile", "category": "colloquial"}
{"nl": "disable swap temporarily", "bash": "sudo swapoff -a", "category": "colloquial"}
{"nl": "show file system types", "bash": "df -hT", "category": "colloquial"}
{"nl": "check for errors on a disk", "bash": "sudo fsck /dev/sdb1", "category": "colloquial"}
{"nl": "show inodes used on my drive", "bash": "df -i", "category": "colloquial"}
{"nl": "see all symbolic links in my home", "bash": "find ~ -type l 2>/dev/null", "category": "colloquial"}
{"nl": "create a shortcut to my projects folder on the desktop", "bash": "ln -s ~/projects ~/Desktop/projects", "category": "colloquial"}
{"nl": "remove a broken shortcut", "bash": "rm ~/Desktop/old_link", "category": "colloquial"}
{"nl": "find broken shortcuts in my home", "bash": "find ~ -xtype l 2>/dev/null", "category": "colloquial"}
{"nl": "make a hard link to this file", "bash": "ln ~/Documents/original.txt ~/Documents/linked.txt", "category": "colloquial"}
{"nl": "show file creation dates", "bash": "stat ~/Documents/file.txt", "category": "colloquial"}
{"nl": "when was this file last modified", "bash": "stat -c '%y' ~/Documents/file.txt", "category": "colloquial"}
{"nl": "update the modification time of a file", "bash": "touch ~/Documents/file.txt", "category": "colloquial"}
{"nl": "my downloads folder is a mess clean it up", "bash": "find ~/Downloads -type f -mtime +30 -delete", "category": "colloquial"}
{"nl": "delete files in tmp that are older than a week", "bash": "find /tmp -type f -mtime +7 -delete 2>/dev/null", "category": "colloquial"}
{"nl": "remove empty folders in this directory", "bash": "find ~/projects -type d -empty -delete", "category": "colloquial"}
{"nl": "delete files older than 90 days from this folder", "bash": "find ~/Downloads/old -type f -mtime +90 -delete", "category": "colloquial"}
{"nl": "clean out the cache folder", "bash": "rm -rf ~/.cache/thumbnails/*", "category": "colloquial"}
{"nl": "clear browser cache for firefox", "bash": "rm -rf ~/.cache/mozilla/firefox/*/cache2/*", "category": "colloquial"}
{"nl": "find duplicate files in my pictures folder", "bash": "fdupes -r ~/Pictures/", "category": "colloquial"}
{"nl": "show me which programs auto start when I log in", "bash": "ls ~/.config/autostart/", "category": "colloquial"}
{"nl": "stop a program from auto starting", "bash": "rm ~/.config/autostart/spotify.desktop", "category": "colloquial"}
{"nl": "add a startup script", "bash": "cp ~/scripts/launcher.desktop ~/.config/autostart/", "category": "colloquial"}
{"nl": "see all the desktop apps installed", "bash": "ls /usr/share/applications/", "category": "colloquial"}
{"nl": "find an installed app by name", "bash": "ls /usr/share/applications/ | grep -i firefox", "category": "colloquial"}
{"nl": "see what wallpaper I'm using", "bash": "gsettings get org.gnome.desktop.background picture-uri", "category": "colloquial"}
{"nl": "change my desktop wallpaper", "bash": "gsettings set org.gnome.desktop.background picture-uri 'file:///home/$USER/Pictures/wallpaper.jpg'", "category": "colloquial"}
{"nl": "toggle dark mode", "bash": "gsettings set org.gnome.desktop.interface color-scheme prefer-dark", "category": "colloquial"}
{"nl": "switch to light mode", "bash": "gsettings set org.gnome.desktop.interface color-scheme default", "category": "colloquial"}
{"nl": "see the size of every subfolder", "bash": "du -sh ~/Documents/*/", "category": "colloquial"}
{"nl": "rank folders by size", "bash": "du -h --max-depth=1 ~ | sort -hr", "category": "colloquial"}
{"nl": "find empty files in my home", "bash": "find ~ -type f -empty 2>/dev/null", "category": "colloquial"}
{"nl": "find folders with no files inside", "bash": "find ~ -type d -empty 2>/dev/null", "category": "colloquial"}
{"nl": "show me only files modified today", "bash": "find ~ -type f -newermt '1 day ago' 2>/dev/null", "category": "colloquial"}
{"nl": "show files I haven't touched in a year", "bash": "find ~ -type f -atime +365 2>/dev/null | head -20", "category": "colloquial"}
{"nl": "find old downloads and list them", "bash": "find ~/Downloads -type f -mtime +60 -ls", "category": "colloquial"}
{"nl": "search for a config file across the system", "bash": "sudo find /etc -name '*.conf' -type f 2>/dev/null", "category": "colloquial"}
{"nl": "where is the apache config", "bash": "find /etc -name 'apache2.conf' 2>/dev/null", "category": "colloquial"}
{"nl": "where is the nginx config", "bash": "find /etc -name 'nginx.conf' 2>/dev/null", "category": "colloquial"}
{"nl": "find python on my system", "bash": "which python3", "category": "colloquial"}
{"nl": "where is the docker binary", "bash": "command -v docker", "category": "colloquial"}
{"nl": "find all the binaries for a command", "bash": "type -a python3", "category": "colloquial"}
{"nl": "show me the man page for cp", "bash": "man cp", "category": "colloquial"}
{"nl": "quick help for the curl command", "bash": "curl --help | less", "category": "colloquial"}
{"nl": "what does this command do explain it", "bash": "tldr tar", "category": "colloquial"}
{"nl": "show examples for the find command", "bash": "tldr find", "category": "colloquial"}
{"nl": "list all the things I can do with ssh", "bash": "ssh --help 2>&1 | less", "category": "colloquial"}
{"nl": "see my git config", "bash": "git config --list", "category": "colloquial"}
{"nl": "set my git username", "bash": "git config --global user.name 'Aditya Mavalankar'", "category": "colloquial"}
{"nl": "set my git email", "bash": "git config --global user.email 'aditya@example.com'", "category": "colloquial"}
{"nl": "clone a github repo", "bash": "git clone https://github.com/torvalds/linux.git ~/projects/linux", "category": "colloquial"}
{"nl": "commit all my changes", "bash": "git -C ~/projects/myapp add -A && git -C ~/projects/myapp commit -m 'updates'", "category": "colloquial"}
{"nl": "push my changes to github", "bash": "git -C ~/projects/myapp push", "category": "colloquial"}
{"nl": "pull the latest changes", "bash": "git -C ~/projects/myapp pull", "category": "colloquial"}
{"nl": "see what changed in my project", "bash": "git -C ~/projects/myapp status", "category": "colloquial"}
{"nl": "show the last 10 commits", "bash": "git -C ~/projects/myapp log --oneline -10", "category": "colloquial"}
{"nl": "create a new branch and switch to it", "bash": "git -C ~/projects/myapp checkout -b feature/new-thing", "category": "colloquial"}
{"nl": "switch back to main branch", "bash": "git -C ~/projects/myapp checkout main", "category": "colloquial"}
{"nl": "see what branches I have", "bash": "git -C ~/projects/myapp branch", "category": "colloquial"}
{"nl": "delete an old branch", "bash": "git -C ~/projects/myapp branch -d old-feature", "category": "colloquial"}
{"nl": "merge a feature branch into main", "bash": "git -C ~/projects/myapp checkout main && git -C ~/projects/myapp merge feature/new-thing", "category": "colloquial"}
{"nl": "undo my last commit but keep the changes", "bash": "git -C ~/projects/myapp reset HEAD~1", "category": "colloquial"}
{"nl": "see what I changed since my last commit", "bash": "git -C ~/projects/myapp diff", "category": "colloquial"}
{"nl": "check my email with mutt", "bash": "mutt", "category": "colloquial"}
{"nl": "send a quick email from terminal", "bash": "echo 'hi there' | mail -s 'Subject' friend@example.com", "category": "colloquial"}
{"nl": "check the spelling of words in a file", "bash": "aspell check ~/Documents/essay.txt", "category": "colloquial"}
{"nl": "translate a word using an online service", "bash": "trans :es 'hello world'", "category": "colloquial"}
{"nl": "do a quick calculation", "bash": "echo '15 * 24 + 100' | bc", "category": "colloquial"}
{"nl": "calculate a percentage", "bash": "echo 'scale=2; 87/120 * 100' | bc", "category": "colloquial"}
{"nl": "show me random numbers", "bash": "shuf -i 1-100 -n 5", "category": "colloquial"}
{"nl": "pick a random line from this file", "bash": "shuf -n 1 ~/Documents/wordlist.txt", "category": "colloquial"}
{"nl": "shuffle the lines in this file", "bash": "shuf ~/Documents/playlist.txt -o ~/Documents/shuffled.txt", "category": "colloquial"}
{"nl": "see what my prompt looks like", "bash": "echo $PS1", "category": "colloquial"}
{"nl": "make terminal text colorful", "bash": "echo -e '\\033[1;32mhello\\033[0m'", "category": "colloquial"}
{"nl": "clear my terminal", "bash": "clear", "category": "colloquial"}
{"nl": "reset the terminal if it gets weird", "bash": "reset", "category": "colloquial"}
{"nl": "what are the keyboard shortcuts in my terminal", "bash": "bind -p | head -30", "category": "colloquial"}
{"nl": "set up a useful alias", "bash": "echo 'alias ll=\"ls -lah\"' >> ~/.bashrc && source ~/.bashrc", "category": "colloquial"}
{"nl": "show my current aliases", "bash": "alias", "category": "colloquial"}
{"nl": "remove an alias", "bash": "unalias ll", "category": "colloquial"}
{"nl": "see my recently used files", "bash": "ls -lt ~ | head -20", "category": "colloquial"}
{"nl": "find files modified after a specific date", "bash": "find ~/projects -type f -newermt '2026-05-01' 2>/dev/null", "category": "colloquial"}
{"nl": "show files that haven't been read in 60 days", "bash": "find ~/Documents -type f -atime +60 2>/dev/null", "category": "colloquial"}
{"nl": "tell me what programs are listening on the network", "bash": "sudo ss -tlnp", "category": "colloquial"}
{"nl": "monitor disk activity", "bash": "iostat -x 2", "category": "colloquial"}
{"nl": "see disk read write speeds in real time", "bash": "sudo iotop", "category": "colloquial"}
{"nl": "watch what cpu cores are doing", "bash": "mpstat -P ALL 2", "category": "colloquial"}
{"nl": "check virtual memory stats", "bash": "vmstat 2 5", "category": "colloquial"}
{"nl": "show context switches and interrupts", "bash": "vmstat 1 5", "category": "colloquial"}
{"nl": "see open files for a process", "bash": "lsof -p 4523", "category": "colloquial"}
{"nl": "what files is firefox using", "bash": "lsof -c firefox 2>/dev/null | head -20", "category": "colloquial"}
{"nl": "who has this file open", "bash": "lsof ~/Documents/report.pdf", "category": "colloquial"}
{"nl": "see network connections by process", "bash": "sudo lsof -i -P -n | grep LISTEN", "category": "colloquial"}
{"nl": "monitor a folder for changes", "bash": "inotifywait -m -r ~/projects/myapp", "category": "colloquial"}
{"nl": "watch a command refresh every 2 seconds", "bash": "watch -n 2 'df -h /'", "category": "colloquial"}
{"nl": "keep checking my battery every 10 seconds", "bash": "watch -n 10 acpi -b", "category": "colloquial"}
{"nl": "send my desktop a notification", "bash": "notify-send 'Done' 'Your script finished'", "category": "colloquial"}
{"nl": "make my speakers beep", "bash": "paplay /usr/share/sounds/freedesktop/stereo/bell.oga", "category": "colloquial"}
{"nl": "speak this text out loud", "bash": "espeak 'hello world'", "category": "colloquial"}
{"nl": "show only directories not files", "bash": "ls -d ~/projects/*/", "category": "colloquial"}
{"nl": "list files showing hidden ones too", "bash": "ls -A ~/", "category": "colloquial"}
{"nl": "show me what's in slash etc", "bash": "ls /etc/ | head -30", "category": "colloquial"}
{"nl": "look at the configuration for nginx", "bash": "cat /etc/nginx/nginx.conf", "category": "colloquial"}
{"nl": "see what's in my crontab folder", "bash": "ls /etc/cron.daily/", "category": "colloquial"}
{"nl": "check disk partition table", "bash": "sudo fdisk -l", "category": "colloquial"}
{"nl": "show me the gpt partitions", "bash": "sudo parted -l", "category": "colloquial"}
{"nl": "see the boot loader entries", "bash": "ls /boot/grub/", "category": "colloquial"}
{"nl": "view kernel boot parameters", "bash": "cat /proc/cmdline", "category": "colloquial"}
{"nl": "list loaded kernel modules", "bash": "lsmod | head -20", "category": "colloquial"}
{"nl": "show the firewall rules", "bash": "sudo ufw status verbose", "category": "colloquial"}
{"nl": "allow web traffic through the firewall", "bash": "sudo ufw allow 80/tcp", "category": "colloquial"}
{"nl": "allow ssh through firewall", "bash": "sudo ufw allow 22/tcp", "category": "colloquial"}
{"nl": "block a specific ip address", "bash": "sudo ufw deny from 192.168.1.50", "category": "colloquial"}
{"nl": "show me what is using port 22", "bash": "sudo lsof -i :22", "category": "colloquial"}
{"nl": "see open udp connections", "bash": "ss -unap 2>/dev/null", "category": "colloquial"}
{"nl": "see established tcp connections", "bash": "ss -tan state established", "category": "colloquial"}
{"nl": "how do I open a port for an app", "bash": "sudo ufw allow 8080/tcp", "category": "colloquial"}
{"nl": "block all outgoing connections to a specific port", "bash": "sudo ufw deny out 25/tcp", "category": "colloquial"}
{"nl": "check if my web app is reachable from outside", "bash": "curl -I http://localhost:8080", "category": "colloquial"}
{"nl": "test a web server response time", "bash": "curl -w 'time_total: %{time_total}\\n' -o /dev/null -s https://example.com", "category": "colloquial"}
{"nl": "see my dns servers", "bash": "resolvectl status | grep 'DNS Servers'", "category": "colloquial"}
{"nl": "see open files by everyone on the system", "bash": "sudo lsof | head -30", "category": "colloquial"}
{"nl": "check how many processes I have", "bash": "ps -e | wc -l", "category": "colloquial"}
{"nl": "see threads of a process", "bash": "ps -eLf | grep firefox | head", "category": "colloquial"}
{"nl": "show me the process tree", "bash": "pstree -p", "category": "colloquial"}
{"nl": "what process started this one", "bash": "ps -p $$ -o ppid=", "category": "colloquial"}
{"nl": "stop all instances of a program", "bash": "killall firefox", "category": "colloquial"}
{"nl": "pause a process temporarily", "bash": "kill -STOP 4523", "category": "colloquial"}
{"nl": "resume a paused process", "bash": "kill -CONT 4523", "category": "colloquial"}
{"nl": "lower the priority of a running task", "bash": "renice -n 10 -p 4523", "category": "colloquial"}
{"nl": "give a process more priority", "bash": "sudo renice -n -5 -p 4523", "category": "colloquial"}
{"nl": "run a command at lower priority", "bash": "nice -n 19 ~/scripts/heavy_task.sh", "category": "colloquial"}
{"nl": "see disk usage tree", "bash": "ncdu ~", "category": "colloquial"}
{"nl": "interactively find what's filling my disk", "bash": "ncdu /", "category": "colloquial"}
{"nl": "show me which folder eats the most space in slash var", "bash": "sudo du -sh /var/* | sort -hr | head", "category": "colloquial"}
{"nl": "find biggest folders under root", "bash": "sudo du -h --max-depth=1 / 2>/dev/null | sort -hr | head", "category": "colloquial"}
{"nl": "do a quick smart test", "bash": "sudo smartctl -t short /dev/sda", "category": "colloquial"}
{"nl": "see drive temperature", "bash": "sudo smartctl -a /dev/sda | grep -i temperature", "category": "colloquial"}
{"nl": "format a usb drive as fat32", "bash": "sudo mkfs.vfat -F32 /dev/sdb1", "category": "colloquial"}
{"nl": "format a drive as ext4", "bash": "sudo mkfs.ext4 /dev/sdb1", "category": "colloquial"}
{"nl": "label a usb drive", "bash": "sudo fatlabel /dev/sdb1 MYDRIVE", "category": "colloquial"}
{"nl": "show all the cron jobs system wide", "bash": "for u in $(cut -d: -f1 /etc/passwd); do sudo crontab -u $u -l 2>/dev/null && echo --$u--; done", "category": "colloquial"}
{"nl": "back up my home folder to an external drive", "bash": "rsync -aAXv ~/ /media/backup/home_backup/ --exclude={.cache,.local/share/Trash}", "category": "colloquial"}
{"nl": "make a full system snapshot", "bash": "sudo rsync -aAXv --exclude={/proc,/sys,/dev,/tmp,/run,/mnt,/media} / /media/backup/system/", "category": "colloquial"}
{"nl": "check if a package is installed", "bash": "dpkg -l | grep nginx", "category": "colloquial"}
{"nl": "show me which package installed a file", "bash": "dpkg -S /usr/bin/python3", "category": "colloquial"}
{"nl": "see what files a package installed", "bash": "dpkg -L nginx | head -20", "category": "colloquial"}
{"nl": "fix broken package installs", "bash": "sudo apt --fix-broken install", "category": "colloquial"}
{"nl": "see my recent apt history", "bash": "less /var/log/apt/history.log", "category": "colloquial"}
{"nl": "what did I install yesterday", "bash": "grep -A1 'Start-Date' /var/log/apt/history.log | tail -20", "category": "colloquial"}
{"nl": "add a new repository", "bash": "sudo add-apt-repository ppa:graphics-drivers/ppa", "category": "colloquial"}
{"nl": "list my repositories", "bash": "grep -rh ^deb /etc/apt/sources.list /etc/apt/sources.list.d/", "category": "colloquial"}
{"nl": "show me what python is installed", "bash": "ls /usr/bin/python*", "category": "colloquial"}
{"nl": "install pip for python", "bash": "sudo apt install -y python3-pip", "category": "colloquial"}
{"nl": "see installed pip packages", "bash": "pip list --user", "category": "colloquial"}
{"nl": "update a pip package", "bash": "pip install --upgrade requests", "category": "colloquial"}
{"nl": "uninstall a python package", "bash": "pip uninstall -y requests", "category": "colloquial"}
{"nl": "show me node js version", "bash": "node --version", "category": "colloquial"}
{"nl": "trying to save changes to the hosts file and it says read-only", "bash": "sudo nano /etc/hosts", "category": "sudo"}
{"nl": "I get permission denied when editing fstab", "bash": "sudo nano /etc/fstab", "category": "sudo"}
{"nl": "it won't let me open the ssh config to edit it", "bash": "sudo nano /etc/ssh/sshd_config", "category": "sudo"}
{"nl": "can't write to the nginx config file says access denied", "bash": "sudo nano /etc/nginx/nginx.conf", "category": "sudo"}
{"nl": "I'm getting read only filesystem error trying to edit crontab", "bash": "sudo nano /etc/crontab", "category": "sudo"}
{"nl": "won't let me edit the resolv.conf file", "bash": "sudo nano /etc/resolv.conf", "category": "sudo"}
{"nl": "access denied when trying to change the sudoers file", "bash": "sudo visudo", "category": "sudo"}
