{"nl": "can't append my mount entry to fstab it says permission denied", "bash": "echo '/dev/sdc1 /mnt/backup ext4 defaults 0 2' | sudo tee -a /etc/fstab", "category": "sudo"}
{"nl": "trying to add a custom DNS server but the file won't save", "bash": "echo 'nameserver 1.1.1.1' | sudo tee -a /etc/resolv.conf", "category": "sudo"}
{"nl": "won't let me edit the apache config file", "bash": "sudo nano /etc/apache2/apache2.conf", "category": "sudo"}
{"nl": "permission denied trying to edit the postgres config", "bash": "sudo nano /etc/postgresql/14/main/postgresql.conf", "category": "sudo"}
{"nl": "I can't modify the mysql config file", "bash": "sudo nano /etc/mysql/my.cnf", "category": "sudo"}
{"nl": "it says I can't write to the redis config", "bash": "sudo nano /etc/redis/redis.conf", "category": "sudo"}
{"nl": "won't save my changes to the docker daemon config", "bash": "sudo nano /etc/docker/daemon.json", "category": "sudo"}
{"nl": "trying to edit the kernel parameters file but it won't let me", "bash": "sudo nano /etc/sysctl.conf", "category": "sudo"}
{"nl": "access denied when I try to edit the network interfaces file", "bash": "sudo nano /etc/network/interfaces", "category": "sudo"}
{"nl": "I can't write to the netplan yaml file", "bash": "sudo nano /etc/netplan/01-netcfg.yaml", "category": "sudo"}
{"nl": "won't let me edit the bash profile in etc", "bash": "sudo nano /etc/profile", "category": "sudo"}
{"nl": "the environment file won't save my changes", "bash": "sudo nano /etc/environment", "category": "sudo"}
{"nl": "permission denied editing the motd login message", "bash": "sudo nano /etc/motd", "category": "sudo"}
{"nl": "I get read-only error on the issue file", "bash": "sudo nano /etc/issue", "category": "sudo"}
{"nl": "can't save my changes to the timezone config", "bash": "sudo nano /etc/timezone", "category": "sudo"}
{"nl": "trying to update the locale file but no write permission", "bash": "sudo nano /etc/locale.gen", "category": "sudo"}
{"nl": "won't let me edit the pam config", "bash": "sudo nano /etc/pam.d/common-auth", "category": "sudo"}
{"nl": "I can't restart nginx, says access denied", "bash": "sudo systemctl restart nginx", "category": "sudo"}
{"nl": "the postgres service won't restart for me", "bash": "sudo systemctl restart postgresql", "category": "sudo"}
{"nl": "trying to stop redis but says permission denied", "bash": "sudo systemctl stop redis", "category": "sudo"}
{"nl": "I can't start the docker service", "bash": "sudo systemctl start docker", "category": "sudo"}
{"nl": "ssh service won't restart says I need to be root", "bash": "sudo systemctl restart sshd", "category": "sudo"}
{"nl": "I need to enable apache to start on boot but it won't let me", "bash": "sudo systemctl enable apache2", "category": "sudo"}
{"nl": "trying to disable the bluetooth service but access denied", "bash": "sudo systemctl disable bluetooth", "category": "sudo"}
{"nl": "the mysql service is stuck and I can't restart it", "bash": "sudo systemctl restart mysql", "category": "sudo"}
{"nl": "can't reload nginx after editing the config", "bash": "sudo systemctl reload nginx", "category": "sudo"}
