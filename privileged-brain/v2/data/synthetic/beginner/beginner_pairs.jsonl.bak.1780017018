{"nl": "I can't search the system log for errors", "bash": "sudo grep -i error /var/log/syslog", "category": "sudo"}
{"nl": "access denied reading the ufw log", "bash": "sudo tail -n 100 /var/log/ufw.log", "category": "sudo"}
{"nl": "trying to see the sshd connection logs", "bash": "sudo journalctl -u ssh --since '1 hour ago'", "category": "sudo"}
{"nl": "I get permission denied looking at the apache error log", "bash": "sudo tail -f /var/log/apache2/error.log", "category": "sudo"}
{"nl": "won't let me see kernel messages from last boot", "bash": "sudo journalctl -k -b -1", "category": "sudo"}
{"nl": "I can't list files in /root", "bash": "sudo ls -la /root", "category": "sudo"}
{"nl": "permission denied trying to write to /var/www/html", "bash": "sudo chown -R $USER:$USER /var/www/html", "category": "sudo"}
{"nl": "the app can't create files in this folder because it's owned by root", "bash": "sudo chown -R www-data:www-data /var/app/data", "category": "sudo"}
{"nl": "I can't make my script executable in /usr/local/bin", "bash": "sudo chmod +x /usr/local/bin/deploy.sh", "category": "sudo"}
{"nl": "trying to create a folder in /opt but access denied", "bash": "sudo mkdir -p /opt/myapp/logs", "category": "sudo"}
{"nl": "won't let me delete this file owned by root", "bash": "sudo rm /var/log/old_install.log", "category": "sudo"}
{"nl": "permission denied trying to copy a file to /etc", "bash": "sudo cp ~/Documents/myapp.conf /etc/myapp.conf", "category": "sudo"}
{"nl": "I can't move this file to /usr/local/bin", "bash": "sudo mv ~/bin/mytool /usr/local/bin/mytool", "category": "sudo"}
{"nl": "trying to rename a system file but it says read only", "bash": "sudo mv /etc/oldconfig.conf /etc/newconfig.conf", "category": "sudo"}
{"nl": "I need to give myself ownership of this directory", "bash": "sudo chown -R $USER:$USER /opt/myproject", "category": "sudo"}
{"nl": "the web server can't write to its data folder", "bash": "sudo chown -R www-data:www-data /var/www/html/uploads", "category": "sudo"}
{"nl": "won't let me set the right permissions on the ssh keys", "bash": "sudo chmod 600 /etc/ssh/ssh_host_rsa_key", "category": "sudo"}
{"nl": "permission denied creating a symlink in /usr/bin", "bash": "sudo ln -s /opt/myapp/bin/run /usr/local/bin/run", "category": "sudo"}
{"nl": "I can't make this folder world-readable", "bash": "sudo chmod -R 755 /opt/myapp/public", "category": "sudo"}
{"nl": "trying to change the group on /etc/ssl/private but no permission", "bash": "sudo chgrp ssl-cert /etc/ssl/private", "category": "sudo"}
{"nl": "I get permission denied moving files to /var/lib", "bash": "sudo mv ~/data/cache /var/lib/myapp/cache", "category": "sudo"}
{"nl": "won't let me open port 80 in the firewall", "bash": "sudo ufw allow 80/tcp", "category": "sudo"}
