# GBNF Grammar — MCP Tool Call (JSON)
# Constrains llama.cpp output to syntactically valid JSON MCP tool call objects.
# Used with: llama-server --grammar-file inference/grammar/mcp_tool_call.gbnf
#
# Valid output example:
#   {"tool": "service.restart", "params": {"service": "nginx"}}

root        ::= tool-call
tool-call   ::= "{" ws tool-field ws "," ws params-field ws "}"
tool-field  ::= "\"tool\"" ws ":" ws string
params-field ::= "\"params\"" ws ":" ws object

object      ::= "{" ws "}" | "{" ws pair (ws "," ws pair)* ws "}"
pair        ::= string ws ":" ws value
value       ::= string | number | "true" | "false" | "null" | object | array
array       ::= "[" ws "]" | "[" ws value (ws "," ws value)* ws "]"

string      ::= "\"" (
                  [^"\\] |
                  "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
                )* "\""

number      ::= "-"? ([0-9] | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [-+]? [0-9]+)?

ws          ::= ([ \t\n\r])*
