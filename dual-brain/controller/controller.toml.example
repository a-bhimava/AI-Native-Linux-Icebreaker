# Icebreaker Controller — example config.
#
# Bootstrap on the GCP VM:
#   mkdir -p ~/.config/icebreaker
#   cp dual-brain/controller/controller.toml.example \
#      ~/.config/icebreaker/controller.toml
#   $EDITOR ~/.config/icebreaker/controller.toml
#
# The live config path is $XDG_CONFIG_HOME/icebreaker/controller.toml,
# falling back to ~/.config/icebreaker/controller.toml.
#
# SECURITY: never put an API key value in this file. The api_key_env
# field is the NAME of an environment variable that holds the key.
# config.load() rejects any TOML key whose name matches
# /api_key|secret|token|password|bearer/i (with `api_key_env` allowlisted).


# Quarantined Brain — translates user NL into an Intent Object.
# Choose one: "local", "anthropic", "gemini".
# Only the section matching `backend` is required.
[qb]
backend = "local"


[qb.local]
# Local llama-server backed by a plug-and-play model registry.
#
# model_id is a CATALOGUE KEY (lookup in controller/catalogue.toml). The
# Controller never sees a GGUF filename — the registry resolves model_id
# to an on-disk path inside the ops scripts.
#
# To list available models:    python3 -m controller.model_registry list --role qb
# To get a hardware recommendation: python3 -m controller.model_registry recommend
# To install a model:          python3 -m controller.model_registry install --id <id>
#
# To swap models: change `model_id` here, then restart llama-server-qb.
# No code change required.
model_id = "qwen-2.5-1.5b-instruct-q4_k_m"

# Optional speculative-decoding draft (must reference a catalogue entry
# with role="draft"). Shared with PB; same file mmap'd by both servers.
draft_model_id = "qwen-2.5-coder-0.5b-instruct-q4_k_m"

endpoint = "http://127.0.0.1:8081"
transport = "http"                                  # "unix" reserved for Phase 6
grammar_path = "grammars/qb_intent.gbnf"
max_tokens = 512
timeout_seconds = 30


[qb.anthropic]
# Claude Haiku 4.5 — required for native JSON output mode
# (output_config.format = "json_schema"). ~$1 / 1M input tokens,
# ~$5 / 1M output tokens (confirm against published rates at deploy).
model = "claude-haiku-4-5"
api_key_env = "ANTHROPIC_API_KEY"
max_tokens = 1024
timeout_seconds = 30


[qb.gemini]
# Gemini 2.5 Flash — stable GA flash model with native response_schema
# structured output. (gemini-2.0-flash was retired; if 2.5-flash is ever
# deprecated, pick a current model via `genai.list_models()`.)
model = "gemini-2.5-flash"
api_key_env = "GEMINI_API_KEY"
max_tokens = 1024
timeout_seconds = 30


[qb.openai]
# GPT-4.1 mini — fast, affordable model with native Structured Outputs
# (response_format type=json_schema, strict=True). Supports oneOf
# natively. ~$0.40 / 1M input, ~$1.60 / 1M output (confirm rates).
model = "gpt-4.1-mini"
api_key_env = "OPENAI_API_KEY"
max_tokens = 1024
timeout_seconds = 30


# HITL gate — tunable safety parameters (all optional; defaults shown).
# Increase lockout_seconds if users are rubber-stamping too fast.
# Decrease timeout_seconds if unattended terminals are a concern.
#
# [hitl]
# lockout_seconds = 3     # seconds the Approve button is disabled (INV-6 minimum: 1)
# timeout_seconds = 30    # seconds before auto-deny
# presenter = "terminal"  # options below
#
# Available:
#   - "terminal"              — TTY prompt with cbreak keyboard input (default)
#   - "screen_reader"         — Accessible plain-text output for Orca/NVDA users
#   - "gtk"                   — Basic GTK4 modal (PyGObject required)
#   - "libadwaita"            — LibAdwaita modal w/ visual lockout + COW diff
#                                (PyGObject + libadwaita required)
#   - "annotated_screenshot"  — v6.15 Fix V: LibAdwaita modal + inline
#                                annotated screenshot preview when the
#                                HITL prompt carries a preview_image_path
#                                (e.g. from grounded vision actions)
# trust_ttl_seconds = 0   # 0 = [T]rust disabled (default); set > 0 to enable trust grants


# HITL keymap — configurable key bindings for the approval gate.
# Each action accepts a list of single-character bindings.
# Defaults: numeric (1–5) + mnemonic (a/d/m/e/t) + universal (y/n).
# Esc is always DENY (hard-reserved, cannot be remapped).
# '?' is always HELP (cannot be unbound).
#
# [keymap]
# approve = ["1", "a", "y"]
# deny    = ["2", "d", "n"]
# modify  = ["3", "m"]
# explain = ["4", "e"]
# trust   = ["5", "t"]
# help    = ["?"]


# Orchestration runtime — all optional; defaults shown.
# mcpd_binary is relative to the repo root; set to an absolute path for system install.
# audit_log is append-only (INV-8); never writable by the AI models.
#
# [run]
# mcpd_binary          = "src/mcpd/target/release/mcpd"
# audit_log            = "~/.local/state/icebreaker/controller-audit.log"
# pb_endpoint          = "http://127.0.0.1:8080"
# pb_model_id          = "run7_cot"
# pb_max_tokens        = 256
# pb_timeout_seconds   = 10
# mcpd_timeout_seconds = 10.0
# qb_max_retries       = 3
# mcpd_schemas_dir     = ""   # empty = auto-detected from mcpd_binary path
# pb_transport         = "http"   # "http" (loopback) or "unix" (AF_UNIX socket for distro)
# pb_grammar_path      = "/var/lib/icebreaker/grammars/mcp_tool_call.gbnf"
#   M7.0.2a (v6.16): GBNF grammar file for PB's llama-server. When set, every
#   PB completion is token-constrained to schema-valid JSON tool calls
#   (whitepaper §6 "the model literally CANNOT generate invalid output").
#   Leave unset / null to run PB unconstrained (audit row C-4 non-compliant;
#   the existing post-hoc verifier still catches ~95% of schema violations).
#   Recommended shipping path shown above. Smoke-gate refuses ISO builds
#   without the file at this path.


# REPL session — all optional; defaults shown.
# Increase max_turns if you need longer workflows; decrease session_ttl_seconds
# on shared or kiosk terminals to auto-close idle sessions.
#
# [session]
# session_ttl_seconds   = 1800    # 30 min inactivity — set 0 to disable
# max_turns             = 50      # auto-close after N turns (P2-F20 memory bound)
# history_path          = "~/.local/state/icebreaker/repl_history"
# ephemeral_history     = true    # true = in-memory only (SF-8); false = file-based
# show_spinner          = true
# show_progress         = true    # step-by-step pipeline labels instead of generic spinner
# stream_output         = true    # stream QB summarisation tokens as they arrive
# color                 = "auto"  # "auto" | "always" | "never"
# prompt_prefix         = "icebreaker"
# max_tool_output_lines = 40      # lines of tool output forwarded to QB for summary


# Cost governance — per-session cost ceiling (SF-9, BP-10).
# Resets on /reset or new session. 0 = no ceiling (unlimited).
#
# [cost]
# session_ceiling_usd = 1.00     # deny turns once this is reached
# warn_fraction       = 0.8      # alert at 80% of ceiling


# Resource limits — input size cap + rate limiting (SF-9, BP-10).
# On breach: deny + audit + user message (never silent).
#
# [limits]
# max_input_chars   = 4000       # reject inputs larger than this (0 = no limit)
# max_turns_per_min = 30         # rate limit (0 = unlimited)


# Risk classifier — pluggable strategy (BP-5).
# Default "rules" uses the built-in rule-based classifier.
#
# [risk]
# strategy = "rules"


# Tier-2 independent review — off by default (BP-2).
# When enabled, high-risk operations get a second independent QB review.
#
# [tier2]
# enabled     = false
# strategy    = "llm"     # "llm" | "rule" | "none"
# max_retries = 2


# Undo scaffold — off by default (BP-2). Tracks undo history per session.
# Actual rollback awaits mcpd rollback RPC; /undo currently shows status only.
#
# [undo]
# enabled     = false
# max_history = 10


# QB-verifier voting — controls how many independent QB calls verify each
# intent→tool_call mapping. Default votes=1 preserves current single-call
# behavior. Set votes>1 to enable majority voting (trades latency for safety).
#
# [verifier]
# votes           = 1       # 1 = single call (default, current behavior)
# require         = 0       # 0 = majority (ceil(votes/2)); >0 = exact threshold
# parallel        = true    # parallel calls via ThreadPoolExecutor
# timeout_seconds = 30      # per-vote timeout


# Daemon mode — persistent background service (BP-2: opt-in).
# Start: python3 -m controller --daemon
# Connect: python3 -m controller --connect
#
# [daemon]
# socket_path     = "~/.local/state/icebreaker/controller.sock"
# pid_file        = "~/.local/state/icebreaker/controller.pid"
# max_connections = 1


# System prompts — all optional. Defaults to the in-package controller/prompts/ directory.
# Override prompts_dir to point at a custom directory (e.g. for A/B prompt testing).
# Per-backend paths take priority over prompts_dir.
# Phase 6: set prompts_dir = "/etc/icebreaker/prompts" in the system config.
#
# [prompts]
# prompts_dir  = "dual-brain/controller/prompts"
# qb_local     = ""   # empty = use prompts_dir/qb_local.txt
# qb_anthropic = ""
# qb_gemini    = ""
# qb_openai    = ""
# pb           = ""
# qb_verifier  = ""


# Optional: override where the model registry looks for catalogue + GGUF files.
# Defaults below are what the registry uses without an explicit [paths] section.
#
# [paths]
# catalogue_path = "dual-brain/controller/catalogue.toml"
# model_search_dirs = [
#     "models",                              # repo-relative (dev)
#     "~/.local/share/icebreaker/models",    # user pool
#     "/var/lib/icebreaker/models",          # system pool (Phase 6)
# ]


# ── Fix V (v6.15) — vision-grounded UI automation ─────────────────────────
#
# The 4 [gui.*] sub-sections below tune the vision layer. All keys are
# optional — omit any section to accept the defaults shown here (also
# hard-coded in dual-brain/controller/config.py Gui{Vision,Trust,Preview,
# Geometry}Config dataclasses).
#
# [gui.vision]
# enabled = true
# backend = "gemini/gemini-2.5-flash"          # LiteLLM primary
# fallback_backend = "anthropic/claude-haiku-4-5"  # rate-limit fallback
# max_elements_per_parse = 50
# cost_ceiling_usd_per_turn = 0.01             # BP-10 governance
# cache_ttl_seconds = 2.0                      # dedup consecutive parses
# retry_on_malformed_json = 1
#
# [gui.trust]
# enabled = true
# store_path   = "/var/lib/icebreaker/gui_trust.jsonl"
# defaults_dir = "/etc/icebreaker/gui_trust.d"
#
# [gui.preview]
# enabled = true
# notify_urgency = "low"      # "low" | "normal" | "critical"
# preview_ttl_seconds = 5     # desktop notification dwell time
#
# [gui.geometry]
# hidpi_scale_override = 0    # 0 = auto (xrandr); positive forces scale
