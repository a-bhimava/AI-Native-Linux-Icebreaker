# Icebreaker Controller — example config.
#
# Bootstrap on the GCP VM:
#   mkdir -p ~/.config/icebreaker
#   cp dual-brain/controller/controller.toml.example \
#      ~/.config/icebreaker/controller.toml
#   $EDITOR ~/.config/icebreaker/controller.toml
#
# The live config path is $XDG_CONFIG_HOME/icebreaker/controller.toml,
# falling back to ~/.config/icebreaker/controller.toml.
#
# SECURITY: never put an API key value in this file. The api_key_env
# field is the NAME of an environment variable that holds the key.
# config.load() rejects any TOML key whose name matches
# /api_key|secret|token|password|bearer/i (with `api_key_env` allowlisted).


# Quarantined Brain — translates user NL into an Intent Object.
# Choose one: "local", "anthropic", "gemini".
# Only the section matching `backend` is required.
[qb]
backend = "local"


[qb.local]
# Local llama-server backed by a plug-and-play model registry.
#
# model_id is a CATALOGUE KEY (lookup in controller/catalogue.toml). The
# Controller never sees a GGUF filename — the registry resolves model_id
# to an on-disk path inside the ops scripts.
#
# To list available models:    python3 -m controller.model_registry list --role qb
# To get a hardware recommendation: python3 -m controller.model_registry recommend
# To install a model:          python3 -m controller.model_registry install --id <id>
#
# To swap models: change `model_id` here, then restart llama-server-qb.
# No code change required.
model_id = "qwen-2.5-1.5b-instruct-q4_k_m"

# Optional speculative-decoding draft (must reference a catalogue entry
# with role="draft"). Shared with PB; same file mmap'd by both servers.
draft_model_id = "qwen-2.5-coder-0.5b-instruct-q4_k_m"

endpoint = "http://127.0.0.1:8081"
transport = "http"                                  # "unix" reserved for Phase 6
grammar_path = "dual-brain/controller/grammars/qb_intent.gbnf"
max_tokens = 512
timeout_seconds = 30


[qb.anthropic]
# Claude Haiku 4.5 — required for native JSON output mode
# (output_config.format = "json_schema"). ~$1 / 1M input tokens,
# ~$5 / 1M output tokens (confirm against published rates at deploy).
model = "claude-haiku-4-5"
api_key_env = "ANTHROPIC_API_KEY"
max_tokens = 1024
timeout_seconds = 30


[qb.gemini]
# Gemini 2.0 Flash — generous free tier (~1,500 req/day).
model = "gemini-2.0-flash"
api_key_env = "GEMINI_API_KEY"
max_tokens = 1024
timeout_seconds = 30


# Optional: override where the model registry looks for catalogue + GGUF files.
# Defaults below are what the registry uses without an explicit [paths] section.
#
# [paths]
# catalogue_path = "dual-brain/controller/catalogue.toml"
# model_search_dirs = [
#     "models",                              # repo-relative (dev)
#     "~/.local/share/icebreaker/models",    # user pool
#     "/var/lib/icebreaker/models",          # system pool (Phase 6)
# ]
