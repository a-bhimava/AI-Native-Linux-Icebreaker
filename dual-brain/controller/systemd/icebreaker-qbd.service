[Unit]
Description=Icebreaker Quarantined Brain llama-server
Documentation=man:icebreaker(1)
# No After= on icebreaker-pbd.service — ADR-7: parallel startup.

[Service]
Type=exec
User=_icebreaker_qb
Group=icebreaker-users
ExecStart=/usr/libexec/icebreaker/start-qbd
EnvironmentFile=/etc/icebreaker/locations.env

Restart=on-failure
RestartSec=5

RuntimeDirectory=icebreaker
RuntimeDirectoryPreserve=yes
UMask=0117

# Hardening (BP-9).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ReadOnlyPaths=/var/lib/icebreaker/models
ReadOnlyPaths=/usr/libexec/icebreaker
ReadOnlyPaths=/usr/share/icebreaker
ReadWritePaths=/run/icebreaker
ReadWritePaths=/var/log/icebreaker
MemoryMax=4G

[Install]
WantedBy=multi-user.target
