[Unit]
Description=Icebreaker MCP Daemon (user %i)
Documentation=man:icebreaker(1)
# mcpd is stdio-only (INV-3) and per-user. The controller spawns it via
# McpdClient.spawn(), but this unit lets systemd manage lifecycle when
# running in daemon mode.

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/icebreaker/mcpd
User=%i

Restart=on-failure
RestartSec=3

# Hardening (BP-9).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# mcpd needs read access to user home for fs tools.
ReadOnlyPaths=/usr/libexec/icebreaker
ReadOnlyPaths=/usr/share/icebreaker
# mcpd writes COW snapshots under user's state dir.
ReadWritePaths=%h/.local/state/icebreaker

[Install]
WantedBy=default.target
