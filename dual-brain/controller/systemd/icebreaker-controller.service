[Unit]
Description=Icebreaker Controller Daemon
Documentation=man:icebreaker(1)
After=network.target icebreaker-pbd.service icebreaker-qbd.service
Wants=icebreaker-pbd.service icebreaker-qbd.service

[Service]
Type=exec
EnvironmentFile=/etc/icebreaker/locations.env
ExecStartPre=/usr/libexec/icebreaker/wait-for-sockets
ExecStart=/opt/icebreaker/venv/bin/python3 -m controller --daemon --config /etc/icebreaker/controller.toml
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5

StateDirectory=icebreaker
# F-99: LogsDirectory creates + owns the listed dirs under /var/log at unit
# start, and adds them to the service's private mount namespace as writable
# (survives ProtectSystem=strict). `mcpd` is required by the OC-edition
# oc_audit_bridge which tails /var/log/mcpd/audit.log; without this line
# the bridge previously killed the daemon with `Fatal: [Errno 2]`. Harmless
# in the current edition (dir just sits empty when the bridge is inactive).
LogsDirectory=icebreaker mcpd

# Hardening (BP-9).
NoNewPrivileges=yes
ProtectSystem=strict
# F-30: ProtectHome=yes masks /home/<user> at mode 0000 in the controller's
# private mount namespace — mcpd (child process) then sees ENOENT on any
# path under /home. Use tmpfs (empty /home) + BindReadOnlyPaths so the
# admin-approved read root(s) are the only /home paths visible.
ProtectHome=tmpfs
# HOME env for the controller — inherited by mcpd via the scrubbed env.
# Sets Landlock kernel allow list AND mcpd's fs.rs default_roots to
# include /home/icebreaker. NOT set globally in locations.env because pbd
# runs as _icebreaker_pb (different user, different home).
Environment=HOME=/home/icebreaker
# F-31: writable bind of the user's home. fs.write inside $HOME is a
# documented Tier-1 supported operation (risk_level=low in the catalogue);
# read-only here made every write fail EROFS at Tool Execution. Security
# for writes is enforced upstream by (a) validated intents, (b) COW gate
# for SENSITIVE_HOME_SUBDIRS + writes outside home, (c) HITL for higher
# tiers, (d) MAX_WRITE_BYTES cap in mcpd.
BindPaths=/home/icebreaker
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ReadOnlyPaths=/opt/icebreaker/venv
ReadOnlyPaths=/usr/share/icebreaker
ReadWritePaths=/run/icebreaker
ReadWritePaths=/var/log/icebreaker

[Install]
WantedBy=multi-user.target
