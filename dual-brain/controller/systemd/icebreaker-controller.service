[Unit]
Description=Icebreaker Controller Daemon
Documentation=man:icebreaker(1)
After=network.target icebreaker-pbd.service icebreaker-qbd.service
Wants=icebreaker-pbd.service icebreaker-qbd.service

[Service]
Type=exec
# Credentials are root-only and intentionally sourced by this service alone.
# PB/QB inference and every execution child run without cloud API keys.
EnvironmentFile=/etc/icebreaker/locations.env -/etc/icebreaker/credentials.env
ExecStartPre=/usr/libexec/icebreaker/wait-for-sockets
ExecStart=/opt/icebreaker/venv/bin/python3 -m controller --daemon --config /etc/icebreaker/controller.toml
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5

StateDirectory=icebreaker
# F-99: LogsDirectory creates + owns the listed dirs under /var/log at unit
# start, and adds them to the service's private mount namespace as writable
# (survives ProtectSystem=strict). `mcpd` is required by the OC-edition
# oc_audit_bridge which tails /var/log/mcpd/audit.log; without this line
# the bridge previously killed the daemon with `Fatal: [Errno 2]`. Harmless
# in the current edition (dir just sits empty when the bridge is inactive).
LogsDirectory=icebreaker mcpd

# Hardening (BP-9).
NoNewPrivileges=yes
ProtectSystem=strict
# The daemon itself has no filesystem operation path.  Each accepted peer
# starts an mcpd child under that peer's uid; mcpd's HOME + Landlock policy
# are set to precisely that account's home.  Bind /home once so a valid
# dynamically-created account is visible without a static /home/icebreaker
# exception (BP-9 / multi-user isolation).
ProtectHome=tmpfs
BindPaths=/home
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
# The controller must create mcpd under the SO_PEERCRED uid/gid.  This
# transition is performed by Python's argv-only Popen identity API (not a
# shell) before mcpd starts.  Keep this explicit rather than silently
# inheriting RestrictSUIDSGID=yes and failing every user session.
RestrictSUIDSGID=no
ReadOnlyPaths=/opt/icebreaker/venv
ReadOnlyPaths=/usr/share/icebreaker
ReadWritePaths=/run/icebreaker
ReadWritePaths=/var/log/icebreaker

[Install]
WantedBy=multi-user.target
