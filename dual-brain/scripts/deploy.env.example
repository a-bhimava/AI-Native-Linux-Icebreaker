# deploy.env.example — Icebreaker Phase 2 close-out: target VM + API keys.
#
# WHAT THIS IS
#   A single sourced shell config that declares (a) which GCP VM to deploy the
#   Controller to and (b) the API keys the gate suite needs. It is the one file
#   you edit to point the close-out at a different machine.
#
# HOW TO USE
#   1. Copy this template to the real (gitignored) file:
#        cp scripts/deploy.env.example scripts/deploy.env
#   2. Edit scripts/deploy.env with the live VM and your real key values.
#   3. Source it before deploying / running gates:
#        source scripts/deploy.env
#        bash scripts/deploy_to_vm.sh        # reads VM_NAME / VM_ZONE / VM_PROJECT
#        bash controller/ci.sh               # reads ANTHROPIC_API_KEY / GEMINI_API_KEY
#
# SECURITY
#   - scripts/deploy.env is gitignored. NEVER commit it — it holds live keys.
#     Verify before staging:  git check-ignore scripts/deploy.env
#   - Real key VALUES live ONLY here (a sourced env file). The controller TOML
#     references only the env-var NAME via `api_key_env`; controller/config.py
#     rejects any secret-shaped key in TOML. Do not move keys into a .toml.
#   - deploy_to_vm.sh packs scripts/deploy.env into the upload tarball so the
#     keys reach the VM without being inlined into a `gcloud ssh --command=`
#     argument (which would leak them into process args / shell history).

# ── Target VM (read by scripts/deploy_to_vm.sh) ───────────────────────────────
# The previous VM (instance-20260528-030421) is retired. Point these at a live
# instance that has the QB GGUF model on disk (required for gate G9).
export VM_NAME="REPLACE_ME-vm"
export VM_ZONE="us-central1-a"
export VM_PROJECT="fiery-artifact-344713"
export REMOTE_DIR="~/dual-brain"
export VENV_PATH="~/dual-brain-venv"
export RUN_TESTS=1                       # 1 = run the pytest subset during deploy; 0 = upload only

# ── Ports / interpreter (the scripts/locations.env contract) ──────────────────
export ICEBREAKER_PORT_QB=8081           # ci.sh G9 probes http://127.0.0.1:$ICEBREAKER_PORT_QB/health
export ICEBREAKER_PYTHON=python3

# ── Secrets: real VALUES go in the gitignored copy, never in this template ────
# Enable gate G10 (backend parity) + the Anthropic/Gemini backends at runtime.
# The names below must match `api_key_env` in controller.toml (ANTHROPIC_API_KEY,
# GEMINI_API_KEY). hypothesis/anthropic/google-generativeai install via
# requirements.txt — no extra step needed.
export ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
export GEMINI_API_KEY="REPLACE_ME"
