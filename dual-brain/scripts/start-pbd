#!/usr/bin/env bash
# start-pbd — Distro wrapper for the Privileged Brain llama-server.
#
# Launched by icebreaker-pbd.service. Sources /etc/icebreaker/locations.env,
# resolves the model via the registry, verifies the checksum (INV-7), and
# binds llama-server to a UNIX socket at /run/icebreaker/pbd.sock.
#
# This is the DISTRO counterpart of scripts/start_pb.sh (which uses TCP
# loopback for dev). Both share the same model_registry resolve flow.
set -euo pipefail

# ── Environment ──────────────────────────────────────────────────────────
# EnvironmentFile= in the systemd unit pre-loads these, but source
# explicitly for manual runs and to fail fast if the file is missing.
LOCATIONS="${ICEBREAKER_LOCATIONS_ENV:-/etc/icebreaker/locations.env}"
if [ -f "${LOCATIONS}" ]; then
    # shellcheck source=/dev/null
    source "${LOCATIONS}"
fi

: "${ICEBREAKER_VENV_PYTHON:=/opt/icebreaker/venv/bin/python3}"
: "${ICEBREAKER_CONFIG:=/etc/icebreaker/controller.toml}"
: "${ICEBREAKER_MODELS_DIR:=/var/lib/icebreaker/models}"
: "${ICEBREAKER_SOCKET_DIR:=/run/icebreaker}"
: "${ICEBREAKER_LLAMA_SERVER:=/usr/libexec/icebreaker/llama-server}"
: "${ICEBREAKER_CHECKSUMS:=${ICEBREAKER_MODELS_DIR}/checksums.sha256}"
export ICEBREAKER_CHECKSUMS

SOCKET_PATH="${ICEBREAKER_SOCKET_DIR}/pbd.sock"

# ── Model resolution ────────────────────────────────────────────────────
# Read pb_model_id from [run] section of the config.
PB_MODEL_ID=$("${ICEBREAKER_VENV_PYTHON}" -c "
import sys, pathlib
if sys.version_info >= (3, 11):
    import tomllib
else:
    import tomli as tomllib
cfg = tomllib.loads(pathlib.Path('${ICEBREAKER_CONFIG}').read_text())
print(cfg.get('run', {}).get('pb_model_id', 'run7_cot'))
")

echo "[start-pbd] model_id=${PB_MODEL_ID}"

MODEL_FILE=$("${ICEBREAKER_VENV_PYTHON}" -m controller.model_registry \
    resolve --id "${PB_MODEL_ID}")
echo "[start-pbd] resolved model: ${MODEL_FILE}"

# ── Checksum already verified by model_registry resolve (INV-7, F-23) ──
# `resolve --id ...` above only returns a path after computing sha256 and
# comparing against models/checksums.sha256 (see model_registry.py:317-322).
# Duplicating that here doubled a 940 MB sha256 hash on every start — under
# emulation without SHA-NI that pushed start-pbd past the 900 s gate limit.
echo "[start-pbd] checksum verified by model_registry (INV-7)"

# ── Clean up stale socket ───────────────────────────────────────────────
if [ -e "${SOCKET_PATH}" ]; then
    rm -f "${SOCKET_PATH}"
fi

# ── Grammar file (M7.0.2b, v6.16) ───────────────────────────────────────
# GBNF grammar constrains PB's token generation to schema-valid JSON tool
# calls (whitepaper §6). Pre-M7.0.2b start-pbd shipped WITHOUT --grammar-file
# and explicitly said "PB uses no grammar — relies on post-hoc tool-call
# validation" — that comment reflected reality but violated audit row C-4.
#
# Belt-and-braces: smoke-gate refuses ISO builds without the file at the
# path below; runtime warns loudly but keeps PB alive if operator manages
# to break the install (degrade-not-crash per user's 2026-08-06 design).
GRAMMAR_FILE="${ICEBREAKER_PB_GRAMMAR:-/var/lib/icebreaker/grammars/mcp_tool_call.gbnf}"
if [ -f "${GRAMMAR_FILE}" ]; then
    GRAMMAR_ARGS=(--grammar-file "${GRAMMAR_FILE}")
    echo "[start-pbd] grammar: ${GRAMMAR_FILE}"
else
    GRAMMAR_ARGS=()
    echo "[start-pbd] ERROR: grammar file not found at ${GRAMMAR_FILE}" >&2
    echo "[start-pbd] ERROR: PB will run WITHOUT grammar constraint —" >&2
    echo "[start-pbd] ERROR:   whitepaper §6 non-compliant, audit row C-4 open." >&2
    echo "[start-pbd] ERROR:   Restore the file OR set ICEBREAKER_PB_GRAMMAR env var." >&2
fi

# ── Launch llama-server on UNIX socket ──────────────────────────────────
# llama-server binds to a UNIX socket when --host ends with .sock.
echo "[start-pbd] binding to ${SOCKET_PATH}"
exec "${ICEBREAKER_LLAMA_SERVER}" \
    --model "${MODEL_FILE}" \
    "${GRAMMAR_ARGS[@]}" \
    -ngl 99 \
    --host "${SOCKET_PATH}" \
    --no-warmup
