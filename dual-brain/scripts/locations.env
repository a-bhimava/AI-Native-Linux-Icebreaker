# Icebreaker — environment-variable contract for the ops scripts.
#
# In dev: source this file before running start_pb.sh / start_qb_local.sh.
# In Phase 6 distro packaging: this file becomes /etc/icebreaker/locations.env
# (admin-editable; sourced by systemd EnvironmentFile= directives).
#
# Every script reads ONLY these variables. No script hardcodes a path.

# Path to the active controller config (model_id lookup source).
# Dev default: the example shipped in-repo (read-only at runtime).
# User: override to ~/.config/icebreaker/controller.toml.
: "${ICEBREAKER_CONFIG:=$(cd "$(dirname "${BASH_SOURCE[0]}")/../controller" && pwd)/controller.toml.example}"

# llama-server bind ports (loopback only).
: "${ICEBREAKER_PORT_PB:=8080}"
: "${ICEBREAKER_PORT_QB:=8081}"

# Directory to chdir into before launching llama-server. Defaults to repo root.
: "${ICEBREAKER_PROJECT_ROOT:=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

# Python interpreter (some VMs ship python3.10, others 3.11+).
: "${ICEBREAKER_PYTHON:=python3}"

export ICEBREAKER_CONFIG ICEBREAKER_PORT_PB ICEBREAKER_PORT_QB
export ICEBREAKER_PROJECT_ROOT ICEBREAKER_PYTHON
