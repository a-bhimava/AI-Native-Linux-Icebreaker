# /etc/icebreaker/credentials.env — root-only Quarantined Brain credentials.
#
# This file is deliberately separate from locations.env.  Only the
# Icebreaker Controller reads it; normal desktop users, PB/QB inference
# services, OpenCode, audit tooling, and child execution processes do not.
#
# Configure an owner-managed key with: sudo ib-setup-key
# GEMINI_API_KEY=
