# /etc/icebreaker/locations.env — environment contract for distro scripts.
# Sourced by icebreaker-pbd, icebreaker-qbd, and icebreaker-controller
# services via EnvironmentFile=. Admin-editable; changes take effect on
# service restart (sudo systemctl restart icebreaker-controller).

ICEBREAKER_VENV_PYTHON=/opt/icebreaker/venv/bin/python3
ICEBREAKER_CONFIG=/etc/icebreaker/controller.toml
ICEBREAKER_MODELS_DIR=/var/lib/icebreaker/models
ICEBREAKER_SOCKET_DIR=/run/icebreaker
ICEBREAKER_LLAMA_SERVER=/usr/libexec/icebreaker/llama-server

# F-28: HOME for the controller daemon (and inherited by mcpd via the
# scrubbed env). Under systemd HOME is empty by default, causing mcpd's
# fs allowlist and Landlock kernel rule to fall back to "/" and "/root",
# so /home/icebreaker reads returned Permission denied (os error 13).
HOME=/home/icebreaker

# Quarantined Brain API key (required when [qb] backend = "gemini").
# Uncomment and set your key, then restart icebreaker-controller.
#GEMINI_API_KEY=
