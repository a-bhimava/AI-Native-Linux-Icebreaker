{
  "$schema": "https://opencode.ai/config.json",
  "//model-note": "F-108 (2026-08-02): swapped from gemini-2.5-flash to gemini-2.0-flash. 2.5-flash defaults to thinking-mode + opencode 1.18.4's ai-sdk streaming exits at step=1 without emitting user-visible text. Diagnosed via v6.14_OC UTM boot: opencode.log showed 'stream ... step=0 -> loop step=1 -> exiting loop' with no text delivered, yet raw curl to Gemini 2.5 Flash worked fine. 2.0-flash is non-thinking + GA + native structured output. Reverse this once opencode ai-sdk fixes the 2.5-thinking stream handling upstream.",
  "model": "google/gemini-2.0-flash",

  "mcp": {
    "icebreaker": {
      "type": "local",
      "command": ["/usr/libexec/icebreaker/mcpd-for-oc.sh"],
      "enabled": true
    },
    "//iceui-note": "F-101 (2026-07-27): second MCP server exposing gui.* + rpa.* to opencode. mcpd (Rust) has neither — those tools live in the Python controller and were unreachable from OC edition until Fix M. Tools appear as `iceui_gui.get_window_list`, `iceui_rpa.execute_workflow`, etc.",
    "iceui": {
      "type": "local",
      "command": ["/usr/libexec/icebreaker/gui-mcp-for-oc.sh"],
      "enabled": true
    }
  },

  "provider": {
    "anthropic": {},
    "openai": {},
    "google": {}
  },

  "//permission-note": "The `permission` block below is generated at ISO build time by incremental/build/gen-oc-config.sh — it boots the just-built mcpd, calls tools/list, and emits one entry per tool (Tier <= 1 => 'allow', Tier >= 2 => 'ask'). Manually editing this section will be overwritten on the next build. Note: opencode namespaces MCP tools as `<server>_<tool>`, so mcpd's `fs.write` becomes `icebreaker_fs.write` in the permission map. See docs/v6.x_OC/IMPLEMENTATION_PLAN.md § Fix P.",
  "permission": {
    "//PLACEHOLDER": "gen-oc-config.sh fills this at build time"
  }
}
