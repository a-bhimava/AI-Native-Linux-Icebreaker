[Desktop Entry]
Name=Icebreaker Terminal
Comment=AI-Native OS split-pane terminal
Exec=sh -c '/opt/icebreaker/venv/bin/python3 -m controller --terminal --config /etc/icebreaker/controller.toml 2>/tmp/icebreaker-terminal.log'
Icon=utilities-terminal
Terminal=true
Type=Application
Categories=System;TerminalEmulator;
Keywords=ai;terminal;tui;icebreaker;
