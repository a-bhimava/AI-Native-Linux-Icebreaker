#!/bin/bash
# ib-setup-key — configure an API key for a Quarantined Brain provider.
#
# Usage:
#   ib-setup-key                                  # interactive; sets GEMINI_API_KEY
#   ib-setup-key --env-var ANTHROPIC_API_KEY      # interactive; sets a specific var
#   ib-setup-key --env-var OPENAI_API_KEY <<<key  # non-interactive (stdin)
#   ib-setup-key --dry-run --env-var GEMINI_API_KEY  # print what would happen; no writes
#
# Writes VAR=VALUE into /etc/icebreaker/credentials.env (0600 root:root,
# BP-8: value never echoed, never logged) and restarts the Controller.  A
# separate non-secret status file says only which provider is configured.
# When invoked from the GUI via pkexec, stdin is a single line — no prompt
# is drawn.
#
# Phase 6 Scope D: --dry-run validates every side-effect boundary
# (arg parsing, env-var whitelist, target path resolvability, systemctl
# availability) and prints the intended sequence WITHOUT writing any
# files or restarting the controller. Used by Scope D smoke tests to
# exercise the polkit dispatch without requiring root or a live daemon.

set -euo pipefail

ENV_FILE=/etc/icebreaker/credentials.env
STATUS_FILE=/var/lib/icebreaker/credential-status.env
OWNER_FILE=/var/lib/icebreaker/device-owner.env
ENV_VAR="GEMINI_API_KEY"   # backwards-compat default
DRY_RUN=0

# Parse --dry-run / --help first so they can bypass the sudo re-exec.
_ARGS=("$@")
_SKIP_SUDO=0
for arg in "${_ARGS[@]}"; do
    case "$arg" in
        --dry-run) DRY_RUN=1; _SKIP_SUDO=1 ;;
        -h|--help) _SKIP_SUDO=1 ;;
    esac
done

# Only escalate to root when we're actually going to write files.
if [ "$_SKIP_SUDO" -eq 0 ]; then
    [ "$(id -u)" = "0" ] || exec sudo "$0" "$@"
fi

while [ $# -gt 0 ]; do
    case "$1" in
        --env-var) ENV_VAR="$2"; shift 2 ;;
        --dry-run) shift ;;
        -h|--help)
            grep -E '^# ' "$0" | sed 's/^# //'
            exit 0
            ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

# Whitelist of accepted variable names — protects against a malicious
# --env-var landing in the env file with a shell-metachar value.
case "$ENV_VAR" in
    GEMINI_API_KEY|ANTHROPIC_API_KEY|OPENAI_API_KEY) ;;
    *) echo "Unsupported env var: $ENV_VAR" >&2
       echo "Supported: GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY" >&2
       exit 2 ;;
esac

if [ "$DRY_RUN" -eq 1 ]; then
    # Print the plan without touching the filesystem or the daemon.
    # Every real side-effect the script would perform gets a "would:"
    # line so an operator (or smoke test) can eyeball the sequence.
    echo "dry-run: would validate ${ENV_VAR} against whitelist [OK]"
    echo "dry-run: would append ${ENV_VAR}=<hidden> to ${ENV_FILE}"
    echo "dry-run: would chmod 600 ${ENV_FILE}"
    echo "dry-run: would chown root:root ${ENV_FILE}"
    echo "dry-run: would write provider-only status to ${STATUS_FILE}"
    echo "dry-run: would establish or enforce the device owner at ${OWNER_FILE}"
    if command -v systemctl >/dev/null 2>&1; then
        echo "dry-run: would run: systemctl restart icebreaker-controller"
    else
        echo "dry-run: NOTE systemctl not available in PATH — restart would fail"
    fi
    exit 0
fi

# A device has one cloud-credential owner.  pkexec supplies PKEXEC_UID;
# sudo preserves SUDO_USER across the root re-exec.  Do not trust a username
# passed on argv or stdin.  Root remains an explicit break-glass recovery
# path; ordinary administrators cannot replace an existing owner.
CALLER_UID="${PKEXEC_UID:-}"
if [ -z "$CALLER_UID" ] && [ -n "${SUDO_USER:-}" ]; then
    CALLER_UID="$(id -u "$SUDO_USER" 2>/dev/null || true)"
fi
case "$CALLER_UID" in
    ''|*[!0-9]*) CALLER_UID="" ;;
esac

if [ -f "$OWNER_FILE" ] && [ -n "$CALLER_UID" ]; then
    # shellcheck source=/dev/null
    source "$OWNER_FILE"
    if [ "${ICEBREAKER_OWNER_UID:-}" != "$CALLER_UID" ]; then
        echo "Only the device owner can change the cloud API key." >&2
        exit 1
    fi
elif [ ! -f "$OWNER_FILE" ] && [ -n "$CALLER_UID" ]; then
    install -d -m 0700 -o root -g root "$(dirname "$OWNER_FILE")"
    {
        printf 'ICEBREAKER_OWNER_UID=%s\n' "$CALLER_UID"
        printf 'ICEBREAKER_OWNER_USER=%s\n' "$(id -nu "$CALLER_UID")"
    } > "${OWNER_FILE}.tmp"
    chown root:root "${OWNER_FILE}.tmp"
    chmod 600 "${OWNER_FILE}.tmp"
    mv "${OWNER_FILE}.tmp" "$OWNER_FILE"
fi

if [ -t 0 ]; then
    read -rsp "Paste your ${ENV_VAR%_API_KEY} API key (input hidden): " KEY
    echo
else
    # Non-interactive (stdin) — read one line.
    IFS= read -r KEY
fi

[ -n "$KEY" ] || { echo "No key entered — nothing changed." >&2; exit 1; }
case "$KEY" in
    *[[:space:]]*) echo "Key contains whitespace — aborting." >&2; exit 1 ;;
esac

touch "$ENV_FILE"
grep -v "^${ENV_VAR}=" "$ENV_FILE" > "${ENV_FILE}.tmp" || true
printf '%s=%s\n' "$ENV_VAR" "$KEY" >> "${ENV_FILE}.tmp"
mv "${ENV_FILE}.tmp" "$ENV_FILE"
chown root:root "$ENV_FILE"
chmod 600 "$ENV_FILE"

# User interfaces may see *only* whether a provider is configured.  Never
# place the value or a masked derivative in a file readable by another user.
install -d -m 0755 -o root -g root "$(dirname "$STATUS_FILE")"
{
    for status_var in GEMINI_API_KEY ANTHROPIC_API_KEY OPENAI_API_KEY; do
        if grep -q "^${status_var}=" "$ENV_FILE"; then
            printf '%s=configured\n' "$status_var"
        fi
    done
} > "${STATUS_FILE}.tmp"
chown root:root "${STATUS_FILE}.tmp"
chmod 644 "${STATUS_FILE}.tmp"
mv "${STATUS_FILE}.tmp" "$STATUS_FILE"

echo "Key installed. Restarting controller..."
systemctl restart icebreaker-controller

for _ in $(seq 1 45); do
    systemctl is-active --quiet icebreaker-controller && break
    sleep 1
done
if systemctl is-active --quiet icebreaker-controller; then
    echo "Controller running with the new key."
    echo "Try: # list files in my home directory"
else
    echo "WARN: controller not active yet — check: systemctl status icebreaker-controller" >&2
    exit 1
fi
