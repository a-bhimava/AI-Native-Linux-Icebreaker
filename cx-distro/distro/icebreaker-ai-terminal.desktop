[Desktop Entry]
Name=Icebreaker AI Terminal
GenericName=AI Terminal
Comment=Chat-first AI terminal (OpenCode edition) — talks to your OS through Icebreaker's mcpd
# F-93/F-94/F-95 fix: wrap the launcher in bash so a non-zero exit
# (missing API key, opencode itself errors) pauses on a "Press Enter
# to close" prompt. Without this, gnome-terminal closes so fast the
# error message flashes past — reads to the user as "the app crashed."
Exec=gnome-terminal --title="Icebreaker AI Terminal" -- bash -c 'icebreaker-oc "$@"; ec=$?; if [ "$ec" -ne 0 ]; then echo; echo "[icebreaker-oc exited with code $ec]"; read -p "Press Enter to close…" _; fi' _
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=System;TerminalEmulator;Development;
Keywords=ai;terminal;opencode;claude;chat;icebreaker;
StartupNotify=true
