[Desktop Entry]
Name=Icebreaker AI Terminal
GenericName=AI Terminal
Comment=Chat-first AI terminal (OpenCode edition) — talks to your OS through Icebreaker's mcpd
# F-96 (2026-07-27): Exec= must be XDG-spec-compliant — the previous
# inline `bash -c '…'` payload had reserved characters (';', '$', "'")
# that failed `desktop-file-validate`. Delegating to a helper script
# (installed at /usr/bin/icebreaker-oc-terminal) that pauses on
# non-zero exit so gnome-terminal doesn't close the window before
# the user reads any error message (F-94 rationale).
Exec=gnome-terminal --title="Icebreaker AI Terminal" -- icebreaker-oc-terminal
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=System;TerminalEmulator;Development;
Keywords=ai;terminal;opencode;claude;chat;icebreaker;
StartupNotify=true
