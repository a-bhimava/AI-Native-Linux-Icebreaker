[Desktop Entry]
Name=Icebreaker Control Center
Comment=Live system status, API keys, and appearance
# gnome-terminal wrapper NOT needed — this is a GUI app.
Exec=/opt/icebreaker/venv/bin/python3 -m gui.control
Icon=preferences-system
Terminal=false
Type=Application
Categories=System;Settings;
Keywords=icebreaker;status;api;key;theme;
StartupNotify=true
