[Desktop Entry]
Name=Icebreaker Terminal (Autostart)
Comment=Auto-launch Icebreaker split-pane terminal on login
Exec=sh -c 'sleep 5 && /opt/icebreaker/venv/bin/python3 -m terminal --sock /run/icebreaker/controller.sock'
Icon=utilities-terminal
Terminal=false
Type=Application
NoDisplay=true
X-GNOME-Autostart-enabled=true
