[Desktop Entry]
Name=Icebreaker Settings
Comment=Configure the AI-Native OS
Exec=sh -c '/opt/icebreaker/venv/bin/python3 -m gui --settings --sock /run/icebreaker/controller.sock 2>/tmp/icebreaker-gui.log || zenity --error --title="Icebreaker" --text="Failed to start settings.\nSee /tmp/icebreaker-gui.log for details." 2>/dev/null'
Icon=preferences-system
Terminal=false
Type=Application
Categories=Settings;System;
Keywords=settings;configuration;icebreaker;
