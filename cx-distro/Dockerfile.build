FROM ubuntu:noble

RUN apt-get update && apt-get install -y --no-install-recommends \
    debootstrap squashfs-tools xorriso \
    isolinux syslinux-common \
    grub-efi-amd64-bin \
    mtools dosfstools \
    build-essential cmake git ca-certificates curl \
    python3 python3-venv python3-pip python3-dev \
    libseccomp-dev libgirepository1.0-dev libgirepository-2.0-dev libcairo2-dev pkg-config \
    gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# Scope I (2026-07-12): arm64 cross-compile toolchain. gcc/g++-aarch64-linux-gnu
# provides the linker + C++ compiler that rust-lld hands off to for the arm64
# target AND that cmake needs to build llama.cpp for arm64. Confirmed
# necessary during first v6.7 build attempt: mcpd's cargo build for
# aarch64-unknown-linux-gnu failed at link time without it.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc

# Rust toolchain (stable, minimal profile).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# Linux targets for mcpd (both arches). Scope G (2026-07-11): the amd64
# target is native to the container; the aarch64 target lets Stage 1 produce
# `mcpd-arm64` for arm64 ISOs. mcpd's Cargo.toml deps (tokio, seccompiler,
# landlock, zbus, libc, jsonschema, nix, uuid, chrono) are all pure Rust
# with no `cc`-crate C compilation, so `rustup target add` alone suffices
# — no `apt install gcc-aarch64-linux-gnu` needed. If Stage 1 ever fails
# at link time on a new dep that pulls in cc, add the cross linker here
# and export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc.
RUN rustup target add x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu

WORKDIR /build
ENTRYPOINT ["/build/cx-distro/build.sh"]
