!training/adapters/**/adapter_config.json
!training/adapters/**/tokenizer_config.json
!training/adapters/**/chat_template.jinja
!training/adapters/**/README.md

# ── llama.cpp clone ───────────────────────────────────────────────────────────
llama.cpp/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.Python

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
training/logs/
