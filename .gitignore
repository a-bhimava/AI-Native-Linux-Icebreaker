# ── Large model files (too big for git) ──────────────────────────────────────
*.gguf
*.safetensors
*.bin

# ── Training data (large JSONL files) ────────────────────────────────────────
train.jsonl
valid.jsonl
data/dpo_pairs.jsonl
data/

# ── Merged / intermediate model outputs ──────────────────────────────────────
training/merged/
training/gguf/*.gguf

