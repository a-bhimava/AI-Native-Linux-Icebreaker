# v2 — Controller daemon (unconfigured brains) + mcpd
#
# Scope (see GROUND_TRUTH.md § 3 V2, decision D-7):
#   - Python venv built INSIDE the chroot at /opt/icebreaker/venv (no relocation)
#   - controller package + PKG-1 data files (schemas/, prompts/, grammars/, catalogue.toml)
#   - icebreaker-controller.service + sysusers.d + tmpfiles.d + wait-for-sockets
#   - mcpd binary (daemon spawns it unconditionally — dormant until PB in V6)
#   - QB = gemini with NO key → tested _UnconfiguredBackend path (F-5); no echo backend
#   - ICEBREAKER_SOCKET_TIMEOUT=0 (no pbd yet — don't stall ExecStartPre 60 s)
#   - Mac ssh pubkey → authorized_keys (passwordless ib-update inner loop)

VERSION_PACKAGES=""

version_overlay() {
    local chroot="$1" repo="$2"

    # ── 1. Venv inside the chroot (network via host, binds already mounted) ──
    echo "[v2] Copying dual-brain source into chroot..."
    rm -rf "${chroot}/tmp/ib-src"
    mkdir -p "${chroot}/tmp/ib-src"
    cp -a "${repo}/dual-brain/pyproject.toml" \
          "${repo}/dual-brain/controller" \
          "${repo}/dual-brain/terminal" \
          "${repo}/dual-brain/gui" \
          "${repo}/dual-brain/gui_agent" \
          "${repo}/dual-brain/rpa_bridge" \
          "${chroot}/tmp/ib-src/"
    find "${chroot}/tmp/ib-src" -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true

    # V6.6 optimization: cache the built venv per-arch, keyed on Python source
    # tree hash. Native pip install is ~2 min. Under qemu-user emulation for
    # cross-arch (amd64 host → arm64 target) it's ~55 min. Cache extract is
    # ~15 sec. Cache hit = order-of-magnitude speedup on rebuild.
    local _v2_arch="${ARCH:-amd64}"
    local venv_cache_dir="${repo}/incremental/.build/venv-cache/${_v2_arch}"
    mkdir -p "$venv_cache_dir"
    # Hash the Python source pip would install (pyproject + all .py files).
    # Uses RELATIVE paths inside /tmp/ib-src so the resulting hash is stable
    # regardless of chroot working directory — same content = same key even
    # when seeded from repo instead of from a chroot copy.
    # Any source change → cache miss → rebuild. Unchanged → cache hit.
    local src_hash
    src_hash="$(cd "${chroot}/tmp/ib-src" && find . -type f \( -name '*.py' -o -name 'pyproject.toml' -o -name '*.toml' \) -print0 \
        | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16)"
    local venv_cache="${venv_cache_dir}/venv-${src_hash}.tar.zst"
    if [ -f "$venv_cache" ]; then
        echo "[v2] Cache hit — extracting venv-${src_hash}.tar.zst (~15 sec)..."
        mkdir -p "${chroot}/opt/icebreaker"
        zstd -dcT0 "$venv_cache" | tar -C "${chroot}/opt/icebreaker/" -xpf -
    else
        local _pip_msg="Building venv inside chroot (pip install"
        if [ "$_v2_arch" != "$(dpkg --print-architecture)" ]; then
            _pip_msg="${_pip_msg}, ~55 min under qemu-user cross-arch emulation)..."
        else
            _pip_msg="${_pip_msg}, ~2 min native)..."
        fi
        echo "[v2] Cache miss — ${_pip_msg}"
        chroot "$chroot" bash -c "
            set -e
            rm -rf /opt/icebreaker/venv
            python3 -m venv --system-site-packages /opt/icebreaker/venv
            /opt/icebreaker/venv/bin/pip install --no-cache-dir /tmp/ib-src/ 2>&1 | tail -3
        " < /dev/null
        # Save for next rebuild — future iterations skip the 55-min emulation tax.
        echo "[v2] Caching venv → venv-${src_hash}.tar.zst (~15 sec)..."
        tar -C "${chroot}/opt/icebreaker" --zstd -cpf "$venv_cache" venv
    fi

    # PKG-1: pip does not ship package data — copy explicitly.
    local sp
    sp="$(chroot "$chroot" /opt/icebreaker/venv/bin/python3 -c \
        'import controller,os;print(os.path.dirname(controller.__file__))')"
    [ -n "$sp" ] || { echo "FATAL[v2]: controller not importable after pip install" >&2; return 1; }

    # PKG-1: pip doesn't ship package data. Copy schemas/, prompts/, grammars/,
    # catalogue.toml into the installed package BEFORE the F-51 marker loop
    # runs — several B2/C markers assert substrings live under schemas/, so
    # the copy must happen first.
    cp    "${repo}/dual-brain/controller/catalogue.toml" "${chroot}${sp}/catalogue.toml"
    cp -a "${repo}/dual-brain/controller/schemas"  "${chroot}${sp}/schemas"
    cp -a "${repo}/dual-brain/controller/prompts"  "${chroot}${sp}/prompts"
    cp -a "${repo}/dual-brain/controller/grammars" "${chroot}${sp}/grammars"

    # F-51 (2026-07-10): venv integrity check — every recent bug we fixed
    # left a durable comment marker in the installed source. If the venv
    # tarball got reseeded from a stale tree (as it silently did between
    # v6.61 and v6.62), the fixes vanish while prompts + tests update
    # normally, producing an ISO that "passed CI" but ships a regressed
    # daemon. Enforce marker presence before we proceed.
    local _v2_markers=(
        "F-41:main.py:_normalize_server_owned_fields"
        "F-42:main.py:_make_cot"
        "F-43:main.py:uuid.uuid4()"
        "F-45:hitl.py:threading.current_thread() is threading.main_thread()"
        "F-47:main.py:F-47"
        "F-48:main.py:F-48"
        "F-49:main.py:_should_retry_verifier"
        "F-52:main.py:_relax_server_owned_for_backend"
        "F-53:main.py:_log_exception"
        "F-54:fallback_backend.py:FallbackChain"
        # Phase 6 Scope A.P1 F-53 sites (2026-07-10). Every marker below
        # names a specific exception-swallow site that got surfaced this
        # session. If any marker is missing from the installed venv, a
        # stale cache reseeded stale code — see F-51 rule for context.
        "F-53-mvot:verifier.py:vote failed:"
        "F-53-sum:main.py:controller.qb_summarize"
        "F-53-exp:main.py:controller.qb_explain"
        "F-53-cancel:main.py:controller.cancel_audit_write"
        "F-53-rpa:main.py:controller.rpa_stream_parse"
        "F-53-clr:client.py:_malformed_warned"
        "F-53-daemon:daemon.py:parse_message failed:"
        "F-53-verify:logger.py:entries_skipped_verify"
        "F-53-recov:logger.py:entries_skipped_recovery"
        "F-53-shot:../rpa_bridge/bridge.py:_last_screenshot_error"
        # Phase 6 Scope B (2026-07-10) — user-configurable knobs.
        # If any substring below disappears from the installed venv,
        # the reseed dropped Scope B and the shipped ISO is silently
        # back on the hardcoded values. Paths are relative to the
        # controller/ site-packages install root (see line 71–73).
        "B1-turn:client.py:_turn_timeout_seconds"
        "B1-recv:client.py:_reader_recv_timeout_seconds"
        "B1-reconn:client.py:_max_reconnect_delay_seconds"
        "B1-shell:session.py:max_shell_context_chars"
        "B1-recent:session.py:max_recent_commands"
        "B1-probe:model_registry.py:probe_timeout_seconds"
        # Scope B B2 — new fields surfaced in the GUI. Markers point to
        # the JSON Schema (single source of truth) so a stale venv
        # without the new schema keys is caught here.
        "B2-vote:schemas/controller_config.json:x-reload"
        "B2-turnto:schemas/controller_config.json:turn_timeout_seconds"
        "B2-shellchars:schemas/controller_config.json:max_shell_context_chars"
        # Phase 6 Scope C (2026-07-11) — cloud QB preset registry +
        # live verification + XDG state cache. If any of these
        # substrings disappears from the venv, the reseed dropped
        # Scope C and the shipped ISO's Models page falls back to the
        # hardcoded _MODEL_PRESETS tuple.
        "C1-reg:preset_registry.py:load_registry"
        "C2-verify:preset_verifier.py:VerifyStatus"
        "C3-cache:preset_verification_cache.py:_DEFAULT_TTL_DAYS"
        "C4-catv2:catalogue.toml:schema_version"
        "C4-presets:catalogue.toml:[[preset]]"
        # Phase 6 Scope F (2026-07-11) — fix-shape markers. The helper-
        # presence markers above (F-41 / F-42 / F-52 / F-53) prove the
        # functions exist; these markers prove the fixes' load-bearing
        # tokens still exist. A stale venv reseed that reverts a fix
        # would keep the helper function but drop its use — caught here.
        # F-43 streaming call site (comment anchor above main.py:508):
        "F43-stream:main.py:F-43 + F-47"
        # F-47b non-streaming call site (comment anchor above main.py:1496):
        "F47b-inner:main.py:F-47b:"
        # F-48 step_state="done" survives — reverting to "unsupported"
        # crashes CotEvent construction at runtime; caught pre-boot here:
        'F48-fix:main.py:"unsupported", "done"'
        # F-52 backend-facing relaxed schema wired into Controller.__init__:
        "F52-wire:main.py:_backend_intent_schema"
        # F-53 verifier reason surfaces type(exc).__name__ (verifier.py has
        # this at two sites — SingleVerifier + MajorityVoter._single_vote):
        "F53-verifier:verifier.py:type(exc).__name__"
        # Phase 6 Scope G (2026-07-11) — F-56 fix-shape marker.
        # F-56: _emit_unsupported yields ResultEvent, but ResultEvent lives
        # in turn_events which mutually imports from .main — so ResultEvent
        # can only be a LOCAL import inside the method (same pattern as
        # _cot in F-42). If someone removes the local import in a refactor,
        # every unsupported turn hits NameError at runtime.
        #
        # F-55 (arm64 seccomp faccessat) is enforced by smoke-gate.sh L6's
        # `strings /usr/libexec/icebreaker/mcpd | grep -qE 'faccessat'`
        # check — the mcpd binary is not in the venv, so a v2.manifest
        # marker cannot cover it.
        #
        # G5 (mcpd-harvest-guest.sh) is enforced by smoke-gate.sh L6's
        # `[ -x ${CHROOT}/usr/local/bin/mcpd-harvest-guest.sh ]` check.
        "F56-emit-import:main.py:from .turn_events import ResultEvent"
        # v6.8 M7.1 (2026-07-13) — verifier tier-floor. If either the
        # helper or the config field disappears from the installed venv,
        # Tier 0/1 intents silently regress to paying ~2 s verifier
        # latency AND the non-streaming call site loses its tier gate
        # entirely (a coverage hole M7.1 closed).
        "M7.1-floor:verifier.py:should_skip_verifier"
        "M7.1-cfg:config.py:tier_floor: int = 2"
        # v6.8 M7.2 (2026-07-13) — Tier-0 fast path. If either the tool
        # mapping table or the try_fast_path callsite disappears from
        # the installed venv, every Tier-0 read-only intent silently
        # regresses to paying the PB HTTP round-trip.
        "M7.2-mod:tier0_fast_path.py:TIER0_FAST_PATH_TOOLS"
        "M7.2-branch:main.py:_try_tier0_fast_path"
        # v6.8 Task #146 Step 2a (2026-07-13) — AgentGraph adapter shell.
        # If the LangSmith gate is broken, a release ISO could ship
        # tracing on. If the msgpack allowlist is dropped, the SQLi->RCE
        # CVE (§13.1) is exposed.
        "T146-adapter:agent_graph.py:class AgentGraph"
        "T146-state:agent_graph_state.py:GraphState"
        "T146-safe-msg:agent_graph.py:allowed_msgpack_modules"
        "T146-langsmith-gate:agent_graph.py:_ICEBREAKER_PROFILE"
        # v6.8 Task #146 Step 2b (2026-07-13) — nodes + edges + run/resume
        # bodies. If the nodes module is missing or the compile call is
        # absent, AgentGraph reduces to a shell.
        "T146-nodes:agent_graph_nodes.py:def planner_node"
        "T146-compile:agent_graph.py:_build_graph"
    )
    local _mkr _f _needle _target
    for _mkr in "${_v2_markers[@]}"; do
        _f="${_mkr#*:}"; _f="${_f%%:*}"
        _needle="${_mkr##*:}"
        _target="${chroot}${sp}/${_f}"
        [ -f "$_target" ] || { echo "FATAL[v2]: venv-integrity: expected ${_target} to exist for marker ${_mkr}" >&2; return 1; }
        if ! grep -qF "$_needle" "$_target"; then
            echo "FATAL[v2]: venv-integrity: marker ${_mkr} missing." >&2
            echo "  Expected substring '${_needle}' in ${_target}." >&2
            echo "  This usually means the venv-cache tarball was reseeded from a stale" >&2
            echo "  tree. Delete the cache and rebuild:" >&2
            echo "    sudo rm -rf ${repo}/incremental/.build/venv-cache/${_v2_arch}" >&2
            return 1
        fi
    done
    echo "[v2] venv integrity check OK (${#_v2_markers[@]} markers)"
    rm -rf "${chroot}/tmp/ib-src"

    # ── 2. mcpd binary (prebuilt on the VM by cx-distro Stage 1; v4/v5-proven) ──
    # V6.6 F-40: prefer per-arch mcpd-${ARCH} over legacy unsuffixed path.
    # The legacy path is amd64 → will ENOEXEC on arm64 guest at controller
    # startup. Also assert the binary matches the target arch to prevent a
    # silent "amd64 shipped in arm64 ISO" regression.
    local _v2_arch="${ARCH:-amd64}"
    local mcpd_bin=""
    if [ -f "${repo}/cx-distro/.build/mcpd-${_v2_arch}" ]; then
        mcpd_bin="${repo}/cx-distro/.build/mcpd-${_v2_arch}"
    elif [ -f "${repo}/cx-distro/.build/mcpd" ] && [ "$_v2_arch" = "amd64" ]; then
        mcpd_bin="${repo}/cx-distro/.build/mcpd"
    else
        echo "FATAL[v2]: no mcpd for arch=${_v2_arch} at ${repo}/cx-distro/.build/mcpd-${_v2_arch}" >&2
        return 1
    fi
    # Arch cross-check — the file(1) description must name the target arch.
    if command -v file >/dev/null 2>&1; then
        local _mcpd_desc
        _mcpd_desc="$(file "$mcpd_bin" 2>/dev/null || true)"
        case "$_v2_arch:$_mcpd_desc" in
            amd64:*"x86-64"*|amd64:*"x86_64"*) : ;;
            arm64:*"ARM aarch64"*) : ;;
            *) echo "FATAL[v2]: mcpd binary arch mismatch (arch=${_v2_arch}, file: ${_mcpd_desc})" >&2; return 1 ;;
        esac
    fi
    install -Dm755 "$mcpd_bin" "${chroot}/usr/libexec/icebreaker/mcpd"

    # ── 3. /usr/share/icebreaker: schemas (controller + mcpd), prompts, catalogue ──
    local f
    for f in "${repo}"/dual-brain/controller/schemas/*.json "${repo}"/src/mcpd/schemas/*.json; do
        [ -f "$f" ] && install -Dm644 "$f" "${chroot}/usr/share/icebreaker/schemas/$(basename "$f")"
    done
    for f in "${repo}"/dual-brain/controller/prompts/*.txt; do
        [ -f "$f" ] && install -Dm644 "$f" "${chroot}/usr/share/icebreaker/prompts/$(basename "$f")"
    done
    install -Dm644 "${repo}/dual-brain/controller/catalogue.toml" \
        "${chroot}/usr/share/icebreaker/catalogue.toml"

    # ── 4. Config ──
    install -Dm644 "${repo}/cx-distro/distro/controller.toml" \
        "${chroot}/etc/icebreaker/controller.toml"
    install -Dm644 "${repo}/cx-distro/distro/locations.env" \
        "${chroot}/etc/icebreaker/locations.env"
    # v6.65 Phase 7 M7.2 foundation: ships empty; mcpd probes it on startup
    # (see src/mcpd/src/main.rs::log_mcp_allowlist) but does not spawn
    # anything from it. Phase 7 M7.2 wires the spawner.
    install -Dm644 "${repo}/cx-distro/distro/mcp_allowlist.toml" \
        "${chroot}/etc/icebreaker/mcp_allowlist.toml"
    # No pbd until V6: make wait-for-sockets return immediately (V6 manifest reverts).
    echo "ICEBREAKER_SOCKET_TIMEOUT=0" >> "${chroot}/etc/icebreaker/locations.env"

    # ── 5. systemd: controller unit only (pbd/qbd arrive in V6) ──
    install -Dm644 "${repo}/dual-brain/controller/systemd/icebreaker-controller.service" \
        "${chroot}/etc/systemd/system/icebreaker-controller.service"
    install -Dm644 "${repo}/dual-brain/controller/systemd/icebreaker.sysusers.d.conf" \
        "${chroot}/etc/sysusers.d/icebreaker.conf"
    install -Dm644 "${repo}/dual-brain/controller/systemd/icebreaker.tmpfiles.d.conf" \
        "${chroot}/etc/tmpfiles.d/icebreaker.conf"
    install -Dm755 "${repo}/cx-distro/distro/wait-for-sockets" \
        "${chroot}/usr/libexec/icebreaker/wait-for-sockets"
    mkdir -p "${chroot}/etc/systemd/system/multi-user.target.wants"
    ln -sf /etc/systemd/system/icebreaker-controller.service \
        "${chroot}/etc/systemd/system/multi-user.target.wants/icebreaker-controller.service"

    # ── 6. Passwordless ssh for the ib-update inner loop ──
    local pubkey="${repo}/incremental/build/authorized_keys.pub"
    if [ -f "$pubkey" ]; then
        install -Dm600 "$pubkey" "${chroot}/home/icebreaker/.ssh/authorized_keys"
        chroot "$chroot" bash -c "
            chown -R icebreaker:icebreaker /home/icebreaker/.ssh
            chmod 700 /home/icebreaker/.ssh
        " < /dev/null
    else
        echo "WARN[v2]: no authorized_keys.pub staged — ib-update will need a password" >&2
    fi

    # Refresh ib-debug with the daemon.status ping fix.
    install -Dm755 "${repo}/dual-brain/scripts/ib_debug.py" \
        "${chroot}/usr/local/bin/ib-debug"

    # G.5 (Scope G.5, 2026-07-12): ib-bundle diagnostic collector.
    # Runs on first-boot red OR user demand; emits
    # ~/icebreaker-bundle-<ts>-<arch>.tar.zst for GitHub issues.
    install -Dm755 "${repo}/dual-brain/scripts/ib_bundle.py" \
        "${chroot}/usr/local/bin/ib-bundle"

    # G5 (Scope G, 2026-07-11): in-guest seccomp harvest runner. Called by
    # qemu-gate.sh L6 via _ssh to run a 5-tool LOG_ONLY exercise inside
    # the booted VM. Catches arch-specific syscall gaps (F-55 pattern) on
    # the REAL guest kernel + REAL seccomp filter, before an ISO ships.
    install -Dm755 "${repo}/incremental/scripts/mcpd-harvest-guest.sh" \
        "${chroot}/usr/local/bin/mcpd-harvest-guest.sh"
}
