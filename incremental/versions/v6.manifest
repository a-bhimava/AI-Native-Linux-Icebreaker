# v6 — Privileged Brain + mcpd execution
# Adds:
#   - run7_cot_q4km.gguf (940 MB) → /var/lib/icebreaker/models/ + INV-7
#     checksums.sha256 (source hash verified against repo manifest at build)
#   - llama-server (STATIC build — F-21: the old shared-lib build shipped a
#     17 KB binary without libllama.so/libggml.so; probable original cause
#     of "cannot access Privileged Brain")
#   - start-pbd (model-registry resolve + INV-7 verify + UNIX-socket bind)
#   - icebreaker-pbd.service, enabled (runs as _icebreaker_pb — sysusers.d
#     shipped by v2 creates the user at boot)
#   - reverts v2's ICEBREAKER_SOCKET_TIMEOUT=0 hack so wait-for-sockets
#     actually waits for pbd.sock at controller start
# mcpd + schemas already installed by v2. HITL flow is in the controller code.
# Gate: GROUND_TRUTH.md § 3 V6.

# V6B Stage 3: xdotool for active-window title capture (~200 KB). Installing
# via VERSION_PACKAGES keeps the cached base tarball valid — bumping
# packages-desktop.txt would force a ~60-min base rebuild for a single tool.
VERSION_PACKAGES="xdotool"

# Expected model hash from the repo manifest (single source of truth).
_V6_MODEL="run7_cot_q4km.gguf"
_V6_MODEL_SRC="/home/aditya/models/run7_cot_q4km.gguf"
_V6_LLAMA_STATIC="/home/aditya/icebreaker/cx-distro/.build/llama.cpp/build-portable/bin/llama-server"

version_overlay() {
    local chroot="$1" repo="$2"

    # ── 1. Model + checksums (INV-7) ──
    echo "[v6] Verifying model source hash against repo manifest..."
    local expected actual
    expected="$(grep -F "$_V6_MODEL" "${repo}/models/checksums.sha256" | awk '{print $1}')"
    [ -n "$expected" ] || { echo "FATAL[v6]: ${_V6_MODEL} not in models/checksums.sha256" >&2; return 1; }
    [ -f "$_V6_MODEL_SRC" ] || { echo "FATAL[v6]: model not staged at ${_V6_MODEL_SRC}" >&2; return 1; }
    actual="$(sha256sum "$_V6_MODEL_SRC" | awk '{print $1}')"
    [ "$expected" = "$actual" ] || {
        echo "FATAL[v6]: INV-7 — model hash mismatch (expected ${expected}, got ${actual})" >&2
        return 1
    }
    echo "[v6] Embedding model (940 MB — this takes a minute)..."
    install -Dm644 "$_V6_MODEL_SRC" "${chroot}/var/lib/icebreaker/models/${_V6_MODEL}"
    install -Dm644 "${repo}/models/checksums.sha256" \
        "${chroot}/var/lib/icebreaker/models/checksums.sha256"

    # ── 2. llama-server (static, F-21) ──
    [ -f "$_V6_LLAMA_STATIC" ] || {
        echo "FATAL[v6]: portable llama-server not built at ${_V6_LLAMA_STATIC}" >&2
        echo "  Build it: sudo bash /tmp/build-llama-portable.sh (see F-24)" >&2
        return 1
    }
    install -Dm755 "$_V6_LLAMA_STATIC" "${chroot}/usr/libexec/icebreaker/llama-server"
    # F-21 tripwire: every dynamic dependency must resolve INSIDE the chroot.
    if chroot "$chroot" ldd /usr/libexec/icebreaker/llama-server 2>/dev/null | grep -q "not found"; then
        echo "FATAL[v6]: F-21 — llama-server has unresolved shared libs in the chroot:" >&2
        chroot "$chroot" ldd /usr/libexec/icebreaker/llama-server | grep "not found" >&2
        return 1
    fi
    # F-24 tripwire: llama-server must NOT contain AVX-512 (zmm registers) —
    # Apple Silicon UTM's x86-64 emulation only supports up to AVX2. This
    # binary is built for portability (-DGGML_NATIVE=OFF, AVX512=OFF); a
    # future accidental native build would be caught here.
    if command -v objdump >/dev/null 2>&1; then
        if objdump -d "${chroot}/usr/libexec/icebreaker/llama-server" 2>/dev/null | grep -qE 'zmm[0-9]'; then
            echo "FATAL[v6]: F-24 — llama-server contains AVX-512 (zmm) instructions;" >&2
            echo "  will SIGILL on Apple Silicon UTM. Rebuild with -DGGML_AVX512=OFF." >&2
            return 1
        fi
    fi

    # ── 3. start-pbd + pbd unit, enabled ──
    install -Dm755 "${repo}/dual-brain/scripts/start-pbd" \
        "${chroot}/usr/libexec/icebreaker/start-pbd"
    bash -n "${chroot}/usr/libexec/icebreaker/start-pbd" || \
        { echo "FATAL[v6]: start-pbd syntax error" >&2; return 1; }
    install -Dm644 "${repo}/dual-brain/controller/systemd/icebreaker-pbd.service" \
        "${chroot}/etc/systemd/system/icebreaker-pbd.service"
    mkdir -p "${chroot}/etc/systemd/system/multi-user.target.wants"
    ln -sf /etc/systemd/system/icebreaker-pbd.service \
        "${chroot}/etc/systemd/system/multi-user.target.wants/icebreaker-pbd.service"

    # ── 4. Revert v2's wait-for-sockets bypass ──
    sed -i '/^ICEBREAKER_SOCKET_TIMEOUT=0$/d' "${chroot}/etc/icebreaker/locations.env"

    echo "[v6] overlay complete"
}
